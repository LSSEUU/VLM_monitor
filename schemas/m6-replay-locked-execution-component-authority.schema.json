{
  "$defs": {
    "M6ReplayLockedExecutionRoute": {
      "enum": [
        "M3_FAST_TERMINAL_POST_PARSE",
        "M4_HEARING_GATE_TERMINAL_POST_PARSE"
      ],
      "title": "M6ReplayLockedExecutionRoute",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m6-replay-locked-execution-component-authority.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
