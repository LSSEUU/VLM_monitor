      "minLength": 1,
      "title": "Code Commit",
      "type": "string"
    },
    "component": {
      "const": "labcourt-m6-replay-locked-executor",
      "default": "labcourt-m6-replay-locked-executor",
      "title": "Component",
      "type": "string"
    },
    "component_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Component Authority Id",
      "type": "string"
    },
    "evaluator_fields_accessible": {
      "const": false,
      "default": false,
      "title": "Evaluator Fields Accessible",
      "type": "boolean"
    },
    "execution_mode": {
