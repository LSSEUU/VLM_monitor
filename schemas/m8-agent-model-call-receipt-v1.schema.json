{
  "$defs": {
    "M8AgentFailureCode": {
      "enum": [
        "NOT_CONFIGURED",
        "PROVIDER_TIMEOUT",
        "TRANSPORT_UNAVAILABLE",
        "PROVIDER_REJECTED",
        "RESPONSE_INVALID",
        "RESPONSE_TOO_LARGE",
        "TOOL_ARGUMENT_INVALID",
        "TOOL_FORBIDDEN",
        "TOOL_LOOP_LIMIT",
        "STREAM_INTERRUPTED",
        "AUTHORITY_CHANGED",
        "CONVERSATION_NOT_FOUND"
      ],
      "title": "M8AgentFailureCode",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-agent-model-call-receipt-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cache_hit": {
      "title": "Cache Hit",
      "type": "boolean"
    },
    "cache_key": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cache Key",
      "type": "string"
    },
    "completed": {
      "title": "Completed",
      "type": "boolean"
    },
    "failure_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/M8AgentFailureCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "model_call_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Model Call Id",
      "type": "string"
    },
    "model_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Manifest Id",
      "type": "string"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "prompt_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Manifest Id",
      "type": "string"
    },
    "provider_profile_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Provider Profile Id",
      "type": "string"
    },
    "raw_response_ref": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Raw Response Ref",
      "type": "string"
    },
    "raw_response_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Response Sha256",
      "type": "string"
    },
    "round_index": {
      "maximum": 4,
      "minimum": 1,
      "title": "Round Index",
      "type": "integer"
    },
    "schema_version": {
      "const": "m8-agent-model-call-receipt-v1",
      "default": "m8-agent-model-call-receipt-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "tool_schema_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Tool Schema Manifest Id",
      "type": "string"
    }
  },
  "required": [
    "model_call_id",
    "round_index",
    "cache_key",
    "provider_profile_id",
    "model_manifest_id",
    "prompt_manifest_id",
    "tool_schema_manifest_id",
    "raw_response_ref",
    "raw_response_sha256",
    "input_tokens",
    "output_tokens",
    "cache_hit",
    "completed"
  ],
  "title": "M8AgentModelCallReceiptV1",
  "type": "object"
}
