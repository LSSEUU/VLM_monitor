{
  "$defs": {
    "M8PlatformReservationAuthorityV1": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "const": true,
          "default": true,
          "title": "Active",
          "type": "boolean"
        },
        "actor_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Actor Id",
          "type": "string"
        },
        "association_notice": {
          "const": "预约关联，非视觉身份识别",
          "default": "预约关联，非视觉身份识别",
          "title": "Association Notice",
          "type": "string"
        },
        "cross_camera_reidentification_performed": {
          "const": false,
          "default": false,
          "title": "Cross Camera Reidentification Performed",
          "type": "boolean"
        },
        "ends_at": {
          "format": "date-time",
          "title": "Ends At",
          "type": "string"
        },
        "face_recognition_performed": {
          "const": false,
          "default": false,
          "title": "Face Recognition Performed",
          "type": "boolean"
        },
        "location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Location Id",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "reservation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Reservation Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-platform-reservation-authority-v1",
          "default": "m8-platform-reservation-authority-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        }
      },
      "required": [
        "reservation_id",
        "actor_id",
        "location_id",
        "starts_at",
        "ends_at",
        "manifest_id"
      ],
      "title": "M8PlatformReservationAuthorityV1",
      "type": "object"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-platform-bootstrap-receipt-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_commit_receipt_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Actor Commit Receipt Ids",
      "type": "array"
    },
    "bootstrap_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bootstrap Manifest Id",
      "type": "string"
    },
    "bootstrap_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Bootstrap Receipt Id",
      "type": "string"
    },
    "camera_media_binding_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Camera Media Binding Receipt Id",
      "type": "string"
    },
    "current_case_count": {
      "const": 0,
      "default": 0,
      "title": "Current Case Count",
      "type": "integer"
    },
    "current_notification_count": {
      "const": 0,
      "default": 0,
      "title": "Current Notification Count",
      "type": "integer"
    },
    "location_count": {
      "const": 4,
      "default": 4,
      "title": "Location Count",
      "type": "integer"
    },
    "reservation": {
      "$ref": "#/$defs/M8PlatformReservationAuthorityV1"
    },
    "schema_version": {
      "const": "m8-platform-bootstrap-receipt-v1",
      "default": "m8-platform-bootstrap-receipt-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Session Id",
      "type": "string"
    },
    "source_catalog_commit_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Catalog Commit Receipt Id",
      "type": "string"
    },
    "source_count": {
      "const": 3,
      "default": 3,
      "title": "Source Count",
      "type": "integer"
    },
    "topology_commit_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Topology Commit Receipt Id",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "topology_commit_receipt_id",
    "source_catalog_commit_receipt_id",
    "actor_commit_receipt_ids",
    "reservation",
    "camera_media_binding_receipt_id",
    "bootstrap_manifest_id",
    "bootstrap_receipt_id"
  ],
  "title": "M8PlatformBootstrapReceiptV1",
  "type": "object"
}
