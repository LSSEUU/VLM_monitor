{
  "$defs": {
    "AlertChannelIdempotencyGuarantee": {
      "enum": [
        "NONE",
        "EXACT_ALERT_ID"
      ],
      "title": "AlertChannelIdempotencyGuarantee",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/alert-channel-capability-authority.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Durable channel claim governing retries after an unknown delivery.",
  "properties": {
    "capability_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Capability Id",
      "type": "string"
    },
    "capability_revision": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Capability Revision",
      "type": "string"
    },
    "channel": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Channel",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "idempotency_guarantee": {
      "$ref": "#/$defs/AlertChannelIdempotencyGuarantee"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "provider_idempotency_key": {
      "anyOf": [
        {
          "const": "alert_id",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Idempotency Key"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "manifest_id",
    "config_sha256",
    "channel",
    "capability_revision",
    "idempotency_guarantee",
    "capability_id"
  ],
  "title": "AlertChannelCapabilityAuthority",
  "type": "object"
}
