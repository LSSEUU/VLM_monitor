{
  "$defs": {
    "M8PlatformRecognitionMode": {
      "enum": [
        "FULL_MODEL",
        "DEMO_FIXTURE"
      ],
      "title": "M8PlatformRecognitionMode",
      "type": "string"
    },
    "M8PlatformScenarioKind": {
      "enum": [
        "PPE_GOGGLES_MISSING",
        "SMOKE_TEMPERATURE_EMERGENCY"
      ],
      "title": "M8PlatformScenarioKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-platform-scenario-start-request-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "explicit_human_confirmation": {
      "const": true,
      "title": "Explicit Human Confirmation",
      "type": "boolean"
    },
    "recognition_mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/M8PlatformRecognitionMode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "retry_of_run_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry Of Run Id"
    },
    "scenario_kind": {
      "$ref": "#/$defs/M8PlatformScenarioKind"
    },
    "schema_version": {
      "const": "m8-platform-scenario-start-request-v1",
      "default": "m8-platform-scenario-start-request-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "scenario_kind",
    "explicit_human_confirmation"
  ],
  "title": "M8PlatformScenarioStartRequestV1",
  "type": "object"
}
