{
  "$id": "https://schemas.labcourt.local/v2/m8-api-credential-authority-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One bearer-token hash mapping to an actor ID, never to role/capability.",
  "properties": {
    "active": {
      "title": "Active",
      "type": "boolean"
    },
    "actor_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Actor Id",
      "type": "string"
    },
    "bearer_token_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bearer Token Sha256",
      "type": "string"
    },
    "credential_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Credential Authority Id",
      "type": "string"
    },
    "credential_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Credential Id",
      "type": "string"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m8-api-credential-authority-v1",
      "default": "m8-api-credential-authority-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "credential_id",
    "actor_id",
    "bearer_token_sha256",
    "active",
    "manifest_id",
    "credential_authority_id"
  ],
  "title": "M8ApiCredentialAuthorityV1",
  "type": "object"
}
