{
  "$defs": {
    "AcquisitionAction": {
      "enum": [
        "REQUEST_MORE_FRAMES",
        "RECROP",
        "OTHER_CAMERA_SAME_TIME",
        "TRACK_CONFIDENCE_CURVE",
        "REDETECT_HIGH_RES"
      ],
      "title": "AcquisitionAction",
      "type": "string"
    },
    "AcquisitionRequest": {
      "additionalProperties": false,
      "description": "Scoped executable request derived exactly from one Judge proposal.",
      "properties": {
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "current_evidence_pack_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Current Evidence Pack Id",
          "type": "string"
        },
        "current_evidence_pack_version": {
          "exclusiveMinimum": 0,
          "title": "Current Evidence Pack Version",
          "type": "integer"
        },
        "hearing_session_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hearing Session Id",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "prior_acquisition_rounds": {
          "exclusiveMaximum": 2,
          "minimum": 0,
          "title": "Prior Acquisition Rounds",
          "type": "integer"
        },
        "prior_rework_rounds": {
          "maximum": 2,
          "minimum": 0,
          "title": "Prior Rework Rounds",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Request Id",
          "type": "string"
        },
        "request_payload": {
          "$ref": "#/$defs/AcquisitionRequestPayload"
        },
        "round_index": {
          "exclusiveMinimum": 0,
          "maximum": 5,
          "title": "Round Index",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m4-acquisition-request-v1",
          "default": "m4-acquisition-request-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_judge_output_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Judge Output Id",
          "type": "string"
        },
        "source_model_request_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "source_model_response_ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "hearing_session_id",
        "round_index",
        "prior_acquisition_rounds",
        "prior_rework_rounds",
        "current_evidence_pack_id",
        "current_evidence_pack_version",
        "source_judge_output_id",
        "source_model_request_ref",
        "source_model_response_ref",
        "request_payload",
        "manifest_id",
        "request_id"
      ],
      "title": "AcquisitionRequest",
      "type": "object"
    },
    "AcquisitionRequestPayload": {
      "additionalProperties": false,
      "description": "Model-authored, non-authoritative proposal for one whitelisted tool action.",
      "properties": {
        "action": {
          "$ref": "#/$defs/AcquisitionAction"
        },
        "reason_summary": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Reason Summary",
          "type": "string"
        },
        "request_payload_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Request Payload Id",
          "type": "string"
        },
        "supporting_evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "maxItems": 32,
          "title": "Supporting Evidence Refs",
          "type": "array"
        },
        "validated_parameters": {
          "discriminator": {
            "mapping": {
              "OTHER_CAMERA_SAME_TIME": "#/$defs/OtherCameraSameTimeParameters",
              "RECROP": "#/$defs/RecropParameters",
              "REDETECT_HIGH_RES": "#/$defs/RedetectHighResolutionParameters",
              "REQUEST_MORE_FRAMES": "#/$defs/RequestMoreFramesParameters",
              "TRACK_CONFIDENCE_CURVE": "#/$defs/TrackConfidenceCurveParameters"
            },
            "propertyName": "action"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RequestMoreFramesParameters"
            },
            {
              "$ref": "#/$defs/RecropParameters"
            },
            {
              "$ref": "#/$defs/OtherCameraSameTimeParameters"
            },
            {
              "$ref": "#/$defs/TrackConfidenceCurveParameters"
            },
            {
              "$ref": "#/$defs/RedetectHighResolutionParameters"
            }
          ],
          "title": "Validated Parameters"
        }
      },
      "required": [
        "action",
        "validated_parameters",
        "reason_summary",
        "request_payload_id"
      ],
      "title": "AcquisitionRequestPayload",
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "RUN",
        "FRAME",
        "SAFETY_SIGNAL",
        "EVENT",
        "CASE",
        "DETECTION",
        "OBJECTIVE_FACT",
        "CROP",
        "MEDIA",
        "EVIDENCE_PACK",
        "TOOL_RESULT",
        "MANIFEST",
        "MODEL_RESPONSE",
        "MODEL_REQUEST",
        "PROMPT_MANIFEST",
        "MODEL_PARSE_RECEIPT",
        "PARSED_MODEL_OUTPUT",
        "PROCEDURAL_REVIEW",
        "MODEL_CACHE_ENTRY",
        "SCREENING_RESULT",
        "VERDICT",
        "ALERT",
        "PRECEDENT",
        "APPEAL",
        "TRAINING_LABEL",
        "BACKLOG_ITEM",
        "DATASET"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A kind-discriminated reference with syntax fixed by the artifact kind.",
      "properties": {
        "artifact_id": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BBoxXYXY": {
      "additionalProperties": false,
      "description": "Integer `[x1, y1, x2, y2)` bounding box.",
      "properties": {
        "x1": {
          "minimum": 0,
          "title": "X1",
          "type": "integer"
        },
        "x2": {
          "exclusiveMinimum": 0,
          "title": "X2",
          "type": "integer"
        },
        "y1": {
          "minimum": 0,
          "title": "Y1",
          "type": "integer"
        },
        "y2": {
          "exclusiveMinimum": 0,
          "title": "Y2",
          "type": "integer"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "BBoxXYXY",
      "type": "object"
    },
    "OtherCameraSameTimeParameters": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "OTHER_CAMERA_SAME_TIME",
          "title": "Action",
          "type": "string"
        },
        "source_frame_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:(?:0|[1-9][0-9]{0,19})$",
          "title": "Source Frame Id",
          "type": "string"
        },
        "target_camera_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Target Camera Id",
          "type": "string"
        }
      },
      "required": [
        "action",
        "source_frame_id",
        "target_camera_id"
      ],
      "title": "OtherCameraSameTimeParameters",
      "type": "object"
    },
    "RecropParameters": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "RECROP",
          "title": "Action",
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BBoxXYXY"
        },
        "frame_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:(?:0|[1-9][0-9]{0,19})$",
          "title": "Frame Id",
          "type": "string"
        }
      },
      "required": [
        "action",
        "frame_id",
        "bbox"
      ],
      "title": "RecropParameters",
      "type": "object"
    },
    "RedetectHighResolutionParameters": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "REDETECT_HIGH_RES",
          "title": "Action",
          "type": "string"
        },
        "crop_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Crop Id",
          "type": "string"
        },
        "prompts": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Prompts",
          "type": "array"
        }
      },
      "required": [
        "action",
        "crop_id",
        "prompts"
      ],
      "title": "RedetectHighResolutionParameters",
      "type": "object"
    },
    "RequestMoreFramesParameters": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "REQUEST_MORE_FRAMES",
          "title": "Action",
          "type": "string"
        },
        "camera_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Camera Id",
          "type": "string"
        },
        "end_frame_exclusive": {
          "exclusiveMinimum": 0,
          "title": "End Frame Exclusive",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "step": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "stream_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Stream Id",
          "type": "string"
        }
      },
      "required": [
        "action",
        "camera_id",
        "stream_id",
        "start_frame",
        "end_frame_exclusive"
      ],
      "title": "RequestMoreFramesParameters",
      "type": "object"
    },
    "ToolExecutionManifest": {
      "additionalProperties": false,
      "description": "Immutable implementation authority for one whitelisted acquisition action.",
      "properties": {
        "acquisition_request_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Acquisition Request Id",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/AcquisitionAction"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "component_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Component Manifest Id",
          "type": "string"
        },
        "execution_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Execution Manifest Id",
          "type": "string"
        },
        "hearing_session_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hearing Session Id",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "model_manifest_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Manifest Id"
        },
        "parameters_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parameters Schema Sha256",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m4-tool-execution-manifest-v1",
          "default": "m4-tool-execution-manifest-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Tool Id",
          "type": "string"
        },
        "tool_revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Tool Revision",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "hearing_session_id",
        "acquisition_request_id",
        "action",
        "tool_id",
        "tool_revision",
        "parameters_schema_sha256",
        "component_manifest_id",
        "manifest_id",
        "execution_manifest_id"
      ],
      "title": "ToolExecutionManifest",
      "type": "object"
    },
    "ToolResult": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/AcquisitionAction"
        },
        "execution_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Execution Manifest Id",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "output_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Output Refs",
          "type": "array"
        },
        "tool_result_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Tool Result Id",
          "type": "string"
        },
        "validated_parameters": {
          "discriminator": {
            "mapping": {
              "OTHER_CAMERA_SAME_TIME": "#/$defs/OtherCameraSameTimeParameters",
              "RECROP": "#/$defs/RecropParameters",
              "REDETECT_HIGH_RES": "#/$defs/RedetectHighResolutionParameters",
              "REQUEST_MORE_FRAMES": "#/$defs/RequestMoreFramesParameters",
              "TRACK_CONFIDENCE_CURVE": "#/$defs/TrackConfidenceCurveParameters"
            },
            "propertyName": "action"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RequestMoreFramesParameters"
            },
            {
              "$ref": "#/$defs/RecropParameters"
            },
            {
              "$ref": "#/$defs/OtherCameraSameTimeParameters"
            },
            {
              "$ref": "#/$defs/TrackConfidenceCurveParameters"
            },
            {
              "$ref": "#/$defs/RedetectHighResolutionParameters"
            }
          ],
          "title": "Validated Parameters"
        }
      },
      "required": [
        "tool_result_id",
        "action",
        "input_refs",
        "output_refs",
        "validated_parameters",
        "execution_manifest_id"
      ],
      "title": "ToolResult",
      "type": "object"
    },
    "TrackConfidenceCurveParameters": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "TRACK_CONFIDENCE_CURVE",
          "title": "Action",
          "type": "string"
        },
        "end_frame_exclusive": {
          "exclusiveMinimum": 0,
          "title": "End Frame Exclusive",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "track_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Track Ref",
          "type": "string"
        }
      },
      "required": [
        "action",
        "track_ref",
        "start_frame",
        "end_frame_exclusive"
      ],
      "title": "TrackConfidenceCurveParameters",
      "type": "object"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/tool-execution-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact request/result/manifest closure that advances EvidencePack by one version.",
  "properties": {
    "execution_manifest": {
      "$ref": "#/$defs/ToolExecutionManifest"
    },
    "receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Receipt Id",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/AcquisitionRequest"
    },
    "resulting_evidence_pack_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Resulting Evidence Pack Id",
      "type": "string"
    },
    "resulting_evidence_pack_version": {
      "exclusiveMinimum": 0,
      "title": "Resulting Evidence Pack Version",
      "type": "integer"
    },
    "schema_version": {
      "const": "m4-tool-execution-receipt-v1",
      "default": "m4-tool-execution-receipt-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "tool_result": {
      "$ref": "#/$defs/ToolResult"
    }
  },
  "required": [
    "request",
    "execution_manifest",
    "tool_result",
    "resulting_evidence_pack_id",
    "resulting_evidence_pack_version",
    "receipt_id"
  ],
  "title": "ToolExecutionReceipt",
  "type": "object"
}
