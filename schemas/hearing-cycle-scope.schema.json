{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "RUN",
        "FRAME",
        "SAFETY_SIGNAL",
        "EVENT",
        "CASE",
        "DETECTION",
        "OBJECTIVE_FACT",
        "CROP",
        "MEDIA",
        "EVIDENCE_PACK",
        "TOOL_RESULT",
        "MANIFEST",
        "MODEL_RESPONSE",
        "MODEL_REQUEST",
        "PROMPT_MANIFEST",
        "MODEL_PARSE_RECEIPT",
        "PARSED_MODEL_OUTPUT",
        "PROCEDURAL_REVIEW",
        "MODEL_CACHE_ENTRY",
        "SCREENING_RESULT",
        "VERDICT",
        "ALERT",
        "PRECEDENT",
        "APPEAL",
        "TRAINING_LABEL",
        "BACKLOG_ITEM",
        "DATASET"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A kind-discriminated reference with syntax fixed by the artifact kind.",
      "properties": {
        "artifact_id": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ProceduralDefectCode": {
      "enum": [
        "MALFORMED_STRUCTURE",
        "INVALID_ENUM",
        "MISSING_REQUIRED_FIELD",
        "FABRICATED_EVIDENCE_REFERENCE",
        "INVALID_COORDINATES",
        "FABRICATED_PRECEDENT_REFERENCE",
        "PRECEDENT_DIRECTION_MISMATCH",
        "EMPTY_DISTINGUISHING_REASON",
        "ESTABLISHED_WITHOUT_EVIDENCE",
        "UNANSWERED_DEFENSE_POINT",
        "CONFIDENCE_ALERT_LEVEL_MISMATCH",
        "OBJECTIVE_ASSERTION_CONTRADICTION",
        "VIOLATION_TYPE_MISMATCH",
        "ABSENCE_FROM_INSUFFICIENT_OBSERVATION"
      ],
      "title": "ProceduralDefectCode",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/hearing-cycle-scope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable authority persisted when one logical Judge cycle begins.",
  "properties": {
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "cycle_evidence_pack_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cycle Evidence Pack Id",
      "type": "string"
    },
    "cycle_evidence_pack_version": {
      "exclusiveMinimum": 0,
      "title": "Cycle Evidence Pack Version",
      "type": "integer"
    },
    "cycle_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Cycle Id",
      "type": "string"
    },
    "cycle_index": {
      "exclusiveMinimum": 0,
      "maximum": 5,
      "title": "Cycle Index",
      "type": "integer"
    },
    "cycle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Cycle Sha256",
      "type": "string"
    },
    "hearing_session_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hearing Session Id",
      "type": "string"
    },
    "initial_defect_codes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProceduralDefectCode"
      },
      "maxItems": 14,
      "title": "Initial Defect Codes",
      "type": "array"
    },
    "initial_trigger_review_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "prior_acquisition_rounds": {
      "maximum": 2,
      "minimum": 0,
      "title": "Prior Acquisition Rounds",
      "type": "integer"
    },
    "prior_rework_rounds": {
      "maximum": 2,
      "minimum": 0,
      "title": "Prior Rework Rounds",
      "type": "integer"
    },
    "rework_defect_codes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProceduralDefectCode"
      },
      "maxItems": 14,
      "title": "Rework Defect Codes",
      "type": "array"
    },
    "rework_review_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m4-hearing-cycle-scope-v1",
      "default": "m4-hearing-cycle-scope-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "hearing_session_id",
    "cycle_index",
    "prior_acquisition_rounds",
    "prior_rework_rounds",
    "cycle_evidence_pack_id",
    "cycle_evidence_pack_version",
    "manifest_id",
    "cycle_id",
    "cycle_sha256"
  ],
  "title": "HearingCycleScope",
  "type": "object"
}
