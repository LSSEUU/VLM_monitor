{
  "$defs": {
    "AffectedCitationReport": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AffectedPrecedentCitation"
          },
          "title": "Citations",
          "type": "array"
        },
        "report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Report Sha256",
          "type": "string"
        },
        "revoked_precedent_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "title": "Revoked Precedent Ids",
          "type": "array"
        }
      },
      "required": [
        "report_sha256"
      ],
      "title": "AffectedCitationReport",
      "type": "object"
    },
    "AffectedPrecedentCitation": {
      "additionalProperties": false,
      "description": "One immutable historical citation affected by a precedent revocation.",
      "properties": {
        "citation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Citation Id",
          "type": "string"
        },
        "citing_case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Citing Case Id",
          "type": "string"
        },
        "precedent_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Precedent Id",
          "type": "string"
        },
        "similarity_score": {
          "maximum": 10,
          "minimum": -10,
          "title": "Similarity Score",
          "type": "number"
        },
        "source_citation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Citation Id",
          "type": "string"
        }
      },
      "required": [
        "source_citation_id",
        "citing_case_id",
        "precedent_id",
        "similarity_score",
        "citation_id"
      ],
      "title": "AffectedPrecedentCitation",
      "type": "object"
    },
    "AlertRescissionIntent": {
      "additionalProperties": false,
      "properties": {
        "alert_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Alert Id",
          "type": "string"
        },
        "rescinded": {
          "const": true,
          "default": true,
          "title": "Rescinded",
          "type": "boolean"
        }
      },
      "required": [
        "alert_id"
      ],
      "title": "AlertRescissionIntent",
      "type": "object"
    },
    "Appeal": {
      "additionalProperties": false,
      "properties": {
        "appeal_id": {
          "minLength": 1,
          "title": "Appeal Id",
          "type": "string"
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "resolution_summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Summary"
        },
        "resolved_decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerdictDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reviewer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Id"
        },
        "status": {
          "$ref": "#/$defs/AppealStatus"
        },
        "submitted_by": {
          "minLength": 1,
          "title": "Submitted By",
          "type": "string"
        }
      },
      "required": [
        "appeal_id",
        "case_id",
        "status",
        "reason",
        "submitted_by"
      ],
      "title": "Appeal",
      "type": "object"
    },
    "AppealResolutionPrecedentSnapshot": {
      "additionalProperties": false,
      "description": "Complete current automatic-precedent view captured for terminal CAS.",
      "properties": {
        "automatic_precedents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AutomaticPrecedentAppealAuthority"
          },
          "title": "Automatic Precedents",
          "type": "array"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "complete": {
          "const": true,
          "default": true,
          "title": "Complete",
          "type": "boolean"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "snapshot_sha256"
      ],
      "title": "AppealResolutionPrecedentSnapshot",
      "type": "object"
    },
    "AppealStatus": {
      "enum": [
        "SUBMITTED",
        "UNDER_REVIEW",
        "UPHELD",
        "OVERTURNED"
      ],
      "title": "AppealStatus",
      "type": "string"
    },
    "AppealVersionAuthority": {
      "additionalProperties": false,
      "description": "One append-only version in the fixed three-step appeal state machine.",
      "properties": {
        "appeal": {
          "$ref": "#/$defs/Appeal"
        },
        "assigned_reviewer_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assigned Reviewer Id"
        },
        "authority_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Authority Sha256",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "previous_authority_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Authority Sha256"
        },
        "rule_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "source_case_authority": {
          "$ref": "#/$defs/ClosedCaseAppealAuthority"
        },
        "source_case_authority_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Case Authority Sha256",
          "type": "string"
        },
        "source_case_revision": {
          "exclusiveMinimum": 0,
          "title": "Source Case Revision",
          "type": "integer"
        },
        "source_decision": {
          "$ref": "#/$defs/VerdictDecision"
        },
        "source_verdict_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Verdict Id",
          "type": "string"
        },
        "source_verdict_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Verdict Sha256",
          "type": "string"
        },
        "source_verdict_version": {
          "exclusiveMinimum": 0,
          "title": "Source Verdict Version",
          "type": "integer"
        },
        "text_embedding_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Embedding Manifest Id",
          "type": "string"
        },
        "version": {
          "maximum": 3,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "visual_embedding_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Visual Embedding Manifest Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "appeal",
        "version",
        "source_case_authority",
        "source_case_revision",
        "source_case_authority_sha256",
        "source_verdict_id",
        "source_verdict_version",
        "source_verdict_sha256",
        "source_decision",
        "text_embedding_manifest_id",
        "visual_embedding_manifest_id",
        "manifest_id",
        "rule_version",
        "authority_sha256"
      ],
      "title": "AppealVersionAuthority",
      "type": "object"
    },
    "AppealableAlertAuthority": {
      "additionalProperties": false,
      "description": "An original adjudicated alert that has not yet been rescinded.",
      "properties": {
        "alert_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Alert Id",
          "type": "string"
        },
        "rescinded": {
          "const": false,
          "default": false,
          "title": "Rescinded",
          "type": "boolean"
        }
      },
      "required": [
        "alert_id"
      ],
      "title": "AppealableAlertAuthority",
      "type": "object"
    },
    "AutomaticPrecedentAppealAuthority": {
      "additionalProperties": false,
      "description": "The exact automatic precedent state visible before appeal resolution.",
      "properties": {
        "citations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AffectedPrecedentCitation"
          },
          "title": "Citations",
          "type": "array"
        },
        "decision_direction": {
          "$ref": "#/$defs/VerdictDecision"
        },
        "precedent_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Precedent Authority Id",
          "type": "string"
        },
        "precedent_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Precedent Id",
          "type": "string"
        },
        "precedent_revision": {
          "exclusiveMinimum": 0,
          "title": "Precedent Revision",
          "type": "integer"
        },
        "source": {
          "const": "AUTOMATIC",
          "default": "AUTOMATIC",
          "title": "Source",
          "type": "string"
        },
        "source_case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Source Case Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "PROVISIONAL",
            "ACTIVE",
            "CONFLICT",
            "INVALIDATED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "precedent_id",
        "precedent_authority_id",
        "precedent_revision",
        "status",
        "decision_direction",
        "source_case_id"
      ],
      "title": "AutomaticPrecedentAppealAuthority",
      "type": "object"
    },
    "BBoxXYXY": {
      "additionalProperties": false,
      "description": "Integer `[x1, y1, x2, y2)` bounding box.",
      "properties": {
        "x1": {
          "minimum": 0,
          "title": "X1",
          "type": "integer"
        },
        "x2": {
          "exclusiveMinimum": 0,
          "title": "X2",
          "type": "integer"
        },
        "y1": {
          "minimum": 0,
          "title": "Y1",
          "type": "integer"
        },
        "y2": {
          "exclusiveMinimum": 0,
          "title": "Y2",
          "type": "integer"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "BBoxXYXY",
      "type": "object"
    },
    "ClosedCaseAppealAuthority": {
      "additionalProperties": false,
      "description": "Minimal immutable Case projection authorized to accept one appeal.",
      "properties": {
        "alerts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AppealableAlertAuthority"
          },
          "title": "Alerts",
          "type": "array"
        },
        "authority_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Authority Sha256",
          "type": "string"
        },
        "automatic_precedents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AutomaticPrecedentAppealAuthority"
          },
          "title": "Automatic Precedents",
          "type": "array"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "case_revision": {
          "exclusiveMinimum": 0,
          "title": "Case Revision",
          "type": "integer"
        },
        "case_status": {
          "const": "CLOSED",
          "default": "CLOSED",
          "title": "Case Status",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "detector_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Detector Manifest Id",
          "type": "string"
        },
        "effective_appeal_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "title": "Effective Appeal Ids",
          "type": "array"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "final_decision": {
          "$ref": "#/$defs/VerdictDecision"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "rule_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "text_embedding_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Embedding Manifest Id",
          "type": "string"
        },
        "verdict_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Verdict Id",
          "type": "string"
        },
        "verdict_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Verdict Sha256",
          "type": "string"
        },
        "verdict_version": {
          "exclusiveMinimum": 0,
          "title": "Verdict Version",
          "type": "integer"
        },
        "violation_type": {
          "$ref": "#/$defs/ViolationType"
        },
        "visual_embedding_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Visual Embedding Manifest Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "case_revision",
        "verdict_id",
        "verdict_version",
        "verdict_sha256",
        "final_decision",
        "evidence_class",
        "violation_type",
        "detector_manifest_id",
        "text_embedding_manifest_id",
        "visual_embedding_manifest_id",
        "manifest_id",
        "config_sha256",
        "rule_version",
        "authority_sha256"
      ],
      "title": "ClosedCaseAppealAuthority",
      "type": "object"
    },
    "EvidenceClass": {
      "enum": [
        "PRESENCE",
        "ABSENCE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "M5EmbeddingChannel": {
      "enum": [
        "TEXT",
        "VISUAL"
      ],
      "title": "M5EmbeddingChannel",
      "type": "string"
    },
    "M5EmbeddingRequest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "FAKE_SHA256_SIGNED_PROJECTION_V1",
          "default": "FAKE_SHA256_SIGNED_PROJECTION_V1",
          "title": "Algorithm",
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/M5EmbeddingChannel"
        },
        "dimensions": {
          "exclusiveMinimum": 0,
          "maximum": 4096,
          "title": "Dimensions",
          "type": "integer"
        },
        "input_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Input Ref",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "model_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Manifest Id",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m5-embedding-request-v1",
          "default": "m5-embedding-request-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "input_ref",
        "input_sha256",
        "model_manifest_id",
        "dimensions",
        "request_id"
      ],
      "title": "M5EmbeddingRequest",
      "type": "object"
    },
    "M5EmbeddingVector": {
      "additionalProperties": false,
      "properties": {
        "embedding_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Embedding Id",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/M5EmbeddingRequest"
        },
        "schema_version": {
          "const": "m5-embedding-vector-v1",
          "default": "m5-embedding-vector-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "request",
        "values",
        "embedding_id"
      ],
      "title": "M5EmbeddingVector",
      "type": "object"
    },
    "M5PrecedentAuthority": {
      "additionalProperties": false,
      "properties": {
        "activated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activated At"
        },
        "activation_not_before": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activation Not Before"
        },
        "authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Authority Id",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "precedent": {
          "$ref": "#/$defs/Precedent"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m5-precedent-authority-v1",
          "default": "m5-precedent-authority-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "text_embedding": {
          "anyOf": [
            {
              "$ref": "#/$defs/M5EmbeddingVector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "visual_embeddings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/M5EmbeddingVector"
          },
          "maxItems": 32,
          "title": "Visual Embeddings",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "config_sha256",
        "revision",
        "precedent",
        "created_at",
        "authority_id"
      ],
      "title": "M5PrecedentAuthority",
      "type": "object"
    },
    "Precedent": {
      "additionalProperties": false,
      "properties": {
        "activation_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activation At"
        },
        "citation_count": {
          "default": 0,
          "minimum": 0,
          "title": "Citation Count",
          "type": "integer"
        },
        "decision_direction": {
          "$ref": "#/$defs/VerdictDecision"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "invalidated_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalidated By"
        },
        "precedent_id": {
          "minLength": 1,
          "title": "Precedent Id",
          "type": "string"
        },
        "rule_version": {
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "situation_text": {
          "minLength": 1,
          "title": "Situation Text",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/PrecedentSource"
        },
        "source_case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Case Id"
        },
        "status": {
          "$ref": "#/$defs/PrecedentStatus"
        },
        "text_embedding_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Embedding Ref"
        },
        "violation_type": {
          "$ref": "#/$defs/ViolationType"
        },
        "visual_embedding_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Visual Embedding Refs",
          "type": "array"
        }
      },
      "required": [
        "precedent_id",
        "situation_text",
        "decision_direction",
        "source",
        "status",
        "evidence_class",
