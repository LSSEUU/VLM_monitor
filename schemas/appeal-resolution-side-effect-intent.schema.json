  "$id": "https://schemas.labcourt.local/v2/appeal-resolution-side-effect-intent.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Atomic effects required by one terminal human appeal decision.",
  "properties": {
    "affected_citations": {
      "$ref": "#/$defs/AffectedCitationReport"
    },
    "alert_rescissions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AlertRescissionIntent"
      },
      "title": "Alert Rescissions",
      "type": "array"
    },
    "appeal_authority": {
      "$ref": "#/$defs/AppealVersionAuthority"
    },
    "appeal_precedent_authority": {
      "anyOf": [
        {
          "$ref": "#/$defs/M5PrecedentAuthority"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "expected_case_revision": {
      "exclusiveMinimum": 0,
      "title": "Expected Case Revision",
      "type": "integer"
    },
    "final_decision": {
      "$ref": "#/$defs/VerdictDecision"
    },
    "final_decision_changed": {
      "readOnly": true,
      "title": "Final Decision Changed",
      "type": "boolean"
    },
    "intent_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Intent Id",
      "type": "string"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "precedent_revocations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PrecedentRevocationIntent"
      },
      "title": "Precedent Revocations",
      "type": "array"
    },
    "precedent_snapshot": {
      "$ref": "#/$defs/AppealResolutionPrecedentSnapshot"
    },
    "rule_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Rule Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "source_decision": {
      "$ref": "#/$defs/VerdictDecision"
    },
    "source_verdict_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Verdict Id",
      "type": "string"
    },
    "text_embedding_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Text Embedding Manifest Id",
      "type": "string"
    },
    "training_labels": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TrainingLabel"
      },
      "maxItems": 10000,
      "title": "Training Labels",
      "type": "array"
    },
    "verdict_rescission": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerdictRescissionIntent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "visual_embedding_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Visual Embedding Manifest Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "expected_case_revision",
    "appeal_authority",
    "source_verdict_id",
    "source_decision",
    "precedent_snapshot",
    "final_decision",
    "affected_citations",
    "text_embedding_manifest_id",
    "visual_embedding_manifest_id",
    "manifest_id",
    "rule_version",
    "final_decision_changed",
    "intent_id"
  ],
  "title": "AppealResolutionSideEffectIntent",
  "type": "object"
}
