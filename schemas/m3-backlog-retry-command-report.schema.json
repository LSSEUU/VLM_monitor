{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "RUN",
        "FRAME",
        "SAFETY_SIGNAL",
        "EVENT",
        "CASE",
        "DETECTION",
        "OBJECTIVE_FACT",
        "CROP",
        "MEDIA",
        "EVIDENCE_PACK",
        "TOOL_RESULT",
        "MANIFEST",
        "MODEL_RESPONSE",
        "MODEL_REQUEST",
        "PROMPT_MANIFEST",
        "MODEL_PARSE_RECEIPT",
        "PARSED_MODEL_OUTPUT",
        "PROCEDURAL_REVIEW",
        "MODEL_CACHE_ENTRY",
        "SCREENING_RESULT",
        "VERDICT",
        "ALERT",
        "PRECEDENT",
        "APPEAL",
        "TRAINING_LABEL",
        "BACKLOG_ITEM",
        "DATASET"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A kind-discriminated reference with syntax fixed by the artifact kind.",
      "properties": {
        "artifact_id": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BacklogCompletionReceipt": {
      "additionalProperties": false,
      "description": "Immutable receipt for an atomic retry attempt and Case/audit transition.\n\nReplaying the exact outcome under the exact lease must return this same\n``receipt_id``.  A caller-visible ``created`` flag belongs to the repository\nreturn wrapper and is intentionally excluded from the durable identity.",
      "properties": {
        "backlog_status": {
          "enum": [
            "PENDING",
            "COMPLETED",
            "EXHAUSTED"
          ],
          "title": "Backlog Status",
          "type": "string"
        },
        "completion_audit_entry_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Completion Audit Entry Hash",
          "type": "string"
        },
        "completion_audit_sequence": {
          "minimum": 0,
          "title": "Completion Audit Sequence",
          "type": "integer"
        },
        "completion_case_revision": {
          "exclusiveMinimum": 0,
          "title": "Completion Case Revision",
          "type": "integer"
        },
        "completion_case_status": {
          "enum": [
            "BACKLOGGED",
            "ESCALATED",
            "READY_FOR_ALERT_POLICY",
            "REWORK_REQUIRED",
            "HUMAN_REVIEW"
          ],
          "title": "Completion Case Status",
          "type": "string"
        },
        "completion_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "outcome": {
          "discriminator": {
            "mapping": {
              "FAILURE": "#/$defs/BacklogRetryFailure",
              "SUCCESS": "#/$defs/BacklogRetrySuccess"
            },
            "propertyName": "outcome_kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BacklogRetrySuccess"
            },
            {
              "$ref": "#/$defs/BacklogRetryFailure"
            }
          ],
          "title": "Outcome"
        },
        "receipt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Receipt Id",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "backlog_status",
        "completion_ref",
        "completion_case_status",
        "completion_case_revision",
        "completion_audit_sequence",
        "completion_audit_entry_hash",
        "manifest_id",
        "receipt_id"
      ],
      "title": "BacklogCompletionReceipt",
      "type": "object"
    },
    "BacklogItem": {
      "additionalProperties": false,
      "description": "One immutable retry identity with explicit mutable lease progress.",
      "properties": {
        "attempt_count": {
          "default": 0,
          "minimum": 0,
          "title": "Attempt Count",
          "type": "integer"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "completed": {
          "readOnly": true,
          "title": "Completed",
          "type": "boolean"
        },
        "item_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Item Id",
          "type": "string"
        },
        "lease_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Expires At"
        },
        "lease_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Id"
        },
        "lease_owner_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Owner Sha256"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "max_attempts": {
          "exclusiveMinimum": 0,
          "title": "Max Attempts",
          "type": "integer"
        },
        "reason_code": {
          "enum": [
            "PROVIDER_UNAVAILABLE",
            "MODEL_OUTPUT_INVALID",
            "BUDGET_EXCEEDED",
            "RESPONSE_INTEGRITY_FAILURE",
            "CURRENT_PACK_CHANGED"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "retry_generation": {
          "default": 0,
          "minimum": 0,
          "title": "Retry Generation",
          "type": "integer"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/VlmRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/BacklogStage"
        },
        "stage_input_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "stage_input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Stage Input Sha256",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/BacklogStatus",
          "default": "PENDING"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "stage",
        "reason_code",
        "stage_input_ref",
        "stage_input_sha256",
        "max_attempts",
        "manifest_id",
        "item_id",
        "completed"
      ],
      "title": "BacklogItem",
      "type": "object"
    },
    "BacklogLeaseIdentity": {
      "additionalProperties": false,
      "description": "Non-secret CAS identity for one exact leased backlog generation.",
      "properties": {
        "attempt_count": {
          "exclusiveMinimum": 0,
          "title": "Attempt Count",
          "type": "integer"
        },
        "item_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Item Id",
          "type": "string"
        },
        "lease_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lease Id",
          "type": "string"
        },
        "lease_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Lease Identity Sha256",
          "type": "string"
        },
        "retry_generation": {
          "minimum": 0,
          "title": "Retry Generation",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "item_id",
        "lease_id",
        "attempt_count",
        "retry_generation",
        "lease_identity_sha256"
      ],
      "title": "BacklogLeaseIdentity",
      "type": "object"
    },
    "BacklogParseFailureEvidence": {
      "additionalProperties": false,
      "description": "Typed references for one persisted strict-parser failure.",
      "properties": {
        "attempt_index": {
          "enum": [
            0,
            1
          ],
          "title": "Attempt Index",
          "type": "integer"
        },
        "parse_receipt_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "request_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "response_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "role": {
          "enum": [
            "SCREENING",
            "STRUCTURE_REPAIR"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "attempt_index",
        "role",
        "request_ref",
        "response_ref",
        "parse_receipt_ref"
      ],
      "title": "BacklogParseFailureEvidence",
      "type": "object"
    },
    "BacklogReasonCode": {
      "enum": [
        "PROVIDER_UNAVAILABLE",
        "MODEL_OUTPUT_INVALID",
        "BUDGET_EXCEEDED",
        "RESPONSE_INTEGRITY_FAILURE",
        "CURRENT_PACK_CHANGED",
        "WORKER_LEASE_EXPIRED"
      ],
      "title": "BacklogReasonCode",
      "type": "string"
    },
    "BacklogRetryContext": {
      "additionalProperties": false,
      "description": "Request identity input that changes only after a proven parse failure.\n\nThe lease is deliberately absent.  A provider outage, timeout, or unknown\nworker crash may result in another lease, but must keep the same model\nrequest identity so durable claim/journal recovery can prevent a duplicate\nexternal call.",
      "properties": {
        "backlog_item_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Backlog Item Id",
          "type": "string"
        },
        "context_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Context Id",
          "type": "string"
        },
        "retry_generation": {
          "minimum": 0,
          "title": "Retry Generation",
          "type": "integer"
        }
      },
      "required": [
        "backlog_item_id",
        "retry_generation",
        "context_id"
      ],
      "title": "BacklogRetryContext",
      "type": "object"
    },
    "BacklogRetryDisposition": {
      "description": "Stable public result of one bounded backlog-worker invocation.",
      "enum": [
        "NO_WORK",
        "COMPLETED",
        "RETRY_PENDING",
        "HUMAN_REVIEW"
      ],
      "title": "BacklogRetryDisposition",
      "type": "string"
    },
    "BacklogRetryFailure": {
      "additionalProperties": false,
      "description": "One atomic retry failure, including any controlled generation advance.",
      "properties": {
        "completion_case_status": {
          "$ref": "#/$defs/CaseStatus",
          "readOnly": true
        },
        "lease": {
          "$ref": "#/$defs/BacklogLeaseIdentity"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "next_retry_generation": {
          "readOnly": true,
          "title": "Next Retry Generation",
          "type": "integer"
        },
        "next_status": {
          "enum": [
            "PENDING",
            "EXHAUSTED"
          ],
          "title": "Next Status",
          "type": "string"
        },
        "outcome_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Outcome Id",
          "type": "string"
        },
        "outcome_kind": {
          "const": "FAILURE",
          "default": "FAILURE",
          "title": "Outcome Kind",
          "type": "string"
        },
        "reason_code": {
          "$ref": "#/$defs/BacklogReasonCode"
        },
        "response_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Response Refs",
          "type": "array"
        },
        "strict_parse_failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/BacklogStrictParseFailureProof"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "lease",
        "reason_code",
        "next_status",
        "manifest_id",
        "next_retry_generation",
        "completion_case_status",
        "outcome_id"
      ],
      "title": "BacklogRetryFailure",
      "type": "object"
    },
    "BacklogRetryReport": {
      "additionalProperties": false,
      "description": "Public, secret-free report for reclaiming and processing at most one item.",
      "properties": {
        "disposition": {
          "$ref": "#/$defs/BacklogRetryDisposition"
        },
        "item": {
          "anyOf": [
            {
              "$ref": "#/$defs/BacklogItem"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/BacklogCompletionReceipt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reclaimed_exhausted_count": {
          "minimum": 0,
          "title": "Reclaimed Exhausted Count",
          "type": "integer"
        },
        "reclaimed_expired_count": {
          "minimum": 0,
          "title": "Reclaimed Expired Count",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m3-backlog-retry-report-v1",
          "default": "m3-backlog-retry-report-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "reclaimed_expired_count",
        "reclaimed_exhausted_count",
        "disposition"
      ],
      "title": "BacklogRetryReport",
      "type": "object"
    },
    "BacklogRetrySuccess": {
      "additionalProperties": false,
      "description": "Intent for one M3 business success under an exact lease identity.",
      "properties": {
        "completion_case_status": {
          "enum": [
            "ESCALATED",
            "READY_FOR_ALERT_POLICY",
            "REWORK_REQUIRED"
          ],
          "title": "Completion Case Status",
          "type": "string"
        },
        "completion_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "lease": {
          "$ref": "#/$defs/BacklogLeaseIdentity"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "outcome_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Outcome Id",
          "type": "string"
        },
        "outcome_kind": {
          "const": "SUCCESS",
          "default": "SUCCESS",
          "title": "Outcome Kind",
          "type": "string"
        },
        "response_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "title": "Response Refs",
          "type": "array"
        }
      },
      "required": [
        "lease",
        "completion_case_status",
        "completion_ref",
        "response_refs",
        "manifest_id",
        "outcome_id"
      ],
      "title": "BacklogRetrySuccess",
      "type": "object"
    },
    "BacklogStage": {
      "enum": [
        "SCREENING",
        "HEARING",
        "EVIDENCE",
        "HUMAN_REVIEW"
      ],
      "title": "BacklogStage",
      "type": "string"
    },
    "BacklogStatus": {
      "enum": [
        "PENDING",
        "LEASED",
        "COMPLETED",
        "EXHAUSTED"
      ],
      "title": "BacklogStatus",
      "type": "string"
    },
    "BacklogStrictParseFailureProof": {
      "additionalProperties": false,
      "description": "Two persisted, billable strict failures authorizing one new generation.\n\nIDs are public references only.  The repository remains responsible for\nloading both receipts, proving their request/response/generation bindings,\nrevalidating raw responses, and atomically accounting their usage.",
      "properties": {
        "attempts": {
          "items": {
            "$ref": "#/$defs/BacklogParseFailureEvidence"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Attempts",
          "type": "array"
        },
        "proof_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Proof Id",
          "type": "string"
        },
        "retry_context": {
          "$ref": "#/$defs/BacklogRetryContext"
        }
      },
      "required": [
        "retry_context",
        "attempts",
        "proof_id"
      ],
      "title": "BacklogStrictParseFailureProof",
      "type": "object"
    },
    "CaseStatus": {
      "enum": [
        "CANDIDATE",
        "EVIDENCE_READY",
        "SCREENED",
        "ESCALATED",
        "DELIBERATING",
        "PROCEDURAL_REVIEW",
        "READY_FOR_ALERT_POLICY",
        "REWORK_REQUIRED",
        "HUMAN_REVIEW",
        "BACKLOGGED",
        "CLOSED",
        "APPEALED",
        "APPEAL_RESOLVED"
      ],
      "title": "CaseStatus",
      "type": "string"
    },
    "M3ProjectionBudget": {
      "additionalProperties": false,
      "description": "Hard limits applied before the full JSON projector is invoked.",
      "properties": {
        "max_audit_entries": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Max Audit Entries",
          "type": "integer"
        },
        "max_cases": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Max Cases",
          "type": "integer"
        },
        "max_database_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 68719476736,
          "title": "Max Database Bytes",
          "type": "integer"
        },
        "max_document_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 1073741824,
          "title": "Max Document Bytes",
          "type": "integer"
        },
        "max_materialization_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 68719476736,
          "title": "Max Materialization Bytes",
          "type": "integer"
        },
        "max_packs": {
          "exclusiveMinimum": 0,
          "maximum": 5000000,
          "title": "Max Packs",
          "type": "integer"
        },
        "max_projection_file_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 68719476736,
          "title": "Max Projection File Bytes",
          "type": "integer"
        }
      },
      "required": [
        "max_database_bytes",
        "max_audit_entries",
        "max_cases",
        "max_packs",
        "max_document_bytes",
        "max_projection_file_bytes",
        "max_materialization_bytes"
      ],
      "title": "M3ProjectionBudget",
      "type": "object"
    },
    "M3ProjectionCounts": {
      "additionalProperties": false,
      "description": "Constant-memory preflight observations from one private DB snapshot.",
      "properties": {
        "audit_entries": {
          "minimum": 0,
          "title": "Audit Entries",
          "type": "integer"
        },
        "cases": {
          "minimum": 0,
          "title": "Cases",
          "type": "integer"
        },
        "largest_jsonl_upper_bound_bytes": {
          "readOnly": true,
          "title": "Largest Jsonl Upper Bound Bytes",
          "type": "integer"
        },
        "materialization_upper_bound_bytes": {
          "readOnly": true,
          "title": "Materialization Upper Bound Bytes",
          "type": "integer"
        },
        "max_document_bytes": {
          "minimum": 0,
          "title": "Max Document Bytes",
          "type": "integer"
        },
        "packs": {
          "minimum": 0,
          "title": "Packs",
          "type": "integer"
        },
        "projected_document_count": {
          "readOnly": true,
          "title": "Projected Document Count",
          "type": "integer"
        },
        "snapshot_database_bytes": {
          "minimum": 0,
          "title": "Snapshot Database Bytes",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_database_bytes",
        "audit_entries",
        "cases",
        "packs",
        "max_document_bytes",
        "projected_document_count",
        "largest_jsonl_upper_bound_bytes",
        "materialization_upper_bound_bytes"
      ],
      "title": "M3ProjectionCounts",
      "type": "object"
    },
    "M3ProjectionDisposition": {
      "description": "Whether the rebuild completed after the authoritative operation.",
      "enum": [
        "REBUILT",
        "PENDING_REBUILD"
      ],
      "title": "M3ProjectionDisposition",
      "type": "string"
    },
    "M3ProjectionOutcome": {
      "additionalProperties": false,
      "description": "Typed outcome that never erases a preceding authority result.",
      "properties": {
        "budget": {
          "$ref": "#/$defs/M3ProjectionBudget"
        },
        "counts": {
          "anyOf": [
            {
              "$ref": "#/$defs/M3ProjectionCounts"
            },
            {
              "type": "null"
            }
          ]
        },
        "disposition": {
          "$ref": "#/$defs/M3ProjectionDisposition"
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/M3ProjectionReasonCode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "disposition",
        "reason_code",
        "budget",
        "counts"
      ],
      "title": "M3ProjectionOutcome",
      "type": "object"
    },
    "M3ProjectionReasonCode": {
      "description": "Path-free, secret-free reasons why a rebuild remains pending.",
      "enum": [
        "DATABASE_BYTES_BUDGET_EXCEEDED",
        "AUDIT_ENTRY_BUDGET_EXCEEDED",
        "CASE_BUDGET_EXCEEDED",
        "PACK_BUDGET_EXCEEDED",
        "DOCUMENT_BYTES_BUDGET_EXCEEDED",
        "PROJECTION_FILE_BUDGET_EXCEEDED",
        "MATERIALIZATION_BUDGET_EXCEEDED",
        "RUN_NOT_FOUND",
        "SNAPSHOT_UNAVAILABLE",
        "PROJECTION_REBUILD_FAILED"
      ],
      "title": "M3ProjectionReasonCode",
      "type": "string"
    },
    "VlmRole": {
      "enum": [
        "SCREENING",
        "STRUCTURE_REPAIR",
        "PROSECUTOR",
        "DEFENDER",
        "JUDGE"
      ],
      "title": "VlmRole",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m3-backlog-retry-command-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "CLI-safe envelope preserving the exact one-item backlog report.",
  "properties": {
    "authority_complete": {
      "const": true,
