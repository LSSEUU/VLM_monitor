          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Camera Id",
          "type": "string"
        },
        "end_frame_exclusive": {
          "exclusiveMinimum": 0,
          "title": "End Frame Exclusive",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "step": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "stream_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Stream Id",
          "type": "string"
        }
      },
      "required": [
        "action",
        "camera_id",
        "stream_id",
        "start_frame",
        "end_frame_exclusive"
      ],
      "title": "RequestMoreFramesParameters",
      "type": "object"
    },
    "ToolResult": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/AcquisitionAction"
        },
        "execution_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Execution Manifest Id",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "output_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Output Refs",
          "type": "array"
        },
        "tool_result_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Tool Result Id",
          "type": "string"
        },
        "validated_parameters": {
          "discriminator": {
            "mapping": {
              "OTHER_CAMERA_SAME_TIME": "#/$defs/OtherCameraSameTimeParameters",
              "RECROP": "#/$defs/RecropParameters",
              "REDETECT_HIGH_RES": "#/$defs/RedetectHighResolutionParameters",
              "REQUEST_MORE_FRAMES": "#/$defs/RequestMoreFramesParameters",
              "TRACK_CONFIDENCE_CURVE": "#/$defs/TrackConfidenceCurveParameters"
            },
            "propertyName": "action"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RequestMoreFramesParameters"
            },
            {
              "$ref": "#/$defs/RecropParameters"
            },
            {
              "$ref": "#/$defs/OtherCameraSameTimeParameters"
            },
            {
              "$ref": "#/$defs/TrackConfidenceCurveParameters"
            },
            {
              "$ref": "#/$defs/RedetectHighResolutionParameters"
            }
          ],
          "title": "Validated Parameters"
        }
      },
      "required": [
        "tool_result_id",
        "action",
        "input_refs",
        "output_refs",
        "validated_parameters",
        "execution_manifest_id"
      ],
      "title": "ToolResult",
      "type": "object"
    },
    "TrackConfidenceCurveParameters": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "TRACK_CONFIDENCE_CURVE",
          "title": "Action",
          "type": "string"
        },
        "end_frame_exclusive": {
          "exclusiveMinimum": 0,
          "title": "End Frame Exclusive",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "track_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Track Ref",
          "type": "string"
        }
      },
      "required": [
        "action",
        "track_ref",
        "start_frame",
        "end_frame_exclusive"
      ],
      "title": "TrackConfidenceCurveParameters",
      "type": "object"
    },
    "TrackSummary": {
      "additionalProperties": false,
      "properties": {
        "end_frame_exclusive": {
          "exclusiveMinimum": 0,
          "title": "End Frame Exclusive",
          "type": "integer"
        },
        "observed_frame_count": {
          "minimum": 0,
          "title": "Observed Frame Count",
          "type": "integer"
        },
        "primary_track_ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Track Ref"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        }
      },
      "required": [
        "start_frame",
        "end_frame_exclusive",
        "observed_frame_count"
      ],
      "title": "TrackSummary",
      "type": "object"
    },
    "ViolationType": {
      "enum": [
        "PPE_GOGGLES_MISSING",
        "PPE_GLOVES_MISSING",
        "PPE_LAB_COAT_MISSING",
        "REAGENT_CONTAINER_OPEN",
        "FOOD_OR_DRINK_IN_LAB",
        "SINGLE_PERSON_HAZARDOUS_OPERATION",
        "FUME_HOOD_SASH_TOO_HIGH",
        "UNATTENDED_HEATING",
        "SMOKE_ABNORMAL",
        "OPEN_FLAME"
      ],
      "title": "ViolationType",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/evidence-pack.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "closure_report": {
      "$ref": "#/$defs/ClosureReport"
    },
    "complete": {
      "default": true,
      "title": "Complete",
      "type": "boolean"
    },
    "confirmation_record": {
      "$ref": "#/$defs/ConfirmationRecord"
    },
    "event": {
      "$ref": "#/$defs/CandidateEvent"
    },
    "focus_crops": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Crop"
      },
      "title": "Focus Crops",
      "type": "array"
    },
    "key_frame_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:(?:0|[1-9][0-9]{0,19})$",
        "type": "string"
      },
      "title": "Key Frame Ids",
      "type": "array"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "objective_facts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectiveFact"
      },
      "title": "Objective Facts",
      "type": "array"
    },
    "observation_sufficiency_input": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObservationSufficiencyInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pack_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Pack Id",
      "type": "string"
    },
    "panorama_crops": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Crop"
      },
      "title": "Panorama Crops",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "subject_crops": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Crop"
      },
      "title": "Subject Crops",
      "type": "array"
    },
    "temporal_crops": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Crop"
      },
      "title": "Temporal Crops",
      "type": "array"
    },
    "tool_results": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolResult"
      },
      "title": "Tool Results",
      "type": "array"
    },
    "track_summary": {
      "$ref": "#/$defs/TrackSummary"
    },
    "version": {
      "exclusiveMinimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "version",
    "event",
    "key_frame_ids",
    "track_summary",
    "confirmation_record",
    "manifest_id",
    "closure_report",
    "pack_id"
  ],
  "title": "EvidencePack",
  "type": "object"
}
