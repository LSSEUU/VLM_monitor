{
  "$defs": {
    "AcquisitionAction": {
      "enum": [
        "REQUEST_MORE_FRAMES",
        "RECROP",
        "OTHER_CAMERA_SAME_TIME",
        "TRACK_CONFIDENCE_CURVE",
        "REDETECT_HIGH_RES"
      ],
      "title": "AcquisitionAction",
      "type": "string"
    },
    "AnchorType": {
      "enum": [
        "HEAD",
        "HANDS",
        "TORSO"
      ],
      "title": "AnchorType",
      "type": "string"
    },
    "ArtifactKind": {
      "enum": [
        "RUN",
        "FRAME",
        "SAFETY_SIGNAL",
        "EVENT",
        "CASE",
        "DETECTION",
        "OBJECTIVE_FACT",
        "CROP",
        "MEDIA",
        "EVIDENCE_PACK",
        "TOOL_RESULT",
        "MANIFEST",
        "MODEL_RESPONSE",
        "MODEL_REQUEST",
        "PROMPT_MANIFEST",
        "MODEL_PARSE_RECEIPT",
        "PARSED_MODEL_OUTPUT",
        "PROCEDURAL_REVIEW",
        "MODEL_CACHE_ENTRY",
        "SCREENING_RESULT",
        "VERDICT",
        "ALERT",
        "PRECEDENT",
        "APPEAL",
        "TRAINING_LABEL",
        "BACKLOG_ITEM",
        "DATASET"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A kind-discriminated reference with syntax fixed by the artifact kind.",
      "properties": {
        "artifact_id": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AssociationMethod": {
      "enum": [
        "KEYPOINT",
        "BODY_FALLBACK"
      ],
      "title": "AssociationMethod",
      "type": "string"
    },
    "BBoxXYXY": {
      "additionalProperties": false,
      "description": "Integer `[x1, y1, x2, y2)` bounding box.",
      "properties": {
        "x1": {
          "minimum": 0,
          "title": "X1",
          "type": "integer"
        },
        "x2": {
          "exclusiveMinimum": 0,
          "title": "X2",
          "type": "integer"
        },
        "y1": {
          "minimum": 0,
          "title": "Y1",
          "type": "integer"
        },
        "y2": {
          "exclusiveMinimum": 0,
          "title": "Y2",
          "type": "integer"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "BBoxXYXY",
      "type": "object"
    },
    "CandidateEvent": {
      "additionalProperties": false,
      "properties": {
        "camera_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Camera Id",
          "type": "string"
        },
        "confirmation": {
          "$ref": "#/$defs/ConfirmationRecord"
        },
        "end_frame_exclusive": {
          "exclusiveMinimum": 0,
          "title": "End Frame Exclusive",
          "type": "integer"
        },
        "event_id": {
          "readOnly": true,
          "title": "Event Id",
          "type": "string"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "hard_rule": {
          "default": false,
          "title": "Hard Rule",
          "type": "boolean"
        },
        "l1_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "L1 Score",
          "type": "number"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "objective_facts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectiveFact"
          },
          "title": "Objective Facts",
          "type": "array"
        },
        "primary_track_ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Track Ref"
        },
        "related_track_refs": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "title": "Related Track Refs",
          "type": "array"
        },
        "rule_version": {
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "stream_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Stream Id",
          "type": "string"
        },
        "trigger_frame": {
          "minimum": 0,
          "title": "Trigger Frame",
          "type": "integer"
        },
        "violation_type": {
          "$ref": "#/$defs/ViolationType"
        },
        "zone_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Zone Id",
          "type": "string"
        }
      },
      "required": [
        "camera_id",
        "stream_id",
        "rule_version",
        "violation_type",
        "evidence_class",
        "zone_id",
        "start_frame",
        "end_frame_exclusive",
        "trigger_frame",
        "l1_score",
        "confirmation",
        "manifest_id",
        "event_id"
      ],
      "title": "CandidateEvent",
      "type": "object"
    },
    "ClosureDefect": {
      "additionalProperties": false,
      "description": "A typed closure failure; diagnostic context is explicit, never an open map.",
      "properties": {
        "actual_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Height"
        },
        "actual_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Sha256"
        },
        "actual_size_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Size Bytes"
        },
        "actual_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Width"
        },
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "code": {
          "$ref": "#/$defs/ClosureDefectCode"
        },
        "end_frame_exclusive": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Frame Exclusive"
        },
        "expected_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Height"
        },
        "expected_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Sha256"
        },
        "expected_size_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Size Bytes"
        },
        "expected_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Width"
        },
        "field": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "frame_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Index"
        },
        "reason_code": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "related_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "start_frame": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Frame"
        }
      },
      "required": [
        "code"
      ],
      "title": "ClosureDefect",
      "type": "object"
    },
    "ClosureDefectCode": {
      "enum": [
        "MISSING_REFERENCE",
        "CROSS_RUN_REFERENCE",
        "CROSS_CASE_REFERENCE",
        "CROSS_STREAM_FRAME",
        "FRAME_OUTSIDE_WINDOW",
        "MISSING_TRIGGER_FRAME",
        "BBOX_OUT_OF_BOUNDS",
        "CROP_ROLE_MISMATCH",
        "TRACK_MISMATCH",
        "OBJECTIVE_SOURCE_MISSING",
        "TOOL_INPUT_MISSING",
        "TOOL_OUTPUT_MISSING",
        "PATH_BOUNDARY_VIOLATION",
        "UNSAFE_LINK",
        "NOT_REGULAR_FILE",
        "MEDIA_MISSING",
        "MEDIA_PURGED_BY_RETENTION",
        "SOURCE_HASH_MISMATCH",
        "MEDIA_HASH_MISMATCH",
        "MEDIA_SIZE_MISMATCH",
        "PIXEL_HASH_MISMATCH",
        "MEDIA_DIMENSION_MISMATCH",
        "PRIVACY_POLICY_VIOLATION",
        "MANIFEST_MISMATCH",
        "IDENTITY_MISMATCH"
      ],
      "title": "ClosureDefectCode",
      "type": "string"
    },
    "ClosureReport": {
      "additionalProperties": false,
      "properties": {
        "checked_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "title": "Checked Refs",
          "type": "array"
        },
        "defects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ClosureDefect"
          },
          "title": "Defects",
          "type": "array"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "passed": {
          "readOnly": true,
          "title": "Passed",
          "type": "boolean"
        },
        "root_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "validator_version": {
          "const": "m2-closure-v1",
          "default": "m2-closure-v1",
          "title": "Validator Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "root_ref",
        "manifest_id",
        "input_sha256",
        "checked_refs",
        "passed"
      ],
      "title": "ClosureReport",
      "type": "object"
    },
    "ConfirmationPolicy": {
      "enum": [
        "STRICT_CAUSAL",
        "SOURCE_COMPAT",
        "NONE"
      ],
      "title": "ConfirmationPolicy",
      "type": "string"
    },
    "ConfirmationRecord": {
      "additionalProperties": false,
      "properties": {
        "causal_risk": {
          "default": false,
          "title": "Causal Risk",
          "type": "boolean"
        },
        "counterevidence_frame_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:(?:0|[1-9][0-9]{0,19})$",
            "type": "string"
          },
          "title": "Counterevidence Frame Ids",
          "type": "array"
        },
        "examined_frame_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:(?:0|[1-9][0-9]{0,19})$",
            "type": "string"
          },
          "title": "Examined Frame Ids",
          "type": "array"
        },
        "policy": {
          "$ref": "#/$defs/ConfirmationPolicy"
        },
        "post_threshold_recovery_frame_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:(?:0|[1-9][0-9]{0,19})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Post Threshold Recovery Frame Id"
        },
        "resolved_frame": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Frame"
        },
        "suppressed": {
          "default": false,
          "title": "Suppressed",
          "type": "boolean"
        },
        "suppression_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suppression Reason"
        }
      },
      "required": [
        "policy"
      ],
      "title": "ConfirmationRecord",
      "type": "object"
    },
    "Crop": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/MediaAvailability"
        },
        "bbox": {
          "$ref": "#/$defs/BBoxXYXY"
        },
        "crop_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Crop Id",
          "type": "string"
        },
        "encoding_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Encoding Version",
          "type": "string"
        },
        "frame_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:(?:0|[1-9][0-9]{0,19})$",
          "title": "Frame Id",
          "type": "string"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\<>:\\\"|?*])(?:[^/\\x00-\\x1f]+/)*[^/\\x00-\\x1f]+$",
          "title": "Local Path"
        },
        "media_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Media Sha256",
          "type": "string"
        },
        "media_type": {
          "const": "IMAGE_PNG",
          "title": "Media Type",
          "type": "string"
        },
        "observability": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservabilityScore"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output_height": {
          "exclusiveMinimum": 0,
          "maximum": 4294967295,
          "title": "Output Height",
          "type": "integer"
        },
        "output_width": {
          "exclusiveMinimum": 0,
          "maximum": 4294967295,
          "title": "Output Width",
          "type": "integer"
        },
        "panorama_long_edge_limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 4294967295,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Panorama Long Edge Limit"
        },
        "pixel_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pixel Sha256",
          "type": "string"
        },
        "primary_track_ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Track Ref"
        },
        "privacy_receipt": {
          "$ref": "#/$defs/PrivacyReceipt"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/CropSource"
        },
        "source_media_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Media Sha256",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "tags": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Tags",
          "type": "object"
        }
      },
      "required": [
        "frame_id",
        "source",
        "bbox",
        "source_refs",
        "availability",
        "source_media_sha256",
        "pixel_sha256",
        "media_sha256",
        "output_width",
        "output_height",
        "size_bytes",
        "media_type",
        "encoding_version",
        "privacy_receipt",
        "crop_id"
      ],
      "title": "Crop",
      "type": "object"
    },
    "CropSource": {
      "enum": [
        "PANORAMA",
        "SUBJECT",
        "DETECTION_FOCUS",
        "ANCHOR_FOCUS",
        "RECROP"
      ],
      "title": "CropSource",
      "type": "string"
    },
    "EvidenceClass": {
      "enum": [
        "PRESENCE",
        "ABSENCE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "Keypoint": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "name",
        "x",
        "y",
        "score"
      ],
      "title": "Keypoint",
      "type": "object"
    },
    "MediaAccess": {
      "enum": [
        "LOCAL_ONLY",
        "CLOUD_ALLOWED"
      ],
      "title": "MediaAccess",
      "type": "string"
    },
    "MediaAvailability": {
      "enum": [
        "AVAILABLE",
        "PURGING",
        "PURGED_BY_RETENTION"
      ],
      "title": "MediaAvailability",
      "type": "string"
    },
    "ObjectiveFact": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "DURATION_FRAMES",
                  "PERSON_COUNT"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "minimum": 0,
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "FRAME_INTERVAL",
                  "TRACK_PRESENCE_INTERVAL"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "minimum": 1,
                    "type": "integer"
                  }
                ],
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ZONE_ID"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "RISK_LEVEL"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH"
                ],
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "DETECTION_SCORE",
                  "OBSERVABILITY"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              }
            }
          }
        }
      ],
      "properties": {
        "fact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Fact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ObjectiveFactKind"
        },
        "source_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Manifest Id",
          "type": "string"
        },
        "source_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "fact_id",
        "kind",
        "value",
        "source_ref",
        "source_manifest_id"
      ],
      "title": "ObjectiveFact",
      "type": "object"
    },
    "ObjectiveFactKind": {
      "enum": [
        "DURATION_FRAMES",
        "PERSON_COUNT",
        "ZONE_ID",
        "RISK_LEVEL",
        "FRAME_INTERVAL",
        "TRACK_PRESENCE_INTERVAL",
        "DETECTION_SCORE",
        "OBSERVABILITY"
      ],
      "title": "ObjectiveFactKind",
      "type": "string"
    },
    "ObservabilityComponents": {
      "additionalProperties": false,
      "properties": {
        "exposure": {
          "maximum": 1,
          "minimum": 0,
          "title": "Exposure",
          "type": "number"
        },
        "frontality": {
          "maximum": 1,
          "minimum": 0,
          "title": "Frontality",
          "type": "number"
        },
        "keypoint_visibility": {
          "maximum": 1,
          "minimum": 0,
          "title": "Keypoint Visibility",
          "type": "number"
        },
        "non_occlusion": {
          "maximum": 1,
          "minimum": 0,
          "title": "Non Occlusion",
          "type": "number"
        },
        "person_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Person Confidence",
          "type": "number"
        },
        "sharpness": {
          "maximum": 1,
          "minimum": 0,
          "title": "Sharpness",
          "type": "number"
        }
      },
      "required": [
        "person_confidence",
        "keypoint_visibility",
        "frontality",
        "sharpness",
        "exposure",
        "non_occlusion"
      ],
      "title": "ObservabilityComponents",
      "type": "object"
