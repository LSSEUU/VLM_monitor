        "components",
        "source"
      ],
      "title": "ObservabilityScore",
      "type": "object"
    },
    "ObservationSource": {
      "enum": [
        "PIXEL_COMPUTED",
        "PRECOMPUTED_FIXTURE"
      ],
      "title": "ObservationSource",
      "type": "string"
    },
    "ObservationSufficiencyInput": {
      "additionalProperties": false,
      "properties": {
        "clear_crop_ids": {
          "default": [],
