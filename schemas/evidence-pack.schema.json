        },
        "consistency_status": {
          "const": "NOT_EVALUATED",
          "default": "NOT_EVALUATED",
          "title": "Consistency Status",
          "type": "string"
        },
        "required_clear_count": {
          "exclusiveMinimum": 0,
          "title": "Required Clear Count",
          "type": "integer"
        },
        "selected_by_observability": {
          "title": "Selected By Observability",
          "type": "boolean"
        },
        "unclear_crop_ids": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Unclear Crop Ids",
          "type": "array"
        }
      },
      "required": [
        "clear_threshold",
        "required_clear_count",
        "selected_by_observability"
      ],
      "title": "ObservationSufficiencyInput",
      "type": "object"
    },
    "OtherCameraSameTimeParameters": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "OTHER_CAMERA_SAME_TIME",
          "title": "Action",
          "type": "string"
        },
        "source_frame_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:(?:0|[1-9][0-9]{0,19})$",
          "title": "Source Frame Id",
          "type": "string"
        },
        "target_camera_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Target Camera Id",
          "type": "string"
        }
      },
      "required": [
        "action",
        "source_frame_id",
        "target_camera_id"
      ],
      "title": "OtherCameraSameTimeParameters",
      "type": "object"
    },
    "PpeType": {
      "enum": [
        "GOGGLES",
        "GLOVES",
        "LAB_COAT"
      ],
      "title": "PpeType",
      "type": "string"
    },
    "PrivacyPolicy": {
      "enum": [
        "EPHEMERAL_RAW",
        "PPE_PRESERVING_REDACTION",
        "FULL_REDACTION"
      ],
      "title": "PrivacyPolicy",
      "type": "string"
    },
    "PrivacyReasonCode": {
      "enum": [
        "PPE_REGION_PRESERVED",
        "KEYPOINTS_INSUFFICIENT_LOCAL_ONLY",
        "BODY_FALLBACK_REGION_LOCAL_ONLY",
        "PANORAMA_FULL_REDACTION",
        "SUBJECT_FULL_REDACTION",
        "POLICY_LOCAL_ONLY"
      ],
      "title": "PrivacyReasonCode",
      "type": "string"
    },
    "PrivacyReceipt": {
      "additionalProperties": false,
      "properties": {
        "anchor_bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBoxXYXY"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "anchor_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "association_method": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssociationMethod"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fallback_used": {
          "default": false,
          "title": "Fallback Used",
          "type": "boolean"
        },
        "fill_rgb": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Fill Rgb",
          "type": "array"
        },
        "input_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "title": "Input Refs",
          "type": "array"
        },
        "keypoints": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Keypoint"
          },
          "title": "Keypoints",
          "type": "array"
        },
        "media_access": {
          "$ref": "#/$defs/MediaAccess"
        },
        "policy": {
          "$ref": "#/$defs/PrivacyPolicy"
        },
        "ppe_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/PpeType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "preserved_regions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BBoxXYXY"
          },
          "title": "Preserved Regions",
          "type": "array"
        },
        "reason_code": {
          "$ref": "#/$defs/PrivacyReasonCode"
        },
        "transform_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Transform Version",
          "type": "string"
        }
      },
      "required": [
        "policy",
        "transform_version",
        "media_access",
        "reason_code",
        "input_refs",
        "fill_rgb"
      ],
      "title": "PrivacyReceipt",
      "type": "object"
    },
    "RecropParameters": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "RECROP",
