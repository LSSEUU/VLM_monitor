            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Clear Crop Ids",
          "type": "array"
        },
        "clear_threshold": {
          "maximum": 1,
          "minimum": 0,
          "title": "Clear Threshold",
