{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "RUN",
        "FRAME",
        "SAFETY_SIGNAL",
        "EVENT",
        "CASE",
        "DETECTION",
        "OBJECTIVE_FACT",
        "CROP",
        "MEDIA",
        "EVIDENCE_PACK",
        "TOOL_RESULT",
        "MANIFEST",
        "MODEL_RESPONSE",
        "MODEL_REQUEST",
        "PROMPT_MANIFEST",
        "MODEL_PARSE_RECEIPT",
        "PARSED_MODEL_OUTPUT",
        "PROCEDURAL_REVIEW",
        "MODEL_CACHE_ENTRY",
        "SCREENING_RESULT",
        "VERDICT",
        "ALERT",
        "PRECEDENT",
        "APPEAL",
        "TRAINING_LABEL",
        "BACKLOG_ITEM",
        "DATASET"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A kind-discriminated reference with syntax fixed by the artifact kind.",
      "properties": {
        "artifact_id": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "HearingSessionEntryStatus": {
      "enum": [
        "ESCALATED",
        "REWORK_REQUIRED"
      ],
      "title": "HearingSessionEntryStatus",
      "type": "string"
    },
    "ProceduralDefectCode": {
      "enum": [
        "MALFORMED_STRUCTURE",
        "INVALID_ENUM",
        "MISSING_REQUIRED_FIELD",
        "FABRICATED_EVIDENCE_REFERENCE",
        "INVALID_COORDINATES",
        "FABRICATED_PRECEDENT_REFERENCE",
        "PRECEDENT_DIRECTION_MISMATCH",
        "EMPTY_DISTINGUISHING_REASON",
        "ESTABLISHED_WITHOUT_EVIDENCE",
        "UNANSWERED_DEFENSE_POINT",
        "CONFIDENCE_ALERT_LEVEL_MISMATCH",
        "OBJECTIVE_ASSERTION_CONTRADICTION",
        "VIOLATION_TYPE_MISMATCH",
        "ABSENCE_FROM_INSUFFICIENT_OBSERVATION"
      ],
      "title": "ProceduralDefectCode",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/hearing-session.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable authority that opens an M4 hearing and fixes all total budgets.",
  "properties": {
    "acquisition_round_limit": {
      "default": 2,
      "maximum": 2,
      "minimum": 0,
      "title": "Acquisition Round Limit",
      "type": "integer"
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "defender_model_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Defender Model Manifest Id",
      "type": "string"
    },
    "entry_status": {
      "$ref": "#/$defs/HearingSessionEntryStatus"
    },
    "hearing_prompt_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hearing Prompt Bundle Sha256",
      "type": "string"
    },
    "initial_defect_codes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProceduralDefectCode"
      },
      "maxItems": 14,
      "title": "Initial Defect Codes",
      "type": "array"
    },
    "initial_evidence_pack_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Initial Evidence Pack Id",
      "type": "string"
    },
    "initial_evidence_pack_version": {
      "exclusiveMinimum": 0,
      "title": "Initial Evidence Pack Version",
      "type": "integer"
    },
    "initial_trigger_review_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "judge_model_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Judge Model Manifest Id",
      "type": "string"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "max_total_images": {
      "exclusiveMinimum": 0,
      "maximum": 320,
      "title": "Max Total Images",
      "type": "integer"
    },
    "max_total_judge_cycles": {
      "readOnly": true,
      "title": "Max Total Judge Cycles",
      "type": "integer"
    },
    "max_total_output_tokens": {
      "exclusiveMinimum": 0,
      "maximum": 1000000,
      "title": "Max Total Output Tokens",
      "type": "integer"
    },
    "prosecutor_model_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prosecutor Model Manifest Id",
      "type": "string"
    },
    "rework_round_limit": {
      "default": 2,
      "maximum": 2,
      "minimum": 0,
      "title": "Rework Round Limit",
      "type": "integer"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m4-hearing-session-v1",
      "default": "m4-hearing-session-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "screening_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Screening Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Session Id",
      "type": "string"
    },
    "session_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Session Sha256",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "screening_id",
    "entry_status",
    "initial_evidence_pack_id",
    "initial_evidence_pack_version",
    "max_total_images",
    "max_total_output_tokens",
    "hearing_prompt_bundle_sha256",
    "prosecutor_model_manifest_id",
    "defender_model_manifest_id",
    "judge_model_manifest_id",
    "manifest_id",
    "max_total_judge_cycles",
    "session_id",
    "session_sha256"
  ],
  "title": "HearingSession",
  "type": "object"
}
