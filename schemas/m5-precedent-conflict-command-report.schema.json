{
  "$defs": {
    "M5PrecedentConflictBatchReceipt": {
      "additionalProperties": false,
      "description": "Atomic commit receipt covering every node in a conflict batch.",
      "properties": {
        "batch_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Batch Authority Id",
          "type": "string"
        },
        "causal_cut_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Causal Cut Id",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Id",
          "type": "string"
        },
        "receipt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Receipt Id",
          "type": "string"
        },
        "results": {
          "default": [],
          "items": {
            "$ref": "#/$defs/M5PrecedentConflictNodeResult"
          },
          "maxItems": 9999,
          "title": "Results",
          "type": "array"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m5-precedent-conflict-batch-receipt-v1",
          "default": "m5-precedent-conflict-batch-receipt-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "config_sha256",
        "policy_id",
        "batch_authority_id",
        "causal_cut_id",
        "receipt_id"
      ],
      "title": "M5PrecedentConflictBatchReceipt",
      "type": "object"
    },
    "M5PrecedentConflictNodeResult": {
      "additionalProperties": false,
      "description": "The unique graph-wide result selected for one candidate head.",
      "properties": {
        "invalidated_by_precedent_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalidated By Precedent Id"
        },
        "precedent_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Precedent Id",
          "type": "string"
        },
        "prior_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prior Authority Id",
          "type": "string"
        },
        "prior_revision": {
          "exclusiveMinimum": 0,
          "title": "Prior Revision",
          "type": "integer"
        },
        "resulting_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Resulting Authority Id",
          "type": "string"
        },
        "resulting_revision": {
          "exclusiveMinimum": 0,
          "title": "Resulting Revision",
          "type": "integer"
        },
        "status_after": {
          "$ref": "#/$defs/PrecedentStatus"
        }
      },
      "required": [
        "precedent_id",
        "prior_authority_id",
        "prior_revision",
        "resulting_authority_id",
        "resulting_revision",
        "status_after"
      ],
      "title": "M5PrecedentConflictNodeResult",
      "type": "object"
    },
    "PrecedentStatus": {
      "enum": [
        "PROVISIONAL",
        "ACTIVE",
        "CONFLICT",
        "INVALIDATED",
        "REVOKED"
      ],
      "title": "PrecedentStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m5-precedent-conflict-command-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applied_receipts": {
      "items": {
        "$ref": "#/$defs/M5PrecedentConflictBatchReceipt"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Applied Receipts",
      "type": "array"
    },
    "batch_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Batch Authority Id",
      "type": "string"
    },
    "batch_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Batch Receipt Id",
      "type": "string"
    },
    "candidate_count": {
      "maximum": 9999,
      "minimum": 0,
      "title": "Candidate Count",
      "type": "integer"
    },
    "causal_cut_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Causal Cut Id",
      "type": "string"
    },
    "conflict_edge_count": {
      "maximum": 49985001,
      "minimum": 0,
      "title": "Conflict Edge Count",
      "type": "integer"
    },
    "current_conflict_precedent_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
        "type": "string"
      },
      "maxItems": 9999,
      "title": "Current Conflict Precedent Ids",
      "type": "array"
    },
    "evaluated_pair_count": {
      "maximum": 49985001,
      "minimum": 0,
      "title": "Evaluated Pair Count",
      "type": "integer"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "candidate_count",
    "evaluated_pair_count",
    "conflict_edge_count",
    "causal_cut_id",
    "batch_authority_id",
    "batch_receipt_id",
    "applied_receipts",
    "current_conflict_precedent_ids"
  ],
  "title": "M5PrecedentConflictCommandReport",
  "type": "object"
}
