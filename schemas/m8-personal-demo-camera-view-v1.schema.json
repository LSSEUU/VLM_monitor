{
  "$defs": {
    "M8OperationalSource": {
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "raw_reference_required": {
              "const": true
            }
          },
          "required": [
            "raw_reference_required"
          ]
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "LIVE_CAMERA"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "certification_id": {
                "type": "null"
              },
              "display_badge": {
                "const": "LIVE · CAMERA"
              },
              "emergency_authority_enabled": {
                "const": false
              },
              "life_safety_eligible": {
                "const": false
              },
              "sensor_type": {
                "type": "null"
              },
              "simulated": {
                "const": false
              },
              "source_kind": {
                "const": "CAMERA"
              },
              "timebase": {
                "const": "FRAME_INDEX"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "RECORDED_VIDEO_SIMULATION"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "certification_id": {
                "type": "null"
              },
              "display_badge": {
                "const": "SIMULATED · RECORDED VIDEO"
              },
              "emergency_authority_enabled": {
                "const": false
              },
              "life_safety_eligible": {
                "const": false
              },
              "sensor_type": {
                "type": "null"
              },
              "simulated": {
                "const": true
              },
              "source_kind": {
                "const": "CAMERA"
              },
              "timebase": {
                "const": "FRAME_INDEX"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "LIVE_SENSOR"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "allOf": [
              {
                "else": {
                  "properties": {
                    "life_safety_eligible": {
                      "const": false
                    }
                  }
                },
                "if": {
                  "properties": {
                    "emergency_authority_enabled": {
                      "const": true
                    }
                  },
                  "required": [
                    "emergency_authority_enabled"
                  ]
                },
                "then": {
                  "properties": {
                    "certification_id": {
                      "pattern": "^\\S{1,128}$",
                      "type": "string"
                    },
                    "life_safety_eligible": {
                      "const": true
                    }
                  },
                  "required": [
                    "certification_id"
                  ]
                }
              }
            ],
            "properties": {
              "certification_id": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "pattern": "^\\S{1,128}$",
                    "type": "string"
                  }
                ]
              },
              "display_badge": {
                "const": "LIVE · SENSOR"
              },
              "sensor_type": {
                "enum": [
                  "SMOKE",
                  "TEMPERATURE",
                  "COMBUSTIBLE_GAS",
                  "TOXIC_GAS",
                  "DOOR_CONTACT",
                  "WATER_LEAK",
                  "EMERGENCY_BUTTON"
                ],
                "type": "string"
              },
              "simulated": {
                "const": false
              },
              "source_kind": {
                "const": "SENSOR"
              },
              "timebase": {
                "const": "DEVICE_TIMESTAMP_UTC"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "SIMULATED_SENSOR"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "certification_id": {
                "type": "null"
              },
              "display_badge": {
                "const": "SIMULATED · SENSOR"
              },
              "emergency_authority_enabled": {
                "const": false
              },
              "life_safety_eligible": {
                "const": false
              },
              "sensor_type": {
                "enum": [
                  "SMOKE",
                  "TEMPERATURE",
                  "COMBUSTIBLE_GAS",
                  "TOXIC_GAS",
                  "DOOR_CONTACT",
                  "WATER_LEAK",
                  "EMERGENCY_BUTTON"
                ],
                "type": "string"
              },
              "simulated": {
                "const": true
              },
              "source_kind": {
                "const": "SENSOR"
              },
              "timebase": {
                "const": "SIMULATION_TICK"
              }
            }
          }
        }
      ],
      "description": "One camera or sensor source with machine-enforced truth labeling.",
      "properties": {
        "adapter_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "certification_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certification Id"
        },
        "device_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Device Id",
          "type": "string"
        },
        "display_badge": {
          "readOnly": true,
          "title": "Display Badge",
          "type": "string"
        },
        "emergency_authority_enabled": {
          "default": false,
          "title": "Emergency Authority Enabled",
          "type": "boolean"
        },
        "life_safety_eligible": {
          "readOnly": true,
          "title": "Life Safety Eligible",
          "type": "boolean"
        },
        "location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Location Id",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/M8OperationalSourceMode"
        },
        "raw_reference_required": {
          "default": true,
          "title": "Raw Reference Required",
          "type": "boolean"
        },
        "schema_version": {
          "const": "m8-operational-source-v1",
          "default": "m8-operational-source-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sensor_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/M8SensorType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "simulated": {
          "readOnly": true,
          "title": "Simulated",
          "type": "boolean"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/M8OperationalSourceKind",
          "readOnly": true
        },
        "timebase": {
          "$ref": "#/$defs/M8SourceTimebase",
          "readOnly": true
        }
      },
      "required": [
        "source_id",
        "device_id",
        "location_id",
        "mode",
        "adapter_id",
        "manifest_id",
        "source_kind",
        "timebase",
        "simulated",
        "display_badge",
        "life_safety_eligible"
      ],
      "title": "M8OperationalSource",
      "type": "object"
    },
    "M8OperationalSourceKind": {
      "enum": [
        "CAMERA",
        "SENSOR"
      ],
      "title": "M8OperationalSourceKind",
      "type": "string"
    },
    "M8OperationalSourceMode": {
      "enum": [
        "LIVE_CAMERA",
        "RECORDED_VIDEO_SIMULATION",
        "LIVE_SENSOR",
        "SIMULATED_SENSOR"
      ],
      "title": "M8OperationalSourceMode",
      "type": "string"
    },
    "M8PersonalDemoRecordedMediaReceiptV1": {
      "additionalProperties": false,
      "description": "Content-addressed binding of one local MP4 to the simulated Demo camera.",
      "properties": {
        "container_signature": {
          "const": "ISO_BMFF_FTYP",
          "default": "ISO_BMFF_FTYP",
          "title": "Container Signature",
          "type": "string"
        },
        "cross_camera_reidentification_performed": {
          "const": false,
          "default": false,
          "title": "Cross Camera Reidentification Performed",
          "type": "boolean"
        },
        "decoder_preflight_performed": {
          "const": false,
          "default": false,
          "title": "Decoder Preflight Performed",
          "type": "boolean"
        },
        "display_badge": {
          "const": "SIMULATED · RECORDED VIDEO",
          "default": "SIMULATED · RECORDED VIDEO",
          "title": "Display Badge",
          "type": "string"
        },
        "exact_byte_copy": {
          "const": true,
          "default": true,
          "title": "Exact Byte Copy",
          "type": "boolean"
        },
        "face_recognition_performed": {
          "const": false,
          "default": false,
          "title": "Face Recognition Performed",
          "type": "boolean"
        },
        "gpu_used": {
          "const": false,
          "default": false,
          "title": "Gpu Used",
          "type": "boolean"
        },
        "input_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input File Sha256",
          "type": "string"
        },
        "input_size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Input Size Bytes",
          "type": "integer"
        },
        "life_safety_eligible": {
          "const": false,
          "default": false,
          "title": "Life Safety Eligible",
          "type": "boolean"
        },
        "live_camera_claim_permitted": {
          "const": false,
          "default": false,
          "title": "Live Camera Claim Permitted",
          "type": "boolean"
        },
        "media_attached": {
          "const": true,
          "default": true,
          "title": "Media Attached",
          "type": "boolean"
        },
        "media_binding_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Media Binding Manifest Id",
          "type": "string"
        },
        "media_binding_receipt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Media Binding Receipt Id",
          "type": "string"
        },
        "mode": {
          "const": "RECORDED_VIDEO_SIMULATION",
          "default": "RECORDED_VIDEO_SIMULATION",
          "title": "Mode",
          "type": "string"
        },
        "network_used": {
          "const": false,
          "default": false,
          "title": "Network Used",
          "type": "boolean"
        },
        "original_media_modified": {
          "const": false,
          "default": false,
          "title": "Original Media Modified",
          "type": "boolean"
        },
        "playback_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Playback File Sha256",
          "type": "string"
        },
        "playback_media_ref": {
          "const": "media/camera-recorded-demo-01.mp4",
          "default": "media/camera-recorded-demo-01.mp4",
          "title": "Playback Media Ref",
          "type": "string"
        },
        "playback_size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Playback Size Bytes",
          "type": "integer"
        },
        "raw_media_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Raw Media Ref",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-personal-demo-recorded-media-receipt-v1",
          "default": "m8-personal-demo-recorded-media-receipt-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_catalog_commit_receipt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Catalog Commit Receipt Id",
          "type": "string"
        },
        "source_catalog_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Catalog Id",
          "type": "string"
        },
        "source_id": {
          "const": "camera-recorded-demo-01",
          "default": "camera-recorded-demo-01",
          "title": "Source Id",
          "type": "string"
        },
        "transcoding_performed": {
          "const": false,
          "default": false,
          "title": "Transcoding Performed",
          "type": "boolean"
        }
      },
      "required": [
        "source_catalog_id",
        "source_catalog_commit_receipt_id",
        "raw_media_ref",
        "input_file_sha256",
        "input_size_bytes",
        "playback_file_sha256",
        "playback_size_bytes",
        "media_binding_manifest_id",
        "media_binding_receipt_id"
      ],
      "title": "M8PersonalDemoRecordedMediaReceiptV1",
      "type": "object"
    },
    "M8SensorType": {
      "enum": [
        "SMOKE",
        "TEMPERATURE",
        "COMBUSTIBLE_GAS",
        "TOXIC_GAS",
        "DOOR_CONTACT",
        "WATER_LEAK",
        "EMERGENCY_BUTTON"
      ],
      "title": "M8SensorType",
      "type": "string"
    },
    "M8SourceTimebase": {
      "enum": [
        "FRAME_INDEX",
        "DEVICE_TIMESTAMP_UTC",
        "SIMULATION_TICK"
      ],
      "title": "M8SourceTimebase",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-personal-demo-camera-view-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Discoverable product view over the fixed simulated recorded camera.",
  "properties": {
    "authentication_required": {
      "const": true,
      "default": true,
      "title": "Authentication Required",
      "type": "boolean"
    },
    "camera_view_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Camera View Id",
      "type": "string"
    },
    "camera_view_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Camera View Manifest Id",
      "type": "string"
    },
    "display_badge": {
      "const": "SIMULATED · RECORDED VIDEO",
      "default": "SIMULATED · RECORDED VIDEO",
      "title": "Display Badge",
      "type": "string"
    },
    "life_safety_eligible": {
      "const": false,
      "default": false,
      "title": "Life Safety Eligible",
      "type": "boolean"
    },
    "live_camera_claim_permitted": {
      "const": false,
      "default": false,
      "title": "Live Camera Claim Permitted",
      "type": "boolean"
    },
    "media_api_path": {
      "const": "/api/m8/cameras/camera-recorded-demo-01/media",
      "default": "/api/m8/cameras/camera-recorded-demo-01/media",
      "title": "Media Api Path",
      "type": "string"
    },
    "media_attached": {
      "title": "Media Attached",
      "type": "boolean"
    },
    "media_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/M8PersonalDemoRecordedMediaReceiptV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "media_metadata_api_path": {
      "const": "/api/m8/cameras/camera-recorded-demo-01/media-metadata",
      "default": "/api/m8/cameras/camera-recorded-demo-01/media-metadata",
      "title": "Media Metadata Api Path",
      "type": "string"
    },
    "schema_version": {
      "const": "m8-personal-demo-camera-view-v1",
      "default": "m8-personal-demo-camera-view-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "simulated": {
      "const": true,
      "default": true,
      "title": "Simulated",
      "type": "boolean"
    },
    "source": {
      "$ref": "#/$defs/M8OperationalSource"
    },
    "source_catalog_commit_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Catalog Commit Receipt Id",
      "type": "string"
    },
    "source_catalog_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Catalog Id",
      "type": "string"
    }
  },
  "required": [
    "source_catalog_id",
    "source_catalog_commit_receipt_id",
    "source",
    "media_attached",
    "camera_view_manifest_id",
    "camera_view_id"
  ],
  "title": "M8PersonalDemoCameraViewV1",
  "type": "object"
}
