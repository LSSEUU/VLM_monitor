{
  "$defs": {
    "M8AppealResolution": {
      "enum": [
        "UPHELD",
        "OVERTURNED"
      ],
      "title": "M8AppealResolution",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-personal-demo-ppe-outcome-notification-receipt-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Queued student outcome card bound to a terminal PPE appeal authority.",
  "properties": {
    "appeal_resolution": {
      "$ref": "#/$defs/M8AppealResolution"
    },
    "audience": {
      "const": "CASE_SUBJECT",
      "default": "CASE_SUBJECT",
      "title": "Audience",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Case Id",
      "type": "string"
    },
    "case_transition_permitted": {
      "const": false,
      "default": false,
      "title": "Case Transition Permitted",
      "type": "boolean"
    },
    "channel": {
      "const": "LOCAL_OFFLINE_FAKE",
      "default": "LOCAL_OFFLINE_FAKE",
      "title": "Channel",
      "type": "string"
    },
    "direct_disciplinary_action_permitted": {
      "const": false,
      "default": false,
      "title": "Direct Disciplinary Action Permitted",
      "type": "boolean"
    },
    "display_badge": {
      "const": "SIMULATED 路 APPEAL OUTCOME CARD",
      "default": "SIMULATED 路 APPEAL OUTCOME CARD",
      "title": "Display Badge",
      "type": "string"
    },
    "model_used": {
      "const": false,
      "default": false,
      "title": "Model Used",
      "type": "boolean"
    },
    "network_used": {
      "const": false,
      "default": false,
      "title": "Network Used",
      "type": "boolean"
    },
    "notification_commit_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Notification Commit Receipt Id",
      "type": "string"
    },
    "notification_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Notification Id",
      "type": "string"
    },
    "notification_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Notification Manifest Id",
      "type": "string"
    },
    "notification_status": {
      "const": "QUEUED",
      "default": "QUEUED",
      "title": "Notification Status",
      "type": "string"
    },
    "notification_version": {
      "const": 2,
      "default": 2,
      "title": "Notification Version",
      "type": "integer"
    },
    "offline_card_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Offline Card Id",
      "type": "string"
    },
    "ppe_case_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ppe Case Receipt Id",
      "type": "string"
    },
    "ppe_outcome_notification_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Ppe Outcome Notification Receipt Id",
      "type": "string"
    },
    "purpose": {
      "const": "CASE_UPDATED",
      "default": "CASE_UPDATED",
      "title": "Purpose",
      "type": "string"
    },
    "real_delivery_confirmed": {
      "const": false,
      "default": false,
      "title": "Real Delivery Confirmed",
      "type": "boolean"
    },
    "routed_at": {
      "format": "date-time",
      "title": "Routed At",
      "type": "string"
    },
    "schema_version": {
      "const": "m8-personal-demo-ppe-outcome-notification-receipt-v1",
      "default": "m8-personal-demo-ppe-outcome-notification-receipt-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "simulated": {
      "const": true,
      "default": true,
      "title": "Simulated",
      "type": "boolean"
    },
    "source_case_authority_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Case Authority Sha256",
      "type": "string"
    },
    "source_case_status": {
      "const": "APPEAL_RESOLVED",
      "default": "APPEAL_RESOLVED",
      "title": "Source Case Status",
      "type": "string"
    },
    "source_case_version": {
      "exclusiveMinimum": 3,
      "title": "Source Case Version",
      "type": "integer"
    },
    "target_actor_id": {
      "const": "student-demo",
      "default": "student-demo",
      "title": "Target Actor Id",
      "type": "string"
    },
    "target_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Authority Id",
      "type": "string"
    },
    "target_commit_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Commit Receipt Id",
      "type": "string"
    }
  },
  "required": [
    "ppe_case_receipt_id",
    "case_id",
    "source_case_version",
    "source_case_authority_sha256",
    "appeal_resolution",
    "target_commit_receipt_id",
    "target_authority_id",
    "notification_id",
    "notification_commit_receipt_id",
    "routed_at",
    "offline_card_id",
    "notification_manifest_id",
    "ppe_outcome_notification_receipt_id"
  ],
  "title": "M8PersonalDemoPpeOutcomeNotificationReceiptV1",
  "type": "object"
}
