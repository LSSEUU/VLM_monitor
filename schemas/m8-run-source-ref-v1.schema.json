{
  "$defs": {
    "M8EvaluationRunSourceKind": {
      "enum": [
        "RECORDED_ASSET",
        "LIVE_CAPTURE_SEGMENT"
      ],
      "title": "M8EvaluationRunSourceKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-run-source-ref-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Asset Id",
      "type": "string"
    },
    "capture_segment_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capture Segment Id"
    },
    "frame_count": {
      "exclusiveMinimum": 0,
      "title": "Frame Count",
      "type": "integer"
    },
    "media_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Media Sha256",
      "type": "string"
    },
    "relative_path": {
      "title": "Relative Path",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m8-run-source-ref-v1",
      "default": "m8-run-source-ref-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_kind": {
      "$ref": "#/$defs/M8EvaluationRunSourceKind"
    },
    "source_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Manifest Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "source_kind",
    "asset_id",
    "media_sha256",
    "relative_path",
    "frame_count",
    "source_manifest_id"
  ],
  "title": "M8RunSourceRefV1",
  "type": "object"
}
