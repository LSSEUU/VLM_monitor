{
  "$defs": {
    "ProceduralDefectCode": {
      "enum": [
        "MALFORMED_STRUCTURE",
        "INVALID_ENUM",
        "MISSING_REQUIRED_FIELD",
        "FABRICATED_EVIDENCE_REFERENCE",
        "INVALID_COORDINATES",
        "FABRICATED_PRECEDENT_REFERENCE",
        "PRECEDENT_DIRECTION_MISMATCH",
        "EMPTY_DISTINGUISHING_REASON",
        "ESTABLISHED_WITHOUT_EVIDENCE",
        "UNANSWERED_DEFENSE_POINT",
        "CONFIDENCE_ALERT_LEVEL_MISMATCH",
        "OBJECTIVE_ASSERTION_CONTRADICTION",
        "VIOLATION_TYPE_MISMATCH",
        "ABSENCE_FROM_INSUFFICIENT_OBSERVATION"
      ],
      "title": "ProceduralDefectCode",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/hearing-rework-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Failed-review authority opening exactly one adjacent rework cycle.",
  "properties": {
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "defect_codes": {
      "items": {
        "$ref": "#/$defs/ProceduralDefectCode"
      },
      "maxItems": 14,
      "minItems": 1,
      "title": "Defect Codes",
      "type": "array"
    },
    "defect_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Defect Set Sha256",
      "type": "string"
    },
    "failed_review_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Failed Review Id",
      "type": "string"
    },
    "hearing_session_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hearing Session Id",
      "type": "string"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "next_cycle_scope_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Next Cycle Scope Id",
      "type": "string"
    },
    "next_cycle_scope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Next Cycle Scope Sha256",
      "type": "string"
    },
    "prior_round_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prior Round Id",
      "type": "string"
    },
    "prompt_defect_summary_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Defect Summary Sha256",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Receipt Id",
      "type": "string"
    },
    "receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Receipt Sha256",
      "type": "string"
    },
    "rework_index": {
      "exclusiveMinimum": 0,
      "maximum": 2,
      "title": "Rework Index",
      "type": "integer"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m4-hearing-rework-receipt-v1",
      "default": "m4-hearing-rework-receipt-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "hearing_session_id",
    "failed_review_id",
    "prior_round_id",
    "next_cycle_scope_id",
    "next_cycle_scope_sha256",
    "rework_index",
    "defect_codes",
    "prompt_defect_summary_sha256",
    "manifest_id",
    "defect_set_sha256",
    "receipt_id",
    "receipt_sha256"
  ],
  "title": "HearingReworkReceipt",
  "type": "object"
}
