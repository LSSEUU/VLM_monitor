{
  "$defs": {
    "PilotPerceptionArtifactReceipt": {
      "additionalProperties": false,
      "description": "One immutable A1 output bound into the final completion inventory.",
      "properties": {
        "artifact_ref": {
          "minLength": 1,
          "title": "Artifact Ref",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "artifact_size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 8589934592,
          "title": "Artifact Size Bytes",
          "type": "integer"
        },
        "receipt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Receipt Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "VIDEO_MANIFEST",
            "EXECUTION_MANIFEST",
            "FRAME_BUNDLES",
            "FRAME_RECEIPTS",
            "REPORT",
            "PREVIEW"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "artifact_ref",
        "artifact_sha256",
        "artifact_size_bytes",
        "receipt_id"
      ],
      "title": "PilotPerceptionArtifactReceipt",
      "type": "object"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/pilot-perception-completion-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Last-written A1 seal proving that every resumable output is present.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/PilotPerceptionArtifactReceipt"
      },
      "maxItems": 6,
      "minItems": 5,
      "title": "Artifacts",
      "type": "array"
    },
    "completion_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Completion Id",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "pilot-perception-completion-v1",
      "default": "pilot-perception-completion-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "video_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Video Sha256",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "config_sha256",
    "video_sha256",
    "manifest_id",
    "artifacts",
    "completion_id"
  ],
  "title": "PilotPerceptionCompletionManifest",
  "type": "object"
}
