{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "RUN",
        "FRAME",
        "SAFETY_SIGNAL",
        "EVENT",
        "CASE",
        "DETECTION",
        "OBJECTIVE_FACT",
        "CROP",
        "MEDIA",
        "EVIDENCE_PACK",
        "TOOL_RESULT",
        "MANIFEST",
        "MODEL_RESPONSE",
        "MODEL_REQUEST",
        "PROMPT_MANIFEST",
        "MODEL_PARSE_RECEIPT",
        "PARSED_MODEL_OUTPUT",
        "PROCEDURAL_REVIEW",
        "MODEL_CACHE_ENTRY",
        "SCREENING_RESULT",
        "VERDICT",
        "ALERT",
        "PRECEDENT",
        "APPEAL",
        "TRAINING_LABEL",
        "BACKLOG_ITEM",
        "DATASET"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A kind-discriminated reference with syntax fixed by the artifact kind.",
      "properties": {
        "artifact_id": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/hearing-verdict-binding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bind every Judge FINAL proposal to its immutable Verdict, before L5 outcome.",
  "properties": {
    "binding_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Binding Id",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "defender_output_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Defender Output Id",
      "type": "string"
    },
    "evidence_pack_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Pack Id",
      "type": "string"
    },
    "evidence_pack_version": {
      "exclusiveMinimum": 0,
      "title": "Evidence Pack Version",
      "type": "integer"
    },
    "hearing_record_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hearing Record Id",
      "type": "string"
    },
    "hearing_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hearing Record Sha256",
      "type": "string"
    },
    "hearing_record_version": {
      "exclusiveMinimum": 0,
      "title": "Hearing Record Version",
      "type": "integer"
    },
    "hearing_session_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hearing Session Id",
      "type": "string"
    },
    "judge_output_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Judge Output Id",
      "type": "string"
    },
    "judge_round_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Judge Round Id",
      "type": "string"
    },
    "judge_round_index": {
      "exclusiveMinimum": 0,
      "maximum": 5,
      "title": "Judge Round Index",
      "type": "integer"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "model_request_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "maxItems": 640,
      "minItems": 3,
      "title": "Model Request Refs",
      "type": "array"
    },
    "model_response_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "maxItems": 640,
      "minItems": 3,
      "title": "Model Response Refs",
      "type": "array"
    },
    "parse_receipt_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "maxItems": 640,
      "minItems": 3,
      "title": "Parse Receipt Refs",
      "type": "array"
    },
    "prosecutor_output_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prosecutor Output Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m4-hearing-verdict-binding-v1",
      "default": "m4-hearing-verdict-binding-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "verdict_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Verdict Id",
      "type": "string"
    },
    "verdict_input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Verdict Input Sha256",
      "type": "string"
    },
    "verdict_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Verdict Sha256",
      "type": "string"
    },
    "verdict_version": {
      "exclusiveMinimum": 0,
      "title": "Verdict Version",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "hearing_session_id",
    "hearing_record_id",
    "hearing_record_version",
    "hearing_record_sha256",
    "judge_round_id",
    "judge_round_index",
    "evidence_pack_id",
    "evidence_pack_version",
    "prosecutor_output_id",
    "defender_output_id",
    "judge_output_id",
    "verdict_id",
    "verdict_version",
    "verdict_input_sha256",
    "verdict_sha256",
    "model_request_refs",
    "model_response_refs",
    "parse_receipt_refs",
    "manifest_id",
    "binding_id"
  ],
  "title": "HearingVerdictBinding",
  "type": "object"
}
