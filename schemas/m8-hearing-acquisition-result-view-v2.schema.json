{
  "$defs": {
    "AcquisitionAction": {
      "enum": [
        "REQUEST_MORE_FRAMES",
        "RECROP",
        "OTHER_CAMERA_SAME_TIME",
        "TRACK_CONFIDENCE_CURVE",
        "REDETECT_HIGH_RES"
      ],
      "title": "AcquisitionAction",
      "type": "string"
    },
    "BBoxXYXY": {
      "additionalProperties": false,
      "description": "Integer `[x1, y1, x2, y2)` bounding box.",
      "properties": {
        "x1": {
          "minimum": 0,
          "title": "X1",
          "type": "integer"
        },
        "x2": {
          "exclusiveMinimum": 0,
          "title": "X2",
          "type": "integer"
        },
        "y1": {
          "minimum": 0,
          "title": "Y1",
          "type": "integer"
        },
        "y2": {
          "exclusiveMinimum": 0,
          "title": "Y2",
          "type": "integer"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "BBoxXYXY",
      "type": "object"
    },
    "M8AcquisitionFailureCode": {
      "enum": [
        "SOURCE_BINDING_MISSING",
        "SOURCE_AUTHORITY_MISMATCH",
        "SOURCE_MEDIA_UNAVAILABLE",
        "RECROP_AUTHORITY_MISSING",
        "DETECTOR_UNAVAILABLE",
        "DETECTOR_FAILED",
        "DETECTOR_OUTPUT_INVALID",
        "TRACK_DATA_MISSING",
        "TRACK_DATA_AMBIGUOUS",
        "OTHER_CAMERA_UNAVAILABLE",
        "V1_EMPTY_OUTPUT_UNREPRESENTABLE"
      ],
      "title": "M8AcquisitionFailureCode",
      "type": "string"
    },
    "M8AcquisitionM4Representability": {
      "enum": [
        "M4_V1_REPRESENTABLE",
        "V1_UNREPRESENTABLE"
      ],
      "title": "M8AcquisitionM4Representability",
      "type": "string"
    },
    "M8AcquisitionOutcomeStatus": {
      "enum": [
        "SUCCEEDED",
        "SUCCEEDED_EMPTY",
        "FAILED",
        "UNAVAILABLE"
      ],
      "title": "M8AcquisitionOutcomeStatus",
      "type": "string"
    },
    "M8AcquisitionRawReceiptV1": {
      "additionalProperties": false,
      "properties": {
        "cache_hit": {
          "title": "Cache Hit",
          "type": "boolean"
        },
        "raw_response_ref": {
          "minLength": 1,
          "title": "Raw Response Ref",
          "type": "string"
        },
        "raw_response_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Response Sha256",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-acquisition-raw-receipt-v1",
          "default": "m8-acquisition-raw-receipt-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "raw_response_ref",
        "raw_response_sha256",
        "cache_hit"
      ],
      "title": "M8AcquisitionRawReceiptV1",
      "type": "object"
    },
    "M8RedetectionCandidateV1": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BBoxXYXY"
        },
        "label": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "label",
        "bbox",
        "score"
      ],
      "title": "M8RedetectionCandidateV1",
      "type": "object"
    },
    "M8RedetectionOutcomeV1": {
      "additionalProperties": false,
      "description": "Strict raw detector result.  Empty success is intentionally legal here.",
      "properties": {
        "crop_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Crop Id",
          "type": "string"
        },
        "crop_media_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Crop Media Sha256",
          "type": "string"
        },
        "detections": {
          "default": [],
          "items": {
            "$ref": "#/$defs/M8RedetectionCandidateV1"
          },
          "maxItems": 512,
          "title": "Detections",
          "type": "array"
        },
        "error_code": {
          "anyOf": [
            {
              "enum": [
                "IMAGE_INVALID",
                "INFERENCE_FAILED",
                "REQUEST_INVALID",
                "MODEL_UNAVAILABLE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "model_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Manifest Id",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-redetection-outcome-v1",
          "default": "m8-redetection-outcome-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "crop_id",
        "crop_media_sha256",
        "model_manifest_id",
        "status"
      ],
      "title": "M8RedetectionOutcomeV1",
      "type": "object"
    },
    "M8TrackConfidencePointStatus": {
      "enum": [
        "OBSERVED",
        "MISSING"
      ],
      "title": "M8TrackConfidencePointStatus",
      "type": "string"
    },
    "M8TrackConfidencePointV1": {
      "additionalProperties": false,
      "properties": {
        "detection_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detection Id"
        },
        "frame_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:(?:0|[1-9][0-9]{0,19})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Id"
        },
        "frame_index": {
          "minimum": 0,
          "title": "Frame Index",
          "type": "integer"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "status": {
          "$ref": "#/$defs/M8TrackConfidencePointStatus"
        }
      },
      "required": [
        "frame_index",
        "status"
      ],
      "title": "M8TrackConfidencePointV1",
      "type": "object"
    },
    "M8TrackConfidenceSeriesViewV1": {
      "additionalProperties": false,
      "description": "Platform-safe projection of a typed series without the internal M4 case ID.",
      "properties": {
        "acquisition_request_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Acquisition Request Id",
          "type": "string"
        },
        "end_frame_exclusive": {
          "exclusiveMinimum": 0,
          "title": "End Frame Exclusive",
          "type": "integer"
        },
        "maximum_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Maximum Score",
          "type": "number"
        },
        "mean_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Mean Score",
          "type": "number"
        },
        "minimum_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Score",
          "type": "number"
        },
        "observed_count": {
          "exclusiveMinimum": 0,
          "title": "Observed Count",
          "type": "integer"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/M8TrackConfidencePointV1"
          },
          "title": "Points",
          "type": "array"
        },
        "schema_version": {
          "const": "m8-track-confidence-series-view-v1",
          "default": "m8-track-confidence-series-view-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_series_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Series Id",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "track_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Track Ref",
          "type": "string"
        }
      },
      "required": [
        "source_series_id",
        "acquisition_request_id",
        "track_ref",
        "start_frame",
        "end_frame_exclusive",
        "points",
        "observed_count",
        "mean_score",
        "minimum_score",
        "maximum_score"
      ],
      "title": "M8TrackConfidenceSeriesViewV1",
      "type": "object"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-hearing-acquisition-result-view-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Same-origin view keyed by the formal platform Case identity.",
  "properties": {
    "acquisition_request_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Acquisition Request Id",
      "type": "string"
    },
    "action": {
      "$ref": "#/$defs/AcquisitionAction"
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "failure_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/M8AcquisitionFailureCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "m4_representability": {
      "$ref": "#/$defs/M8AcquisitionM4Representability"
    },
    "raw_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/M8AcquisitionRawReceiptV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "redetection_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/M8RedetectionOutcomeV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "result_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m8-hearing-acquisition-result-view-v2",
      "default": "m8-hearing-acquisition-result-view-v2",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/M8AcquisitionOutcomeStatus"
    },
    "track_confidence_series": {
      "anyOf": [
        {
          "$ref": "#/$defs/M8TrackConfidenceSeriesViewV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "case_id",
    "result_id",
    "acquisition_request_id",
    "action",
    "status",
    "m4_representability"
  ],
  "title": "M8HearingAcquisitionResultViewV2",
  "type": "object"
}
