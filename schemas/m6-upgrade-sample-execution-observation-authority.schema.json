{
  "$defs": {
    "M6LockedModelCallLayer": {
      "enum": [
        "SCREENING",
        "HEARING"
      ],
      "title": "M6LockedModelCallLayer",
      "type": "string"
    },
    "M6LockedModelCallResultKind": {
      "enum": [
        "RESPONSE",
        "FAILURE"
      ],
      "title": "M6LockedModelCallResultKind",
      "type": "string"
    },
    "M6LockedModelRole": {
      "enum": [
        "SCREENING",
        "PROSECUTOR",
        "DEFENDER",
        "JUDGE"
      ],
      "title": "M6LockedModelRole",
      "type": "string"
    },
    "M6RegressionExecutionEntry": {
      "additionalProperties": false,
      "description": "Blinded candidate input; it contains no membership or expected decision.",
      "properties": {
        "execution_entry_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Execution Entry Id",
          "type": "string"
        },
        "input_authority_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Authority Document Sha256",
          "type": "string"
        },
        "input_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Authority Id",
          "type": "string"
        },
        "replay_input_closure_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Replay Input Closure Authority Id",
          "type": "string"
        },
        "replay_input_closure_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Replay Input Closure Document Sha256",
          "type": "string"
        },
        "sample_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Sample Id",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "input_authority_id",
        "input_authority_document_sha256",
        "replay_input_closure_authority_id",
        "replay_input_closure_document_sha256",
        "execution_entry_id"
      ],
      "title": "M6RegressionExecutionEntry",
      "type": "object"
    },
    "M6ReplayExecutionOutcome": {
      "enum": [
        "CASE_REPLAYED",
        "NO_CASE"
      ],
      "title": "M6ReplayExecutionOutcome",
      "type": "string"
    },
    "M6UpgradeArtifactUsage": {
      "description": "Relationship to this candidate sample execution, not global ownership.",
      "enum": [
        "CONSUMED",
        "PRODUCED"
      ],
      "title": "M6UpgradeArtifactUsage",
      "type": "string"
    },
    "M6UpgradeCandidateCaseBinding": {
      "additionalProperties": false,
      "properties": {
        "case_audit_entry_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Case Audit Entry Hash",
          "type": "string"
        },
        "case_audit_sequence": {
          "minimum": 0,
          "title": "Case Audit Sequence",
          "type": "integer"
        },
        "case_binding_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Case Binding Id",
          "type": "string"
        },
        "case_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Case Document Sha256",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "case_revision": {
          "exclusiveMinimum": 0,
          "title": "Case Revision",
          "type": "integer"
        }
      },
      "required": [
        "case_id",
        "case_revision",
        "case_document_sha256",
        "case_audit_sequence",
        "case_audit_entry_hash",
        "case_binding_id"
      ],
      "title": "M6UpgradeCandidateCaseBinding",
      "type": "object"
    },
    "M6UpgradeObservedArtifactIdentity": {
      "additionalProperties": false,
      "description": "One non-model artifact identity observed during candidate execution.",
      "properties": {
        "artifact_id": {
          "maxLength": 192,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/M6UpgradePhysicalArtifactKind"
        },
        "source": {
          "$ref": "#/$defs/M6UpgradePhysicalArtifactSource"
        },
        "usage": {
          "$ref": "#/$defs/M6UpgradeArtifactUsage"
        }
      },
      "required": [
        "source",
        "kind",
        "artifact_id",
        "usage"
      ],
      "title": "M6UpgradeObservedArtifactIdentity",
      "type": "object"
    },
    "M6UpgradeObservedModelCall": {
      "additionalProperties": false,
      "description": "Runtime facts needed to resolve one model call from trusted stores.",
      "properties": {
        "attempt_index": {
          "maximum": 1,
          "minimum": 0,
          "title": "Attempt Index",
          "type": "integer"
        },
        "layer": {
          "$ref": "#/$defs/M6LockedModelCallLayer"
        },
        "provider_invoked": {
          "title": "Provider Invoked",
          "type": "boolean"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Id",
          "type": "string"
        },
        "result_kind": {
          "$ref": "#/$defs/M6LockedModelCallResultKind"
        },
        "role": {
          "$ref": "#/$defs/M6LockedModelRole"
        }
      },
      "required": [
        "request_id",
        "layer",
        "role",
        "attempt_index",
        "result_kind",
        "provider_invoked"
      ],
      "title": "M6UpgradeObservedModelCall",
      "type": "object"
    },
    "M6UpgradePhysicalArtifactKind": {
      "enum": [
        "FRAME",
        "DETECTION",
        "MODEL_REQUEST",
        "MODEL_RESPONSE",
        "MODEL_CACHE",
        "MODEL_PARSE_RECEIPT",
        "MODEL_PARSED_OUTPUT",
        "MODEL_CALL_FAILURE",
        "MODEL_USAGE_RECEIPT",
        "EMBEDDING",
        "PRECEDENT_EXPOSURE",
        "TOOL_EXECUTION_MANIFEST",
        "TOOL_RESULT",
        "EVIDENCE_PACK"
      ],
      "title": "M6UpgradePhysicalArtifactKind",
      "type": "string"
    },
    "M6UpgradePhysicalArtifactSource": {
      "enum": [
        "M2_PERCEPTION",
        "M2_EVIDENCE",
        "M3_SCREENING_MODEL",
        "M4_HEARING_MODEL",
        "M4_ACQUISITION",
        "M5_PRECEDENT"
      ],
      "title": "M6UpgradePhysicalArtifactSource",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m6-upgrade-sample-execution-observation-authority.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Complete logical observation captured before one ledger entry exists.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/M6UpgradeObservedArtifactIdentity"
      },
      "maxItems": 20000,
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "candidate_case": {
      "anyOf": [
        {
          "$ref": "#/$defs/M6UpgradeCandidateCaseBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "candidate_run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Candidate Run Id",
      "type": "string"
    },
    "command_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Command Id",
      "type": "string"
    },
    "execution_dataset_snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Dataset Snapshot Id",
      "type": "string"
    },
    "execution_entry": {
      "$ref": "#/$defs/M6RegressionExecutionEntry"
    },
    "execution_scope_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Scope Authority Id",
      "type": "string"
    },
    "ledger_sequence": {
      "minimum": 0,
      "title": "Ledger Sequence",
      "type": "integer"
    },
    "model_calls": {
      "default": [],
      "items": {
        "$ref": "#/$defs/M6UpgradeObservedModelCall"
      },
      "maxItems": 1000,
      "title": "Model Calls",
      "type": "array"
    },
    "observation_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Observation Authority Id",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/M6ReplayExecutionOutcome"
    },
    "schema_version": {
      "const": "m6-upgrade-sample-execution-observation-authority-v1",
      "default": "m6-upgrade-sample-execution-observation-authority-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "execution_scope_authority_id",
    "candidate_run_id",
    "command_id",
    "execution_dataset_snapshot_id",
    "execution_entry",
    "ledger_sequence",
    "outcome",
    "artifacts",
    "observation_authority_id"
  ],
  "title": "M6UpgradeSampleExecutionObservationAuthority",
  "type": "object"
}
