{
  "$defs": {
    "M8ActorRole": {
      "enum": [
        "LEADER",
        "SAFETY_OFFICER",
        "STUDENT",
        "OPERATIONS"
      ],
      "title": "M8ActorRole",
      "type": "string"
    },
    "M8AgentCaseTransitionPayloadV2": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "CONFIRM",
          "title": "Action",
          "type": "string"
        },
        "explicit_human_confirmation": {
          "const": true,
          "title": "Explicit Human Confirmation",
          "type": "boolean"
        },
        "source_case_authority_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Case Authority Sha256",
          "type": "string"
        },
        "source_case_version": {
          "exclusiveMinimum": 0,
          "title": "Source Case Version",
          "type": "integer"
        },
        "source_status": {
          "const": "PENDING_VERIFICATION",
          "title": "Source Status",
          "type": "string"
        }
      },
      "required": [
        "action",
        "source_case_version",
        "source_case_authority_sha256",
        "source_status",
        "explicit_human_confirmation"
      ],
      "title": "M8AgentCaseTransitionPayloadV2",
      "type": "object"
    },
    "M8AgentConversationSummaryV1": {
      "additionalProperties": false,
      "properties": {
        "actor_authority_commit_receipt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Actor Authority Commit Receipt Id",
          "type": "string"
        },
        "actor_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Actor Id",
          "type": "string"
        },
        "actor_role": {
          "$ref": "#/$defs/M8ActorRole"
        },
        "conversation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Conversation Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "latest_activity_at": {
          "format": "date-time",
          "title": "Latest Activity At",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-agent-conversation-summary-v1",
          "default": "m8-agent-conversation-summary-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sealed": {
          "title": "Sealed",
          "type": "boolean"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "turn_count": {
          "minimum": 0,
          "title": "Turn Count",
          "type": "integer"
        }
      },
      "required": [
        "conversation_id",
        "actor_id",
        "actor_role",
        "actor_authority_commit_receipt_id",
        "created_at",
        "title",
        "turn_count",
        "latest_activity_at",
        "sealed"
      ],
      "title": "M8AgentConversationSummaryV1",
      "type": "object"
    },
    "M8AgentConversationTurnV1": {
      "additionalProperties": false,
      "properties": {
        "completion": {
          "anyOf": [
            {
              "$ref": "#/$defs/M8AgentTurnCompletionV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "failure_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/M8AgentFailureCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "m8-agent-conversation-turn-v1",
          "default": "m8-agent-conversation-turn-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/M8AgentTurnState"
        },
        "submitted_at": {
          "format": "date-time",
          "title": "Submitted At",
          "type": "string"
        },
        "turn_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Turn Id",
          "type": "string"
        },
        "user_text": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "User Text",
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "user_text",
        "submitted_at",
        "state"
      ],
      "title": "M8AgentConversationTurnV1",
      "type": "object"
    },
    "M8AgentExecutionMode": {
      "enum": [
        "LIVE_QWEN",
        "CACHE_REPLAY",
        "OFFLINE_FALLBACK",
        "DETERMINISTIC_ACTION"
      ],
      "title": "M8AgentExecutionMode",
      "type": "string"
    },
    "M8AgentFailureCode": {
      "enum": [
        "NOT_CONFIGURED",
        "PROVIDER_TIMEOUT",
        "TRANSPORT_UNAVAILABLE",
        "PROVIDER_REJECTED",
        "RESPONSE_INVALID",
        "RESPONSE_TOO_LARGE",
        "TOOL_ARGUMENT_INVALID",
        "TOOL_FORBIDDEN",
        "TOOL_LOOP_LIMIT",
        "STREAM_INTERRUPTED",
        "AUTHORITY_CHANGED",
        "CONVERSATION_NOT_FOUND"
      ],
      "title": "M8AgentFailureCode",
      "type": "string"
    },
    "M8AgentFeishuTestCardPayloadV2": {
      "additionalProperties": false,
      "properties": {
        "activation_revision": {
          "exclusiveMinimum": 0,
          "title": "Activation Revision",
          "type": "integer"
        },
        "activation_status_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Activation Status Id",
          "type": "string"
        },
        "explicit_human_confirmation": {
          "const": true,
          "title": "Explicit Human Confirmation",
          "type": "boolean"
        },
        "schema_version": {
          "const": "m8-feishu-test-card-check-request-v1",
          "default": "m8-feishu-test-card-check-request-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "activation_revision",
        "activation_status_id",
        "explicit_human_confirmation"
      ],
      "title": "M8AgentFeishuTestCardPayloadV2",
      "type": "object"
    },
    "M8AgentModelCallReceiptV1": {
      "additionalProperties": false,
      "properties": {
        "cache_hit": {
          "title": "Cache Hit",
          "type": "boolean"
        },
        "cache_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cache Key",
          "type": "string"
        },
        "completed": {
          "title": "Completed",
          "type": "boolean"
        },
        "failure_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/M8AgentFailureCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model_call_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Model Call Id",
          "type": "string"
        },
        "model_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Manifest Id",
          "type": "string"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "prompt_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Manifest Id",
          "type": "string"
        },
        "provider_profile_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Provider Profile Id",
          "type": "string"
        },
        "raw_response_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Raw Response Ref",
          "type": "string"
        },
        "raw_response_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Response Sha256",
          "type": "string"
        },
        "round_index": {
          "maximum": 4,
          "minimum": 1,
          "title": "Round Index",
          "type": "integer"
        },
        "schema_version": {
          "const": "m8-agent-model-call-receipt-v1",
          "default": "m8-agent-model-call-receipt-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_schema_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tool Schema Manifest Id",
          "type": "string"
        }
      },
      "required": [
        "model_call_id",
        "round_index",
        "cache_key",
        "provider_profile_id",
        "model_manifest_id",
        "prompt_manifest_id",
        "tool_schema_manifest_id",
        "raw_response_ref",
        "raw_response_sha256",
        "input_tokens",
        "output_tokens",
        "cache_hit",
        "completed"
      ],
      "title": "M8AgentModelCallReceiptV1",
      "type": "object"
    },
    "M8AgentNotificationSendPayloadV2": {
      "additionalProperties": false,
      "properties": {
        "explicit_human_confirmation": {
          "const": true,
          "title": "Explicit Human Confirmation",
          "type": "boolean"
        },
        "kind": {
          "const": "CASE_UPDATED",
          "title": "Kind",
          "type": "string"
        },
        "source_case_authority_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Case Authority Sha256",
          "type": "string"
        },
        "source_case_version": {
          "exclusiveMinimum": 0,
          "title": "Source Case Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "source_case_version",
        "source_case_authority_sha256",
        "explicit_human_confirmation"
      ],
      "title": "M8AgentNotificationSendPayloadV2",
      "type": "object"
    },
    "M8AgentResetPayloadV2": {
      "additionalProperties": false,
      "properties": {
        "explicit_human_confirmation": {
          "const": true,
          "title": "Explicit Human Confirmation",
          "type": "boolean"
        }
      },
      "required": [
        "explicit_human_confirmation"
      ],
      "title": "M8AgentResetPayloadV2",
      "type": "object"
    },
    "M8AgentRunScenarioPayloadV2": {
      "additionalProperties": false,
      "properties": {
        "explicit_human_confirmation": {
          "const": true,
          "title": "Explicit Human Confirmation",
          "type": "boolean"
        },
        "scenario_kind": {
          "const": "SMOKE_TEMPERATURE_EMERGENCY",
          "title": "Scenario Kind",
          "type": "string"
        }
      },
      "required": [
        "scenario_kind",
        "explicit_human_confirmation"
      ],
      "title": "M8AgentRunScenarioPayloadV2",
      "type": "object"
    },
    "M8AgentToolKind": {
      "enum": [
        "READ_CASES",
        "READ_NOTIFICATIONS",
        "READ_OPERATIONS_PROJECTION",
        "QUERY_KNOWLEDGE"
      ],
      "title": "M8AgentToolKind",
      "type": "string"
    },
    "M8AgentToolReceiptV1": {
      "additionalProperties": false,
      "properties": {
        "arguments_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Arguments Sha256",
          "type": "string"
        },
        "knowledge_projection": {
          "anyOf": [
            {
              "$ref": "#/$defs/M8KnowledgeQueryProjectionV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "result_count": {
          "minimum": 0,
          "title": "Result Count",
          "type": "integer"
        },
        "result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-agent-tool-receipt-v1",
          "default": "m8-agent-tool-receipt-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_refs": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Source Refs",
          "type": "array"
        },
        "tool_call_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Tool Call Id",
          "type": "string"
        },
        "tool_kind": {
          "$ref": "#/$defs/M8AgentToolKind"
        }
      },
      "required": [
        "tool_call_id",
        "tool_kind",
        "arguments_sha256",
        "result_sha256",
        "result_count"
      ],
      "title": "M8AgentToolReceiptV1",
      "type": "object"
    },
    "M8AgentTurnCompletionV1": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "conversation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Conversation Id",
          "type": "string"
        },
        "direct_execution_permitted": {
          "const": false,
          "default": false,
          "title": "Direct Execution Permitted",
          "type": "boolean"
        },
        "execution_mode": {
          "$ref": "#/$defs/M8AgentExecutionMode"
        },
        "knowledge_projection": {
          "anyOf": [
            {
              "$ref": "#/$defs/M8KnowledgeQueryProjectionV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_call_receipts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/M8AgentModelCallReceiptV1"
          },
          "maxItems": 4,
          "title": "Model Call Receipts",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/M8AgentTurnOutcome"
        },
        "proposed_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/M8PlatformProposedActionV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "m8-agent-turn-completion-v1",
          "default": "m8-agent-turn-completion-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_refs": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Source Refs",
          "type": "array"
        },
        "tool_receipts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/M8AgentToolReceiptV1"
          },
          "maxItems": 16,
          "title": "Tool Receipts",
          "type": "array"
        },
        "turn_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Turn Id",
          "type": "string"
        }
      },
      "required": [
        "conversation_id",
        "turn_id",
        "outcome",
        "execution_mode",
        "answer",
        "completed_at"
      ],
      "title": "M8AgentTurnCompletionV1",
      "type": "object"
    },
    "M8AgentTurnOutcome": {
      "enum": [
        "ANSWERED",
        "NO_MATCH",
        "ACTION_PROPOSED",
        "FAILED"
      ],
      "title": "M8AgentTurnOutcome",
      "type": "string"
    },
    "M8AgentTurnState": {
      "enum": [
        "ACCEPTED",
        "COMPLETED",
        "FAILED"
      ],
      "title": "M8AgentTurnState",
      "type": "string"
    },
    "M8CaseMemoryAvailability": {
      "enum": [
        "AVAILABLE",
        "NO_MATCH",
        "NO_PLATFORM_AUTHORITY"
      ],
      "title": "M8CaseMemoryAvailability",
      "type": "string"
    },
    "M8CaseMemoryEntryV1": {
      "additionalProperties": false,
      "description": "One role-scoped, persisted Case citation; never a rule or ground truth.",
      "properties": {
        "audit_event_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Audit Event Id",
          "type": "string"
        },
        "case_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Case Authority Id",
          "type": "string"
        },
        "case_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Case Document Sha256",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Case Id",
          "type": "string"
        },
        "case_version": {
          "exclusiveMinimum": 0,
          "title": "Case Version",
          "type": "integer"
        },
        "current_rule_rewrite_permitted": {
          "const": false,
          "default": false,
          "title": "Current Rule Rewrite Permitted",
          "type": "boolean"
        },
        "location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Location Id",
          "type": "string"
        },
        "machine_weak_label_is_ground_truth": {
          "const": false,
          "default": false,
          "title": "Machine Weak Label Is Ground Truth",
          "type": "boolean"
        },
        "persisted_case_authority": {
          "const": true,
          "default": true,
          "title": "Persisted Case Authority",
          "type": "boolean"
        },
        "risk_level": {
          "$ref": "#/$defs/M8OperationalRiskLevel"
        },
        "schema_version": {
          "const": "m8-case-memory-entry-v1",
          "default": "m8-case-memory-entry-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/M8OperationalCaseStatus"
        },
        "summary": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "case_version",
        "status",
        "risk_level",
        "location_id",
        "case_authority_id",
        "case_document_sha256",
        "audit_event_id",
        "summary"
      ],
      "title": "M8CaseMemoryEntryV1",
      "type": "object"
    },
    "M8CaseMemoryProjectionV1": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/M8CaseMemoryAvailability"
        },
        "current_rule_rewrite_permitted": {
          "const": false,
          "default": false,
          "title": "Current Rule Rewrite Permitted",
          "type": "boolean"
        },
        "entries": {
          "default": [],
          "items": {
            "$ref": "#/$defs/M8CaseMemoryEntryV1"
          },
          "maxItems": 8,
          "title": "Entries",
          "type": "array"
        },
        "machine_weak_label_is_ground_truth": {
          "const": false,
          "default": false,
          "title": "Machine Weak Label Is Ground Truth",
          "type": "boolean"
        },
        "ordinary_document_partition_used": {
          "const": false,
          "default": false,
          "title": "Ordinary Document Partition Used",
          "type": "boolean"
        },
        "partition": {
          "const": "CASE_PRECEDENT_AUTHORITY",
          "default": "CASE_PRECEDENT_AUTHORITY",
          "title": "Partition",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-case-memory-projection-v1",
          "default": "m8-case-memory-projection-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "availability"
      ],
      "title": "M8CaseMemoryProjectionV1",
      "type": "object"
    },
    "M8KnowledgeAnswerCommitReceiptV1": {
      "additionalProperties": false,
      "description": "Receipt binding a deterministic answer to the repository-resolved requester.",
      "properties": {
        "answer": {
          "$ref": "#/$defs/M8KnowledgeAnswerV1"
        },
        "answer_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Answer Id",
          "type": "string"
        },
        "commit_receipt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Commit Receipt Id",
          "type": "string"
        },
        "query_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Query Id",
          "type": "string"
        },
        "repository_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Repository Manifest Id",
          "type": "string"
        },
        "resolved_actor_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Resolved Actor Document Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-knowledge-answer-commit-receipt-v1",
          "default": "m8-knowledge-answer-commit-receipt-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "answer",
        "resolved_actor_document_sha256",
        "repository_manifest_id",
        "query_id",
        "answer_id",
        "commit_receipt_id"
      ],
      "title": "M8KnowledgeAnswerCommitReceiptV1",
      "type": "object"
    },
    "M8KnowledgeAnswerOutcome": {
      "enum": [
        "ANSWERED",
        "NO_MATCH"
      ],
      "title": "M8KnowledgeAnswerOutcome",
      "type": "string"
    },
    "M8KnowledgeAnswerV1": {
      "additionalProperties": false,
      "description": "Deterministic extractive answer with exact versioned citations.",
      "properties": {
        "adapter_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Adapter Manifest Id",
          "type": "string"
        },
        "answer_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Answer Id",
          "type": "string"
        },
        "answer_text": {
          "readOnly": true,
          "title": "Answer Text",
          "type": "string"
        },
        "case_transition_permitted": {
          "readOnly": true,
          "title": "Case Transition Permitted",
          "type": "boolean"
        },
        "catalog": {
          "$ref": "#/$defs/M8KnowledgeCatalogAuthorityV1"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/M8KnowledgeCitationV1"
          },
          "maxItems": 10,
          "title": "Citations",
          "type": "array"
        },
        "model_used": {
          "readOnly": true,
          "title": "Model Used",
          "type": "boolean"
        },
