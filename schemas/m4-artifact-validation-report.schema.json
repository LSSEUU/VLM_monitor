{
  "$defs": {
    "ArtifactInventoryKind": {
      "enum": [
        "AUDIT_ENTRY",
        "EVENT",
        "CASE",
        "PACK",
        "MEDIA"
      ],
      "title": "ArtifactInventoryKind",
      "type": "string"
    },
    "ArtifactKind": {
      "enum": [
        "RUN",
        "FRAME",
        "SAFETY_SIGNAL",
        "EVENT",
        "CASE",
        "DETECTION",
        "OBJECTIVE_FACT",
        "CROP",
        "MEDIA",
        "EVIDENCE_PACK",
        "TOOL_RESULT",
        "MANIFEST",
        "MODEL_RESPONSE",
        "MODEL_REQUEST",
        "PROMPT_MANIFEST",
        "MODEL_PARSE_RECEIPT",
        "PARSED_MODEL_OUTPUT",
        "PROCEDURAL_REVIEW",
        "MODEL_CACHE_ENTRY",
        "SCREENING_RESULT",
        "VERDICT",
        "ALERT",
        "PRECEDENT",
        "APPEAL",
        "TRAINING_LABEL",
        "BACKLOG_ITEM",
        "DATASET"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A kind-discriminated reference with syntax fixed by the artifact kind.",
      "properties": {
        "artifact_id": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactValidationArea": {
      "enum": [
        "AUTHORITY",
        "AUDIT",
        "EVENT",
        "CASE",
        "PACK",
        "MEDIA",
        "PROJECTION",
        "BUDGET"
      ],
      "title": "ArtifactValidationArea",
      "type": "string"
    },
    "ArtifactValidationBudget": {
      "additionalProperties": false,
      "properties": {
        "max_audit_entries": {
          "default": 100000,
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Max Audit Entries",
          "type": "integer"
        },
        "max_cases": {
          "default": 10000,
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Max Cases",
          "type": "integer"
        },
        "max_database_bytes": {
          "default": 4294967296,
          "exclusiveMinimum": 0,
          "maximum": 68719476736,
          "title": "Max Database Bytes",
          "type": "integer"
        },
        "max_document_bytes": {
          "default": 16777216,
          "exclusiveMinimum": 0,
          "maximum": 1073741824,
          "title": "Max Document Bytes",
          "type": "integer"
        },
        "max_events": {
          "default": 10000,
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Max Events",
          "type": "integer"
        },
        "max_media": {
          "default": 200000,
          "exclusiveMinimum": 0,
          "maximum": 2000000,
          "title": "Max Media",
          "type": "integer"
        },
        "max_packs": {
          "default": 50000,
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Max Packs",
          "type": "integer"
        },
        "max_projection_bytes": {
          "default": 268435456,
          "exclusiveMinimum": 0,
          "maximum": 4294967296,
          "title": "Max Projection Bytes",
          "type": "integer"
        }
      },
      "title": "ArtifactValidationBudget",
      "type": "object"
    },
    "ArtifactValidationCounts": {
      "additionalProperties": false,
      "properties": {
        "audit_entries": {
          "default": 0,
          "minimum": 0,
          "title": "Audit Entries",
          "type": "integer"
        },
        "cases": {
          "default": 0,
          "minimum": 0,
          "title": "Cases",
          "type": "integer"
        },
        "events": {
          "default": 0,
          "minimum": 0,
          "title": "Events",
          "type": "integer"
        },
        "max_document_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Max Document Bytes",
          "type": "integer"
        },
        "media": {
          "default": 0,
          "minimum": 0,
          "title": "Media",
          "type": "integer"
        },
        "packs": {
          "default": 0,
          "minimum": 0,
          "title": "Packs",
          "type": "integer"
        },
        "projection_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Projection Bytes",
          "type": "integer"
        },
        "projections": {
          "default": 0,
          "minimum": 0,
          "title": "Projections",
          "type": "integer"
        }
      },
      "title": "ArtifactValidationCounts",
      "type": "object"
    },
    "ArtifactValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "actual_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Sha256"
        },
        "actual_size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Size Bytes"
        },
        "area": {
          "$ref": "#/$defs/ArtifactValidationArea"
        },
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "audit_failure_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditChainFailureReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "authoritative_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authoritative Count"
        },
        "closure_defect_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClosureDefectCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "code": {
          "$ref": "#/$defs/ArtifactValidationIssueCode"
        },
        "expected_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Sha256"
        },
        "expected_size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Size Bytes"
        },
        "inventory_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactInventoryKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "media_availability": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaAvailability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "projection_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projection Id"
        },
        "projection_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectionArtifactKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason_code": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "root_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sequence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence"
        },
        "traversed_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traversed Count"
        }
      },
      "required": [
        "code",
        "area"
      ],
      "title": "ArtifactValidationIssue",
      "type": "object"
    },
    "ArtifactValidationIssueCode": {
      "enum": [
        "AUTHORITY_DOCUMENT_INVALID",
        "AUTHORITY_INVENTORY_MISMATCH",
        "AUDIT_DOCUMENT_INVALID",
        "AUDIT_CHAIN_INVALID",
        "EVENT_DOCUMENT_INVALID",
        "CASE_DOCUMENT_INVALID",
        "CASE_SCOPE_MISMATCH",
        "PACK_DOCUMENT_INVALID",
        "PACK_SCOPE_MISMATCH",
        "CURRENT_CLOSURE_INVALID",
        "CURRENT_CLOSURE_DEFECT",
        "MEDIA_UNAVAILABLE",
        "PROJECTION_MISSING",
        "PROJECTION_UNSAFE",
        "PROJECTION_CONTENT_MISMATCH",
        "DOCUMENT_BYTES_BUDGET_EXCEEDED",
        "AUDIT_BUDGET_EXCEEDED",
        "EVENT_BUDGET_EXCEEDED",
        "CASE_BUDGET_EXCEEDED",
        "PACK_BUDGET_EXCEEDED",
        "MEDIA_BUDGET_EXCEEDED",
        "PROJECTION_BYTES_BUDGET_EXCEEDED"
      ],
      "title": "ArtifactValidationIssueCode",
      "type": "string"
    },
    "ArtifactValidationReport": {
      "additionalProperties": false,
      "properties": {
        "audit_head_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audit Head Hash"
        },
        "audit_head_sequence": {
          "anyOf": [
            {
              "minimum": -1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audit Head Sequence"
        },
        "budget": {
          "$ref": "#/$defs/ArtifactValidationBudget"
        },
        "counts": {
          "$ref": "#/$defs/ArtifactValidationCounts"
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactValidationIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "manifest_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Id"
        },
        "passed": {
          "readOnly": true,
          "title": "Passed",
          "type": "boolean"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ArtifactValidationScope"
        },
        "validator_version": {
          "const": "m2-artifacts-v1",
          "default": "m2-artifacts-v1",
          "title": "Validator Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "passed"
      ],
      "title": "ArtifactValidationReport",
      "type": "object"
    },
    "ArtifactValidationScope": {
      "additionalProperties": false,
      "properties": {
        "audit_chain_and_head": {
          "const": true,
          "default": true,
          "title": "Audit Chain And Head",
          "type": "boolean"
        },
        "authority": {
          "const": "SQLITE",
          "default": "SQLITE",
          "title": "Authority",
          "type": "string"
        },
        "canonical_projections": {
          "const": true,
          "default": true,
          "title": "Canonical Projections",
          "type": "boolean"
        },
        "creation_privacy_basis": {
          "const": "IMMUTABLE_DB_AND_CREATION_CLOSURE",
          "default": "IMMUTABLE_DB_AND_CREATION_CLOSURE",
          "title": "Creation Privacy Basis",
          "type": "string"
        },
        "current_closure": {
          "const": true,
          "default": true,
          "title": "Current Closure",
          "type": "boolean"
        },
        "database_documents": {
          "const": true,
          "default": true,
          "title": "Database Documents",
          "type": "boolean"
        },
        "privacy_transform_replay": {
          "const": false,
          "default": false,
          "title": "Privacy Transform Replay",
          "type": "boolean"
        },
        "source_pixel_replay": {
          "const": false,
          "default": false,
          "title": "Source Pixel Replay",
          "type": "boolean"
        },
        "stored_media": {
          "const": true,
          "default": true,
          "title": "Stored Media",
          "type": "boolean"
        }
      },
      "title": "ArtifactValidationScope",
      "type": "object"
    },
