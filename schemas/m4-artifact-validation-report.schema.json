        "SOURCE_HASH_MISMATCH",
        "MEDIA_HASH_MISMATCH",
        "MEDIA_SIZE_MISMATCH",
        "PIXEL_HASH_MISMATCH",
        "MEDIA_DIMENSION_MISMATCH",
        "PRIVACY_POLICY_VIOLATION",
