        "CROP_ROLE_MISMATCH",
        "TRACK_MISMATCH",
        "OBJECTIVE_SOURCE_MISSING",
        "TOOL_INPUT_MISSING",
        "TOOL_OUTPUT_MISSING",
        "PATH_BOUNDARY_VIOLATION",
        "UNSAFE_LINK",
        "NOT_REGULAR_FILE",
        "MEDIA_MISSING",
