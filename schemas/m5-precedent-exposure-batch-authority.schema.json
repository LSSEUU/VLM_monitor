  "$id": "https://schemas.labcourt.local/v2/m5-precedent-exposure-batch-authority.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Complete content-addressed authority for one M4 prompt-visible batch.",
  "properties": {
    "authority_kind": {
      "const": "EXPOSED",
      "default": "EXPOSED",
      "title": "Authority Kind",
      "type": "string"
    },
    "bridge_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bridge Manifest Id",
      "type": "string"
    },
    "bridge_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Bridge Version",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "cycle_index": {
      "exclusiveMinimum": 0,
      "title": "Cycle Index",
      "type": "integer"
    },
    "cycle_scope_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cycle Scope Id",
      "type": "string"
    },
    "cycle_scope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cycle Scope Sha256",
      "type": "string"
    },
    "exposed_precedents": {
      "default": [],
      "items": {
        "$ref": "#/$defs/M5PrecedentExposureItem"
      },
      "maxItems": 64,
      "title": "Exposed Precedents",
      "type": "array"
    },
    "exposure_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Exposure Id",
      "type": "string"
    },
    "exposure_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Exposure Sha256",
      "type": "string"
    },
    "hearing_session_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hearing Session Id",
      "type": "string"
    },
    "hearing_session_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hearing Session Sha256",
      "type": "string"
    },
    "m4_retrieval_outcome": {
      "$ref": "#/$defs/HearingPrecedentRetrievalOutcome"
    },
    "m5_retrieval_result": {
      "$ref": "#/$defs/M5PrecedentRetrievalResult"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "policy_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m5-precedent-exposure-batch-authority-v1",
      "default": "m5-precedent-exposure-batch-authority-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "text_embedding_model_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Text Embedding Model Manifest Id",
      "type": "string"
    },
    "visual_embedding_model_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Visual Embedding Model Manifest Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "hearing_session_id",
    "hearing_session_sha256",
    "cycle_index",
    "cycle_scope_id",
    "cycle_scope_sha256",
    "manifest_id",
    "config_sha256",
    "policy_id",
    "bridge_version",
    "bridge_manifest_id",
    "text_embedding_model_manifest_id",
    "visual_embedding_model_manifest_id",
    "m4_retrieval_outcome",
    "m5_retrieval_result",
    "exposure_id",
    "exposure_sha256"
  ],
  "title": "M5PrecedentExposureBatchAuthority",
  "type": "object"
}
