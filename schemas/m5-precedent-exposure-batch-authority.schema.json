{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "RUN",
        "FRAME",
        "SAFETY_SIGNAL",
        "EVENT",
        "CASE",
        "DETECTION",
        "OBJECTIVE_FACT",
        "CROP",
        "MEDIA",
        "EVIDENCE_PACK",
        "TOOL_RESULT",
        "MANIFEST",
        "MODEL_RESPONSE",
        "MODEL_REQUEST",
        "PROMPT_MANIFEST",
        "MODEL_PARSE_RECEIPT",
        "PARSED_MODEL_OUTPUT",
        "PROCEDURAL_REVIEW",
        "MODEL_CACHE_ENTRY",
        "SCREENING_RESULT",
        "VERDICT",
        "ALERT",
        "PRECEDENT",
        "APPEAL",
        "TRAINING_LABEL",
        "BACKLOG_ITEM",
        "DATASET"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A kind-discriminated reference with syntax fixed by the artifact kind.",
      "properties": {
        "artifact_id": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "EvidenceClass": {
      "enum": [
        "PRESENCE",
        "ABSENCE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "HearingPrecedentDegradedReason": {
      "enum": [
        "EMBEDDING_PROVIDER_UNAVAILABLE",
        "EMBEDDING_MODEL_UNAVAILABLE",
        "PRECEDENT_INDEX_UNAVAILABLE"
      ],
      "title": "HearingPrecedentDegradedReason",
      "type": "string"
    },
    "HearingPrecedentRetrievalOutcome": {
      "additionalProperties": false,
      "description": "Exact application result joining a query, optional success result, and receipt.",
      "properties": {
        "query": {
          "$ref": "#/$defs/HearingPrecedentRetrievalQuery"
        },
        "receipt": {
          "$ref": "#/$defs/HearingPrecedentRetrievalReceipt"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/HearingPrecedentRetrievalResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "query",
        "receipt"
      ],
      "title": "HearingPrecedentRetrievalOutcome",
      "type": "object"
    },
    "HearingPrecedentRetrievalQuery": {
      "additionalProperties": false,
      "description": "Content-addressed M4 query bound to every current retrieval authority.",
      "properties": {
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "current_evidence_pack_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Current Evidence Pack Id",
          "type": "string"
        },
        "current_evidence_pack_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Current Evidence Pack Sha256",
          "type": "string"
        },
        "current_evidence_pack_version": {
          "exclusiveMinimum": 0,
          "title": "Current Evidence Pack Version",
          "type": "integer"
        },
        "cycle_scope_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cycle Scope Id",
          "type": "string"
        },
        "cycle_scope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cycle Scope Sha256",
          "type": "string"
        },
        "embedding_model_manifest": {
          "$ref": "#/$defs/ModelManifest"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "hearing_session_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hearing Session Id",
          "type": "string"
        },
        "hearing_session_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hearing Session Sha256",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "query_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Query Id",
          "type": "string"
        },
        "query_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Query Sha256",
          "type": "string"
        },
        "retriever_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Retriever Manifest Id",
          "type": "string"
        },
        "retriever_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Retriever Version",
          "type": "string"
        },
        "rule_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Rule Version",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m4-hearing-precedent-query-v1",
          "default": "m4-hearing-precedent-query-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "situation_text": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Situation Text",
          "type": "string"
        },
        "top_k": {
          "exclusiveMinimum": 0,
          "maximum": 64,
          "title": "Top K",
          "type": "integer"
        },
        "violation_type": {
          "$ref": "#/$defs/ViolationType"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "hearing_session_id",
        "hearing_session_sha256",
        "cycle_scope_id",
        "cycle_scope_sha256",
        "current_evidence_pack_id",
        "current_evidence_pack_version",
        "current_evidence_pack_sha256",
        "evidence_class",
        "violation_type",
        "rule_version",
        "situation_text",
        "top_k",
        "config_sha256",
        "retriever_version",
        "retriever_manifest_id",
        "embedding_model_manifest",
        "manifest_id",
        "query_id",
        "query_sha256"
      ],
      "title": "HearingPrecedentRetrievalQuery",
      "type": "object"
    },
    "HearingPrecedentRetrievalReceipt": {
      "additionalProperties": false,
      "description": "Auditable visible-set and ranked-result authority for one hearing round.",
      "properties": {
        "candidate_precedent_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "maxItems": 10000,
          "title": "Candidate Precedent Refs",
          "type": "array"
        },
        "candidate_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Snapshot Sha256",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "current_evidence_pack_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Current Evidence Pack Id",
          "type": "string"
        },
        "current_evidence_pack_version": {
          "exclusiveMinimum": 0,
          "title": "Current Evidence Pack Version",
          "type": "integer"
        },
        "cycle_scope_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Cycle Scope Id",
          "type": "string"
        },
        "cycle_scope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Cycle Scope Sha256",
          "type": "string"
        },
        "degraded_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/HearingPrecedentDegradedReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "embedding_model_manifest_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Model Manifest Id"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "hearing_session_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hearing Session Id",
          "type": "string"
        },
        "initial_defect_codes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProceduralDefectCode"
          },
          "maxItems": 14,
          "title": "Initial Defect Codes",
          "type": "array"
        },
        "initial_trigger_review_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "prior_acquisition_rounds": {
          "maximum": 2,
          "minimum": 0,
          "title": "Prior Acquisition Rounds",
          "type": "integer"
        },
        "prior_rework_rounds": {
          "maximum": 2,
          "minimum": 0,
          "title": "Prior Rework Rounds",
          "type": "integer"
        },
        "query_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Query Sha256",
          "type": "string"
        },
        "receipt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Receipt Id",
          "type": "string"
        },
        "receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Receipt Sha256",
          "type": "string"
        },
        "retriever_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Retriever Manifest Id",
          "type": "string"
        },
        "retriever_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Retriever Version",
          "type": "string"
        },
        "rework_defect_codes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProceduralDefectCode"
          },
          "maxItems": 14,
          "title": "Rework Defect Codes",
          "type": "array"
        },
        "rework_review_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "round_index": {
          "exclusiveMinimum": 0,
          "maximum": 5,
          "title": "Round Index",
          "type": "integer"
        },
        "rule_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Rule Version",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m4-hearing-precedent-retrieval-v1",
          "default": "m4-hearing-precedent-retrieval-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scored_precedents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScoredPrecedent"
          },
          "maxItems": 64,
          "title": "Scored Precedents",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/HearingPrecedentRetrievalStatus"
        },
        "top_k": {
          "maximum": 64,
          "minimum": 0,
          "title": "Top K",
          "type": "integer"
        },
        "violation_type": {
          "$ref": "#/$defs/ViolationType"
        },
        "visible_precedent_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "maxItems": 10000,
          "title": "Visible Precedent Refs",
          "type": "array"
        },
        "visible_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Visible Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "hearing_session_id",
        "round_index",
        "prior_acquisition_rounds",
        "prior_rework_rounds",
        "current_evidence_pack_id",
        "current_evidence_pack_version",
        "evidence_class",
        "violation_type",
        "rule_version",
        "top_k",
        "query_sha256",
        "candidate_snapshot_sha256",
        "visible_snapshot_sha256",
        "status",
        "retriever_version",
        "retriever_manifest_id",
        "manifest_id",
        "cycle_scope_id",
        "cycle_scope_sha256",
        "receipt_id",
        "receipt_sha256"
      ],
      "title": "HearingPrecedentRetrievalReceipt",
      "type": "object"
    },
    "HearingPrecedentRetrievalResult": {
      "additionalProperties": false,
      "description": "Successful, self-verifying candidate snapshot and prompt-visible ranking.",
      "properties": {
        "candidate_precedents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Precedent"
          },
          "maxItems": 10000,
          "title": "Candidate Precedents",
          "type": "array"
        },
        "candidate_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Candidate Snapshot Sha256",
          "type": "string"
        },
        "query": {
          "$ref": "#/$defs/HearingPrecedentRetrievalQuery"
        },
        "result_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Result Id",
          "type": "string"
        },
        "result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Result Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "m4-hearing-precedent-result-v1",
          "default": "m4-hearing-precedent-result-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scored_precedents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScoredPrecedent"
          },
          "maxItems": 64,
          "title": "Scored Precedents",
          "type": "array"
        },
        "visible_precedents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Precedent"
          },
          "maxItems": 64,
          "title": "Visible Precedents",
          "type": "array"
        },
        "visible_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Visible Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "query",
        "candidate_snapshot_sha256",
        "visible_snapshot_sha256",
        "result_id",
        "result_sha256"
      ],
      "title": "HearingPrecedentRetrievalResult",
      "type": "object"
    },
    "HearingPrecedentRetrievalStatus": {
      "enum": [
        "SUCCESS",
        "DEGRADED"
      ],
      "title": "HearingPrecedentRetrievalStatus",
      "type": "string"
    },
    "M5EmbeddingChannel": {
      "enum": [
        "TEXT",
        "VISUAL"
      ],
      "title": "M5EmbeddingChannel",
      "type": "string"
    },
    "M5EmbeddingRequest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "FAKE_SHA256_SIGNED_PROJECTION_V1",
          "default": "FAKE_SHA256_SIGNED_PROJECTION_V1",
          "title": "Algorithm",
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/M5EmbeddingChannel"
        },
        "dimensions": {
          "exclusiveMinimum": 0,
          "maximum": 4096,
          "title": "Dimensions",
          "type": "integer"
        },
        "input_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Input Ref",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "model_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Manifest Id",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m5-embedding-request-v1",
          "default": "m5-embedding-request-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "input_ref",
        "input_sha256",
        "model_manifest_id",
        "dimensions",
        "request_id"
      ],
      "title": "M5EmbeddingRequest",
      "type": "object"
    },
    "M5EmbeddingVector": {
      "additionalProperties": false,
      "properties": {
        "embedding_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Embedding Id",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/M5EmbeddingRequest"
        },
        "schema_version": {
          "const": "m5-embedding-vector-v1",
          "default": "m5-embedding-vector-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "request",
        "values",
        "embedding_id"
      ],
      "title": "M5EmbeddingVector",
      "type": "object"
    },
    "M5PrecedentAuthority": {
      "additionalProperties": false,
      "properties": {
        "activated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activated At"
        },
        "activation_not_before": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activation Not Before"
        },
        "authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Authority Id",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "precedent": {
          "$ref": "#/$defs/Precedent"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m5-precedent-authority-v1",
          "default": "m5-precedent-authority-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "text_embedding": {
          "anyOf": [
            {
              "$ref": "#/$defs/M5EmbeddingVector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "visual_embeddings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/M5EmbeddingVector"
          },
          "maxItems": 32,
          "title": "Visual Embeddings",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "config_sha256",
        "revision",
        "precedent",
        "created_at",
        "authority_id"
      ],
      "title": "M5PrecedentAuthority",
      "type": "object"
    },
    "M5PrecedentCandidateDisposition": {
      "description": "Exhaustive disposition for one exact retrieval input authority.",
      "enum": [
        "SCOPE_EXCLUDED",
        "STATUS_EXCLUDED",
        "UNSCORABLE",
        "SCORED"
      ],
      "title": "M5PrecedentCandidateDisposition",
      "type": "string"
    },
    "M5PrecedentCandidateEvaluation": {
      "additionalProperties": false,
      "description": "Content-addressed evaluation of every authority supplied to retrieval.",
      "properties": {
        "authority": {
          "$ref": "#/$defs/M5PrecedentAuthority"
        },
        "base_similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Similarity"
        },
        "disposition": {
          "$ref": "#/$defs/M5PrecedentCandidateDisposition"
        },
        "evaluation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Evaluation Id",
          "type": "string"
        },
        "normalized_text_weight": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Text Weight"
        },
        "normalized_visual_weight": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Visual Weight"
        },
        "schema_version": {
          "const": "m5-precedent-candidate-evaluation-v1",
          "default": "m5-precedent-candidate-evaluation-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": -10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "source_weight": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Weight"
        },
