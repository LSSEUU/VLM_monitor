{
  "$defs": {
    "EvidenceClass": {
      "enum": [
        "PRESENCE",
        "ABSENCE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "M5EmbeddingChannel": {
      "enum": [
        "TEXT",
        "VISUAL"
      ],
      "title": "M5EmbeddingChannel",
      "type": "string"
    },
    "M5EmbeddingRequest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "FAKE_SHA256_SIGNED_PROJECTION_V1",
          "default": "FAKE_SHA256_SIGNED_PROJECTION_V1",
          "title": "Algorithm",
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/M5EmbeddingChannel"
        },
        "dimensions": {
          "exclusiveMinimum": 0,
          "maximum": 4096,
          "title": "Dimensions",
          "type": "integer"
        },
        "input_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Input Ref",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "model_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Manifest Id",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m5-embedding-request-v1",
          "default": "m5-embedding-request-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "input_ref",
        "input_sha256",
        "model_manifest_id",
        "dimensions",
        "request_id"
      ],
      "title": "M5EmbeddingRequest",
      "type": "object"
    },
    "M5EmbeddingVector": {
      "additionalProperties": false,
      "properties": {
        "embedding_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Embedding Id",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/M5EmbeddingRequest"
        },
        "schema_version": {
          "const": "m5-embedding-vector-v1",
          "default": "m5-embedding-vector-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "request",
        "values",
        "embedding_id"
      ],
      "title": "M5EmbeddingVector",
      "type": "object"
    },
    "M5PrecedentAuthority": {
      "additionalProperties": false,
      "properties": {
        "activated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activated At"
        },
        "activation_not_before": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activation Not Before"
        },
        "authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Authority Id",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "precedent": {
          "$ref": "#/$defs/Precedent"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m5-precedent-authority-v1",
          "default": "m5-precedent-authority-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "text_embedding": {
          "anyOf": [
            {
              "$ref": "#/$defs/M5EmbeddingVector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "visual_embeddings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/M5EmbeddingVector"
          },
          "maxItems": 32,
          "title": "Visual Embeddings",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "config_sha256",
        "revision",
        "precedent",
        "created_at",
        "authority_id"
      ],
      "title": "M5PrecedentAuthority",
      "type": "object"
    },
    "M5PrecedentConflictCausalCut": {
      "additionalProperties": false,
      "description": "Authority-only ledger watermark and complete ACTIVE-head root.",
      "properties": {
        "active_head_count": {
          "maximum": 9999,
          "minimum": 0,
          "title": "Active Head Count",
          "type": "integer"
        },
        "active_head_root_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Active Head Root Sha256",
          "type": "string"
        },
        "authority_event_sequence": {
          "minimum": 0,
          "title": "Authority Event Sequence",
          "type": "integer"
        },
        "authority_event_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Authority Event Sha256",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "cut_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Cut Id",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m5-precedent-conflict-causal-cut-v1",
          "default": "m5-precedent-conflict-causal-cut-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "manifest_id",
        "config_sha256",
        "policy_id",
        "authority_event_sequence",
        "authority_event_sha256",
        "active_head_count",
        "active_head_root_sha256",
        "cut_id"
      ],
      "title": "M5PrecedentConflictCausalCut",
      "type": "object"
    },
    "Precedent": {
      "additionalProperties": false,
      "properties": {
        "activation_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activation At"
        },
        "citation_count": {
          "default": 0,
          "minimum": 0,
          "title": "Citation Count",
          "type": "integer"
        },
        "decision_direction": {
          "$ref": "#/$defs/VerdictDecision"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "invalidated_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalidated By"
        },
        "precedent_id": {
          "minLength": 1,
          "title": "Precedent Id",
          "type": "string"
        },
        "rule_version": {
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "situation_text": {
          "minLength": 1,
          "title": "Situation Text",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/PrecedentSource"
        },
        "source_case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Case Id"
        },
        "status": {
          "$ref": "#/$defs/PrecedentStatus"
        },
        "text_embedding_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Embedding Ref"
        },
        "violation_type": {
          "$ref": "#/$defs/ViolationType"
        },
        "visual_embedding_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Visual Embedding Refs",
          "type": "array"
        }
      },
      "required": [
        "precedent_id",
        "situation_text",
        "decision_direction",
        "source",
        "status",
        "evidence_class",
        "violation_type",
        "rule_version"
      ],
      "title": "Precedent",
      "type": "object"
    },
    "PrecedentSource": {
      "enum": [
        "PRESET",
        "AUTOMATIC",
        "HUMAN_REVIEW",
        "APPEAL_OVERTURN"
      ],
      "title": "PrecedentSource",
      "type": "string"
    },
    "PrecedentStatus": {
      "enum": [
        "PROVISIONAL",
        "ACTIVE",
        "CONFLICT",
        "INVALIDATED",
        "REVOKED"
      ],
      "title": "PrecedentStatus",
      "type": "string"
    },
    "VerdictDecision": {
      "enum": [
        "ESTABLISHED",
        "NOT_ESTABLISHED",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "VerdictDecision",
      "type": "string"
    },
    "ViolationType": {
      "enum": [
        "PPE_GOGGLES_MISSING",
        "PPE_GLOVES_MISSING",
        "PPE_LAB_COAT_MISSING",
        "REAGENT_CONTAINER_OPEN",
        "FOOD_OR_DRINK_IN_LAB",
        "SINGLE_PERSON_HAZARDOUS_OPERATION",
        "FUME_HOOD_SASH_TOO_HIGH",
        "UNATTENDED_HEATING",
        "SMOKE_ABNORMAL",
        "OPEN_FLAME"
      ],
      "title": "ViolationType",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m5-precedent-conflict-snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One complete, stably ordered ACTIVE authority inventory at a causal cut.",
  "properties": {
    "authorities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/M5PrecedentAuthority"
      },
      "maxItems": 9999,
      "title": "Authorities",
      "type": "array"
    },
    "causal_cut": {
      "$ref": "#/$defs/M5PrecedentConflictCausalCut"
    },
    "schema_version": {
      "const": "m5-precedent-conflict-snapshot-v1",
      "default": "m5-precedent-conflict-snapshot-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "causal_cut"
  ],
  "title": "M5PrecedentConflictSnapshot",
  "type": "object"
}
