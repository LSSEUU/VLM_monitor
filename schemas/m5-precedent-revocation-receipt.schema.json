{
  "$defs": {
    "M5PrecedentRevocationOutcome": {
      "enum": [
        "REVOKED",
        "ALREADY_REVOKED"
      ],
      "title": "M5PrecedentRevocationOutcome",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m5-precedent-revocation-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "citation_snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Citation Snapshot Id",
      "type": "string"
    },
    "historical_case_ids": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
        "type": "string"
      },
      "maxItems": 100000,
      "title": "Historical Case Ids",
      "type": "array"
    },
    "historical_citation_ids": {
      "default": [],
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 100000,
      "title": "Historical Citation Ids",
      "type": "array"
    },
    "old_cases_rewritten": {
      "const": false,
      "default": false,
      "title": "Old Cases Rewritten",
      "type": "boolean"
    },
    "outcome": {
      "$ref": "#/$defs/M5PrecedentRevocationOutcome"
    },
    "precedent_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Precedent Id",
      "type": "string"
    },
    "prior_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prior Authority Id",
      "type": "string"
    },
    "prior_revision": {
      "exclusiveMinimum": 0,
      "title": "Prior Revision",
      "type": "integer"
    },
    "receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Receipt Id",
      "type": "string"
    },
    "resulting_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Resulting Authority Id",
      "type": "string"
    },
    "resulting_revision": {
      "exclusiveMinimum": 0,
      "title": "Resulting Revision",
      "type": "integer"
    },
    "revoked_at": {
      "format": "date-time",
      "title": "Revoked At",
      "type": "string"
    },
    "revoked_by_ref": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Revoked By Ref",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m5-precedent-revocation-receipt-v1",
      "default": "m5-precedent-revocation-receipt-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "precedent_id",
    "prior_authority_id",
    "prior_revision",
    "citation_snapshot_id",
    "revoked_by_ref",
    "revoked_at",
    "outcome",
    "resulting_authority_id",
    "resulting_revision",
    "receipt_id"
  ],
  "title": "M5PrecedentRevocationReceipt",
  "type": "object"
}
