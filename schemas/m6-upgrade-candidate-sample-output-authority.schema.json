{
  "$defs": {
    "AlertLevel": {
      "enum": [
        "ADVISORY",
        "CONFIRMED",
        "EMERGENCY"
      ],
      "title": "AlertLevel",
      "type": "string"
    },
    "AppealStatus": {
      "enum": [
        "SUBMITTED",
        "UNDER_REVIEW",
        "UPHELD",
        "OVERTURNED"
      ],
      "title": "AppealStatus",
      "type": "string"
    },
    "CaseStatus": {
      "enum": [
        "CANDIDATE",
        "EVIDENCE_READY",
        "SCREENED",
        "ESCALATED",
        "DELIBERATING",
        "PROCEDURAL_REVIEW",
        "READY_FOR_ALERT_POLICY",
        "REWORK_REQUIRED",
        "HUMAN_REVIEW",
        "BACKLOGGED",
        "CLOSED",
        "APPEALED",
        "APPEAL_RESOLVED"
      ],
      "title": "CaseStatus",
      "type": "string"
    },
    "M6CaseReplaySnapshot": {
      "additionalProperties": false,
      "description": "One replayed Case semantic projection without operational identity noise.",
      "properties": {
        "case_status": {
          "$ref": "#/$defs/CaseStatus"
        },
        "final_decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerdictDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "highest_alert_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlertLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "projection_version": {
          "const": "m6-semantic-case-v1",
          "default": "m6-semantic-case-v1",
          "title": "Projection Version",
          "type": "string"
        },
        "sample_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Sample Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m6-case-replay-snapshot-v1",
          "default": "m6-case-replay-snapshot-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_case_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Semantic Case Hash",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_case_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Case Document Sha256",
          "type": "string"
        },
        "source_case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Source Case Id",
          "type": "string"
        },
        "source_case_revision": {
          "exclusiveMinimum": 0,
          "title": "Source Case Revision",
          "type": "integer"
        },
        "source_run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Source Run Id",
          "type": "string"
        },
        "stage_roots": {
          "items": {
            "$ref": "#/$defs/M6SemanticStageRoot"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Stage Roots",
          "type": "array"
        },
        "terminal_appeal_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppealStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "sample_id",
        "source_run_id",
        "source_case_id",
        "source_case_revision",
        "source_case_document_sha256",
        "manifest_id",
        "stage_roots",
        "case_status",
        "semantic_case_hash",
        "snapshot_id"
      ],
      "title": "M6CaseReplaySnapshot",
      "type": "object"
    },
    "M6LockedModelCallLayer": {
      "enum": [
        "SCREENING",
        "HEARING"
      ],
      "title": "M6LockedModelCallLayer",
      "type": "string"
    },
    "M6LockedModelCallResultKind": {
      "enum": [
        "RESPONSE",
        "FAILURE"
      ],
      "title": "M6LockedModelCallResultKind",
      "type": "string"
    },
    "M6LockedModelRole": {
      "enum": [
        "SCREENING",
        "PROSECUTOR",
        "DEFENDER",
        "JUDGE"
      ],
      "title": "M6LockedModelRole",
      "type": "string"
    },
    "M6RegressionExecutionEntry": {
      "additionalProperties": false,
      "description": "Blinded candidate input; it contains no membership or expected decision.",
      "properties": {
        "execution_entry_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Execution Entry Id",
          "type": "string"
        },
        "input_authority_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Authority Document Sha256",
          "type": "string"
        },
        "input_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Authority Id",
          "type": "string"
        },
        "replay_input_closure_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Replay Input Closure Authority Id",
          "type": "string"
        },
        "replay_input_closure_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Replay Input Closure Document Sha256",
          "type": "string"
        },
        "sample_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Sample Id",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "input_authority_id",
        "input_authority_document_sha256",
        "replay_input_closure_authority_id",
        "replay_input_closure_document_sha256",
        "execution_entry_id"
      ],
      "title": "M6RegressionExecutionEntry",
      "type": "object"
    },
    "M6RegressionStage": {
      "enum": [
        "PERCEPTION",
        "SCREENING",
        "RETRIEVAL",
        "HEARING",
        "GATE",
        "POLICY"
      ],
      "title": "M6RegressionStage",
      "type": "string"
    },
    "M6ReplayExecutionOutcome": {
      "enum": [
        "CASE_REPLAYED",
        "NO_CASE"
      ],
      "title": "M6ReplayExecutionOutcome",
      "type": "string"
    },
    "M6ReplayExecutionReceipt": {
      "additionalProperties": false,
      "description": "Per-sample proof envelope reconstructed from replay input/output closure.",
      "properties": {
        "candidate_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Manifest Id",
          "type": "string"
        },
        "candidate_run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Candidate Run Id",
          "type": "string"
        },
        "candidate_snapshot_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Snapshot Id"
        },
        "command_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Command Id",
          "type": "string"
        },
        "detection_count": {
          "minimum": 0,
          "title": "Detection Count",
          "type": "integer"
        },
        "detection_inventory_root_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Detection Inventory Root Sha256",
          "type": "string"
        },
        "embedding_count": {
          "minimum": 0,
          "title": "Embedding Count",
          "type": "integer"
        },
        "embedding_inventory_root_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Embedding Inventory Root Sha256",
          "type": "string"
        },
        "execution_component_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Execution Component Manifest Id",
          "type": "string"
        },
        "execution_entry_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Execution Entry Id",
          "type": "string"
        },
        "execution_receipt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Execution Receipt Id",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/ReproducibilityMode"
        },
        "model_response_count": {
          "minimum": 0,
          "title": "Model Response Count",
          "type": "integer"
        },
        "model_response_inventory_root_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Response Inventory Root Sha256",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/M6ReplayExecutionOutcome"
        },
        "provider_call_count": {
          "minimum": 0,
          "title": "Provider Call Count",
          "type": "integer"
        },
        "provider_trap_authority_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Trap Authority Id"
        },
        "provider_trap_document_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Trap Document Sha256"
        },
        "sample_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Sample Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m6-replay-execution-receipt-v1",
          "default": "m6-replay-execution-receipt-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_result_count": {
          "minimum": 0,
          "title": "Tool Result Count",
          "type": "integer"
        },
        "tool_result_inventory_root_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tool Result Inventory Root Sha256",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "mode",
        "sample_id",
        "execution_entry_id",
        "candidate_run_id",
        "candidate_manifest_id",
        "execution_component_manifest_id",
        "outcome",
        "detection_count",
        "detection_inventory_root_sha256",
        "model_response_count",
        "model_response_inventory_root_sha256",
        "embedding_count",
        "embedding_inventory_root_sha256",
        "tool_result_count",
        "tool_result_inventory_root_sha256",
        "provider_call_count",
        "execution_receipt_id"
      ],
      "title": "M6ReplayExecutionReceipt",
      "type": "object"
    },
    "M6SemanticStageRoot": {
      "additionalProperties": false,
      "properties": {
        "projection_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Projection Sha256",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/M6RegressionStage"
        }
      },
      "required": [
        "stage",
        "projection_sha256"
      ],
      "title": "M6SemanticStageRoot",
      "type": "object"
    },
    "M6UpgradeCandidateModelCallAuthority": {
      "additionalProperties": false,
      "description": "One offline-fake model call with timeout, cache, manifest, and raw proof.",
      "properties": {
        "attempt_index": {
          "maximum": 1,
          "minimum": 0,
          "title": "Attempt Index",
          "type": "integer"
        },
        "cache_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/M6UpgradePhysicalArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution_model_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Execution Model Manifest Id",
          "type": "string"
        },
        "failure_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/M6UpgradePhysicalArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "layer": {
          "$ref": "#/$defs/M6LockedModelCallLayer"
        },
        "model_call_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Model Call Authority Id",
          "type": "string"
        },
        "parse_receipt_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/M6UpgradePhysicalArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parsed_output_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/M6UpgradePhysicalArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provider_invoked": {
          "title": "Provider Invoked",
          "type": "boolean"
        },
        "provider_mode": {
          "const": "FAKE_OFFLINE",
          "default": "FAKE_OFFLINE",
          "title": "Provider Mode",
          "type": "string"
        },
        "request_ref": {
          "$ref": "#/$defs/M6UpgradePhysicalArtifactRef"
        },
        "response_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/M6UpgradePhysicalArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "result_kind": {
          "$ref": "#/$defs/M6LockedModelCallResultKind"
        },
        "role": {
          "$ref": "#/$defs/M6LockedModelRole"
        },
        "sample_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Sample Id",
          "type": "string"
        },
        "timeout_ms": {
          "exclusiveMinimum": 0,
          "maximum": 3600000,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "usage_receipt_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/M6UpgradePhysicalArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "sample_id",
        "layer",
        "role",
        "attempt_index",
        "timeout_ms",
        "execution_model_manifest_id",
        "provider_invoked",
        "request_ref",
        "result_kind",
        "model_call_authority_id"
      ],
      "title": "M6UpgradeCandidateModelCallAuthority",
      "type": "object"
    },
    "M6UpgradePhysicalArtifactKind": {
      "enum": [
        "FRAME",
        "DETECTION",
        "MODEL_REQUEST",
        "MODEL_RESPONSE",
        "MODEL_CACHE",
        "MODEL_PARSE_RECEIPT",
        "MODEL_PARSED_OUTPUT",
        "MODEL_CALL_FAILURE",
        "MODEL_USAGE_RECEIPT",
        "EMBEDDING",
        "PRECEDENT_EXPOSURE",
        "TOOL_EXECUTION_MANIFEST",
        "TOOL_RESULT",
        "EVIDENCE_PACK"
      ],
      "title": "M6UpgradePhysicalArtifactKind",
      "type": "string"
    },
    "M6UpgradePhysicalArtifactRef": {
      "additionalProperties": false,
      "description": "One resolver-addressable artifact with exact canonical/raw byte identity.",
      "properties": {
        "artifact_id": {
          "maxLength": 192,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_ref_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Artifact Ref Id",
          "type": "string"
        },
        "container_id": {
          "anyOf": [
            {
              "maxLength": 192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Id"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/M6UpgradePhysicalArtifactKind"
        },
        "schema_version": {
          "const": "m6-upgrade-physical-artifact-ref-v1",
          "default": "m6-upgrade-physical-artifact-ref-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 4294967296,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/M6UpgradePhysicalArtifactSource"
        }
      },
      "required": [
        "source",
        "kind",
        "artifact_id",
        "document_sha256",
        "content_sha256",
        "size_bytes",
        "artifact_ref_id"
      ],
      "title": "M6UpgradePhysicalArtifactRef",
      "type": "object"
    },
    "M6UpgradePhysicalArtifactSource": {
      "enum": [
        "M2_PERCEPTION",
        "M2_EVIDENCE",
        "M3_SCREENING_MODEL",
        "M4_HEARING_MODEL",
        "M4_ACQUISITION",
        "M5_PRECEDENT"
      ],
      "title": "M6UpgradePhysicalArtifactSource",
      "type": "string"
    },
    "ReproducibilityMode": {
      "enum": [
        "REPLAY_LOCKED",
        "REINFER_PINNED",
        "UPGRADE_REGRESSION"
      ],
      "title": "ReproducibilityMode",
      "type": "string"
    },
    "VerdictDecision": {
      "enum": [
        "ESTABLISHED",
        "NOT_ESTABLISHED",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "VerdictDecision",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m6-upgrade-candidate-sample-output-authority.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Complete evaluator-blind output authority for one execution entry.",
  "properties": {
    "artifact_count": {
      "readOnly": true,
      "title": "Artifact Count",
      "type": "integer"
    },
    "artifact_inventory_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Artifact Inventory Root Sha256",
      "type": "string"
    },
    "candidate_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Manifest Id",
      "type": "string"
    },
    "candidate_output_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Candidate Output Authority Id",
      "type": "string"
    },
    "candidate_run_cut_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Run Cut Authority Id",
      "type": "string"
    },
    "candidate_run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Candidate Run Id",
      "type": "string"
    },
    "candidate_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/M6CaseReplaySnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "candidate_snapshot_content_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "readOnly": true,
      "title": "Candidate Snapshot Content Sha256"
    },
    "command_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Command Id",
      "type": "string"
    },
    "detection_count": {
      "readOnly": true,
      "title": "Detection Count",
      "type": "integer"
    },
    "detection_inventory_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Detection Inventory Root Sha256",
      "type": "string"
    },
    "detections": {
      "default": [],
      "items": {
        "$ref": "#/$defs/M6UpgradePhysicalArtifactRef"
      },
      "maxItems": 20000,
      "title": "Detections",
      "type": "array"
    },
    "embedding_count": {
      "readOnly": true,
      "title": "Embedding Count",
      "type": "integer"
    },
    "embedding_inventory_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Embedding Inventory Root Sha256",
      "type": "string"
    },
    "embeddings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/M6UpgradePhysicalArtifactRef"
      },
      "maxItems": 20000,
      "title": "Embeddings",
      "type": "array"
    },
    "evidence_packs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/M6UpgradePhysicalArtifactRef"
      },
      "maxItems": 20000,
      "title": "Evidence Packs",
      "type": "array"
    },
    "execution_component_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Component Manifest Id",
      "type": "string"
    },
    "execution_dataset_snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Dataset Snapshot Id",
      "type": "string"
    },
    "execution_entry": {
      "$ref": "#/$defs/M6RegressionExecutionEntry"
    },
    "execution_entry_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Execution Entry Id",
      "type": "string"
    },
    "execution_receipt": {
      "$ref": "#/$defs/M6ReplayExecutionReceipt",
      "readOnly": true
    },
    "frames": {
      "default": [],
      "items": {
        "$ref": "#/$defs/M6UpgradePhysicalArtifactRef"
      },
      "maxItems": 20000,
      "title": "Frames",
      "type": "array"
    },
    "mode": {
      "const": "UPGRADE_REGRESSION",
      "default": "UPGRADE_REGRESSION",
      "title": "Mode",
      "type": "string"
    },
    "model_call_count": {
      "readOnly": true,
      "title": "Model Call Count",
      "type": "integer"
    },
    "model_call_inventory_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Model Call Inventory Root Sha256",
      "type": "string"
    },
    "model_calls": {
      "default": [],
