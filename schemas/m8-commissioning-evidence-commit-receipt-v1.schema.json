{
  "$defs": {
    "M8ActorAuthorityCommitReceiptV1": {
      "additionalProperties": false,
      "description": "Append receipt for one persisted actor authority revision.",
      "properties": {
        "authority": {
          "$ref": "#/$defs/M8ActorAuthorityV1"
        },
        "authority_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Authority Document Sha256",
          "type": "string"
        },
        "commit_receipt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Commit Receipt Id",
          "type": "string"
        },
        "prior_authority_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prior Authority Id"
        },
        "prior_document_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prior Document Sha256"
        },
        "repository_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Repository Manifest Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-actor-authority-commit-receipt-v1",
          "default": "m8-actor-authority-commit-receipt-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "authority",
        "repository_manifest_id",
        "authority_document_sha256",
        "commit_receipt_id"
      ],
      "title": "M8ActorAuthorityCommitReceiptV1",
      "type": "object"
    },
    "M8ActorAuthorityV1": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "LEADER"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "capabilities": {
                "const": [
                  "VIEW_GLOBAL_OVERVIEW",
                  "VIEW_MAJOR_EVENTS",
                  "VIEW_AUDIT"
                ]
              },
              "scope_kind": {
                "const": "CAMPUS_WIDE"
              },
              "scope_location_ids": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "SAFETY_OFFICER"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "allOf": [
              {
                "else": {
                  "properties": {
                    "scope_location_ids": {
                      "maxItems": 0
                    }
                  }
                },
                "if": {
                  "properties": {
                    "scope_kind": {
                      "const": "LOCATIONS"
                    }
                  },
                  "required": [
                    "scope_kind"
                  ]
                },
                "then": {
                  "properties": {
                    "scope_location_ids": {
                      "minItems": 1
                    }
                  }
                }
              }
            ],
            "properties": {
              "capabilities": {
                "const": [
                  "VIEW_GLOBAL_OVERVIEW",
                  "VIEW_MAJOR_EVENTS",
                  "VIEW_AUDIT",
                  "CONFIRM_CASE",
                  "REJECT_CASE",
                  "REQUEST_CASE_EVIDENCE",
                  "RETURN_CASE_TO_VERIFICATION",
                  "RESOLVE_CASE",
                  "RESOLVE_APPEAL",
                  "MANAGE_RULES"
                ]
              },
              "scope_kind": {
                "enum": [
                  "CAMPUS_WIDE",
                  "LOCATIONS"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "STUDENT"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "capabilities": {
                "const": [
                  "VIEW_OWN_CASE",
                  "SUBMIT_EXPLANATION",
                  "SUBMIT_APPEAL"
                ]
              },
              "scope_kind": {
                "const": "SELF_ONLY"
              },
              "scope_location_ids": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "OPERATIONS"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "allOf": [
              {
                "else": {
                  "properties": {
                    "scope_location_ids": {
                      "maxItems": 0
                    }
                  }
                },
                "if": {
                  "properties": {
                    "scope_kind": {
                      "const": "LOCATIONS"
                    }
                  },
                  "required": [
                    "scope_kind"
                  ]
                },
                "then": {
                  "properties": {
                    "scope_location_ids": {
                      "minItems": 1
                    }
                  }
                }
              }
            ],
            "properties": {
              "capabilities": {
                "const": [
                  "MANAGE_DEVICES",
                  "VIEW_DEVICE_HEALTH"
                ]
              },
              "scope_kind": {
                "enum": [
                  "CAMPUS_WIDE",
                  "LOCATIONS"
                ]
              }
            }
          }
        }
      ],
      "description": "Versioned actor role, scope, and derived capability authority.",
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "actor_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Actor Authority Id",
          "type": "string"
        },
        "actor_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Actor Id",
          "type": "string"
        },
        "authority_revision": {
          "exclusiveMinimum": 0,
          "title": "Authority Revision",
          "type": "integer"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/M8Capability"
          },
          "readOnly": true,
          "title": "Capabilities",
          "type": "array"
        },
        "identity_provider_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Identity Provider Id",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/M8ActorRole"
        },
        "schema_version": {
          "const": "m8-actor-authority-v1",
          "default": "m8-actor-authority-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_kind": {
          "$ref": "#/$defs/M8ActorScopeKind"
        },
        "scope_location_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Scope Location Ids",
          "type": "array"
        },
        "subject_binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Subject Binding Sha256",
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "role",
        "scope_kind",
        "identity_provider_id",
        "subject_binding_sha256",
        "authority_revision",
        "active",
        "manifest_id",
        "capabilities",
        "actor_authority_id"
      ],
      "title": "M8ActorAuthorityV1",
      "type": "object"
    },
    "M8ActorRole": {
      "enum": [
        "LEADER",
        "SAFETY_OFFICER",
        "STUDENT",
        "OPERATIONS"
      ],
      "title": "M8ActorRole",
      "type": "string"
    },
    "M8ActorScopeKind": {
      "enum": [
        "CAMPUS_WIDE",
        "LOCATIONS",
        "SELF_ONLY"
      ],
      "title": "M8ActorScopeKind",
      "type": "string"
    },
    "M8Capability": {
      "enum": [
        "VIEW_GLOBAL_OVERVIEW",
        "VIEW_MAJOR_EVENTS",
        "VIEW_AUDIT",
        "CONFIRM_CASE",
        "REJECT_CASE",
        "REQUEST_CASE_EVIDENCE",
        "RETURN_CASE_TO_VERIFICATION",
        "RESOLVE_CASE",
        "RESOLVE_APPEAL",
        "MANAGE_RULES",
        "VIEW_OWN_CASE",
        "SUBMIT_EXPLANATION",
        "SUBMIT_APPEAL",
        "MANAGE_DEVICES",
        "VIEW_DEVICE_HEALTH"
      ],
      "title": "M8Capability",
      "type": "string"
    },
    "M8CommissioningEvidenceAuthorityV1": {
      "additionalProperties": false,
      "description": "One human-attested evidence reference for an exact adapter candidate.",
      "properties": {
        "artifact_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Artifact Ref",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "artifact_size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 16777216,
          "title": "Artifact Size Bytes",
          "type": "integer"
        },
        "candidate": {
          "$ref": "#/$defs/M8ProductionAdapterCandidateAuthorityV1"
        },
        "evidence_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Evidence Authority Id",
          "type": "string"
        },
        "evidence_kind": {
          "$ref": "#/$defs/M8CommissioningEvidenceKind"
        },
        "evidence_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Manifest Id",
          "type": "string"
        },
        "human_attested": {
          "const": true,
          "default": true,
          "title": "Human Attested",
          "type": "boolean"
        },
        "model_generated": {
          "const": false,
          "default": false,
          "title": "Model Generated",
          "type": "boolean"
        },
        "outcome": {
          "$ref": "#/$defs/M8CommissioningEvidenceOutcome"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer_actor_receipt": {
          "$ref": "#/$defs/M8ActorAuthorityCommitReceiptV1"
        },
        "schema_version": {
          "const": "m8-commissioning-evidence-authority-v1",
          "default": "m8-commissioning-evidence-authority-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "simulated": {
          "title": "Simulated",
          "type": "boolean"
        },
        "valid_through": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Through"
        }
      },
      "required": [
        "candidate",
        "evidence_kind",
        "outcome",
        "artifact_ref",
        "artifact_sha256",
        "artifact_size_bytes",
        "reviewer_actor_receipt",
        "reviewed_at",
        "simulated",
        "evidence_manifest_id",
        "evidence_authority_id"
      ],
      "title": "M8CommissioningEvidenceAuthorityV1",
      "type": "object"
    },
    "M8CommissioningEvidenceKind": {
      "enum": [
        "LICENSE_REVIEW",
        "OFFLINE_FALLBACK_DRILL",
        "SAFETY_REVIEW",
        "SECURITY_REVIEW",
        "SITE_ACCEPTANCE"
      ],
      "title": "M8CommissioningEvidenceKind",
      "type": "string"
    },
    "M8CommissioningEvidenceOutcome": {
      "enum": [
        "FAILED",
        "PASSED"
      ],
      "title": "M8CommissioningEvidenceOutcome",
      "type": "string"
    },
    "M8ExternalIdempotencyKey": {
      "enum": [
        "BACKUP_GENERATION_ID",
        "EXPORT_BATCH_ID",
        "NOTIFICATION_ID",
        "REQUEST_ID",
        "SOURCE_SEQUENCE",
        "SUBJECT_ASSERTION_ID"
      ],
      "title": "M8ExternalIdempotencyKey",
      "type": "string"
    },
    "M8ProductionAdapterCandidateAuthorityV1": {
      "additionalProperties": false,
      "description": "A pinned external adapter candidate; it is never activation authority by itself.",
      "properties": {
        "adapter_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_kind": {
          "$ref": "#/$defs/M8ProductionAdapterKind"
        },
        "adapter_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Adapter Manifest Id",
          "type": "string"
        },
        "adapter_revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Adapter Revision",
          "type": "string"
        },
        "campus_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Campus Id",
          "type": "string"
        },
        "candidate_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Candidate Authority Id",
          "type": "string"
        },
        "cross_camera_reidentification_permitted": {
          "readOnly": true,
          "title": "Cross Camera Reidentification Permitted",
          "type": "boolean"
        },
        "declared_license_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Declared License Id",
          "type": "string"
        },
        "direct_disciplinary_action_permitted": {
          "readOnly": true,
          "title": "Direct Disciplinary Action Permitted",
          "type": "boolean"
        },
        "external_io_required": {
          "const": true,
          "default": true,
          "title": "External Io Required",
          "type": "boolean"
        },
        "face_recognition_permitted": {
          "readOnly": true,
          "title": "Face Recognition Permitted",
          "type": "boolean"
        },
        "idempotency_key": {
          "$ref": "#/$defs/M8ExternalIdempotencyKey"
        },
        "life_safety_action_permitted": {
          "readOnly": true,
          "title": "Life Safety Action Permitted",
          "type": "boolean"
        },
        "network_required": {
          "title": "Network Required",
          "type": "boolean"
        },
        "offline_fallback_adapter_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Offline Fallback Adapter Id",
          "type": "string"
        },
        "offline_fallback_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Offline Fallback Manifest Id",
          "type": "string"
        },
        "offline_fallback_revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Offline Fallback Revision",
          "type": "string"
        },
        "product_revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Product Revision",
          "type": "string"
        },
        "production_activation_permitted": {
          "readOnly": true,
          "title": "Production Activation Permitted",
          "type": "boolean"
        },
        "provider_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Provider Id",
          "type": "string"
        },
        "raw_receipt_required": {
          "const": true,
          "default": true,
          "title": "Raw Receipt Required",
          "type": "boolean"
        },
        "request_timeout_ms": {
          "exclusiveMinimum": 0,
          "maximum": 120000,
          "title": "Request Timeout Ms",
          "type": "integer"
        },
        "schema_version": {
          "const": "m8-production-adapter-candidate-authority-v1",
          "default": "m8-production-adapter-candidate-authority-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_kind": {
          "$ref": "#/$defs/M8ActorScopeKind"
        },
        "scope_location_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Scope Location Ids",
          "type": "array"
        },
        "secret_material_embedded": {
          "const": false,
          "default": false,
          "title": "Secret Material Embedded",
          "type": "boolean"
        }
      },
      "required": [
        "adapter_id",
        "adapter_revision",
        "adapter_kind",
        "provider_id",
        "product_revision",
        "campus_id",
        "scope_kind",
        "declared_license_id",
        "request_timeout_ms",
        "idempotency_key",
        "network_required",
        "offline_fallback_adapter_id",
        "offline_fallback_revision",
        "adapter_manifest_id",
        "offline_fallback_manifest_id",
        "production_activation_permitted",
        "life_safety_action_permitted",
        "direct_disciplinary_action_permitted",
        "face_recognition_permitted",
        "cross_camera_reidentification_permitted",
        "candidate_authority_id"
      ],
      "title": "M8ProductionAdapterCandidateAuthorityV1",
      "type": "object"
    },
    "M8ProductionAdapterKind": {
      "enum": [
        "DISASTER_RECOVERY",
        "EXTERNAL_NOTIFICATION",
        "OBSERVABILITY",
        "OIDC_IDENTITY",
        "PHYSICAL_SENSOR",
        "RTSP_CAMERA"
      ],
      "title": "M8ProductionAdapterKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-commissioning-evidence-commit-receipt-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Commit proof binding one evidence authority to persisted raw artifact bytes.",
  "properties": {
    "artifact_storage_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Storage Manifest Id",
      "type": "string"
    },
    "commit_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Commit Receipt Id",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/M8CommissioningEvidenceAuthorityV1"
    },
    "evidence_document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Evidence Document Sha256",
      "type": "string"
    },
    "repository_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Repository Manifest Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m8-commissioning-evidence-commit-receipt-v1",
      "default": "m8-commissioning-evidence-commit-receipt-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "evidence",
    "artifact_storage_manifest_id",
    "repository_manifest_id",
    "evidence_document_sha256",
    "commit_receipt_id"
  ],
  "title": "M8CommissioningEvidenceCommitReceiptV1",
  "type": "object"
}
