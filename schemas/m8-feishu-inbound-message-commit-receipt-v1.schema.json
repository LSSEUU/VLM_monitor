{
  "$defs": {
    "M8ActorScopeKind": {
      "enum": [
        "CAMPUS_WIDE",
        "LOCATIONS",
        "SELF_ONLY"
      ],
      "title": "M8ActorScopeKind",
      "type": "string"
    },
    "M8ExternalIdempotencyKey": {
      "enum": [
        "BACKUP_GENERATION_ID",
        "EXPORT_BATCH_ID",
        "NOTIFICATION_ID",
        "REQUEST_ID",
        "SOURCE_SEQUENCE",
        "SUBJECT_ASSERTION_ID"
      ],
      "title": "M8ExternalIdempotencyKey",
      "type": "string"
    },
    "M8FeishuAdapterProfileV1": {
      "additionalProperties": false,
      "description": "Pinned custom-app API profile that contains references, never Feishu secrets.",
      "properties": {
        "api_origin": {
          "const": "https://open.feishu.cn",
          "default": "https://open.feishu.cn",
          "title": "Api Origin",
          "type": "string"
        },
        "app_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "App Id Sha256",
          "type": "string"
        },
        "authentication_kind": {
          "const": "TENANT_ACCESS_TOKEN_INTERNAL",
          "default": "TENANT_ACCESS_TOKEN_INTERNAL",
          "title": "Authentication Kind",
          "type": "string"
        },
        "bot_capability_required": {
          "const": true,
          "default": true,
          "title": "Bot Capability Required",
          "type": "boolean"
        },
        "candidate": {
          "$ref": "#/$defs/M8ProductionAdapterCandidateAuthorityV1"
        },
        "credential_bundle_reference_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Credential Bundle Reference Id",
          "type": "string"
        },
        "external_call_permitted": {
          "const": false,
          "default": false,
          "title": "External Call Permitted",
          "type": "boolean"
        },
        "max_card_content_bytes": {
          "const": 30720,
          "default": 30720,
          "title": "Max Card Content Bytes",
          "type": "integer"
        },
        "message_path": {
          "const": "/open-apis/im/v1/messages",
          "default": "/open-apis/im/v1/messages",
          "title": "Message Path",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Manifest Id",
          "type": "string"
        },
        "provider_uuid_dedup_window_seconds": {
          "const": 3600,
          "default": 3600,
          "title": "Provider Uuid Dedup Window Seconds",
          "type": "integer"
        },
        "provider_uuid_max_characters": {
          "const": 50,
          "default": 50,
          "title": "Provider Uuid Max Characters",
          "type": "integer"
        },
        "published_app_version_required": {
          "const": true,
          "default": true,
          "title": "Published App Version Required",
          "type": "boolean"
        },
        "raw_response_required": {
          "const": true,
          "default": true,
          "title": "Raw Response Required",
          "type": "boolean"
        },
        "receive_id_type": {
          "const": "open_id",
          "default": "open_id",
          "title": "Receive Id Type",
          "type": "string"
        },
        "required_scope": {
          "const": "im:message:send_as_bot",
          "default": "im:message:send_as_bot",
          "title": "Required Scope",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-feishu-adapter-profile-v1",
          "default": "m8-feishu-adapter-profile-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "secret_material_embedded": {
          "const": false,
          "default": false,
          "title": "Secret Material Embedded",
          "type": "boolean"
        },
        "token_cache_required": {
          "const": true,
          "default": true,
          "title": "Token Cache Required",
          "type": "boolean"
        },
        "token_path": {
          "const": "/open-apis/auth/v3/tenant_access_token/internal",
          "default": "/open-apis/auth/v3/tenant_access_token/internal",
          "title": "Token Path",
          "type": "string"
        }
      },
      "required": [
        "candidate",
        "credential_bundle_reference_id",
        "app_id_sha256",
        "profile_manifest_id",
        "profile_id"
      ],
      "title": "M8FeishuAdapterProfileV1",
      "type": "object"
    },
    "M8FeishuInboundMessageVerificationReceiptV1": {
      "additionalProperties": false,
      "description": "Hash-only proof of one verified, decrypted, reply-shaped text event.",
      "properties": {
        "app_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "App Id Sha256",
          "type": "string"
        },
        "case_transition_permitted": {
          "readOnly": true,
          "title": "Case Transition Permitted",
          "type": "boolean"
        },
        "chat_type": {
          "const": "p2p",
          "default": "p2p",
          "title": "Chat Type",
          "type": "string"
        },
        "clear_message_content_embedded": {
          "readOnly": true,
          "title": "Clear Message Content Embedded",
          "type": "boolean"
        },
        "clear_sender_identifier_persisted": {
          "readOnly": true,
          "title": "Clear Sender Identifier Persisted",
          "type": "boolean"
        },
        "content_document_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Content Document Ref",
          "type": "string"
        },
        "content_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Document Sha256",
          "type": "string"
        },
        "content_size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 262144,
          "title": "Content Size Bytes",
          "type": "integer"
        },
        "decrypted_event_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Decrypted Event Ref",
          "type": "string"
        },
        "decrypted_event_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Decrypted Event Sha256",
          "type": "string"
        },
        "decrypted_event_size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 262144,
          "title": "Decrypted Event Size Bytes",
          "type": "integer"
        },
        "direct_disciplinary_action_permitted": {
          "readOnly": true,
          "title": "Direct Disciplinary Action Permitted",
          "type": "boolean"
        },
        "event_created_at": {
          "format": "date-time",
          "title": "Event Created At",
          "type": "string"
        },
        "event_schema": {
          "const": "2.0",
          "default": "2.0",
          "title": "Event Schema",
          "type": "string"
        },
        "event_type": {
          "const": "im.message.receive_v1",
          "default": "im.message.receive_v1",
          "title": "Event Type",
          "type": "string"
        },
        "ingress_request": {
          "$ref": "#/$defs/M8FeishuWebhookIngressRequestV1"
        },
        "message_created_at": {
          "format": "date-time",
          "title": "Message Created At",
          "type": "string"
        },
        "message_type": {
          "const": "text",
          "default": "text",
          "title": "Message Type",
          "type": "string"
        },
        "notification_reply_commit_permitted": {
          "readOnly": true,
          "title": "Notification Reply Commit Permitted",
          "type": "boolean"
        },
        "payload_decrypted": {
          "readOnly": true,
          "title": "Payload Decrypted",
          "type": "boolean"
        },
        "profile": {
          "$ref": "#/$defs/M8FeishuInboundWebhookProfileV1"
        },
        "provider_event_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Provider Event Id",
          "type": "string"
        },
        "provider_message_deduplication_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "readOnly": true,
          "title": "Provider Message Deduplication Key",
          "type": "string"
        },
        "provider_message_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Provider Message Id",
          "type": "string"
        },
        "provider_parent_message_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Provider Parent Message Id",
          "type": "string"
        },
        "provider_root_message_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Root Message Id"
        },
        "reply_correlation_message_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "readOnly": true,
          "title": "Reply Correlation Message Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-feishu-inbound-message-verification-receipt-v1",
          "default": "m8-feishu-inbound-message-verification-receipt-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sender_open_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sender Open Id Sha256",
          "type": "string"
        },
        "sender_type": {
          "const": "user",
          "default": "user",
          "title": "Sender Type",
          "type": "string"
        },
        "signature_verified": {
          "readOnly": true,
          "title": "Signature Verified",
          "type": "boolean"
        },
        "tenant_key_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tenant Key Sha256",
          "type": "string"
        },
        "verification_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Verification Manifest Id",
          "type": "string"
        },
        "verification_receipt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Verification Receipt Id",
          "type": "string"
        },
        "verification_token_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Verification Token Sha256",
          "type": "string"
        },
        "verification_token_verified": {
          "readOnly": true,
          "title": "Verification Token Verified",
          "type": "boolean"
        }
      },
      "required": [
        "profile",
        "ingress_request",
        "decrypted_event_ref",
        "decrypted_event_sha256",
        "decrypted_event_size_bytes",
        "provider_event_id",
        "provider_message_id",
        "provider_parent_message_id",
        "app_id_sha256",
        "tenant_key_sha256",
        "verification_token_sha256",
        "sender_open_id_sha256",
        "event_created_at",
        "message_created_at",
        "content_document_ref",
        "content_document_sha256",
        "content_size_bytes",
        "verification_manifest_id",
        "signature_verified",
        "payload_decrypted",
        "verification_token_verified",
        "provider_message_deduplication_key",
        "reply_correlation_message_id",
        "clear_message_content_embedded",
        "clear_sender_identifier_persisted",
        "notification_reply_commit_permitted",
        "case_transition_permitted",
        "direct_disciplinary_action_permitted",
        "verification_receipt_id"
      ],
      "title": "M8FeishuInboundMessageVerificationReceiptV1",
      "type": "object"
    },
    "M8FeishuInboundWebhookProfileV1": {
      "additionalProperties": false,
      "description": "Pinned encrypted webhook profile; never an external-ingress activation.",
      "properties": {
        "allowed_chat_type": {
          "const": "p2p",
          "default": "p2p",
          "title": "Allowed Chat Type",
          "type": "string"
        },
        "allowed_message_type": {
          "const": "text",
          "default": "text",
          "title": "Allowed Message Type",
          "type": "string"
        },
        "allowed_sender_type": {
          "const": "user",
          "default": "user",
          "title": "Allowed Sender Type",
          "type": "string"
        },
        "clear_sender_identifier_persisted": {
          "const": false,
          "default": false,
          "title": "Clear Sender Identifier Persisted",
          "type": "boolean"
        },
        "delivery_kind": {
          "const": "HTTPS_WEBHOOK",
          "default": "HTTPS_WEBHOOK",
          "title": "Delivery Kind",
          "type": "string"
        },
        "encrypt_key_reference_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Encrypt Key Reference Id",
          "type": "string"
        },
        "encrypt_key_required": {
          "const": true,
          "default": true,
          "title": "Encrypt Key Required",
          "type": "boolean"
        },
        "encrypt_key_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Encrypt Key Sha256",
          "type": "string"
        },
        "event_schema": {
          "const": "2.0",
          "default": "2.0",
          "title": "Event Schema",
          "type": "string"
        },
        "event_type": {
          "const": "im.message.receive_v1",
          "default": "im.message.receive_v1",
          "title": "Event Type",
          "type": "string"
        },
        "external_ingress_permitted": {
          "const": false,
          "default": false,
          "title": "External Ingress Permitted",
          "type": "boolean"
        },
        "inbound_profile_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Inbound Profile Id",
          "type": "string"
        },
        "message_id_deduplication_required": {
          "const": true,
          "default": true,
          "title": "Message Id Deduplication Required",
          "type": "boolean"
        },
        "outbound_profile": {
          "$ref": "#/$defs/M8FeishuAdapterProfileV1"
        },
        "profile_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Manifest Id",
          "type": "string"
        },
        "raw_body_max_bytes": {
          "const": 262144,
          "default": 262144,
          "title": "Raw Body Max Bytes",
          "type": "integer"
        },
        "request_signature_required": {
          "const": true,
          "default": true,
          "title": "Request Signature Required",
          "type": "boolean"
        },
        "request_timestamp_max_skew_seconds": {
          "const": 300,
          "default": 300,
          "title": "Request Timestamp Max Skew Seconds",
          "type": "integer"
        },
        "request_url_reference_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Request Url Reference Id",
          "type": "string"
        },
        "required_scope": {
          "const": "im:message.p2p_msg:readonly",
          "default": "im:message.p2p_msg:readonly",
          "title": "Required Scope",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-feishu-inbound-webhook-profile-v1",
          "default": "m8-feishu-inbound-webhook-profile-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "secret_material_embedded": {
          "const": false,
          "default": false,
          "title": "Secret Material Embedded",
          "type": "boolean"
        },
        "verification_token_reference_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Verification Token Reference Id",
          "type": "string"
        },
        "verification_token_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Verification Token Sha256",
          "type": "string"
        }
      },
      "required": [
        "outbound_profile",
        "request_url_reference_id",
        "encrypt_key_reference_id",
        "encrypt_key_sha256",
        "verification_token_reference_id",
        "verification_token_sha256",
        "profile_manifest_id",
        "inbound_profile_id"
      ],
      "title": "M8FeishuInboundWebhookProfileV1",
      "type": "object"
    },
    "M8FeishuWebhookIngressRequestV1": {
      "additionalProperties": false,
      "description": "Exact encrypted request evidence before any signature or payload claim.",
      "properties": {
        "business_event_accepted": {
          "readOnly": true,
          "title": "Business Event Accepted",
          "type": "boolean"
        },
        "credential_material_persisted": {
          "readOnly": true,
          "title": "Credential Material Persisted",
          "type": "boolean"
        },
        "encrypted_body_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Encrypted Body Ref",
          "type": "string"
        },
        "encrypted_body_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Encrypted Body Sha256",
          "type": "string"
        },
        "encrypted_body_size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 262144,
          "title": "Encrypted Body Size Bytes",
          "type": "integer"
        },
        "inbound_profile_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Inbound Profile Id",
          "type": "string"
        },
        "ingress_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ingress Manifest Id",
          "type": "string"
        },
        "ingress_request_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Ingress Request Id",
          "type": "string"
        },
        "payload_decrypted": {
          "readOnly": true,
          "title": "Payload Decrypted",
          "type": "boolean"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "request_nonce": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Request Nonce",
          "type": "string"
        },
        "request_signature": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Signature",
          "type": "string"
        },
        "request_timestamp_seconds": {
          "exclusiveMinimum": 0,
          "title": "Request Timestamp Seconds",
          "type": "integer"
        },
        "schema_version": {
          "const": "m8-feishu-webhook-ingress-request-v1",
          "default": "m8-feishu-webhook-ingress-request-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "signature_verified": {
          "readOnly": true,
          "title": "Signature Verified",
          "type": "boolean"
        }
      },
      "required": [
        "inbound_profile_id",
        "request_timestamp_seconds",
        "request_nonce",
        "request_signature",
        "encrypted_body_ref",
        "encrypted_body_sha256",
        "encrypted_body_size_bytes",
        "received_at",
        "ingress_manifest_id",
        "signature_verified",
        "payload_decrypted",
        "business_event_accepted",
        "credential_material_persisted",
        "ingress_request_id"
      ],
      "title": "M8FeishuWebhookIngressRequestV1",
      "type": "object"
    },
