{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "RUN",
        "FRAME",
        "SAFETY_SIGNAL",
        "EVENT",
        "CASE",
        "DETECTION",
        "OBJECTIVE_FACT",
        "CROP",
        "MEDIA",
        "EVIDENCE_PACK",
        "TOOL_RESULT",
        "MANIFEST",
        "MODEL_RESPONSE",
        "MODEL_REQUEST",
        "PROMPT_MANIFEST",
        "MODEL_PARSE_RECEIPT",
        "PARSED_MODEL_OUTPUT",
        "PROCEDURAL_REVIEW",
        "MODEL_CACHE_ENTRY",
        "SCREENING_RESULT",
        "VERDICT",
        "ALERT",
        "PRECEDENT",
        "APPEAL",
        "TRAINING_LABEL",
        "BACKLOG_ITEM",
        "DATASET"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A kind-discriminated reference with syntax fixed by the artifact kind.",
      "properties": {
        "artifact_id": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "HearingHumanReviewReason": {
      "enum": [
        "ACQUISITION_LIMIT_EXHAUSTED",
        "REWORK_LIMIT_EXHAUSTED",
        "HEARING_BUDGET_EXHAUSTED",
        "EVIDENCE_UNAVAILABLE",
        "ACQUISITION_UNRECOVERABLE",
        "HEARING_BACKLOG_EXHAUSTED"
      ],
      "title": "HearingHumanReviewReason",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/hearing-human-review-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Content-addressed authority for a bounded M4 transfer to human review.",
  "properties": {
    "acquisition_request_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "backlog_item_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "current_evidence_pack_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Current Evidence Pack Id",
      "type": "string"
    },
    "current_evidence_pack_version": {
      "exclusiveMinimum": 0,
      "title": "Current Evidence Pack Version",
      "type": "integer"
    },
    "hearing_session_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hearing Session Id",
      "type": "string"
    },
    "judge_cycle": {
      "exclusiveMinimum": 0,
      "maximum": 5,
      "title": "Judge Cycle",
      "type": "integer"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "procedural_review_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason": {
      "$ref": "#/$defs/HearingHumanReviewReason"
    },
    "receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Receipt Id",
      "type": "string"
    },
    "receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Receipt Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m4-hearing-human-review-receipt-v1",
      "default": "m4-hearing-human-review-receipt-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_checkpoint_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Checkpoint Id",
      "type": "string"
    },
    "source_checkpoint_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Checkpoint Sha256",
      "type": "string"
    },
    "source_checkpoint_version": {
      "exclusiveMinimum": 0,
      "title": "Source Checkpoint Version",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "hearing_session_id",
    "current_evidence_pack_id",
    "current_evidence_pack_version",
    "judge_cycle",
    "reason",
    "source_checkpoint_id",
    "source_checkpoint_sha256",
    "source_checkpoint_version",
    "manifest_id",
    "receipt_id",
    "receipt_sha256"
  ],
  "title": "HearingHumanReviewReceipt",
  "type": "object"
}
