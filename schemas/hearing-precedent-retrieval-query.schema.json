{
  "$defs": {
    "EvidenceClass": {
      "enum": [
        "PRESENCE",
        "ABSENCE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "ModelManifest": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "license_id": {
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Model Manifest Id",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "provider_revision_guarantee": {
          "default": true,
          "title": "Provider Revision Guarantee",
          "type": "boolean"
        },
        "quantization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantization"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "weights_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weights Sha256"
        }
      },
      "required": [
        "component",
        "provider",
        "model",
        "revision",
        "license_id",
        "model_manifest_id"
      ],
      "title": "ModelManifest",
      "type": "object"
    },
    "ViolationType": {
      "enum": [
        "PPE_GOGGLES_MISSING",
        "PPE_GLOVES_MISSING",
        "PPE_LAB_COAT_MISSING",
        "REAGENT_CONTAINER_OPEN",
        "FOOD_OR_DRINK_IN_LAB",
        "SINGLE_PERSON_HAZARDOUS_OPERATION",
        "FUME_HOOD_SASH_TOO_HIGH",
        "UNATTENDED_HEATING",
        "SMOKE_ABNORMAL",
        "OPEN_FLAME"
      ],
      "title": "ViolationType",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/hearing-precedent-retrieval-query.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Content-addressed M4 query bound to every current retrieval authority.",
  "properties": {
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "current_evidence_pack_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Current Evidence Pack Id",
      "type": "string"
    },
    "current_evidence_pack_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Current Evidence Pack Sha256",
      "type": "string"
    },
    "current_evidence_pack_version": {
      "exclusiveMinimum": 0,
      "title": "Current Evidence Pack Version",
      "type": "integer"
    },
    "cycle_scope_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cycle Scope Id",
      "type": "string"
    },
    "cycle_scope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cycle Scope Sha256",
      "type": "string"
    },
    "embedding_model_manifest": {
      "$ref": "#/$defs/ModelManifest"
    },
    "evidence_class": {
      "$ref": "#/$defs/EvidenceClass"
    },
    "hearing_session_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hearing Session Id",
      "type": "string"
    },
    "hearing_session_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hearing Session Sha256",
      "type": "string"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "query_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Query Id",
      "type": "string"
    },
    "query_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Query Sha256",
      "type": "string"
    },
    "retriever_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Retriever Manifest Id",
      "type": "string"
    },
    "retriever_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Retriever Version",
      "type": "string"
    },
    "rule_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Rule Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m4-hearing-precedent-query-v1",
      "default": "m4-hearing-precedent-query-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "situation_text": {
      "maxLength": 16384,
      "minLength": 1,
      "title": "Situation Text",
      "type": "string"
    },
    "top_k": {
      "exclusiveMinimum": 0,
      "maximum": 64,
      "title": "Top K",
      "type": "integer"
    },
    "violation_type": {
      "$ref": "#/$defs/ViolationType"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "hearing_session_id",
    "hearing_session_sha256",
    "cycle_scope_id",
    "cycle_scope_sha256",
    "current_evidence_pack_id",
    "current_evidence_pack_version",
    "current_evidence_pack_sha256",
    "evidence_class",
    "violation_type",
    "rule_version",
    "situation_text",
    "top_k",
    "config_sha256",
    "retriever_version",
    "retriever_manifest_id",
    "embedding_model_manifest",
    "manifest_id",
    "query_id",
    "query_sha256"
  ],
  "title": "HearingPrecedentRetrievalQuery",
  "type": "object"
}
