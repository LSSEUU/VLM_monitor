{
  "$defs": {
    "M8NotificationConversationActionKind": {
      "enum": [
        "SUBMIT_EXPLANATION",
        "SUBMIT_APPEAL",
        "RETRY_APPEAL",
        "RESOLVE_APPEAL_UPHELD",
        "RESOLVE_APPEAL_OVERTURNED",
        "SEND_CASE_UPDATE",
        "SEND_APPEAL_OUTCOME",
        "ACKNOWLEDGE_OUTCOME"
      ],
      "title": "M8NotificationConversationActionKind",
      "type": "string"
    },
    "M8NotificationConversationActionV1": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/M8NotificationConversationActionKind"
        },
        "current_case_version": {
          "exclusiveMinimum": 0,
          "title": "Current Case Version",
          "type": "integer"
        },
        "requires_confirmation": {
          "const": true,
          "default": true,
          "title": "Requires Confirmation",
          "type": "boolean"
        },
        "supporting_authority_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supporting Authority Id"
        },
        "supporting_document_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supporting Document Sha256"
        },
        "target_notification_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Notification Id"
        }
      },
      "required": [
        "action",
        "current_case_version"
      ],
      "title": "M8NotificationConversationActionV1",
      "type": "object"
    },
    "M8NotificationConversationEventKind": {
      "enum": [
        "NOTIFICATION",
        "STUDENT_EXPLANATION",
        "STUDENT_APPEAL",
        "SAFETY_DECISION",
        "OUTCOME_NOTIFICATION",
        "STUDENT_ACKNOWLEDGEMENT"
      ],
      "title": "M8NotificationConversationEventKind",
      "type": "string"
    },
    "M8NotificationConversationEventV1": {
      "additionalProperties": false,
      "properties": {
        "authority_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Authority Id",
          "type": "string"
        },
        "body": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "event_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Event Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/M8NotificationConversationEventKind"
        },
        "notification_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notification Id"
        },
        "occurred_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurred At"
        },
        "sender": {
          "enum": [
            "SYSTEM",
            "STUDENT",
            "SAFETY_OFFICER"
          ],
          "title": "Sender",
          "type": "string"
        },
        "sequence": {
          "exclusiveMinimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "status": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "technical": {
          "anyOf": [
            {
              "$ref": "#/$defs/M8NotificationConversationTechnicalV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "sequence",
        "kind",
        "sender",
        "title",
        "authority_id",
        "status"
      ],
      "title": "M8NotificationConversationEventV1",
      "type": "object"
    },
    "M8NotificationConversationSummaryV1": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "case_status": {
          "$ref": "#/$defs/M8OperationalCaseStatus"
        },
        "case_version": {
          "exclusiveMinimum": 0,
          "title": "Case Version",
          "type": "integer"
        },
        "fake_delivery": {
          "const": true,
          "default": true,
          "title": "Fake Delivery",
          "type": "boolean"
        },
        "last_activity_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Activity At"
        },
        "latest_progress": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Latest Progress",
          "type": "string"
        },
        "latest_title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Latest Title",
          "type": "string"
        },
        "location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Location Id",
          "type": "string"
        },
        "notification_count": {
          "minimum": 0,
          "title": "Notification Count",
          "type": "integer"
        },
        "pending_actor_role": {
          "enum": [
            "STUDENT",
            "SAFETY_OFFICER",
            "NONE"
          ],
          "title": "Pending Actor Role",
          "type": "string"
        },
        "reply_count": {
          "minimum": 0,
          "title": "Reply Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "m8-notification-conversation-summary-v1",
          "default": "m8-notification-conversation-summary-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "case_status",
        "case_version",
        "location_id",
        "notification_count",
        "reply_count",
        "latest_title",
        "latest_progress",
        "pending_actor_role"
      ],
      "title": "M8NotificationConversationSummaryV1",
      "type": "object"
    },
    "M8NotificationConversationTechnicalV1": {
      "additionalProperties": false,
      "properties": {
        "authority_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Authority Ref",
          "type": "string"
        },
        "channel": {
          "const": "LOCAL_OFFLINE_FAKE",
          "default": "LOCAL_OFFLINE_FAKE",
          "title": "Channel",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "real_delivery_confirmed": {
          "const": false,
          "default": false,
          "title": "Real Delivery Confirmed",
          "type": "boolean"
        },
        "simulated": {
          "const": true,
          "default": true,
          "title": "Simulated",
          "type": "boolean"
        }
      },
      "required": [
        "authority_ref",
        "document_sha256"
      ],
      "title": "M8NotificationConversationTechnicalV1",
      "type": "object"
    },
    "M8OperationalCaseStatus": {
      "enum": [
        "PENDING_VERIFICATION",
        "CONFIRMED",
        "REJECTED",
        "EVIDENCE_REQUESTED",
        "RESOLVED",
        "APPEALED",
        "APPEAL_RESOLVED"
      ],
      "title": "M8OperationalCaseStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-notification-conversation-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/M8NotificationConversationActionV1"
      },
      "maxItems": 16,
      "title": "Actions",
      "type": "array"
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "case_status": {
      "$ref": "#/$defs/M8OperationalCaseStatus"
    },
    "case_version": {
      "exclusiveMinimum": 0,
      "title": "Case Version",
      "type": "integer"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/M8NotificationConversationEventV1"
      },
      "maxItems": 256,
      "title": "Events",
      "type": "array"
    },
    "location_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Location Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m8-notification-conversation-v1",
      "default": "m8-notification-conversation-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/M8NotificationConversationSummaryV1"
    }
  },
  "required": [
    "case_id",
    "case_status",
    "case_version",
    "location_id",
    "summary",
    "events",
    "actions"
  ],
  "title": "M8NotificationConversationV1",
  "type": "object"
}
