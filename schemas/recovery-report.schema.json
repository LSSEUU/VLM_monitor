{
  "$defs": {
    "RecoveryArea": {
      "description": "The two fixed workspace locations eligible for M2 startup recovery.",
      "enum": [
        "STAGING",
        "FINAL_MEDIA"
      ],
      "title": "RecoveryArea",
      "type": "string"
    },
    "RecoveryDisposition": {
      "enum": [
        "QUARANTINED",
        "CLEANED",
        "RETAINED",
        "ANOMALY"
      ],
      "title": "RecoveryDisposition",
      "type": "string"
    },
    "RecoveryItemResult": {
      "additionalProperties": false,
      "description": "One stable recovery decision without host paths or artifact bytes.",
      "properties": {
        "area": {
          "$ref": "#/$defs/RecoveryArea"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "disposition": {
          "$ref": "#/$defs/RecoveryDisposition"
        },
        "quarantine_relative_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quarantine Relative Path"
        },
        "reason_code": {
          "$ref": "#/$defs/RecoveryReasonCode"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "source_token": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Token",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "area",
        "source_token",
        "disposition",
        "reason_code"
      ],
      "title": "RecoveryItemResult",
      "type": "object"
    },
    "RecoveryReasonCode": {
      "enum": [
        "STAGING_QUARANTINED",
        "ORPHAN_QUARANTINED",
        "EMPTY_STAGING_CLEANED",
        "REFERENCED_MEDIA",
        "MINIMUM_AGE_NOT_MET",
        "UNKNOWN_ENTRY_SHAPE",
        "UNSAFE_FILESYSTEM_ENTRY",
        "CONTENT_IDENTITY_MISMATCH",
        "ENTRY_CHANGED_DURING_RECOVERY",
        "DEPTH_LIMIT_REACHED"
      ],
      "title": "RecoveryReasonCode",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/recovery-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded run-scoped startup-recovery report in stable item order.",
  "properties": {
    "items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RecoveryItemResult"
      },
      "title": "Items",
      "type": "array"
    },
    "not_modified_after": {
      "format": "date-time",
      "title": "Not Modified After",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "not_modified_after"
  ],
  "title": "RecoveryReport",
  "type": "object"
}
