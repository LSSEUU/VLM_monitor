{
  "$defs": {
    "M6StaticReportEvidenceDisposition": {
      "enum": [
        "PRIVACY_PROCESSED_AVAILABLE",
        "RETENTION_PURGED",
        "NOT_PUBLISHED"
      ],
      "title": "M6StaticReportEvidenceDisposition",
      "type": "string"
    },
    "M6StaticReportEvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "artifact_content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Content Sha256"
        },
        "artifact_relative_path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Relative Path"
        },
        "deletion_audit_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deletion Audit Id"
        },
        "disposition": {
          "$ref": "#/$defs/M6StaticReportEvidenceDisposition"
        },
        "evidence_item_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Evidence Item Id",
          "type": "string"
        },
        "retention_reason_code": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retention Reason Code"
        },
        "sample_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Sample Id",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "disposition",
        "evidence_item_id"
      ],
      "title": "M6StaticReportEvidenceItem",
      "type": "object"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m6-privacy-safe-static-report-manifest-authority-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Candidate Run Id",
      "type": "string"
    },
    "classification": {
      "const": "SYNTHETIC_PRECOMPUTED_FAKE",
      "default": "SYNTHETIC_PRECOMPUTED_FAKE",
      "title": "Classification",
      "type": "string"
    },
    "evidence_inventory_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Evidence Inventory Root Sha256",
      "type": "string"
    },
    "evidence_item_count": {
      "readOnly": true,
      "title": "Evidence Item Count",
      "type": "integer"
    },
    "evidence_items": {
      "items": {
        "$ref": "#/$defs/M6StaticReportEvidenceItem"
      },
      "maxItems": 100000,
      "minItems": 1,
      "title": "Evidence Items",
      "type": "array"
    },
    "external_resources_included": {
      "const": false,
      "default": false,
      "title": "External Resources Included",
      "type": "boolean"
    },
    "hidden_reasoning_included": {
      "const": false,
      "default": false,
      "title": "Hidden Reasoning Included",
      "type": "boolean"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Manifest Id",
      "type": "string"
    },
    "publication_seal_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Publication Seal Id",
      "type": "string"
    },
    "raw_media_included": {
      "const": false,
      "default": false,
      "title": "Raw Media Included",
      "type": "boolean"
    },
    "report_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m6-privacy-safe-static-report-manifest-authority-v1",
      "default": "m6-privacy-safe-static-report-manifest-authority-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "publication_seal_id",
    "candidate_run_id",
    "evidence_items",
    "evidence_item_count",
    "evidence_inventory_root_sha256",
    "manifest_id"
  ],
  "title": "M6PrivacySafeStaticReportManifestAuthorityV1",
  "type": "object"
}
