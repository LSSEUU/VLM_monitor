{
  "$id": "https://schemas.labcourt.local/v2/m5-appeal-window-snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "appeal_ids": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Appeal Ids",
      "type": "array"
    },
    "complete": {
      "const": true,
      "default": true,
      "title": "Complete",
      "type": "boolean"
    },
    "observed_through": {
      "format": "date-time",
      "title": "Observed Through",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m5-appeal-window-snapshot-v1",
      "default": "m5-appeal-window-snapshot-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_case_document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Case Document Sha256",
      "type": "string"
    },
    "source_case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Source Case Id",
      "type": "string"
    },
    "source_case_revision": {
      "exclusiveMinimum": 0,
      "title": "Source Case Revision",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "source_case_id",
    "source_case_revision",
    "source_case_document_sha256",
    "observed_through",
    "snapshot_id"
  ],
  "title": "M5AppealWindowSnapshot",
  "type": "object"
}
