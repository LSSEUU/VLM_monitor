{
  "$defs": {
    "M8ActorScopeKind": {
      "enum": [
        "CAMPUS_WIDE",
        "LOCATIONS",
        "SELF_ONLY"
      ],
      "title": "M8ActorScopeKind",
      "type": "string"
    },
    "M8ExternalIdempotencyKey": {
      "enum": [
        "BACKUP_GENERATION_ID",
        "EXPORT_BATCH_ID",
        "NOTIFICATION_ID",
        "REQUEST_ID",
        "SOURCE_SEQUENCE",
        "SUBJECT_ASSERTION_ID"
      ],
      "title": "M8ExternalIdempotencyKey",
      "type": "string"
    },
    "M8ProductionAdapterCandidateAuthorityV1": {
      "additionalProperties": false,
      "description": "A pinned external adapter candidate; it is never activation authority by itself.",
      "properties": {
        "adapter_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_kind": {
          "$ref": "#/$defs/M8ProductionAdapterKind"
        },
        "adapter_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Adapter Manifest Id",
          "type": "string"
        },
        "adapter_revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Adapter Revision",
          "type": "string"
        },
        "campus_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Campus Id",
          "type": "string"
        },
        "candidate_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Candidate Authority Id",
          "type": "string"
        },
        "cross_camera_reidentification_permitted": {
          "readOnly": true,
          "title": "Cross Camera Reidentification Permitted",
          "type": "boolean"
        },
        "declared_license_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Declared License Id",
          "type": "string"
        },
        "direct_disciplinary_action_permitted": {
          "readOnly": true,
          "title": "Direct Disciplinary Action Permitted",
          "type": "boolean"
        },
        "external_io_required": {
          "const": true,
          "default": true,
          "title": "External Io Required",
          "type": "boolean"
        },
        "face_recognition_permitted": {
          "readOnly": true,
          "title": "Face Recognition Permitted",
          "type": "boolean"
        },
        "idempotency_key": {
          "$ref": "#/$defs/M8ExternalIdempotencyKey"
        },
        "life_safety_action_permitted": {
          "readOnly": true,
          "title": "Life Safety Action Permitted",
          "type": "boolean"
        },
        "network_required": {
          "title": "Network Required",
          "type": "boolean"
        },
        "offline_fallback_adapter_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Offline Fallback Adapter Id",
          "type": "string"
        },
        "offline_fallback_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Offline Fallback Manifest Id",
          "type": "string"
        },
        "offline_fallback_revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Offline Fallback Revision",
          "type": "string"
        },
        "product_revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Product Revision",
          "type": "string"
        },
        "production_activation_permitted": {
          "readOnly": true,
          "title": "Production Activation Permitted",
          "type": "boolean"
        },
        "provider_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Provider Id",
          "type": "string"
        },
        "raw_receipt_required": {
          "const": true,
          "default": true,
          "title": "Raw Receipt Required",
          "type": "boolean"
        },
        "request_timeout_ms": {
          "exclusiveMinimum": 0,
          "maximum": 120000,
          "title": "Request Timeout Ms",
          "type": "integer"
        },
        "schema_version": {
          "const": "m8-production-adapter-candidate-authority-v1",
          "default": "m8-production-adapter-candidate-authority-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_kind": {
          "$ref": "#/$defs/M8ActorScopeKind"
        },
        "scope_location_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Scope Location Ids",
          "type": "array"
        },
        "secret_material_embedded": {
          "const": false,
          "default": false,
          "title": "Secret Material Embedded",
          "type": "boolean"
        }
      },
      "required": [
        "adapter_id",
        "adapter_revision",
        "adapter_kind",
        "provider_id",
        "product_revision",
        "campus_id",
        "scope_kind",
        "declared_license_id",
        "request_timeout_ms",
        "idempotency_key",
        "network_required",
        "offline_fallback_adapter_id",
        "offline_fallback_revision",
        "adapter_manifest_id",
        "offline_fallback_manifest_id",
        "production_activation_permitted",
        "life_safety_action_permitted",
        "direct_disciplinary_action_permitted",
        "face_recognition_permitted",
        "cross_camera_reidentification_permitted",
        "candidate_authority_id"
      ],
      "title": "M8ProductionAdapterCandidateAuthorityV1",
      "type": "object"
    },
    "M8ProductionAdapterKind": {
      "enum": [
        "DISASTER_RECOVERY",
        "EXTERNAL_NOTIFICATION",
        "OBSERVABILITY",
        "OIDC_IDENTITY",
        "PHYSICAL_SENSOR",
        "RTSP_CAMERA"
      ],
      "title": "M8ProductionAdapterKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-feishu-adapter-profile-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Pinned custom-app API profile that contains references, never Feishu secrets.",
  "properties": {
    "api_origin": {
      "const": "https://open.feishu.cn",
      "default": "https://open.feishu.cn",
      "title": "Api Origin",
      "type": "string"
    },
    "app_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "App Id Sha256",
      "type": "string"
    },
    "authentication_kind": {
      "const": "TENANT_ACCESS_TOKEN_INTERNAL",
      "default": "TENANT_ACCESS_TOKEN_INTERNAL",
      "title": "Authentication Kind",
      "type": "string"
    },
    "bot_capability_required": {
      "const": true,
      "default": true,
      "title": "Bot Capability Required",
      "type": "boolean"
    },
    "candidate": {
      "$ref": "#/$defs/M8ProductionAdapterCandidateAuthorityV1"
    },
    "credential_bundle_reference_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Credential Bundle Reference Id",
      "type": "string"
    },
    "external_call_permitted": {
      "const": false,
      "default": false,
      "title": "External Call Permitted",
      "type": "boolean"
    },
    "max_card_content_bytes": {
      "const": 30720,
      "default": 30720,
      "title": "Max Card Content Bytes",
      "type": "integer"
    },
    "message_path": {
      "const": "/open-apis/im/v1/messages",
      "default": "/open-apis/im/v1/messages",
      "title": "Message Path",
      "type": "string"
    },
    "profile_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Profile Id",
      "type": "string"
    },
    "profile_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Manifest Id",
      "type": "string"
    },
    "provider_uuid_dedup_window_seconds": {
      "const": 3600,
      "default": 3600,
      "title": "Provider Uuid Dedup Window Seconds",
      "type": "integer"
    },
    "provider_uuid_max_characters": {
      "const": 50,
      "default": 50,
      "title": "Provider Uuid Max Characters",
      "type": "integer"
    },
    "published_app_version_required": {
      "const": true,
      "default": true,
      "title": "Published App Version Required",
      "type": "boolean"
    },
    "raw_response_required": {
      "const": true,
      "default": true,
      "title": "Raw Response Required",
      "type": "boolean"
    },
    "receive_id_type": {
      "const": "open_id",
      "default": "open_id",
      "title": "Receive Id Type",
      "type": "string"
    },
    "required_scope": {
      "const": "im:message:send_as_bot",
      "default": "im:message:send_as_bot",
      "title": "Required Scope",
      "type": "string"
    },
    "schema_version": {
      "const": "m8-feishu-adapter-profile-v1",
      "default": "m8-feishu-adapter-profile-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "secret_material_embedded": {
      "const": false,
      "default": false,
      "title": "Secret Material Embedded",
      "type": "boolean"
    },
    "token_cache_required": {
      "const": true,
      "default": true,
      "title": "Token Cache Required",
      "type": "boolean"
    },
    "token_path": {
      "const": "/open-apis/auth/v3/tenant_access_token/internal",
      "default": "/open-apis/auth/v3/tenant_access_token/internal",
      "title": "Token Path",
      "type": "string"
    }
  },
  "required": [
    "candidate",
    "credential_bundle_reference_id",
    "app_id_sha256",
    "profile_manifest_id",
    "profile_id"
  ],
  "title": "M8FeishuAdapterProfileV1",
  "type": "object"
}
