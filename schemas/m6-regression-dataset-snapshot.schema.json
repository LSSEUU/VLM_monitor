{
  "$defs": {
    "AlertLevel": {
      "enum": [
        "ADVISORY",
        "CONFIRMED",
        "EMERGENCY"
      ],
      "title": "AlertLevel",
      "type": "string"
    },
    "AppealStatus": {
      "enum": [
        "SUBMITTED",
        "UNDER_REVIEW",
        "UPHELD",
        "OVERTURNED"
      ],
      "title": "AppealStatus",
      "type": "string"
    },
    "CaseStatus": {
      "enum": [
        "CANDIDATE",
        "EVIDENCE_READY",
        "SCREENED",
        "ESCALATED",
        "DELIBERATING",
        "PROCEDURAL_REVIEW",
        "READY_FOR_ALERT_POLICY",
        "REWORK_REQUIRED",
        "HUMAN_REVIEW",
        "BACKLOGGED",
        "CLOSED",
        "APPEALED",
        "APPEAL_RESOLVED"
      ],
      "title": "CaseStatus",
      "type": "string"
    },
    "M6BaselineAuthorityKind": {
      "enum": [
        "MACHINE_TERMINAL_CASE",
        "PRE_APPEAL_CLOSED_CASE",
        "CHALLENGE_NO_CASE"
      ],
      "title": "M6BaselineAuthorityKind",
      "type": "string"
    },
    "M6CaseReplaySnapshot": {
      "additionalProperties": false,
      "description": "One replayed Case semantic projection without operational identity noise.",
      "properties": {
        "case_status": {
          "$ref": "#/$defs/CaseStatus"
        },
        "final_decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerdictDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "highest_alert_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlertLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "projection_version": {
          "const": "m6-semantic-case-v1",
          "default": "m6-semantic-case-v1",
          "title": "Projection Version",
          "type": "string"
        },
        "sample_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Sample Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m6-case-replay-snapshot-v1",
          "default": "m6-case-replay-snapshot-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_case_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Semantic Case Hash",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_case_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Case Document Sha256",
          "type": "string"
        },
        "source_case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Source Case Id",
          "type": "string"
        },
        "source_case_revision": {
          "exclusiveMinimum": 0,
          "title": "Source Case Revision",
          "type": "integer"
        },
        "source_run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Source Run Id",
          "type": "string"
        },
        "stage_roots": {
          "items": {
            "$ref": "#/$defs/M6SemanticStageRoot"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Stage Roots",
          "type": "array"
        },
        "terminal_appeal_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppealStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "sample_id",
        "source_run_id",
        "source_case_id",
        "source_case_revision",
        "source_case_document_sha256",
        "manifest_id",
        "stage_roots",
        "case_status",
        "semantic_case_hash",
        "snapshot_id"
      ],
      "title": "M6CaseReplaySnapshot",
      "type": "object"
    },
    "M6ChallengeKind": {
      "enum": [
        "DIFFICULT_NEGATIVE",
        "INSUFFICIENT_OBSERVATION",
        "DON_AFTER_THRESHOLD",
        "OCCLUSION",
        "DETECTOR_MISS",
        "FABRICATED_REFERENCE",
        "OBJECTIVE_CONFLICT",
        "PROVIDER_OUTAGE",
        "PRECEDENT_MISMATCH",
        "HARD_SIGNAL_UNCERTIFIED"
      ],
      "title": "M6ChallengeKind",
      "type": "string"
    },
    "M6GoldTruthAuthority": {
      "additionalProperties": false,
      "properties": {
        "authority_kind": {
          "$ref": "#/$defs/M6GoldTruthAuthorityKind"
        },
        "baseline_snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Baseline Snapshot Id",
          "type": "string"
        },
        "baseline_source_case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Baseline Source Case Id",
          "type": "string"
        },
        "baseline_source_case_revision": {
          "exclusiveMinimum": 0,
          "title": "Baseline Source Case Revision",
          "type": "integer"
        },
        "baseline_source_run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Baseline Source Run Id",
          "type": "string"
        },
        "decision_authority_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Decision Authority Document Sha256",
          "type": "string"
        },
        "decision_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Decision Authority Id",
          "type": "string"
        },
        "expected_decision": {
          "$ref": "#/$defs/VerdictDecision"
        },
        "resolution_commit_document_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Commit Document Sha256"
        },
        "resolution_commit_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Commit Id"
        },
        "sample_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Sample Id",
          "type": "string"
        },
        "truth_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Truth Id",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "baseline_snapshot_id",
        "baseline_source_run_id",
        "baseline_source_case_id",
        "baseline_source_case_revision",
        "authority_kind",
        "decision_authority_id",
        "decision_authority_document_sha256",
        "expected_decision",
        "truth_id"
      ],
      "title": "M6GoldTruthAuthority",
      "type": "object"
    },
    "M6GoldTruthAuthorityKind": {
      "enum": [
        "APPEAL_RESOLUTION",
        "HUMAN_REVIEW",
        "PRESET_GOLD"
      ],
      "title": "M6GoldTruthAuthorityKind",
      "type": "string"
    },
    "M6RegressionDatasetEntry": {
      "additionalProperties": false,
      "properties": {
        "baseline_authority_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Baseline Authority Document Sha256",
          "type": "string"
        },
        "baseline_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Baseline Authority Id",
          "type": "string"
        },
        "baseline_authority_kind": {
          "$ref": "#/$defs/M6BaselineAuthorityKind"
        },
        "baseline_snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/M6CaseReplaySnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "challenge_kinds": {
          "default": [],
          "items": {
            "$ref": "#/$defs/M6ChallengeKind"
          },
          "maxItems": 10,
          "title": "Challenge Kinds",
          "type": "array"
        },
        "entry_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Entry Id",
          "type": "string"
        },
        "gold_truth": {
          "anyOf": [
            {
              "$ref": "#/$defs/M6GoldTruthAuthority"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_authority_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Authority Document Sha256",
          "type": "string"
        },
        "input_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Authority Id",
          "type": "string"
        },
        "memberships": {
          "items": {
            "$ref": "#/$defs/M6RegressionDatasetKind"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Memberships",
          "type": "array"
        },
        "replay_input_closure_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Replay Input Closure Authority Id",
          "type": "string"
        },
        "replay_input_closure_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Replay Input Closure Document Sha256",
          "type": "string"
        },
        "sample_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Sample Id",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "input_authority_id",
        "input_authority_document_sha256",
        "replay_input_closure_authority_id",
        "replay_input_closure_document_sha256",
        "baseline_authority_kind",
        "baseline_authority_id",
        "baseline_authority_document_sha256",
        "memberships",
        "entry_id"
      ],
      "title": "M6RegressionDatasetEntry",
      "type": "object"
    },
    "M6RegressionDatasetKind": {
      "enum": [
        "STABILITY",
        "GOLD",
        "CHALLENGE"
      ],
      "title": "M6RegressionDatasetKind",
      "type": "string"
    },
    "M6RegressionExecutionDatasetSnapshot": {
      "additionalProperties": false,
      "description": "Candidate-facing dataset projection with evaluator truth intentionally absent.",
      "properties": {
        "baseline_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Baseline Manifest Id",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/M6RegressionExecutionEntry"
          },
          "maxItems": 100000,
          "minItems": 1,
          "title": "Entries",
          "type": "array"
        },
        "entry_count": {
          "readOnly": true,
          "title": "Entry Count",
          "type": "integer"
        },
        "execution_dataset_snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Execution Dataset Snapshot Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m6-regression-execution-dataset-v1",
          "default": "m6-regression-execution-dataset-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_catalog_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Catalog Authority Id",
          "type": "string"
        },
        "source_catalog_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Catalog Document Sha256",
          "type": "string"
        }
      },
      "required": [
        "baseline_manifest_id",
        "source_catalog_authority_id",
        "source_catalog_document_sha256",
        "entries",
        "entry_count",
        "execution_dataset_snapshot_id"
      ],
      "title": "M6RegressionExecutionDatasetSnapshot",
      "type": "object"
    },
    "M6RegressionExecutionEntry": {
      "additionalProperties": false,
      "description": "Blinded candidate input; it contains no membership or expected decision.",
      "properties": {
        "execution_entry_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Execution Entry Id",
          "type": "string"
        },
        "input_authority_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Authority Document Sha256",
          "type": "string"
        },
        "input_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Authority Id",
          "type": "string"
        },
        "replay_input_closure_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Replay Input Closure Authority Id",
          "type": "string"
        },
        "replay_input_closure_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Replay Input Closure Document Sha256",
          "type": "string"
        },
        "sample_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Sample Id",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "input_authority_id",
        "input_authority_document_sha256",
        "replay_input_closure_authority_id",
        "replay_input_closure_document_sha256",
        "execution_entry_id"
      ],
      "title": "M6RegressionExecutionEntry",
      "type": "object"
    },
    "M6RegressionStage": {
      "enum": [
        "PERCEPTION",
        "SCREENING",
        "RETRIEVAL",
        "HEARING",
        "GATE",
        "POLICY"
      ],
      "title": "M6RegressionStage",
      "type": "string"
    },
    "M6SemanticStageRoot": {
      "additionalProperties": false,
      "properties": {
        "projection_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Projection Sha256",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/M6RegressionStage"
        }
      },
      "required": [
        "stage",
        "projection_sha256"
      ],
      "title": "M6SemanticStageRoot",
      "type": "object"
    },
    "VerdictDecision": {
      "enum": [
        "ESTABLISHED",
        "NOT_ESTABLISHED",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "VerdictDecision",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m6-regression-dataset-snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Baseline Manifest Id",
      "type": "string"
    },
    "challenge_count": {
      "readOnly": true,
      "title": "Challenge Count",
      "type": "integer"
    },
    "dataset_snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Dataset Snapshot Id",
      "type": "string"
    },
    "eligibility_policy_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Eligibility Policy Authority Id",
      "type": "string"
    },
    "eligibility_policy_document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Eligibility Policy Document Sha256",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/M6RegressionDatasetEntry"
      },
      "maxItems": 100000,
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    },
    "execution_dataset": {
      "$ref": "#/$defs/M6RegressionExecutionDatasetSnapshot"
    },
    "gold_count": {
      "readOnly": true,
      "title": "Gold Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "m6-regression-dataset-snapshot-v1",
      "default": "m6-regression-dataset-snapshot-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "selection_inventory_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Inventory Authority Id",
      "type": "string"
    },
    "selection_inventory_document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Inventory Document Sha256",
      "type": "string"
    },
    "selection_inventory_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Inventory Root Sha256",
      "type": "string"
    },
    "selection_receipt_count": {
      "exclusiveMinimum": 0,
      "title": "Selection Receipt Count",
      "type": "integer"
    },
    "source_inventory_cut_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Inventory Cut Authority Id",
      "type": "string"
    },
    "source_inventory_cut_document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Inventory Cut Document Sha256",
      "type": "string"
    },
    "source_inventory_item_count": {
      "exclusiveMinimum": 0,
      "title": "Source Inventory Item Count",
      "type": "integer"
    },
    "source_inventory_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Inventory Root Sha256",
      "type": "string"
    },
    "stability_count": {
      "readOnly": true,
      "title": "Stability Count",
      "type": "integer"
    }
  },
  "required": [
    "baseline_manifest_id",
    "execution_dataset",
    "source_inventory_cut_authority_id",
    "source_inventory_cut_document_sha256",
    "source_inventory_item_count",
    "source_inventory_root_sha256",
    "eligibility_policy_authority_id",
    "eligibility_policy_document_sha256",
    "selection_inventory_authority_id",
    "selection_inventory_document_sha256",
    "selection_receipt_count",
    "selection_inventory_root_sha256",
    "entries",
    "stability_count",
    "gold_count",
    "challenge_count",
    "dataset_snapshot_id"
  ],
  "title": "M6RegressionDatasetSnapshot",
  "type": "object"
}
