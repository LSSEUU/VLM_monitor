{
  "$defs": {
    "M8ActorScopeKind": {
      "enum": [
        "CAMPUS_WIDE",
        "LOCATIONS",
        "SELF_ONLY"
      ],
      "title": "M8ActorScopeKind",
      "type": "string"
    },
    "M8ExternalIdempotencyKey": {
      "enum": [
        "BACKUP_GENERATION_ID",
        "EXPORT_BATCH_ID",
        "NOTIFICATION_ID",
        "REQUEST_ID",
        "SOURCE_SEQUENCE",
        "SUBJECT_ASSERTION_ID"
      ],
      "title": "M8ExternalIdempotencyKey",
      "type": "string"
    },
    "M8FeishuAdapterProfileV1": {
      "additionalProperties": false,
      "description": "Pinned custom-app API profile that contains references, never Feishu secrets.",
      "properties": {
        "api_origin": {
          "const": "https://open.feishu.cn",
          "default": "https://open.feishu.cn",
          "title": "Api Origin",
          "type": "string"
        },
        "app_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "App Id Sha256",
          "type": "string"
        },
        "authentication_kind": {
          "const": "TENANT_ACCESS_TOKEN_INTERNAL",
          "default": "TENANT_ACCESS_TOKEN_INTERNAL",
          "title": "Authentication Kind",
          "type": "string"
        },
        "bot_capability_required": {
          "const": true,
          "default": true,
          "title": "Bot Capability Required",
          "type": "boolean"
        },
        "candidate": {
          "$ref": "#/$defs/M8ProductionAdapterCandidateAuthorityV1"
        },
        "credential_bundle_reference_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Credential Bundle Reference Id",
          "type": "string"
        },
        "external_call_permitted": {
          "const": false,
          "default": false,
          "title": "External Call Permitted",
          "type": "boolean"
        },
        "max_card_content_bytes": {
          "const": 30720,
          "default": 30720,
          "title": "Max Card Content Bytes",
          "type": "integer"
        },
        "message_path": {
          "const": "/open-apis/im/v1/messages",
          "default": "/open-apis/im/v1/messages",
          "title": "Message Path",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Manifest Id",
          "type": "string"
        },
        "provider_uuid_dedup_window_seconds": {
          "const": 3600,
          "default": 3600,
          "title": "Provider Uuid Dedup Window Seconds",
          "type": "integer"
        },
        "provider_uuid_max_characters": {
          "const": 50,
          "default": 50,
          "title": "Provider Uuid Max Characters",
          "type": "integer"
        },
        "published_app_version_required": {
          "const": true,
          "default": true,
          "title": "Published App Version Required",
          "type": "boolean"
        },
        "raw_response_required": {
          "const": true,
          "default": true,
          "title": "Raw Response Required",
          "type": "boolean"
        },
        "receive_id_type": {
          "const": "open_id",
          "default": "open_id",
          "title": "Receive Id Type",
          "type": "string"
        },
        "required_scope": {
          "const": "im:message:send_as_bot",
          "default": "im:message:send_as_bot",
          "title": "Required Scope",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-feishu-adapter-profile-v1",
          "default": "m8-feishu-adapter-profile-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "secret_material_embedded": {
          "const": false,
          "default": false,
          "title": "Secret Material Embedded",
          "type": "boolean"
        },
        "token_cache_required": {
          "const": true,
          "default": true,
          "title": "Token Cache Required",
          "type": "boolean"
        },
        "token_path": {
          "const": "/open-apis/auth/v3/tenant_access_token/internal",
          "default": "/open-apis/auth/v3/tenant_access_token/internal",
          "title": "Token Path",
          "type": "string"
        }
      },
      "required": [
        "candidate",
        "credential_bundle_reference_id",
        "app_id_sha256",
        "profile_manifest_id",
        "profile_id"
      ],
      "title": "M8FeishuAdapterProfileV1",
      "type": "object"
    },
    "M8FeishuRecipientBindingAuthorityV1": {
      "additionalProperties": false,
      "description": "Authorized target-to-open-ID hash binding without persisting the clear identifier.",
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "binding_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Binding Authority Id",
          "type": "string"
        },
        "clear_receive_id_persisted": {
          "readOnly": true,
          "title": "Clear Receive Id Persisted",
          "type": "boolean"
        },
        "mapping_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Mapping Manifest Id",
          "type": "string"
        },
        "mapping_revision": {
          "exclusiveMinimum": 0,
          "title": "Mapping Revision",
          "type": "integer"
        },
        "profile_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Id",
          "type": "string"
        },
        "receive_id_reference": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Receive Id Reference",
          "type": "string"
        },
        "receive_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receive Id Sha256",
          "type": "string"
        },
        "receive_id_type": {
          "const": "open_id",
          "default": "open_id",
          "title": "Receive Id Type",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-feishu-recipient-binding-authority-v1",
          "default": "m8-feishu-recipient-binding-authority-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/M8NotificationTargetAuthorityV1"
        }
      },
      "required": [
        "target",
        "profile_id",
        "receive_id_reference",
        "receive_id_sha256",
        "mapping_revision",
        "active",
        "mapping_manifest_id",
        "clear_receive_id_persisted",
        "binding_authority_id"
      ],
      "title": "M8FeishuRecipientBindingAuthorityV1",
      "type": "object"
    },
    "M8NotificationChannelKind": {
      "enum": [
        "DINGTALK",
        "FEISHU",
        "LOCAL_OFFLINE_FAKE",
        "WECHAT_WORK"
      ],
      "title": "M8NotificationChannelKind",
      "type": "string"
    },
    "M8NotificationTargetAuthorityV1": {
      "additionalProperties": false,
      "description": "Versioned privacy-safe mapping from one actor to one delivery channel.",
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "actor_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Actor Id",
          "type": "string"
        },
        "authority_revision": {
          "exclusiveMinimum": 0,
          "title": "Authority Revision",
          "type": "integer"
        },
        "channel": {
          "$ref": "#/$defs/M8NotificationChannelKind"
        },
        "display_badge": {
          "readOnly": true,
          "title": "Display Badge",
          "type": "string"
        },
        "external_subject_binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "External Subject Binding Sha256",
          "type": "string"
        },
        "identity_provider_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Identity Provider Id",
          "type": "string"
        },
        "inbound_response_supported": {
          "title": "Inbound Response Supported",
          "type": "boolean"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-notification-target-authority-v1",
          "default": "m8-notification-target-authority-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "simulated": {
          "readOnly": true,
          "title": "Simulated",
          "type": "boolean"
        },
        "target_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Target Authority Id",
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "identity_provider_id",
        "external_subject_binding_sha256",
        "channel",
        "authority_revision",
        "active",
        "inbound_response_supported",
        "manifest_id",
        "simulated",
        "display_badge",
        "target_authority_id"
      ],
      "title": "M8NotificationTargetAuthorityV1",
      "type": "object"
    },
    "M8ProductionAdapterCandidateAuthorityV1": {
      "additionalProperties": false,
      "description": "A pinned external adapter candidate; it is never activation authority by itself.",
      "properties": {
        "adapter_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_kind": {
          "$ref": "#/$defs/M8ProductionAdapterKind"
        },
        "adapter_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Adapter Manifest Id",
          "type": "string"
        },
        "adapter_revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Adapter Revision",
          "type": "string"
        },
        "campus_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Campus Id",
          "type": "string"
        },
        "candidate_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Candidate Authority Id",
          "type": "string"
        },
        "cross_camera_reidentification_permitted": {
          "readOnly": true,
          "title": "Cross Camera Reidentification Permitted",
          "type": "boolean"
        },
        "declared_license_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Declared License Id",
          "type": "string"
        },
        "direct_disciplinary_action_permitted": {
          "readOnly": true,
          "title": "Direct Disciplinary Action Permitted",
          "type": "boolean"
        },
        "external_io_required": {
          "const": true,
          "default": true,
          "title": "External Io Required",
          "type": "boolean"
        },
        "face_recognition_permitted": {
          "readOnly": true,
          "title": "Face Recognition Permitted",
          "type": "boolean"
        },
        "idempotency_key": {
          "$ref": "#/$defs/M8ExternalIdempotencyKey"
        },
        "life_safety_action_permitted": {
          "readOnly": true,
          "title": "Life Safety Action Permitted",
          "type": "boolean"
        },
        "network_required": {
          "title": "Network Required",
          "type": "boolean"
        },
        "offline_fallback_adapter_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Offline Fallback Adapter Id",
          "type": "string"
        },
        "offline_fallback_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Offline Fallback Manifest Id",
          "type": "string"
        },
        "offline_fallback_revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Offline Fallback Revision",
          "type": "string"
        },
        "product_revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Product Revision",
          "type": "string"
        },
        "production_activation_permitted": {
          "readOnly": true,
          "title": "Production Activation Permitted",
          "type": "boolean"
        },
        "provider_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Provider Id",
          "type": "string"
        },
        "raw_receipt_required": {
          "const": true,
          "default": true,
          "title": "Raw Receipt Required",
          "type": "boolean"
        },
        "request_timeout_ms": {
          "exclusiveMinimum": 0,
          "maximum": 120000,
          "title": "Request Timeout Ms",
          "type": "integer"
        },
        "schema_version": {
          "const": "m8-production-adapter-candidate-authority-v1",
          "default": "m8-production-adapter-candidate-authority-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_kind": {
          "$ref": "#/$defs/M8ActorScopeKind"
        },
        "scope_location_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Scope Location Ids",
          "type": "array"
        },
        "secret_material_embedded": {
          "const": false,
          "default": false,
          "title": "Secret Material Embedded",
          "type": "boolean"
        }
      },
      "required": [
        "adapter_id",
        "adapter_revision",
        "adapter_kind",
        "provider_id",
        "product_revision",
        "campus_id",
        "scope_kind",
        "declared_license_id",
        "request_timeout_ms",
        "idempotency_key",
        "network_required",
        "offline_fallback_adapter_id",
        "offline_fallback_revision",
        "adapter_manifest_id",
        "offline_fallback_manifest_id",
        "production_activation_permitted",
        "life_safety_action_permitted",
        "direct_disciplinary_action_permitted",
        "face_recognition_permitted",
        "cross_camera_reidentification_permitted",
        "candidate_authority_id"
      ],
      "title": "M8ProductionAdapterCandidateAuthorityV1",
      "type": "object"
    },
    "M8ProductionAdapterKind": {
      "enum": [
        "DISASTER_RECOVERY",
        "EXTERNAL_NOTIFICATION",
        "OBSERVABILITY",
        "OIDC_IDENTITY",
        "PHYSICAL_SENSOR",
        "RTSP_CAMERA"
      ],
      "title": "M8ProductionAdapterKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-feishu-sandbox-runtime-config-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Secret-free, allowlist-only runtime configuration; never call authority alone.",
  "properties": {
    "clear_receive_id_persisted": {
      "const": false,
      "default": false,
      "title": "Clear Receive Id Persisted",
      "type": "boolean"
    },
    "environment": {
      "const": "SANDBOX",
      "default": "SANDBOX",
      "title": "Environment",
      "type": "string"
    },
    "external_call_permitted": {
      "const": false,
      "default": false,
      "title": "External Call Permitted",
      "type": "boolean"
    },
    "profile": {
      "$ref": "#/$defs/M8FeishuAdapterProfileV1"
    },
    "provider_response_max_bytes": {
      "const": 262144,
      "default": 262144,
      "title": "Provider Response Max Bytes",
      "type": "integer"
    },
    "recipient_allowlist": {
      "items": {
        "$ref": "#/$defs/M8FeishuRecipientBindingAuthorityV1"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Recipient Allowlist",
      "type": "array"
    },
    "recipient_allowlist_enforced": {
      "const": true,
      "default": true,
      "title": "Recipient Allowlist Enforced",
      "type": "boolean"
    },
    "recipient_allowlist_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Recipient Allowlist Sha256",
      "type": "string"
    },
    "recipient_binding_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "readOnly": true,
      "title": "Recipient Binding Ids",
      "type": "array"
    },
    "recipient_target_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "readOnly": true,
      "title": "Recipient Target Ids",
      "type": "array"
    },
    "runtime_config_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Runtime Config Id",
      "type": "string"
    },
    "runtime_config_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Config Manifest Id",
      "type": "string"
    },
    "runtime_config_ref": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Runtime Config Ref",
      "type": "string"
    },
    "schema_version": {
      "const": "m8-feishu-sandbox-runtime-config-v1",
      "default": "m8-feishu-sandbox-runtime-config-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "secret_material_embedded": {
      "const": false,
      "default": false,
      "title": "Secret Material Embedded",
      "type": "boolean"
    },
    "tls_certificate_validation_required": {
      "const": true,
      "default": true,
      "title": "Tls Certificate Validation Required",
      "type": "boolean"
    },
    "transport_kind": {
      "const": "HTTPS_JSON",
      "default": "HTTPS_JSON",
      "title": "Transport Kind",
      "type": "string"
    }
  },
  "required": [
    "profile",
    "recipient_allowlist",
    "runtime_config_ref",
    "runtime_config_manifest_id",
    "recipient_binding_ids",
    "recipient_target_ids",
    "recipient_allowlist_sha256",
    "runtime_config_id"
  ],
  "title": "M8FeishuSandboxRuntimeConfigV1",
  "type": "object"
}
