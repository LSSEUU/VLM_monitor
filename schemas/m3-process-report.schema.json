{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "RUN",
        "FRAME",
        "SAFETY_SIGNAL",
        "EVENT",
        "CASE",
        "DETECTION",
        "OBJECTIVE_FACT",
        "CROP",
        "MEDIA",
        "EVIDENCE_PACK",
        "TOOL_RESULT",
        "MANIFEST",
        "MODEL_RESPONSE",
        "MODEL_REQUEST",
        "PROMPT_MANIFEST",
        "MODEL_PARSE_RECEIPT",
        "PARSED_MODEL_OUTPUT",
        "PROCEDURAL_REVIEW",
        "MODEL_CACHE_ENTRY",
        "SCREENING_RESULT",
        "VERDICT",
        "ALERT",
        "PRECEDENT",
        "APPEAL",
        "TRAINING_LABEL",
        "BACKLOG_ITEM",
        "DATASET"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A kind-discriminated reference with syntax fixed by the artifact kind.",
      "properties": {
        "artifact_id": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CaseStatus": {
      "enum": [
        "CANDIDATE",
        "EVIDENCE_READY",
        "SCREENED",
        "ESCALATED",
        "DELIBERATING",
        "PROCEDURAL_REVIEW",
        "READY_FOR_ALERT_POLICY",
        "REWORK_REQUIRED",
        "HUMAN_REVIEW",
        "BACKLOGGED",
        "CLOSED",
        "APPEALED",
        "APPEAL_RESOLVED"
      ],
      "title": "CaseStatus",
      "type": "string"
    },
    "M3ProcessCaseOutcome": {
      "additionalProperties": false,
      "description": "One case result without prompts, raw responses, paths, or secrets.",
      "properties": {
        "backlog_item_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "cache_hit_count": {
          "minimum": 0,
          "title": "Cache Hit Count",
          "type": "integer"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/M3ProcessDisposition"
        },
        "event_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Event Id",
          "type": "string"
        },
        "initial_status": {
          "$ref": "#/$defs/CaseStatus"
        },
        "pipeline_invoked": {
          "title": "Pipeline Invoked",
          "type": "boolean"
        },
        "procedural_review_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovered_response_count": {
          "minimum": 0,
          "title": "Recovered Response Count",
          "type": "integer"
        },
        "repair_attempt_count": {
          "maximum": 1,
          "minimum": 0,
          "title": "Repair Attempt Count",
          "type": "integer"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "screening_result_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/CaseStatus"
        },
        "verdict_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "event_id",
        "case_id",
        "initial_status",
        "status",
        "revision",
        "disposition",
        "pipeline_invoked",
        "screening_result_ref",
        "verdict_ref",
        "procedural_review_ref",
        "backlog_item_ref",
        "cache_hit_count",
        "recovered_response_count",
        "repair_attempt_count"
      ],
      "title": "M3ProcessCaseOutcome",
      "type": "object"
    },
    "M3ProcessCounts": {
      "additionalProperties": false,
      "description": "Explicit bounded-work and model-cache counters.",
      "properties": {
        "cache_hits": {
          "minimum": 0,
          "title": "Cache Hits",
          "type": "integer"
        },
        "deferred_to_backlog_cases": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Deferred To Backlog Cases",
          "type": "integer"
        },
        "observed_existing_cases": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Observed Existing Cases",
          "type": "integer"
        },
        "pipeline_invocations": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Pipeline Invocations",
          "type": "integer"
        },
        "processed_cases": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Processed Cases",
          "type": "integer"
        },
        "recovered_responses": {
          "minimum": 0,
          "title": "Recovered Responses",
          "type": "integer"
        },
        "repair_attempts": {
          "minimum": 0,
          "title": "Repair Attempts",
          "type": "integer"
        },
        "selected_cases": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Selected Cases",
          "type": "integer"
        },
        "skipped_not_ready_cases": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Skipped Not Ready Cases",
          "type": "integer"
        }
      },
      "required": [
        "selected_cases",
        "pipeline_invocations",
        "processed_cases",
        "deferred_to_backlog_cases",
        "observed_existing_cases",
        "skipped_not_ready_cases",
        "cache_hits",
        "recovered_responses",
        "repair_attempts"
      ],
      "title": "M3ProcessCounts",
      "type": "object"
    },
    "M3ProcessDisposition": {
      "description": "Stable distinction between advancement, deferral, observation, and skip.",
      "enum": [
        "PROCESSED",
        "DEFERRED_TO_BACKLOG",
        "OBSERVED_EXISTING",
        "SKIPPED_NOT_READY"
      ],
      "title": "M3ProcessDisposition",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m3-process-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded run report that prominently identifies its simulated M3 authority.",
  "properties": {
    "available_case_count": {
      "minimum": 0,
      "title": "Available Case Count",
      "type": "integer"
    },
    "counts": {
      "$ref": "#/$defs/M3ProcessCounts"
    },
    "fixture_bundle_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fixture Bundle Id",
      "type": "string"
    },
    "fixture_entry_count": {
      "maximum": 1000,
      "minimum": 0,
      "title": "Fixture Entry Count",
      "type": "integer"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "model_mode": {
      "const": "FAKE VLM",
      "title": "Model Mode",
      "type": "string"
    },
    "outcomes": {
      "items": {
        "$ref": "#/$defs/M3ProcessCaseOutcome"
      },
      "maxItems": 1000,
      "title": "Outcomes",
      "type": "array"
    },
    "perception_mode": {
      "const": "SIMULATED PERCEPTION",
      "title": "Perception Mode",
      "type": "string"
    },
    "provider_profile": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Provider Profile",
      "type": "string"
    },
    "requested_case_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Requested Case Id"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m3-process-report-v1",
      "default": "m3-process-report-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "selection_limit": {
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "title": "Selection Limit",
      "type": "integer"
    },
    "selection_truncated": {
      "title": "Selection Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "run_id",
    "manifest_id",
    "provider_profile",
    "perception_mode",
    "model_mode",
    "fixture_bundle_id",
    "fixture_entry_count",
    "requested_case_id",
    "selection_limit",
    "available_case_count",
    "selection_truncated",
    "outcomes",
    "counts"
  ],
  "title": "M3ProcessReport",
  "type": "object"
}
