{
  "$defs": {
    "AcquisitionAction": {
      "enum": [
        "REQUEST_MORE_FRAMES",
        "RECROP",
        "OTHER_CAMERA_SAME_TIME",
        "TRACK_CONFIDENCE_CURVE",
        "REDETECT_HIGH_RES"
      ],
      "title": "AcquisitionAction",
      "type": "string"
    },
    "AcquisitionRequestPayload": {
      "additionalProperties": false,
      "description": "Model-authored, non-authoritative proposal for one whitelisted tool action.",
      "properties": {
        "action": {
          "$ref": "#/$defs/AcquisitionAction"
        },
        "reason_summary": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Reason Summary",
          "type": "string"
        },
        "supporting_evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "maxItems": 32,
          "title": "Supporting Evidence Refs",
          "type": "array"
        },
        "validated_parameters": {
          "discriminator": {
            "mapping": {
              "OTHER_CAMERA_SAME_TIME": "#/$defs/OtherCameraSameTimeParameters",
              "RECROP": "#/$defs/RecropParameters",
              "REDETECT_HIGH_RES": "#/$defs/RedetectHighResolutionParameters",
              "REQUEST_MORE_FRAMES": "#/$defs/RequestMoreFramesParameters",
              "TRACK_CONFIDENCE_CURVE": "#/$defs/TrackConfidenceCurveParameters"
            },
            "propertyName": "action"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RequestMoreFramesParameters"
            },
            {
              "$ref": "#/$defs/RecropParameters"
            },
            {
              "$ref": "#/$defs/OtherCameraSameTimeParameters"
            },
            {
              "$ref": "#/$defs/TrackConfidenceCurveParameters"
            },
            {
              "$ref": "#/$defs/RedetectHighResolutionParameters"
            }
          ],
          "title": "Validated Parameters"
        }
      },
      "required": [
        "action",
        "validated_parameters",
        "reason_summary"
      ],
      "title": "AcquisitionRequestPayload",
      "type": "object"
    },
    "AlertLevel": {
      "enum": [
        "ADVISORY",
        "CONFIRMED",
        "EMERGENCY"
      ],
      "title": "AlertLevel",
      "type": "string"
    },
    "ArtifactKind": {
      "enum": [
        "RUN",
        "FRAME",
        "SAFETY_SIGNAL",
        "EVENT",
        "CASE",
        "DETECTION",
        "OBJECTIVE_FACT",
        "CROP",
        "MEDIA",
        "EVIDENCE_PACK",
        "TOOL_RESULT",
        "MANIFEST",
        "MODEL_RESPONSE",
        "MODEL_REQUEST",
        "PROMPT_MANIFEST",
        "MODEL_PARSE_RECEIPT",
        "PARSED_MODEL_OUTPUT",
        "PROCEDURAL_REVIEW",
        "MODEL_CACHE_ENTRY",
        "SCREENING_RESULT",
        "VERDICT",
        "ALERT",
        "PRECEDENT",
        "APPEAL",
        "TRAINING_LABEL",
        "BACKLOG_ITEM",
        "DATASET"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A kind-discriminated reference with syntax fixed by the artifact kind.",
      "properties": {
        "artifact_id": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BBoxXYXY": {
      "additionalProperties": false,
      "description": "Integer `[x1, y1, x2, y2)` bounding box.",
      "properties": {
        "x1": {
          "minimum": 0,
          "title": "X1",
          "type": "integer"
        },
        "x2": {
          "exclusiveMinimum": 0,
          "title": "X2",
          "type": "integer"
        },
        "y1": {
          "minimum": 0,
          "title": "Y1",
          "type": "integer"
        },
        "y2": {
          "exclusiveMinimum": 0,
          "title": "Y2",
          "type": "integer"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "BBoxXYXY",
      "type": "object"
    },
    "EvidenceCitation": {
      "additionalProperties": false,
      "description": "A typed model citation whose relative geometry is checked later by L5.",
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "bbox"
                ]
              },
              {
                "required": [
                  "coordinate_space"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "bbox": {
              "type": "null"
            },
            "coordinate_space": {
              "type": "null"
            }
          },
          "required": [
            "bbox",
            "coordinate_space"
          ]
        },
        {
          "properties": {
            "bbox": {
              "not": {
                "type": "null"
              }
            },
            "coordinate_space": {
              "const": "CITED_ARTIFACT_PIXELS"
            },
            "evidence_ref": {
              "properties": {
                "kind": {
                  "enum": [
                    "CROP",
                    "FRAME"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            }
          },
          "required": [
            "bbox",
            "coordinate_space",
            "evidence_ref"
          ]
        }
      ],
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBoxXYXY"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "coordinate_space": {
          "anyOf": [
            {
              "const": "CITED_ARTIFACT_PIXELS",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coordinate Space"
        },
        "evidence_ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "evidence_ref"
      ],
      "title": "EvidenceCitation",
      "type": "object"
    },
    "JudgeAcquisitionDecisionPayload": {
      "additionalProperties": false,
      "properties": {
        "outcome_type": {
          "const": "ACQUISITION",
          "default": "ACQUISITION",
          "title": "Outcome Type",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/AcquisitionRequestPayload"
        }
      },
      "required": [
        "request"
      ],
      "title": "JudgeAcquisitionDecisionPayload",
      "type": "object"
    },
    "JudgeDisposition": {
      "enum": [
        "ACCEPTED",
        "REJECTED",
        "PARTIALLY_ACCEPTED"
      ],
      "title": "JudgeDisposition",
      "type": "string"
    },
    "JudgeFinalDecisionPayload": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "decision": {
          "$ref": "#/$defs/VerdictDecision"
        },
        "evidence_citations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceCitation"
          },
          "maxItems": 64,
          "title": "Evidence Citations",
          "type": "array"
        },
        "objective_claims": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectiveClaim"
          },
          "maxItems": 32,
          "title": "Objective Claims",
          "type": "array"
        },
        "observation_sufficiency": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservationSufficiency"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome_type": {
          "const": "FINAL",
          "default": "FINAL",
          "title": "Outcome Type",
          "type": "string"
        },
        "rationale_summary": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Rationale Summary",
          "type": "string"
        },
        "recommended_alert_level": {
          "$ref": "#/$defs/AlertLevel"
        }
      },
      "required": [
        "decision",
        "confidence",
        "recommended_alert_level",
        "rationale_summary"
      ],
      "title": "JudgeFinalDecisionPayload",
      "type": "object"
    },
    "JudgeResponse": {
      "additionalProperties": false,
      "properties": {
        "defense_argument_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Defense Argument Id",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/JudgeDisposition"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "response_summary": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Response Summary",
          "type": "string"
        }
      },
      "required": [
        "defense_argument_id",
        "disposition",
        "response_summary"
      ],
      "title": "JudgeResponse",
      "type": "object"
    },
    "ObjectiveClaim": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "DURATION_FRAMES",
                  "PERSON_COUNT"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "minimum": 0,
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "FRAME_INTERVAL",
                  "TRACK_PRESENCE_INTERVAL"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "minimum": 1,
                    "type": "integer"
                  }
                ],
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ZONE_ID"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "RISK_LEVEL"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH"
                ],
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "DETECTION_SCORE",
                  "OBSERVABILITY"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              }
            }
          }
        }
      ],
      "properties": {
        "evidence_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "kind": {
          "$ref": "#/$defs/ObjectiveFactKind"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "kind",
        "value",
        "evidence_ref"
      ],
      "title": "ObjectiveClaim",
      "type": "object"
    },
    "ObjectiveFactKind": {
      "enum": [
        "DURATION_FRAMES",
        "PERSON_COUNT",
        "ZONE_ID",
        "RISK_LEVEL",
        "FRAME_INTERVAL",
        "TRACK_PRESENCE_INTERVAL",
        "DETECTION_SCORE",
        "OBSERVABILITY"
      ],
      "title": "ObjectiveFactKind",
      "type": "string"
    },
    "ObservationLabel": {
      "additionalProperties": false,
      "properties": {
        "crop_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Crop Id",
          "type": "string"
        },
        "wear_status": {
          "$ref": "#/$defs/WearStatus"
        }
      },
      "required": [
        "crop_id",
        "wear_status"
      ],
      "title": "ObservationLabel",
      "type": "object"
    },
    "ObservationSufficiency": {
      "additionalProperties": false,
      "properties": {
        "clear_threshold": {
          "maximum": 1,
          "minimum": 0,
          "title": "Clear Threshold",
          "type": "number"
        },
        "observations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObservationLabel"
          },
          "title": "Observations",
          "type": "array"
        },
        "required_clear_count": {
          "exclusiveMinimum": 0,
          "title": "Required Clear Count",
          "type": "integer"
        }
      },
      "required": [
        "clear_threshold",
        "required_clear_count"
      ],
      "title": "ObservationSufficiency",
      "type": "object"
    },
    "OtherCameraSameTimeParameters": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "OTHER_CAMERA_SAME_TIME",
          "title": "Action",
          "type": "string"
        },
        "source_frame_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:(?:0|[1-9][0-9]{0,19})$",
          "title": "Source Frame Id",
          "type": "string"
        },
        "target_camera_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Target Camera Id",
          "type": "string"
        }
      },
      "required": [
        "action",
        "source_frame_id",
        "target_camera_id"
      ],
      "title": "OtherCameraSameTimeParameters",
      "type": "object"
    },
    "PrecedentApplication": {
      "additionalProperties": false,
      "properties": {
        "distinguishing_reason": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distinguishing Reason"
        },
        "fact_difference_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Fact Difference Refs",
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/PrecedentApplicationMode"
        },
        "precedent_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "similarity_score": {
          "maximum": 1,
          "minimum": -1,
          "title": "Similarity Score",
          "type": "number"
        }
      },
      "required": [
        "precedent_ref",
        "mode",
        "similarity_score"
      ],
      "title": "PrecedentApplication",
      "type": "object"
    },
    "PrecedentApplicationMode": {
      "enum": [
        "FOLLOWED",
        "DISTINGUISHED"
      ],
      "title": "PrecedentApplicationMode",
      "type": "string"
    },
    "RecropParameters": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "RECROP",
          "title": "Action",
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BBoxXYXY"
        },
        "frame_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:(?:0|[1-9][0-9]{0,19})$",
          "title": "Frame Id",
          "type": "string"
        }
      },
      "required": [
        "action",
        "frame_id",
        "bbox"
      ],
      "title": "RecropParameters",
      "type": "object"
    },
    "RedetectHighResolutionParameters": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "REDETECT_HIGH_RES",
          "title": "Action",
          "type": "string"
        },
        "crop_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Crop Id",
          "type": "string"
        },
        "prompts": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Prompts",
          "type": "array"
        }
      },
      "required": [
        "action",
        "crop_id",
        "prompts"
      ],
      "title": "RedetectHighResolutionParameters",
      "type": "object"
    },
    "RequestMoreFramesParameters": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "REQUEST_MORE_FRAMES",
          "title": "Action",
          "type": "string"
        },
        "camera_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Camera Id",
          "type": "string"
        },
        "end_frame_exclusive": {
          "exclusiveMinimum": 0,
          "title": "End Frame Exclusive",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "step": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "stream_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Stream Id",
          "type": "string"
        }
      },
      "required": [
        "action",
        "camera_id",
        "stream_id",
        "start_frame",
        "end_frame_exclusive"
      ],
      "title": "RequestMoreFramesParameters",
      "type": "object"
    },
    "TrackConfidenceCurveParameters": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "TRACK_CONFIDENCE_CURVE",
          "title": "Action",
          "type": "string"
        },
        "end_frame_exclusive": {
          "exclusiveMinimum": 0,
          "title": "End Frame Exclusive",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "track_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Track Ref",
          "type": "string"
        }
      },
      "required": [
        "action",
        "track_ref",
        "start_frame",
        "end_frame_exclusive"
      ],
      "title": "TrackConfidenceCurveParameters",
      "type": "object"
    },
    "VerdictDecision": {
      "enum": [
        "ESTABLISHED",
        "NOT_ESTABLISHED",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "VerdictDecision",
      "type": "string"
    },
    "WearStatus": {
      "enum": [
        "WORN",
        "NOT_WORN",
        "UNCLEAR"
      ],
      "title": "WearStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/judge-model-payload.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict Judge output: one final decision or exactly one acquisition request.",
  "properties": {
    "judge_responses": {
      "default": [],
      "items": {
        "$ref": "#/$defs/JudgeResponse"
      },
      "maxItems": 32,
      "title": "Judge Responses",
      "type": "array"
    },
    "outcome": {
      "discriminator": {
        "mapping": {
          "ACQUISITION": "#/$defs/JudgeAcquisitionDecisionPayload",
          "FINAL": "#/$defs/JudgeFinalDecisionPayload"
        },
        "propertyName": "outcome_type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/JudgeFinalDecisionPayload"
        },
        {
          "$ref": "#/$defs/JudgeAcquisitionDecisionPayload"
        }
      ],
      "title": "Outcome"
    },
    "precedent_applications": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PrecedentApplication"
      },
      "maxItems": 16,
      "title": "Precedent Applications",
      "type": "array"
    },
    "role": {
      "const": "JUDGE",
      "default": "JUDGE",
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "const": "m4-judge-payload-v1",
      "default": "m4-judge-payload-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "outcome"
  ],
  "title": "JudgeModelPayload",
  "type": "object"
}
