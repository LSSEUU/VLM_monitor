    "ToolResult": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/AcquisitionAction"
        },
        "execution_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Execution Manifest Id",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "output_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Output Refs",
          "type": "array"
        },
        "tool_result_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Tool Result Id",
          "type": "string"
        },
        "validated_parameters": {
          "discriminator": {
            "mapping": {
              "OTHER_CAMERA_SAME_TIME": "#/$defs/OtherCameraSameTimeParameters",
              "RECROP": "#/$defs/RecropParameters",
              "REDETECT_HIGH_RES": "#/$defs/RedetectHighResolutionParameters",
              "REQUEST_MORE_FRAMES": "#/$defs/RequestMoreFramesParameters",
              "TRACK_CONFIDENCE_CURVE": "#/$defs/TrackConfidenceCurveParameters"
            },
            "propertyName": "action"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RequestMoreFramesParameters"
            },
            {
              "$ref": "#/$defs/RecropParameters"
            },
            {
              "$ref": "#/$defs/OtherCameraSameTimeParameters"
            },
            {
              "$ref": "#/$defs/TrackConfidenceCurveParameters"
            },
            {
              "$ref": "#/$defs/RedetectHighResolutionParameters"
            }
          ],
          "title": "Validated Parameters"
        }
      },
      "required": [
        "tool_result_id",
        "action",
        "input_refs",
        "output_refs",
        "validated_parameters",
        "execution_manifest_id"
      ],
      "title": "ToolResult",
      "type": "object"
    },
    "TrackConfidenceCurveParameters": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "TRACK_CONFIDENCE_CURVE",
          "title": "Action",
          "type": "string"
        },
        "end_frame_exclusive": {
          "exclusiveMinimum": 0,
          "title": "End Frame Exclusive",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "track_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Track Ref",
          "type": "string"
        }
      },
      "required": [
        "action",
        "track_ref",
        "start_frame",
        "end_frame_exclusive"
      ],
      "title": "TrackConfidenceCurveParameters",
      "type": "object"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/acquisition-execution-publication.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Durable result authority published before EvidencePack mutation.\n\nThe publication closes one fenced executor owner and makes the exact tool\nresult recoverable without crossing the external tool boundary again.",
  "properties": {
    "claim_fence": {
      "exclusiveMinimum": 0,
      "title": "Claim Fence",
      "type": "integer"
    },
    "claim_owner_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Claim Owner Sha256",
      "type": "string"
    },
    "crop_request": {
      "anyOf": [
        {
          "$ref": "#/$defs/CropRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "crops": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Crop"
      },
      "title": "Crops",
      "type": "array"
    },
    "detections": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Detection"
      },
      "title": "Detections",
      "type": "array"
    },
    "execution_manifest": {
      "$ref": "#/$defs/ToolExecutionManifest"
    },
    "execution_mode": {
      "$ref": "#/$defs/AcquisitionExecutionMode"
    },
    "frames": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FrameRef"
      },
      "title": "Frames",
      "type": "array"
    },
    "idempotency_key": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "objective_facts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectiveFact"
      },
      "title": "Objective Facts",
      "type": "array"
    },
    "publication_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Publication Id",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/AcquisitionRequest"
    },
    "schema_version": {
      "const": "m4-acquisition-execution-publication-v1",
      "default": "m4-acquisition-execution-publication-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "tool_result": {
      "$ref": "#/$defs/ToolResult"
    }
  },
  "required": [
    "request",
    "execution_manifest",
    "tool_result",
    "execution_mode",
    "idempotency_key",
    "claim_owner_sha256",
    "claim_fence",
    "publication_id"
  ],
  "title": "AcquisitionExecutionPublication",
  "type": "object"
}
