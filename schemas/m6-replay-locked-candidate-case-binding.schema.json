{
  "$id": "https://schemas.labcourt.local/v2/m6-replay-locked-candidate-case-binding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Physical identity and audit anchor of one independently persisted Case.",
  "properties": {
    "candidate_run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Candidate Run Id",
      "type": "string"
    },
    "case_audit_entry_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Case Audit Entry Hash",
      "type": "string"
    },
    "case_audit_sequence": {
      "minimum": 0,
      "title": "Case Audit Sequence",
      "type": "integer"
    },
    "case_binding_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Case Binding Id",
      "type": "string"
    },
    "case_document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Case Document Sha256",
      "type": "string"
    },
    "case_document_size_bytes": {
      "exclusiveMinimum": 0,
      "maximum": 268435456,
      "title": "Case Document Size Bytes",
      "type": "integer"
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "case_revision": {
      "exclusiveMinimum": 0,
      "title": "Case Revision",
      "type": "integer"
    },
    "sample_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m6-replay-locked-candidate-case-binding-v1",
      "default": "m6-replay-locked-candidate-case-binding-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "candidate_run_id",
    "sample_id",
    "case_id",
    "case_revision",
    "case_document_sha256",
    "case_document_size_bytes",
    "case_audit_sequence",
    "case_audit_entry_hash",
    "case_binding_id"
  ],
  "title": "M6ReplayLockedCandidateCaseBinding",
  "type": "object"
}
