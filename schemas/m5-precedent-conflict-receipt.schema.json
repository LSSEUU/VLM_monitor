{
  "$defs": {
    "M5PrecedentConflictOutcome": {
      "enum": [
        "NO_CONFLICT",
        "NEW_INVALIDATED",
        "EXISTING_INVALIDATED",
        "PEER_CONFLICT"
      ],
      "title": "M5PrecedentConflictOutcome",
      "type": "string"
    },
    "PrecedentStatus": {
      "enum": [
        "PROVISIONAL",
        "ACTIVE",
        "CONFLICT",
        "INVALIDATED",
        "REVOKED"
      ],
      "title": "PrecedentStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m5-precedent-conflict-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "existing_precedent_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Existing Precedent Id",
      "type": "string"
    },
    "existing_prior_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Existing Prior Authority Id",
      "type": "string"
    },
    "existing_prior_revision": {
      "exclusiveMinimum": 0,
      "title": "Existing Prior Revision",
      "type": "integer"
    },
    "existing_priority": {
      "maximum": 1000,
      "minimum": 0,
      "title": "Existing Priority",
      "type": "integer"
    },
    "existing_resulting_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Existing Resulting Authority Id",
      "type": "string"
    },
    "existing_resulting_revision": {
      "exclusiveMinimum": 0,
      "title": "Existing Resulting Revision",
      "type": "integer"
    },
    "existing_status_after": {
      "$ref": "#/$defs/PrecedentStatus"
    },
    "new_precedent_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "New Precedent Id",
      "type": "string"
    },
    "new_prior_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "New Prior Authority Id",
      "type": "string"
    },
    "new_prior_revision": {
      "exclusiveMinimum": 0,
      "title": "New Prior Revision",
      "type": "integer"
    },
    "new_priority": {
      "maximum": 1000,
      "minimum": 0,
      "title": "New Priority",
      "type": "integer"
    },
    "new_resulting_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "New Resulting Authority Id",
      "type": "string"
    },
    "new_resulting_revision": {
      "exclusiveMinimum": 0,
      "title": "New Resulting Revision",
      "type": "integer"
    },
    "new_status_after": {
      "$ref": "#/$defs/PrecedentStatus"
    },
    "normalized_text_weight": {
      "maximum": 1,
      "minimum": 0,
      "title": "Normalized Text Weight",
      "type": "number"
    },
    "normalized_visual_weight": {
      "maximum": 1,
      "minimum": 0,
      "title": "Normalized Visual Weight",
      "type": "number"
    },
    "outcome": {
      "$ref": "#/$defs/M5PrecedentConflictOutcome"
    },
    "policy_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Id",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Receipt Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m5-precedent-conflict-receipt-v1",
      "default": "m5-precedent-conflict-receipt-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "similarity": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Similarity"
    },
    "text_similarity": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text Similarity"
    },
    "threshold": {
      "maximum": 1,
      "minimum": -1,
      "title": "Threshold",
      "type": "number"
    },
    "visual_similarity": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Visual Similarity"
    }
  },
  "required": [
    "run_id",
    "policy_id",
    "existing_precedent_id",
    "new_precedent_id",
    "existing_prior_authority_id",
    "new_prior_authority_id",
    "existing_prior_revision",
    "new_prior_revision",
    "normalized_text_weight",
    "normalized_visual_weight",
    "threshold",
    "existing_priority",
    "new_priority",
    "outcome",
    "existing_resulting_authority_id",
    "new_resulting_authority_id",
    "existing_resulting_revision",
    "new_resulting_revision",
    "existing_status_after",
    "new_status_after",
    "receipt_id"
  ],
  "title": "M5PrecedentConflictReceipt",
  "type": "object"
}
