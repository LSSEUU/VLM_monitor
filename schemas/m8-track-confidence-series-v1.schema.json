{
  "$defs": {
    "M8TrackConfidencePointStatus": {
      "enum": [
        "OBSERVED",
        "MISSING"
      ],
      "title": "M8TrackConfidencePointStatus",
      "type": "string"
    },
    "M8TrackConfidencePointV1": {
      "additionalProperties": false,
      "properties": {
        "detection_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detection Id"
        },
        "frame_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:(?:0|[1-9][0-9]{0,19})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Id"
        },
        "frame_index": {
          "minimum": 0,
          "title": "Frame Index",
          "type": "integer"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "status": {
          "$ref": "#/$defs/M8TrackConfidencePointStatus"
        }
      },
      "required": [
        "frame_index",
        "status"
      ],
      "title": "M8TrackConfidencePointV1",
      "type": "object"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-track-confidence-series-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acquisition_request_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Acquisition Request Id",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "end_frame_exclusive": {
      "exclusiveMinimum": 0,
      "title": "End Frame Exclusive",
      "type": "integer"
    },
    "maximum_score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Maximum Score",
      "type": "number"
    },
    "mean_score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Mean Score",
      "type": "number"
    },
    "minimum_score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Minimum Score",
      "type": "number"
    },
    "observed_count": {
      "exclusiveMinimum": 0,
      "title": "Observed Count",
      "type": "integer"
    },
    "points": {
      "items": {
        "$ref": "#/$defs/M8TrackConfidencePointV1"
      },
      "maxItems": 512,
      "minItems": 1,
      "title": "Points",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m8-track-confidence-series-v1",
      "default": "m8-track-confidence-series-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "series_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Series Id",
      "type": "string"
    },
    "start_frame": {
      "minimum": 0,
      "title": "Start Frame",
      "type": "integer"
    },
    "track_ref": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Track Ref",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "acquisition_request_id",
    "track_ref",
    "start_frame",
    "end_frame_exclusive",
    "points",
    "observed_count",
    "mean_score",
    "minimum_score",
    "maximum_score",
    "series_id"
  ],
  "title": "M8TrackConfidenceSeriesV1",
  "type": "object"
}
