{
  "$defs": {
    "M8CampusLocation": {
      "additionalProperties": false,
      "description": "One stable node in the campus/building/floor/room hierarchy.",
      "properties": {
        "display_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/M8CampusLocationKind"
        },
        "location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Location Id",
          "type": "string"
        },
        "parent_location_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Location Id"
        },
        "schema_version": {
          "const": "m8-campus-location-v1",
          "default": "m8-campus-location-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "location_id",
        "kind",
        "parent_location_id",
        "display_name"
      ],
      "title": "M8CampusLocation",
      "type": "object"
    },
    "M8CampusLocationKind": {
      "enum": [
        "CAMPUS",
        "BUILDING",
        "FLOOR",
        "ROOM"
      ],
      "title": "M8CampusLocationKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-projection-map-node-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_major_case_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 10000,
      "title": "Active Major Case Ids",
      "type": "array"
    },
    "child_location_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "title": "Child Location Ids",
      "type": "array"
    },
    "current_case_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 10000,
      "title": "Current Case Ids",
      "type": "array"
    },
    "location": {
      "$ref": "#/$defs/M8CampusLocation"
    },
    "schema_version": {
      "const": "m8-projection-map-node-v1",
      "default": "m8-projection-map-node-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "simulated_source_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 20000,
      "title": "Simulated Source Ids",
      "type": "array"
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 20000,
      "title": "Source Ids",
      "type": "array"
    }
  },
  "required": [
    "location",
    "child_location_ids",
    "source_ids",
    "simulated_source_ids",
    "current_case_ids",
    "active_major_case_ids"
  ],
  "title": "M8ProjectionMapNodeV1",
  "type": "object"
}
