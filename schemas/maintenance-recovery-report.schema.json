{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "RUN",
        "FRAME",
        "SAFETY_SIGNAL",
        "EVENT",
        "CASE",
        "DETECTION",
        "OBJECTIVE_FACT",
        "CROP",
        "MEDIA",
        "EVIDENCE_PACK",
        "TOOL_RESULT",
        "MANIFEST",
        "MODEL_RESPONSE",
        "MODEL_REQUEST",
        "PROMPT_MANIFEST",
        "MODEL_PARSE_RECEIPT",
        "PARSED_MODEL_OUTPUT",
        "PROCEDURAL_REVIEW",
        "MODEL_CACHE_ENTRY",
        "SCREENING_RESULT",
        "VERDICT",
        "ALERT",
        "PRECEDENT",
        "APPEAL",
        "TRAINING_LABEL",
        "BACKLOG_ITEM",
        "DATASET"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A kind-discriminated reference with syntax fixed by the artifact kind.",
      "properties": {
        "artifact_id": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "MediaAvailability": {
      "enum": [
        "AVAILABLE",
        "PURGING",
        "PURGED_BY_RETENTION"
      ],
      "title": "MediaAvailability",
      "type": "string"
    },
    "ModelResponseArtifactPhase": {
      "enum": [
        "COMPLETED",
        "DEFERRED_ACTIVE_CLAIM",
        "SUPPRESSED_CLAIM_SCAN_INCOMPLETE",
        "SUPPRESSED_INTEGRITY_FAILURE",
        "BUDGET_EXHAUSTED"
      ],
      "title": "ModelResponseArtifactPhase",
      "type": "string"
    },
    "ModelResponseRecoveryArea": {
      "enum": [
        "MODEL_CALL",
        "STAGED_RESPONSE",
        "FINAL_RESPONSE",
        "JOURNAL"
      ],
      "title": "ModelResponseRecoveryArea",
      "type": "string"
    },
    "ModelResponseRecoveryDisposition": {
      "enum": [
        "VERIFIED",
        "ACKNOWLEDGED",
        "DEFERRED",
        "RETAINED",
        "QUARANTINED",
        "CLEANED",
        "ANOMALY"
      ],
      "title": "ModelResponseRecoveryDisposition",
      "type": "string"
    },
    "ModelResponseRecoveryItem": {
      "additionalProperties": false,
      "description": "One stable outcome without owner tokens, host paths, or response bytes.",
      "properties": {
        "area": {
          "$ref": "#/$defs/ModelResponseRecoveryArea"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "disposition": {
          "$ref": "#/$defs/ModelResponseRecoveryDisposition"
        },
        "quarantine_relative_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quarantine Relative Path"
        },
        "reason_code": {
          "$ref": "#/$defs/ModelResponseRecoveryReason"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "response_content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Content Sha256"
        },
        "response_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Id"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "source_token": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Token"
        }
      },
      "required": [
        "run_id",
        "area",
        "disposition",
        "reason_code"
      ],
      "title": "ModelResponseRecoveryItem",
      "type": "object"
    },
    "ModelResponseRecoveryReason": {
      "enum": [
        "ACTIVE_LEASE_UNEXPIRED",
        "ACTIVE_EXPIRED_NO_JOURNAL",
        "CLAIM_RACE_LOST",
        "CLAIM_SCAN_INCOMPLETE",
        "CLAIM_RECOVERY_SUPPRESSED",
        "JOURNAL_ACKNOWLEDGED",
        "JOURNAL_ALREADY_ABSENT",
        "ORPHAN_STAGE_QUARANTINED",
        "ORPHAN_FINAL_QUARANTINED",
        "ORPHAN_JOURNAL_QUARANTINED",
        "EMPTY_OPERATION_CLEANED",
        "MINIMUM_AGE_NOT_MET",
        "DATABASE_REFERENCED_ARTIFACT",
        "ARTIFACT_SCAN_INCOMPLETE",
        "ARTIFACT_FILE_BYTES_EXCEEDED",
        "ARTIFACT_TOTAL_BYTES_EXHAUSTED",
        "CLAIM_AUTHORITY_INVALID",
        "JOURNAL_INTEGRITY_FAILURE",
        "RESPONSE_INTEGRITY_FAILURE",
        "RESPONSE_CONFLICT",
        "DATABASE_OBSERVATION_CONFLICT",
        "CONTENT_IDENTITY_MISMATCH",
        "ENTRY_CHANGED_DURING_RECOVERY",
        "UNSAFE_FILESYSTEM_ENTRY",
        "UNKNOWN_ENTRY_SHAPE",
        "ORPHAN_MUTATION_SUPPRESSED"
      ],
      "title": "ModelResponseRecoveryReason",
      "type": "string"
    },
    "ModelResponseRecoveryReport": {
      "additionalProperties": false,
      "description": "Bounded claim and artifact recovery with explicit incomplete phases.",
      "properties": {
        "artifact_bytes_scanned": {
          "minimum": 0,
          "title": "Artifact Bytes Scanned",
          "type": "integer"
        },
        "artifact_file_bytes_limit": {
          "exclusiveMinimum": 0,
          "maximum": 262144,
          "title": "Artifact File Bytes Limit",
          "type": "integer"
        },
        "artifact_limit": {
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "title": "Artifact Limit",
          "type": "integer"
        },
        "artifact_not_modified_after": {
          "format": "date-time",
          "title": "Artifact Not Modified After",
          "type": "string"
        },
        "artifact_phase": {
          "$ref": "#/$defs/ModelResponseArtifactPhase"
        },
        "artifact_scan_complete": {
          "title": "Artifact Scan Complete",
          "type": "boolean"
        },
        "artifact_total_bytes_limit": {
          "exclusiveMinimum": 0,
          "maximum": 262144000,
          "title": "Artifact Total Bytes Limit",
          "type": "integer"
        },
        "artifacts_scanned": {
          "minimum": 0,
          "title": "Artifacts Scanned",
          "type": "integer"
        },
        "claim_limit": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Claim Limit",
          "type": "integer"
        },
        "claim_scan_complete": {
          "title": "Claim Scan Complete",
          "type": "boolean"
        },
        "claims_scanned": {
          "minimum": 0,
          "title": "Claims Scanned",
          "type": "integer"
        },
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelResponseRecoveryItem"
          },
          "title": "Items",
          "type": "array"
        },
        "passed": {
          "readOnly": true,
          "title": "Passed",
          "type": "boolean"
        },
        "requires_attention": {
          "readOnly": true,
          "title": "Requires Attention",
          "type": "boolean"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "started_at",
        "artifact_not_modified_after",
        "claim_limit",
        "claims_scanned",
        "claim_scan_complete",
        "artifact_limit",
        "artifacts_scanned",
        "artifact_file_bytes_limit",
        "artifact_total_bytes_limit",
        "artifact_bytes_scanned",
        "artifact_scan_complete",
        "artifact_phase",
        "requires_attention",
        "passed"
      ],
      "title": "ModelResponseRecoveryReport",
      "type": "object"
    },
    "PurgeDisposition": {
      "enum": [
        "PURGED",
        "RETAINED",
        "RECOVERY_REQUIRED"
      ],
      "title": "PurgeDisposition",
      "type": "string"
    },
    "PurgeItemResult": {
      "additionalProperties": false,
      "description": "Typed outcome for one content-addressed media retention decision.",
      "properties": {
        "audit_sequences": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Audit Sequences",
          "type": "array"
        },
        "crop_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "title": "Crop Refs",
          "type": "array"
        },
        "current_availability": {
          "$ref": "#/$defs/MediaAvailability"
        },
        "disposition": {
          "$ref": "#/$defs/PurgeDisposition"
        },
        "hold_kinds": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RetentionHoldKind"
          },
          "title": "Hold Kinds",
          "type": "array"
        },
        "media_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "previous_availability": {
          "$ref": "#/$defs/MediaAvailability"
        },
        "reason_code": {
          "$ref": "#/$defs/PurgeReasonCode"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "media_ref",
        "crop_refs",
        "disposition",
        "reason_code",
        "previous_availability",
        "current_availability"
      ],
      "title": "PurgeItemResult",
      "type": "object"
    },
    "PurgeReasonCode": {
      "enum": [
        "EXPIRED_AND_PURGED",
        "RECOVERED_PURGE_COMPLETED",
        "ACTIVE_RETENTION_HOLD",
        "RETENTION_NOT_EXPIRED",
        "ALREADY_PURGED",
        "PURGE_ALREADY_IN_PROGRESS",
        "MEDIA_FILE_MISSING",
        "MEDIA_INTEGRITY_FAILURE",
        "WORKSPACE_OPERATION_FAILED",
        "TRASH_CLEANUP_FAILED"
      ],
      "title": "PurgeReasonCode",
      "type": "string"
    },
    "RecoveryArea": {
      "description": "The two fixed workspace locations eligible for M2 startup recovery.",
      "enum": [
        "STAGING",
        "FINAL_MEDIA"
      ],
      "title": "RecoveryArea",
      "type": "string"
    },
    "RecoveryDisposition": {
      "enum": [
        "QUARANTINED",
        "CLEANED",
        "RETAINED",
        "ANOMALY"
      ],
      "title": "RecoveryDisposition",
      "type": "string"
    },
    "RecoveryItemResult": {
      "additionalProperties": false,
      "description": "One stable recovery decision without host paths or artifact bytes.",
      "properties": {
        "area": {
          "$ref": "#/$defs/RecoveryArea"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "disposition": {
          "$ref": "#/$defs/RecoveryDisposition"
        },
        "quarantine_relative_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quarantine Relative Path"
        },
        "reason_code": {
          "$ref": "#/$defs/RecoveryReasonCode"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "source_token": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Token",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "area",
        "source_token",
        "disposition",
        "reason_code"
      ],
      "title": "RecoveryItemResult",
      "type": "object"
    },
    "RecoveryReasonCode": {
      "enum": [
        "STAGING_QUARANTINED",
        "ORPHAN_QUARANTINED",
        "EMPTY_STAGING_CLEANED",
        "REFERENCED_MEDIA",
        "MINIMUM_AGE_NOT_MET",
        "UNKNOWN_ENTRY_SHAPE",
        "UNSAFE_FILESYSTEM_ENTRY",
        "CONTENT_IDENTITY_MISMATCH",
        "ENTRY_CHANGED_DURING_RECOVERY",
        "DEPTH_LIMIT_REACHED"
      ],
      "title": "RecoveryReasonCode",
      "type": "string"
    },
    "RecoveryReport": {
      "additionalProperties": false,
      "description": "Bounded run-scoped startup-recovery report in stable item order.",
      "properties": {
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RecoveryItemResult"
          },
          "title": "Items",
          "type": "array"
        },
        "not_modified_after": {
          "format": "date-time",
          "title": "Not Modified After",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "not_modified_after"
      ],
      "title": "RecoveryReport",
      "type": "object"
    },
    "RetentionHoldKind": {
      "enum": [
        "APPEAL",
        "GOLD_SET",
        "CHALLENGE_SET",
        "MANUAL_LEGAL_HOLD"
      ],
      "title": "RetentionHoldKind",
      "type": "string"
    },
    "StartupRecoveryReport": {
      "additionalProperties": false,
      "description": "One run-scoped outcome for ordered retention and orphan recovery.",
      "properties": {
        "orphan_report": {
          "$ref": "#/$defs/RecoveryReport"
        },
        "passed": {
          "readOnly": true,
          "title": "Passed",
          "type": "boolean"
        },
        "requires_attention": {
          "readOnly": true,
          "title": "Requires Attention",
          "type": "boolean"
        },
        "retention_items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PurgeItemResult"
          },
          "title": "Retention Items",
          "type": "array"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "started_at",
        "orphan_report",
        "requires_attention",
        "passed"
      ],
      "title": "StartupRecoveryReport",
      "type": "object"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/maintenance-recovery-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned envelope that preserves the frozen M2 startup report unchanged.",
  "properties": {
    "model_response_report": {
      "$ref": "#/$defs/ModelResponseRecoveryReport"
    },
    "passed": {
      "readOnly": true,
      "title": "Passed",
      "type": "boolean"
    },
    "requires_attention": {
      "readOnly": true,
      "title": "Requires Attention",
      "type": "boolean"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "storage_report": {
      "$ref": "#/$defs/StartupRecoveryReport"
    }
  },
  "required": [
    "run_id",
    "started_at",
    "storage_report",
    "model_response_report",
    "requires_attention",
    "passed"
  ],
  "title": "MaintenanceRecoveryReport",
  "type": "object"
}
