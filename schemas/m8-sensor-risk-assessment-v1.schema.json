{
  "$defs": {
    "M8OperationalRiskLevel": {
      "enum": [
        "REMINDER",
        "GENERAL",
        "SEVERE",
        "EMERGENCY"
      ],
      "title": "M8OperationalRiskLevel",
      "type": "string"
    },
    "M8OperationalSource": {
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "raw_reference_required": {
              "const": true
            }
          },
          "required": [
            "raw_reference_required"
          ]
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "LIVE_CAMERA"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "certification_id": {
                "type": "null"
              },
              "display_badge": {
                "const": "LIVE · CAMERA"
              },
              "emergency_authority_enabled": {
                "const": false
              },
              "life_safety_eligible": {
                "const": false
              },
              "sensor_type": {
                "type": "null"
              },
              "simulated": {
                "const": false
              },
              "source_kind": {
                "const": "CAMERA"
              },
              "timebase": {
                "const": "FRAME_INDEX"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "RECORDED_VIDEO_SIMULATION"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "certification_id": {
                "type": "null"
              },
              "display_badge": {
                "const": "SIMULATED · RECORDED VIDEO"
              },
              "emergency_authority_enabled": {
                "const": false
              },
              "life_safety_eligible": {
                "const": false
              },
              "sensor_type": {
                "type": "null"
              },
              "simulated": {
                "const": true
              },
              "source_kind": {
                "const": "CAMERA"
              },
              "timebase": {
                "const": "FRAME_INDEX"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "LIVE_SENSOR"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "allOf": [
              {
                "else": {
                  "properties": {
                    "life_safety_eligible": {
                      "const": false
                    }
                  }
                },
                "if": {
                  "properties": {
                    "emergency_authority_enabled": {
                      "const": true
                    }
                  },
                  "required": [
                    "emergency_authority_enabled"
                  ]
                },
                "then": {
                  "properties": {
                    "certification_id": {
                      "pattern": "^\\S{1,128}$",
                      "type": "string"
                    },
                    "life_safety_eligible": {
                      "const": true
                    }
                  },
                  "required": [
                    "certification_id"
                  ]
                }
              }
            ],
            "properties": {
              "certification_id": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "pattern": "^\\S{1,128}$",
                    "type": "string"
                  }
                ]
              },
              "display_badge": {
                "const": "LIVE · SENSOR"
              },
              "sensor_type": {
                "enum": [
                  "SMOKE",
                  "TEMPERATURE",
                  "COMBUSTIBLE_GAS",
                  "TOXIC_GAS",
                  "DOOR_CONTACT",
                  "WATER_LEAK",
                  "EMERGENCY_BUTTON"
                ],
                "type": "string"
              },
              "simulated": {
                "const": false
              },
              "source_kind": {
                "const": "SENSOR"
              },
              "timebase": {
                "const": "DEVICE_TIMESTAMP_UTC"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "SIMULATED_SENSOR"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "certification_id": {
                "type": "null"
              },
              "display_badge": {
                "const": "SIMULATED · SENSOR"
              },
              "emergency_authority_enabled": {
                "const": false
              },
              "life_safety_eligible": {
                "const": false
              },
              "sensor_type": {
                "enum": [
                  "SMOKE",
                  "TEMPERATURE",
                  "COMBUSTIBLE_GAS",
                  "TOXIC_GAS",
                  "DOOR_CONTACT",
                  "WATER_LEAK",
                  "EMERGENCY_BUTTON"
                ],
                "type": "string"
              },
              "simulated": {
                "const": true
              },
              "source_kind": {
                "const": "SENSOR"
              },
              "timebase": {
                "const": "SIMULATION_TICK"
              }
            }
          }
        }
      ],
      "description": "One camera or sensor source with machine-enforced truth labeling.",
      "properties": {
        "adapter_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "certification_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certification Id"
        },
        "device_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Device Id",
          "type": "string"
        },
        "display_badge": {
          "readOnly": true,
          "title": "Display Badge",
          "type": "string"
        },
        "emergency_authority_enabled": {
          "default": false,
          "title": "Emergency Authority Enabled",
          "type": "boolean"
        },
        "life_safety_eligible": {
          "readOnly": true,
          "title": "Life Safety Eligible",
          "type": "boolean"
        },
        "location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Location Id",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/M8OperationalSourceMode"
        },
        "raw_reference_required": {
          "default": true,
          "title": "Raw Reference Required",
          "type": "boolean"
        },
        "schema_version": {
          "const": "m8-operational-source-v1",
          "default": "m8-operational-source-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sensor_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/M8SensorType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "simulated": {
          "readOnly": true,
          "title": "Simulated",
          "type": "boolean"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/M8OperationalSourceKind",
          "readOnly": true
        },
        "timebase": {
          "$ref": "#/$defs/M8SourceTimebase",
          "readOnly": true
        }
      },
      "required": [
        "source_id",
        "device_id",
        "location_id",
        "mode",
        "adapter_id",
        "manifest_id",
        "source_kind",
        "timebase",
        "simulated",
        "display_badge",
        "life_safety_eligible"
      ],
      "title": "M8OperationalSource",
      "type": "object"
    },
    "M8OperationalSourceKind": {
      "enum": [
        "CAMERA",
        "SENSOR"
      ],
      "title": "M8OperationalSourceKind",
      "type": "string"
    },
    "M8OperationalSourceMode": {
      "enum": [
        "LIVE_CAMERA",
        "RECORDED_VIDEO_SIMULATION",
        "LIVE_SENSOR",
        "SIMULATED_SENSOR"
      ],
      "title": "M8OperationalSourceMode",
      "type": "string"
    },
    "M8SensorAssessmentReasonCode": {
      "enum": [
        "MATCHED_RULE",
        "NO_MATCHING_RULE",
        "SAMPLE_QUALITY_NOT_GOOD"
      ],
      "title": "M8SensorAssessmentReasonCode",
      "type": "string"
    },
    "M8SensorQuality": {
      "enum": [
        "GOOD",
        "DEGRADED",
        "INVALID"
      ],
      "title": "M8SensorQuality",
      "type": "string"
    },
    "M8SensorRiskOperator": {
      "enum": [
        "BOOLEAN_EQUALS",
        "INTEGER_GTE"
      ],
      "title": "M8SensorRiskOperator",
      "type": "string"
    },
    "M8SensorRiskPolicyAuthorityV1": {
      "additionalProperties": false,
      "description": "Versioned, ordered rule inventory separate from ordinary documents.",
      "properties": {
        "policy_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Policy Authority Id",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Manifest Id",
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/M8SensorRiskPolicyPurpose"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "rule_inventory_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Rule Inventory Sha256",
          "type": "string"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/M8SensorRiskRule"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        },
        "schema_version": {
          "const": "m8-sensor-risk-policy-authority-v1",
          "default": "m8-sensor-risk-policy-authority-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "revision",
        "purpose",
        "rules",
        "policy_manifest_id",
        "rule_inventory_sha256",
        "policy_authority_id"
      ],
      "title": "M8SensorRiskPolicyAuthorityV1",
      "type": "object"
    },
    "M8SensorRiskPolicyPurpose": {
      "enum": [
        "DEMONSTRATION",
        "OPERATIONAL"
      ],
      "title": "M8SensorRiskPolicyPurpose",
      "type": "string"
    },
    "M8SensorRiskRule": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "boolean_threshold": {
                "type": "null"
              },
              "integer_threshold": {
                "type": "integer"
              }
            },
            "required": [
              "integer_threshold"
            ]
          },
          "if": {
            "properties": {
              "operator": {
                "const": "BOOLEAN_EQUALS"
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "boolean_threshold": {
                "type": "boolean"
              },
              "integer_threshold": {
                "type": "null"
              }
            },
            "required": [
              "boolean_threshold"
            ]
          }
        },
        {
          "else": {
            "properties": {
              "response_deadline_seconds": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "create_pending_case": {
                "const": true
              }
            },
            "required": [
              "create_pending_case"
            ]
          },
          "then": {
            "properties": {
              "response_deadline_seconds": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "response_deadline_seconds"
            ]
          }
        }
      ],
      "description": "One explicitly configured typed threshold; never free-text parsed.",
      "properties": {
        "boolean_threshold": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boolean Threshold"
        },
        "create_pending_case": {
          "title": "Create Pending Case",
          "type": "boolean"
        },
        "integer_threshold": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Integer Threshold"
        },
        "operator": {
          "$ref": "#/$defs/M8SensorRiskOperator"
        },
        "priority": {
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "response_deadline_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Deadline Seconds"
        },
        "risk_level": {
          "$ref": "#/$defs/M8OperationalRiskLevel"
        },
        "rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Rule Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-sensor-risk-rule-v1",
          "default": "m8-sensor-risk-rule-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sensor_type": {
          "$ref": "#/$defs/M8SensorType"
        },
        "unit": {
          "$ref": "#/$defs/M8SensorUnit",
          "readOnly": true
        }
      },
      "required": [
        "rule_id",
        "sensor_type",
        "priority",
        "operator",
        "risk_level",
        "create_pending_case",
        "unit"
      ],
      "title": "M8SensorRiskRule",
      "type": "object"
    },
    "M8SensorSample": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "sensor_type": {
                "const": "SMOKE"
              }
            },
            "required": [
              "sensor_type"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "BOOLEAN"
              },
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sensor_type": {
                "const": "TEMPERATURE"
              }
            },
            "required": [
              "sensor_type"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "MILLI_CELSIUS"
              },
              "value": {
                "maximum": 500000,
                "minimum": -273150,
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sensor_type": {
                "const": "COMBUSTIBLE_GAS"
              }
            },
            "required": [
              "sensor_type"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "MILLI_PERCENT_LFL"
              },
              "value": {
                "maximum": 2147483647,
                "minimum": 0,
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sensor_type": {
                "const": "TOXIC_GAS"
              }
            },
            "required": [
              "sensor_type"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "MILLI_PPM"
              },
              "value": {
                "maximum": 2147483647,
                "minimum": 0,
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sensor_type": {
                "const": "DOOR_CONTACT"
              }
            },
            "required": [
              "sensor_type"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "BOOLEAN"
              },
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sensor_type": {
                "const": "WATER_LEAK"
              }
            },
            "required": [
              "sensor_type"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "BOOLEAN"
              },
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sensor_type": {
                "const": "EMERGENCY_BUTTON"
              }
            },
            "required": [
              "sensor_type"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "BOOLEAN"
              },
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "display_badge": {
                "const": "LIVE · SENSOR"
              },
              "observed_at_utc": {
                "format": "date-time",
                "type": "string"
              },
              "simulated": {
                "const": false
              },
              "simulation_tick": {
                "type": "null"
              }
            },
            "required": [
              "observed_at_utc"
            ]
          },
          "if": {
            "properties": {
              "timebase": {
                "const": "SIMULATION_TICK"
              }
            },
            "required": [
              "timebase"
            ]
          },
          "then": {
            "properties": {
              "display_badge": {
                "const": "SIMULATED · SENSOR"
              },
              "observed_at_utc": {
                "type": "null"
              },
              "simulated": {
                "const": true
              },
              "simulation_tick": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "simulation_tick"
            ]
          }
        }
      ],
      "description": "One integrity-bound sample from a catalogued sensor source.",
      "properties": {
        "adapter_input_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Adapter Input Authority Id",
          "type": "string"
        },
        "adapter_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Adapter Manifest Id",
          "type": "string"
        },
        "device_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "readOnly": true,
          "title": "Device Id",
          "type": "string"
        },
        "display_badge": {
          "readOnly": true,
          "title": "Display Badge",
          "type": "string"
        },
        "location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "readOnly": true,
          "title": "Location Id",
          "type": "string"
        },
        "observed_at_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At Utc"
        },
        "quality": {
          "$ref": "#/$defs/M8SensorQuality"
        },
        "raw_signal_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Raw Signal Ref",
          "type": "string"
        },
        "raw_signal_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Signal Sha256",
          "type": "string"
        },
        "sample_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Sample Id",
          "type": "string"
        },
        "sample_integrity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Sample Integrity Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-sensor-sample-v1",
          "default": "m8-sensor-sample-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sensor_type": {
          "$ref": "#/$defs/M8SensorType",
          "readOnly": true
        },
        "simulated": {
          "readOnly": true,
          "title": "Simulated",
          "type": "boolean"
        },
        "simulation_tick": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Simulation Tick"
        },
        "source": {
          "$ref": "#/$defs/M8OperationalSource"
        },
        "source_catalog_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Catalog Id",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "readOnly": true,
          "title": "Source Id",
          "type": "string"
        },
        "source_sequence": {
          "minimum": 0,
          "title": "Source Sequence",
          "type": "integer"
        },
        "timebase": {
          "$ref": "#/$defs/M8SourceTimebase",
          "readOnly": true
        },
        "unit": {
          "$ref": "#/$defs/M8SensorUnit",
          "readOnly": true
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "source_catalog_id",
        "source",
        "source_sequence",
        "value",
        "quality",
        "raw_signal_ref",
        "raw_signal_sha256",
        "adapter_input_authority_id",
        "adapter_manifest_id",
        "source_id",
        "device_id",
        "location_id",
        "sensor_type",
        "timebase",
        "unit",
        "simulated",
        "display_badge",
        "sample_integrity_sha256",
        "sample_id"
      ],
      "title": "M8SensorSample",
      "type": "object"
    },
    "M8SensorType": {
      "enum": [
        "SMOKE",
        "TEMPERATURE",
        "COMBUSTIBLE_GAS",
        "TOXIC_GAS",
        "DOOR_CONTACT",
        "WATER_LEAK",
        "EMERGENCY_BUTTON"
      ],
      "title": "M8SensorType",
      "type": "string"
    },
    "M8SensorUnit": {
      "enum": [
        "BOOLEAN",
        "MILLI_CELSIUS",
        "MILLI_PERCENT_LFL",
        "MILLI_PPM"
      ],
      "title": "M8SensorUnit",
      "type": "string"
    },
    "M8SourceTimebase": {
      "enum": [
