{
  "$defs": {
    "BBoxXYXY": {
      "additionalProperties": false,
      "description": "Integer `[x1, y1, x2, y2)` bounding box.",
      "properties": {
        "x1": {
          "minimum": 0,
          "title": "X1",
          "type": "integer"
        },
        "x2": {
          "exclusiveMinimum": 0,
          "title": "X2",
          "type": "integer"
        },
        "y1": {
          "minimum": 0,
          "title": "Y1",
          "type": "integer"
        },
        "y2": {
          "exclusiveMinimum": 0,
          "title": "Y2",
          "type": "integer"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "BBoxXYXY",
      "type": "object"
    },
    "M5AppealResolutionCommandReport": {
      "additionalProperties": false,
      "description": "Audit-safe terminal report without reproducing human-authored free text.",
      "properties": {
        "affected_citation_case_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Affected Citation Case Ids",
          "type": "array"
        },
        "affected_citation_report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Affected Citation Report Sha256",
          "type": "string"
        },
        "appeal_authority_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Appeal Authority Sha256",
          "type": "string"
        },
        "appeal_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Appeal Id",
          "type": "string"
        },
        "appeal_version": {
          "const": 3,
          "default": 3,
          "title": "Appeal Version",
          "type": "integer"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "committed_case_revision": {
          "exclusiveMinimum": 0,
          "title": "Committed Case Revision",
          "type": "integer"
        },
        "final_decision": {
          "$ref": "#/$defs/VerdictDecision"
        },
        "precedent_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Precedent Snapshot Sha256",
          "type": "string"
        },
        "previous_appeal_authority_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Previous Appeal Authority Sha256",
          "type": "string"
        },
        "replacement_precedent_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement Precedent Id"
        },
        "rescinded_alert_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Rescinded Alert Ids",
          "type": "array"
        },
        "resolution_intent_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Resolution Intent Id",
          "type": "string"
        },
        "reviewer_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Reviewer Id",
          "type": "string"
        },
        "revoked_precedent_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Revoked Precedent Ids",
          "type": "array"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "source_case_revision": {
          "exclusiveMinimum": 0,
          "title": "Source Case Revision",
          "type": "integer"
        },
        "source_decision": {
          "$ref": "#/$defs/VerdictDecision"
        },
        "status": {
          "enum": [
            "UPHELD",
            "OVERTURNED"
          ],
          "title": "Status",
          "type": "string"
        },
        "training_label_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Training Label Ids",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "appeal_id",
        "source_case_revision",
        "committed_case_revision",
        "status",
        "reviewer_id",
        "source_decision",
        "final_decision",
        "previous_appeal_authority_sha256",
        "appeal_authority_sha256",
        "precedent_snapshot_sha256",
        "affected_citation_report_sha256",
        "resolution_intent_id"
      ],
      "title": "M5AppealResolutionCommandReport",
      "type": "object"
    },
    "M5AppealTrainingLabelInput": {
      "additionalProperties": false,
      "description": "Reviewer-authored label facts; authority fields are bound by the application.",
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BBoxXYXY"
        },
        "crop_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Crop Id",
          "type": "string"
        },
        "input_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Input Id",
          "type": "string"
        },
        "label_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Label Name",
          "type": "string"
        },
        "label_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label Value"
        }
      },
      "required": [
        "crop_id",
        "bbox",
        "label_name",
        "label_value",
        "input_id"
      ],
      "title": "M5AppealTrainingLabelInput",
      "type": "object"
    },
    "VerdictDecision": {
      "enum": [
        "ESTABLISHED",
        "NOT_ESTABLISHED",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "VerdictDecision",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/pilot-a4-review-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Audit-safe projection of one thin pilot review onto the M5 appeal authority.",
  "properties": {
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "disclaimer": {
      "const": "用于安全辅助与记录，不直接作为处罚依据",
      "default": "用于安全辅助与记录，不直接作为处罚依据",
      "title": "Disclaimer",
      "type": "string"
    },
    "index_path": {
      "title": "Index Path",
      "type": "string"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "metrics_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Metrics Id",
      "type": "string"
    },
    "production_delivery_count": {
      "const": 0,
      "default": 0,
      "title": "Production Delivery Count",
      "type": "integer"
    },
    "publication_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Publication Id",
      "type": "string"
    },
    "reason_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reason Sha256",
      "type": "string"
    },
    "requested_decision": {
      "$ref": "#/$defs/VerdictDecision"
    },
    "resolution": {
      "$ref": "#/$defs/M5AppealResolutionCommandReport"
    },
    "review_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Review Id",
      "type": "string"
    },
    "review_label": {
      "anyOf": [
        {
          "$ref": "#/$defs/M5AppealTrainingLabelInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "pilot-a4-review-report-v1",
      "default": "pilot-a4-review-report-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_decision": {
      "$ref": "#/$defs/VerdictDecision"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "source_decision",
    "requested_decision",
    "reason_sha256",
    "manifest_id",
    "resolution",
    "publication_id",
    "metrics_id",
    "index_path",
    "review_id"
  ],
  "title": "PilotA4ReviewReport",
  "type": "object"
}
