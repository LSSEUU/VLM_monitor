{
  "$defs": {
    "M5EmbeddingChannel": {
      "enum": [
        "TEXT",
        "VISUAL"
      ],
      "title": "M5EmbeddingChannel",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m5-embedding-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "FAKE_SHA256_SIGNED_PROJECTION_V1",
      "default": "FAKE_SHA256_SIGNED_PROJECTION_V1",
      "title": "Algorithm",
      "type": "string"
    },
    "channel": {
      "$ref": "#/$defs/M5EmbeddingChannel"
    },
    "dimensions": {
      "exclusiveMinimum": 0,
      "maximum": 4096,
      "title": "Dimensions",
      "type": "integer"
    },
    "input_ref": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Input Ref",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "model_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Manifest Id",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m5-embedding-request-v1",
      "default": "m5-embedding-request-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "channel",
    "input_ref",
    "input_sha256",
    "model_manifest_id",
    "dimensions",
    "request_id"
  ],
  "title": "M5EmbeddingRequest",
  "type": "object"
}
