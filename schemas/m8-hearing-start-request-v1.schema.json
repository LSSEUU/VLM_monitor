{
  "$defs": {
    "CaseStatus": {
      "enum": [
        "CANDIDATE",
        "EVIDENCE_READY",
        "SCREENED",
        "ESCALATED",
        "DELIBERATING",
        "PROCEDURAL_REVIEW",
        "READY_FOR_ALERT_POLICY",
        "REWORK_REQUIRED",
        "HUMAN_REVIEW",
        "BACKLOGGED",
        "CLOSED",
        "APPEALED",
        "APPEAL_RESOLVED"
      ],
      "title": "CaseStatus",
      "type": "string"
    },
    "M8HearingModelMode": {
      "enum": [
        "OFFLINE_FIXTURE",
        "OPENAI_COMPATIBLE_QWEN"
      ],
      "title": "M8HearingModelMode",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-hearing-start-request-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Explicit source fence and model selection for one M4 hearing start.",
  "properties": {
    "automatic_start_permitted": {
      "readOnly": true,
      "title": "Automatic Start Permitted",
      "type": "boolean"
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "clear_case_forcing_permitted": {
      "readOnly": true,
      "title": "Clear Case Forcing Permitted",
      "type": "boolean"
    },
    "client_actor_authority_permitted": {
      "readOnly": true,
      "title": "Client Actor Authority Permitted",
      "type": "boolean"
    },
    "explicit_start": {
      "const": true,
      "default": true,
      "title": "Explicit Start",
      "type": "boolean"
    },
    "model_mode": {
      "$ref": "#/$defs/M8HearingModelMode",
      "default": "OFFLINE_FIXTURE"
    },
    "request_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Manifest Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m8-hearing-start-request-v1",
      "default": "m8-hearing-start-request-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_evidence_pack_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Evidence Pack Id",
      "type": "string"
    },
    "source_evidence_pack_version": {
      "exclusiveMinimum": 0,
      "title": "Source Evidence Pack Version",
      "type": "integer"
    },
    "source_screening_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Screening Id",
      "type": "string"
    },
    "source_status": {
      "$ref": "#/$defs/CaseStatus"
    },
    "start_request_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Start Request Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "source_status",
    "source_screening_id",
    "source_evidence_pack_id",
    "source_evidence_pack_version",
    "request_manifest_id",
    "client_actor_authority_permitted",
    "automatic_start_permitted",
    "clear_case_forcing_permitted",
    "start_request_id"
  ],
  "title": "M8HearingStartRequestV1",
  "type": "object"
}
