{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "RUN",
        "FRAME",
        "SAFETY_SIGNAL",
        "EVENT",
        "CASE",
        "DETECTION",
        "OBJECTIVE_FACT",
        "CROP",
        "MEDIA",
        "EVIDENCE_PACK",
        "TOOL_RESULT",
        "MANIFEST",
        "MODEL_RESPONSE",
        "MODEL_REQUEST",
        "PROMPT_MANIFEST",
        "MODEL_PARSE_RECEIPT",
        "PARSED_MODEL_OUTPUT",
        "PROCEDURAL_REVIEW",
        "MODEL_CACHE_ENTRY",
        "SCREENING_RESULT",
        "VERDICT",
        "ALERT",
        "PRECEDENT",
        "APPEAL",
        "TRAINING_LABEL",
        "BACKLOG_ITEM",
        "DATASET"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A kind-discriminated reference with syntax fixed by the artifact kind.",
      "properties": {
        "artifact_id": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactVerification": {
      "additionalProperties": false,
      "description": "A media-specific verification result with a complete expected/actual matrix.",
      "properties": {
        "actual_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Height"
        },
        "actual_media_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Media Sha256"
        },
        "actual_output_pixel_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Output Pixel Sha256"
        },
        "actual_size_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Size Bytes"
        },
        "actual_source_pixel_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Source Pixel Sha256"
        },
        "actual_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Width"
        },
        "artifact_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "availability": {
          "$ref": "#/$defs/MediaAvailability"
        },
        "expected_height": {
          "exclusiveMinimum": 0,
          "title": "Expected Height",
          "type": "integer"
        },
        "expected_media_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Media Sha256",
          "type": "string"
        },
        "expected_output_pixel_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Output Pixel Sha256",
          "type": "string"
        },
        "expected_size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Expected Size Bytes",
          "type": "integer"
        },
        "expected_source_pixel_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Source Pixel Sha256",
          "type": "string"
        },
        "expected_width": {
          "exclusiveMinimum": 0,
          "title": "Expected Width",
          "type": "integer"
        },
        "media_type": {
          "$ref": "#/$defs/MediaType"
        },
        "reason_code": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "status": {
          "$ref": "#/$defs/VerificationStatus"
        }
      },
      "required": [
        "artifact_ref",
        "status",
        "availability",
        "media_type",
        "expected_source_pixel_sha256",
        "expected_output_pixel_sha256",
        "expected_media_sha256",
        "expected_width",
        "expected_height",
        "expected_size_bytes"
      ],
      "title": "ArtifactVerification",
      "type": "object"
    },
    "ClosureDefect": {
      "additionalProperties": false,
      "description": "A typed closure failure; diagnostic context is explicit, never an open map.",
      "properties": {
        "actual_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Height"
        },
        "actual_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Sha256"
        },
        "actual_size_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Size Bytes"
        },
        "actual_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Width"
        },
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "code": {
          "$ref": "#/$defs/ClosureDefectCode"
        },
        "end_frame_exclusive": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Frame Exclusive"
        },
        "expected_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Height"
        },
        "expected_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Sha256"
        },
        "expected_size_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Size Bytes"
        },
        "expected_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Width"
        },
        "field": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "frame_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Index"
        },
        "reason_code": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "related_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "start_frame": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Frame"
        }
      },
      "required": [
        "code"
      ],
      "title": "ClosureDefect",
      "type": "object"
    },
    "ClosureDefectCode": {
      "enum": [
        "MISSING_REFERENCE",
        "CROSS_RUN_REFERENCE",
        "CROSS_CASE_REFERENCE",
        "CROSS_STREAM_FRAME",
        "FRAME_OUTSIDE_WINDOW",
        "MISSING_TRIGGER_FRAME",
        "BBOX_OUT_OF_BOUNDS",
        "CROP_ROLE_MISMATCH",
        "TRACK_MISMATCH",
        "OBJECTIVE_SOURCE_MISSING",
        "TOOL_INPUT_MISSING",
        "TOOL_OUTPUT_MISSING",
        "PATH_BOUNDARY_VIOLATION",
        "UNSAFE_LINK",
        "NOT_REGULAR_FILE",
        "MEDIA_MISSING",
        "MEDIA_PURGED_BY_RETENTION",
        "SOURCE_HASH_MISMATCH",
        "MEDIA_HASH_MISMATCH",
        "MEDIA_SIZE_MISMATCH",
        "PIXEL_HASH_MISMATCH",
        "MEDIA_DIMENSION_MISMATCH",
        "PRIVACY_POLICY_VIOLATION",
        "MANIFEST_MISMATCH",
        "IDENTITY_MISMATCH"
      ],
      "title": "ClosureDefectCode",
      "type": "string"
    },
    "ClosureReport": {
      "additionalProperties": false,
      "properties": {
        "checked_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "title": "Checked Refs",
          "type": "array"
        },
        "defects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ClosureDefect"
          },
          "title": "Defects",
          "type": "array"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "passed": {
          "readOnly": true,
          "title": "Passed",
          "type": "boolean"
        },
        "root_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "validator_version": {
          "const": "m2-closure-v1",
          "default": "m2-closure-v1",
          "title": "Validator Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "root_ref",
        "manifest_id",
        "input_sha256",
        "checked_refs",
        "passed"
      ],
      "title": "ClosureReport",
      "type": "object"
    },
    "M6GateCurrentClosureBasis": {
      "enum": [
        "CURRENT_PRIVACY_CROP_REVERIFIED",
        "SEMANTIC_ONLY_NO_CROPS"
      ],
      "title": "M6GateCurrentClosureBasis",
      "type": "string"
    },
    "M6GateCurrentClosureReceipt": {
      "additionalProperties": false,
      "description": "One review-scoped current closure sealed before media retention.",
      "properties": {
        "basis": {
          "$ref": "#/$defs/M6GateCurrentClosureBasis"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "crop_verifications": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactVerification"
          },
          "maxItems": 256,
          "title": "Crop Verifications",
          "type": "array"
        },
        "current_closure": {
          "$ref": "#/$defs/ClosureReport"
        },
        "evidence_pack_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Pack Document Sha256",
          "type": "string"
        },
        "evidence_pack_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Pack Id",
          "type": "string"
        },
        "evidence_pack_version": {
          "exclusiveMinimum": 0,
          "title": "Evidence Pack Version",
          "type": "integer"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "receipt_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Receipt Document Sha256",
          "type": "string"
        },
        "receipt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Receipt Id",
          "type": "string"
        },
        "review_version": {
          "exclusiveMinimum": 0,
          "title": "Review Version",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m6-gate-current-closure-receipt-v1",
          "default": "m6-gate-current-closure-receipt-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_review_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Review Document Sha256",
          "type": "string"
        },
        "source_review_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Review Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "manifest_id",
        "review_version",
        "source_review_id",
        "source_review_document_sha256",
        "evidence_pack_id",
        "evidence_pack_version",
        "evidence_pack_document_sha256",
        "basis",
        "current_closure",
        "receipt_id",
        "receipt_document_sha256"
      ],
      "title": "M6GateCurrentClosureReceipt",
      "type": "object"
    },
    "MediaAvailability": {
      "enum": [
        "AVAILABLE",
        "PURGING",
        "PURGED_BY_RETENTION"
      ],
      "title": "MediaAvailability",
      "type": "string"
    },
    "MediaType": {
      "enum": [
        "IMAGE_PNG",
        "VIDEO"
      ],
      "title": "MediaType",
      "type": "string"
    },
    "VerificationStatus": {
      "enum": [
        "VERIFIED",
        "CURRENT_MEDIA_VERIFIED",
        "MISSING",
        "SOURCE_HASH_MISMATCH",
        "MEDIA_HASH_MISMATCH",
        "SIZE_MISMATCH",
        "PIXEL_HASH_MISMATCH",
        "DIMENSION_MISMATCH",
        "PATH_BOUNDARY_VIOLATION",
        "UNSAFE_LINK",
        "NOT_REGULAR_FILE",
        "INVALID_MEDIA",
        "PRIVACY_POLICY_VIOLATION",
        "PURGED_BY_RETENTION"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m6-replay-input-authority.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Content-addressed source catalog dereferenced by locked replay.",
  "properties": {
    "detection_inventory_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Detection Inventory Root Sha256",
      "type": "string"
    },
    "embedding_inventory_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Embedding Inventory Root Sha256",
      "type": "string"
    },
    "frame_inventory_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Frame Inventory Root Sha256",
      "type": "string"
    },
    "gate_current_closure_count": {
      "readOnly": true,
      "title": "Gate Current Closure Count",
      "type": "integer"
    },
    "gate_current_closure_inventory_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Gate Current Closure Inventory Root Sha256",
      "type": "string"
    },
    "gate_current_closures": {
      "default": [],
      "items": {
        "$ref": "#/$defs/M6GateCurrentClosureReceipt"
      },
      "maxItems": 64,
      "title": "Gate Current Closures",
      "type": "array"
    },
    "historical_causal_cut_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Historical Causal Cut Id",
      "type": "string"
    },
    "input_authority_document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Input Authority Document Sha256",
      "type": "string"
    },
    "input_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Input Authority Id",
      "type": "string"
    },
    "model_call_inventory_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Call Inventory Root Sha256",
      "type": "string"
    },
    "sample_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m6-replay-input-authority-v1",
      "default": "m6-replay-input-authority-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_case_document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Case Document Sha256",
      "type": "string"
    },
    "source_case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Source Case Id",
      "type": "string"
    },
    "source_case_revision": {
      "exclusiveMinimum": 0,
      "title": "Source Case Revision",
      "type": "integer"
    },
    "source_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Config Sha256",
      "type": "string"
    },
    "source_m4_authority_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source M4 Authority Root Sha256",
      "type": "string"
    },
    "source_m5_authority_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source M5 Authority Root Sha256",
      "type": "string"
    },
    "source_manifest_document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Manifest Document Sha256",
      "type": "string"
    },
    "source_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Manifest Id",
      "type": "string"
    },
    "source_run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Source Run Id",
      "type": "string"
    },
    "source_validation_report_document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Validation Report Document Sha256",
      "type": "string"
    },
    "source_validation_report_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Validation Report Id",
      "type": "string"
    },
    "tool_result_inventory_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Tool Result Inventory Root Sha256",
      "type": "string"
    }
  },
  "required": [
    "sample_id",
    "source_run_id",
    "source_case_id",
    "source_case_revision",
    "source_case_document_sha256",
    "source_manifest_id",
    "source_manifest_document_sha256",
    "source_config_sha256",
    "source_m4_authority_root_sha256",
    "source_m5_authority_root_sha256",
    "source_validation_report_id",
    "source_validation_report_document_sha256",
    "frame_inventory_root_sha256",
    "detection_inventory_root_sha256",
    "model_call_inventory_root_sha256",
    "embedding_inventory_root_sha256",
    "tool_result_inventory_root_sha256",
    "historical_causal_cut_id",
    "gate_current_closure_count",
    "gate_current_closure_inventory_root_sha256",
    "input_authority_id",
    "input_authority_document_sha256"
  ],
  "title": "M6ReplayInputAuthority",
  "type": "object"
}
