{
  "$id": "https://schemas.labcourt.local/v2/pilot-perception-worker-failure.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Sanitized worker failure; model exceptions never become empty detections.",
  "properties": {
    "error_code": {
      "enum": [
        "IMAGE_INVALID",
        "INFERENCE_FAILED",
        "TRACKER_FAILED",
        "REQUEST_INVALID"
      ],
      "title": "Error Code",
      "type": "string"
    },
    "frame_content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Frame Content Sha256",
      "type": "string"
    },
    "frame_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:(?:0|[1-9][0-9]{0,19})$",
      "title": "Frame Id",
      "type": "string"
    },
    "kind": {
      "const": "RESULT",
      "default": "RESULT",
      "title": "Kind",
      "type": "string"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "protocol_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Request Id",
      "type": "string"
    },
    "status": {
      "const": "FAILED",
      "default": "FAILED",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "frame_id",
    "frame_content_sha256",
    "manifest_id",
    "error_code"
  ],
  "title": "PilotPerceptionWorkerFailure",
  "type": "object"
}
