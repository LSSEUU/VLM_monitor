{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "RUN",
        "FRAME",
        "SAFETY_SIGNAL",
        "EVENT",
        "CASE",
        "DETECTION",
        "OBJECTIVE_FACT",
        "CROP",
        "MEDIA",
        "EVIDENCE_PACK",
        "TOOL_RESULT",
        "MANIFEST",
        "MODEL_RESPONSE",
        "MODEL_REQUEST",
        "PROMPT_MANIFEST",
        "MODEL_PARSE_RECEIPT",
        "PARSED_MODEL_OUTPUT",
        "PROCEDURAL_REVIEW",
        "MODEL_CACHE_ENTRY",
        "SCREENING_RESULT",
        "VERDICT",
        "ALERT",
        "PRECEDENT",
        "APPEAL",
        "TRAINING_LABEL",
        "BACKLOG_ITEM",
        "DATASET"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A kind-discriminated reference with syntax fixed by the artifact kind.",
      "properties": {
        "artifact_id": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "EvidenceClass": {
      "enum": [
        "PRESENCE",
        "ABSENCE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "HearingPrecedentDegradedReason": {
      "enum": [
        "EMBEDDING_PROVIDER_UNAVAILABLE",
        "EMBEDDING_MODEL_UNAVAILABLE",
        "PRECEDENT_INDEX_UNAVAILABLE"
      ],
      "title": "HearingPrecedentDegradedReason",
      "type": "string"
    },
    "HearingPrecedentRetrievalQuery": {
      "additionalProperties": false,
      "description": "Content-addressed M4 query bound to every current retrieval authority.",
      "properties": {
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "current_evidence_pack_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Current Evidence Pack Id",
          "type": "string"
        },
        "current_evidence_pack_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Current Evidence Pack Sha256",
          "type": "string"
        },
        "current_evidence_pack_version": {
          "exclusiveMinimum": 0,
          "title": "Current Evidence Pack Version",
          "type": "integer"
        },
        "cycle_scope_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cycle Scope Id",
          "type": "string"
        },
        "cycle_scope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cycle Scope Sha256",
          "type": "string"
        },
        "embedding_model_manifest": {
          "$ref": "#/$defs/ModelManifest"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "hearing_session_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hearing Session Id",
          "type": "string"
        },
        "hearing_session_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hearing Session Sha256",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "query_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Query Id",
          "type": "string"
        },
        "query_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Query Sha256",
          "type": "string"
        },
        "retriever_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Retriever Manifest Id",
          "type": "string"
        },
        "retriever_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Retriever Version",
          "type": "string"
        },
        "rule_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Rule Version",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m4-hearing-precedent-query-v1",
          "default": "m4-hearing-precedent-query-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "situation_text": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Situation Text",
          "type": "string"
        },
        "top_k": {
          "exclusiveMinimum": 0,
          "maximum": 64,
          "title": "Top K",
          "type": "integer"
        },
        "violation_type": {
          "$ref": "#/$defs/ViolationType"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "hearing_session_id",
        "hearing_session_sha256",
        "cycle_scope_id",
        "cycle_scope_sha256",
        "current_evidence_pack_id",
        "current_evidence_pack_version",
        "current_evidence_pack_sha256",
        "evidence_class",
        "violation_type",
        "rule_version",
        "situation_text",
        "top_k",
        "config_sha256",
        "retriever_version",
        "retriever_manifest_id",
        "embedding_model_manifest",
        "manifest_id",
        "query_id",
        "query_sha256"
      ],
      "title": "HearingPrecedentRetrievalQuery",
      "type": "object"
    },
    "HearingPrecedentRetrievalReceipt": {
      "additionalProperties": false,
      "description": "Auditable visible-set and ranked-result authority for one hearing round.",
      "properties": {
        "candidate_precedent_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "maxItems": 10000,
          "title": "Candidate Precedent Refs",
          "type": "array"
        },
        "candidate_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Snapshot Sha256",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "current_evidence_pack_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Current Evidence Pack Id",
          "type": "string"
        },
        "current_evidence_pack_version": {
          "exclusiveMinimum": 0,
          "title": "Current Evidence Pack Version",
          "type": "integer"
        },
        "cycle_scope_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Cycle Scope Id",
          "type": "string"
        },
        "cycle_scope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Cycle Scope Sha256",
          "type": "string"
        },
        "degraded_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/HearingPrecedentDegradedReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "embedding_model_manifest_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Model Manifest Id"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "hearing_session_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hearing Session Id",
          "type": "string"
        },
        "initial_defect_codes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProceduralDefectCode"
          },
          "maxItems": 14,
          "title": "Initial Defect Codes",
          "type": "array"
        },
        "initial_trigger_review_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "prior_acquisition_rounds": {
          "maximum": 2,
          "minimum": 0,
          "title": "Prior Acquisition Rounds",
          "type": "integer"
        },
        "prior_rework_rounds": {
          "maximum": 2,
          "minimum": 0,
          "title": "Prior Rework Rounds",
          "type": "integer"
        },
        "query_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Query Sha256",
          "type": "string"
        },
        "receipt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Receipt Id",
          "type": "string"
        },
        "receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Receipt Sha256",
          "type": "string"
        },
        "retriever_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Retriever Manifest Id",
          "type": "string"
        },
        "retriever_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Retriever Version",
          "type": "string"
        },
        "rework_defect_codes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProceduralDefectCode"
          },
          "maxItems": 14,
          "title": "Rework Defect Codes",
          "type": "array"
        },
        "rework_review_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "round_index": {
          "exclusiveMinimum": 0,
          "maximum": 5,
          "title": "Round Index",
          "type": "integer"
        },
        "rule_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Rule Version",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m4-hearing-precedent-retrieval-v1",
          "default": "m4-hearing-precedent-retrieval-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scored_precedents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScoredPrecedent"
          },
          "maxItems": 64,
          "title": "Scored Precedents",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/HearingPrecedentRetrievalStatus"
        },
        "top_k": {
          "maximum": 64,
          "minimum": 0,
          "title": "Top K",
          "type": "integer"
        },
        "violation_type": {
          "$ref": "#/$defs/ViolationType"
        },
        "visible_precedent_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "maxItems": 10000,
          "title": "Visible Precedent Refs",
          "type": "array"
        },
        "visible_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Visible Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "hearing_session_id",
        "round_index",
        "prior_acquisition_rounds",
        "prior_rework_rounds",
        "current_evidence_pack_id",
        "current_evidence_pack_version",
        "evidence_class",
        "violation_type",
        "rule_version",
        "top_k",
        "query_sha256",
        "candidate_snapshot_sha256",
        "visible_snapshot_sha256",
        "status",
        "retriever_version",
        "retriever_manifest_id",
        "manifest_id",
        "cycle_scope_id",
        "cycle_scope_sha256",
        "receipt_id",
        "receipt_sha256"
      ],
      "title": "HearingPrecedentRetrievalReceipt",
      "type": "object"
    },
    "HearingPrecedentRetrievalResult": {
      "additionalProperties": false,
      "description": "Successful, self-verifying candidate snapshot and prompt-visible ranking.",
      "properties": {
        "candidate_precedents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Precedent"
          },
          "maxItems": 10000,
          "title": "Candidate Precedents",
          "type": "array"
        },
        "candidate_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Candidate Snapshot Sha256",
          "type": "string"
        },
        "query": {
          "$ref": "#/$defs/HearingPrecedentRetrievalQuery"
        },
        "result_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Result Id",
          "type": "string"
        },
        "result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Result Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "m4-hearing-precedent-result-v1",
          "default": "m4-hearing-precedent-result-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scored_precedents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScoredPrecedent"
          },
          "maxItems": 64,
          "title": "Scored Precedents",
          "type": "array"
        },
        "visible_precedents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Precedent"
          },
          "maxItems": 64,
          "title": "Visible Precedents",
          "type": "array"
        },
        "visible_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Visible Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "query",
        "candidate_snapshot_sha256",
        "visible_snapshot_sha256",
        "result_id",
        "result_sha256"
      ],
      "title": "HearingPrecedentRetrievalResult",
      "type": "object"
    },
    "HearingPrecedentRetrievalStatus": {
      "enum": [
        "SUCCESS",
        "DEGRADED"
      ],
      "title": "HearingPrecedentRetrievalStatus",
      "type": "string"
    },
    "ModelManifest": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "license_id": {
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Model Manifest Id",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "provider_revision_guarantee": {
          "default": true,
          "title": "Provider Revision Guarantee",
          "type": "boolean"
        },
        "quantization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantization"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "weights_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weights Sha256"
        }
      },
      "required": [
        "component",
        "provider",
        "model",
        "revision",
        "license_id",
        "model_manifest_id"
      ],
      "title": "ModelManifest",
      "type": "object"
    },
    "Precedent": {
      "additionalProperties": false,
      "properties": {
        "activation_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activation At"
        },
        "citation_count": {
          "default": 0,
          "minimum": 0,
          "title": "Citation Count",
          "type": "integer"
        },
        "decision_direction": {
          "$ref": "#/$defs/VerdictDecision"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "invalidated_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalidated By"
        },
        "precedent_id": {
          "minLength": 1,
          "title": "Precedent Id",
          "type": "string"
        },
        "rule_version": {
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "situation_text": {
          "minLength": 1,
          "title": "Situation Text",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/PrecedentSource"
        },
        "source_case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Case Id"
        },
        "status": {
          "$ref": "#/$defs/PrecedentStatus"
        },
        "text_embedding_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Embedding Ref"
        },
        "violation_type": {
          "$ref": "#/$defs/ViolationType"
        },
        "visual_embedding_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Visual Embedding Refs",
          "type": "array"
        }
      },
      "required": [
        "precedent_id",
        "situation_text",
        "decision_direction",
        "source",
        "status",
        "evidence_class",
        "violation_type",
        "rule_version"
      ],
      "title": "Precedent",
      "type": "object"
    },
    "PrecedentSource": {
      "enum": [
        "PRESET",
        "AUTOMATIC",
        "HUMAN_REVIEW",
        "APPEAL_OVERTURN"
      ],
      "title": "PrecedentSource",
      "type": "string"
    },
    "PrecedentStatus": {
      "enum": [
        "PROVISIONAL",
        "ACTIVE",
        "CONFLICT",
        "INVALIDATED",
        "REVOKED"
      ],
      "title": "PrecedentStatus",
      "type": "string"
    },
    "ProceduralDefectCode": {
      "enum": [
        "MALFORMED_STRUCTURE",
        "INVALID_ENUM",
        "MISSING_REQUIRED_FIELD",
        "FABRICATED_EVIDENCE_REFERENCE",
        "INVALID_COORDINATES",
        "FABRICATED_PRECEDENT_REFERENCE",
        "PRECEDENT_DIRECTION_MISMATCH",
        "EMPTY_DISTINGUISHING_REASON",
        "ESTABLISHED_WITHOUT_EVIDENCE",
        "UNANSWERED_DEFENSE_POINT",
        "CONFIDENCE_ALERT_LEVEL_MISMATCH",
        "OBJECTIVE_ASSERTION_CONTRADICTION",
        "VIOLATION_TYPE_MISMATCH",
        "ABSENCE_FROM_INSUFFICIENT_OBSERVATION"
      ],
      "title": "ProceduralDefectCode",
      "type": "string"
    },
    "ScoredPrecedent": {
      "additionalProperties": false,
      "properties": {
        "fused_score": {
          "minimum": -1,
          "title": "Fused Score",
          "type": "number"
        },
        "precedent": {
          "$ref": "#/$defs/Precedent"
        },
        "text_similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Similarity"
        },
        "visual_similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visual Similarity"
        }
      },
      "required": [
        "precedent",
        "fused_score"
      ],
      "title": "ScoredPrecedent",
      "type": "object"
    },
    "VerdictDecision": {
      "enum": [
        "ESTABLISHED",
        "NOT_ESTABLISHED",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "VerdictDecision",
      "type": "string"
    },
    "ViolationType": {
      "enum": [
        "PPE_GOGGLES_MISSING",
        "PPE_GLOVES_MISSING",
        "PPE_LAB_COAT_MISSING",
        "REAGENT_CONTAINER_OPEN",
        "FOOD_OR_DRINK_IN_LAB",
        "SINGLE_PERSON_HAZARDOUS_OPERATION",
        "FUME_HOOD_SASH_TOO_HIGH",
        "UNATTENDED_HEATING",
        "SMOKE_ABNORMAL",
        "OPEN_FLAME"
      ],
      "title": "ViolationType",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/hearing-precedent-retrieval-outcome.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact application result joining a query, optional success result, and receipt.",
  "properties": {
    "query": {
      "$ref": "#/$defs/HearingPrecedentRetrievalQuery"
    },
    "receipt": {
      "$ref": "#/$defs/HearingPrecedentRetrievalReceipt"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/HearingPrecedentRetrievalResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "query",
    "receipt"
  ],
  "title": "HearingPrecedentRetrievalOutcome",
  "type": "object"
}
