{
  "$defs": {
    "M8PreHearingOutcomeCode": {
      "description": "Typed, non-model outcomes produced before an M4 session exists.",
      "enum": [
        "NO_NOVEL_CLEAR_FRAME"
      ],
      "title": "M8PreHearingOutcomeCode",
      "type": "string"
    },
    "M8PreHearingPreparationState": {
      "description": "Append-only lifecycle of one objective-evidence gate decision.",
      "enum": [
        "PENDING",
        "COMPLETED"
      ],
      "title": "M8PreHearingPreparationState",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-prehearing-preparation-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Restart-safe authority for an insufficient-observation M3 escalation.\n\nThis contract intentionally represents only the first, objective absence-\nevidence gate.  It cannot represent an M4 role call or a successful\nhearing, which keeps that frozen state machine outside this authority.",
  "properties": {
    "candidate_crop_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Candidate Crop Ids",
      "type": "array"
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "clear_crop_ids": {
      "default": [],
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Clear Crop Ids",
      "type": "array"
    },
    "clear_threshold": {
      "maximum": 1,
      "minimum": 0,
      "title": "Clear Threshold",
      "type": "number"
    },
    "evidence_class": {
      "const": "ABSENCE",
      "default": "ABSENCE",
      "title": "Evidence Class",
      "type": "string"
    },
    "evidence_failure_code": {
      "anyOf": [
        {
          "const": "EVIDENCE_MISSING",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Failure Code"
    },
    "hearing_role_call_count": {
      "const": 0,
      "default": 0,
      "title": "Hearing Role Call Count",
      "type": "integer"
    },
    "hearing_session_absent_at_start": {
      "const": true,
      "default": true,
      "title": "Hearing Session Absent At Start",
      "type": "boolean"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "outcome_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/M8PreHearingOutcomeCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "preparation_id": {
      "description": "Stable identity shared by both append-only revisions.",
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Preparation Id",
      "type": "string"
    },
    "required_clear_count": {
      "exclusiveMinimum": 0,
      "title": "Required Clear Count",
      "type": "integer"
    },
    "resulting_case_revision": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resulting Case Revision"
    },
    "resulting_case_status": {
      "anyOf": [
        {
          "const": "HUMAN_REVIEW",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resulting Case Status"
    },
    "revision": {
      "maximum": 2,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m8-prehearing-preparation-v1",
      "default": "m8-prehearing-preparation-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "selection_policy_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Selection Policy Version",
      "type": "string"
    },
    "source_case_revision": {
      "exclusiveMinimum": 0,
      "title": "Source Case Revision",
      "type": "integer"
    },
    "source_evidence_pack_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Evidence Pack Id",
      "type": "string"
    },
    "source_evidence_pack_version": {
      "exclusiveMinimum": 0,
      "title": "Source Evidence Pack Version",
      "type": "integer"
    },
    "source_screening_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Screening Id",
      "type": "string"
    },
    "source_screening_version": {
      "exclusiveMinimum": 0,
      "title": "Source Screening Version",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/M8PreHearingPreparationState"
    }
  },
  "required": [
    "revision",
    "run_id",
    "case_id",
    "source_case_revision",
    "source_screening_id",
    "source_screening_version",
    "source_evidence_pack_id",
    "source_evidence_pack_version",
    "manifest_id",
    "candidate_crop_ids",
    "clear_threshold",
    "required_clear_count",
    "selection_policy_version",
    "state",
    "preparation_id"
  ],
  "title": "M8PreHearingEvidencePreparationV1",
  "type": "object"
}
