{
  "$defs": {
    "M8ActorRole": {
      "enum": [
        "LEADER",
        "SAFETY_OFFICER",
        "STUDENT",
        "OPERATIONS"
      ],
      "title": "M8ActorRole",
      "type": "string"
    },
    "M8ActorScopeKind": {
      "enum": [
        "CAMPUS_WIDE",
        "LOCATIONS",
        "SELF_ONLY"
      ],
      "title": "M8ActorScopeKind",
      "type": "string"
    },
    "M8ExternalIdempotencyKey": {
      "enum": [
        "BACKUP_GENERATION_ID",
        "EXPORT_BATCH_ID",
        "NOTIFICATION_ID",
        "REQUEST_ID",
        "SOURCE_SEQUENCE",
        "SUBJECT_ASSERTION_ID"
      ],
      "title": "M8ExternalIdempotencyKey",
      "type": "string"
    },
    "M8FeishuAdapterProfileV1": {
      "additionalProperties": false,
      "description": "Pinned custom-app API profile that contains references, never Feishu secrets.",
      "properties": {
        "api_origin": {
          "const": "https://open.feishu.cn",
          "default": "https://open.feishu.cn",
          "title": "Api Origin",
          "type": "string"
        },
        "app_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "App Id Sha256",
          "type": "string"
        },
        "authentication_kind": {
          "const": "TENANT_ACCESS_TOKEN_INTERNAL",
          "default": "TENANT_ACCESS_TOKEN_INTERNAL",
          "title": "Authentication Kind",
          "type": "string"
        },
        "bot_capability_required": {
          "const": true,
          "default": true,
          "title": "Bot Capability Required",
          "type": "boolean"
        },
        "candidate": {
          "$ref": "#/$defs/M8ProductionAdapterCandidateAuthorityV1"
        },
        "credential_bundle_reference_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Credential Bundle Reference Id",
          "type": "string"
        },
        "external_call_permitted": {
          "const": false,
          "default": false,
          "title": "External Call Permitted",
          "type": "boolean"
        },
        "max_card_content_bytes": {
          "const": 30720,
          "default": 30720,
          "title": "Max Card Content Bytes",
          "type": "integer"
        },
        "message_path": {
          "const": "/open-apis/im/v1/messages",
          "default": "/open-apis/im/v1/messages",
          "title": "Message Path",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Manifest Id",
          "type": "string"
        },
        "provider_uuid_dedup_window_seconds": {
          "const": 3600,
          "default": 3600,
          "title": "Provider Uuid Dedup Window Seconds",
          "type": "integer"
        },
        "provider_uuid_max_characters": {
          "const": 50,
          "default": 50,
          "title": "Provider Uuid Max Characters",
          "type": "integer"
        },
        "published_app_version_required": {
          "const": true,
          "default": true,
          "title": "Published App Version Required",
          "type": "boolean"
        },
        "raw_response_required": {
          "const": true,
          "default": true,
          "title": "Raw Response Required",
          "type": "boolean"
        },
        "receive_id_type": {
          "const": "open_id",
          "default": "open_id",
          "title": "Receive Id Type",
          "type": "string"
        },
        "required_scope": {
          "const": "im:message:send_as_bot",
          "default": "im:message:send_as_bot",
          "title": "Required Scope",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-feishu-adapter-profile-v1",
          "default": "m8-feishu-adapter-profile-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "secret_material_embedded": {
          "const": false,
          "default": false,
          "title": "Secret Material Embedded",
          "type": "boolean"
        },
        "token_cache_required": {
          "const": true,
          "default": true,
          "title": "Token Cache Required",
          "type": "boolean"
        },
        "token_path": {
          "const": "/open-apis/auth/v3/tenant_access_token/internal",
          "default": "/open-apis/auth/v3/tenant_access_token/internal",
          "title": "Token Path",
          "type": "string"
        }
      },
      "required": [
        "candidate",
        "credential_bundle_reference_id",
        "app_id_sha256",
        "profile_manifest_id",
        "profile_id"
      ],
      "title": "M8FeishuAdapterProfileV1",
      "type": "object"
    },
    "M8FeishuNotificationCardV1": {
      "additionalProperties": false,
      "description": "Deterministic Feishu interactive-card content derived from an exact M8 plan.",
      "properties": {
        "card_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Card Id",
          "type": "string"
        },
        "card_renderer_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Card Renderer Manifest Id",
          "type": "string"
        },
        "case_transition_permitted": {
          "readOnly": true,
          "title": "Case Transition Permitted",
          "type": "boolean"
        },
        "direct_disciplinary_action_permitted": {
          "readOnly": true,
          "title": "Direct Disciplinary Action Permitted",
          "type": "boolean"
        },
        "msg_type": {
          "readOnly": true,
          "title": "Msg Type",
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/M8NotificationPlanAuthorityV1"
        },
        "provider_content_json": {
          "readOnly": true,
          "title": "Provider Content Json",
          "type": "string"
        },
        "provider_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Provider Content Sha256",
          "type": "string"
        },
        "provider_content_size_bytes": {
          "readOnly": true,
          "title": "Provider Content Size Bytes",
          "type": "integer"
        },
        "raw_card_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "readOnly": true,
          "title": "Raw Card Ref",
          "type": "string"
        },
        "real_send_confirmed": {
          "readOnly": true,
          "title": "Real Send Confirmed",
          "type": "boolean"
        },
        "reply_event_contract_activated": {
          "readOnly": true,
          "title": "Reply Event Contract Activated",
          "type": "boolean"
        },
        "reply_event_type": {
          "readOnly": true,
          "title": "Reply Event Type",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-feishu-notification-card-v1",
          "default": "m8-feishu-notification-card-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "plan",
        "card_renderer_manifest_id",
        "msg_type",
        "provider_content_json",
        "provider_content_sha256",
        "provider_content_size_bytes",
        "reply_event_type",
        "reply_event_contract_activated",
        "real_send_confirmed",
        "case_transition_permitted",
        "direct_disciplinary_action_permitted",
        "card_id",
        "raw_card_ref"
      ],
      "title": "M8FeishuNotificationCardV1",
      "type": "object"
    },
    "M8FeishuRecipientBindingAuthorityV1": {
      "additionalProperties": false,
      "description": "Authorized target-to-open-ID hash binding without persisting the clear identifier.",
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "binding_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Binding Authority Id",
          "type": "string"
        },
        "clear_receive_id_persisted": {
          "readOnly": true,
          "title": "Clear Receive Id Persisted",
          "type": "boolean"
        },
        "mapping_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Mapping Manifest Id",
          "type": "string"
        },
        "mapping_revision": {
          "exclusiveMinimum": 0,
          "title": "Mapping Revision",
          "type": "integer"
        },
        "profile_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Id",
          "type": "string"
        },
        "receive_id_reference": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Receive Id Reference",
          "type": "string"
        },
        "receive_id_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receive Id Sha256",
          "type": "string"
        },
        "receive_id_type": {
          "const": "open_id",
          "default": "open_id",
          "title": "Receive Id Type",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-feishu-recipient-binding-authority-v1",
          "default": "m8-feishu-recipient-binding-authority-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/M8NotificationTargetAuthorityV1"
        }
      },
      "required": [
        "target",
        "profile_id",
        "receive_id_reference",
        "receive_id_sha256",
        "mapping_revision",
        "active",
        "mapping_manifest_id",
        "clear_receive_id_persisted",
        "binding_authority_id"
      ],
      "title": "M8FeishuRecipientBindingAuthorityV1",
      "type": "object"
    },
    "M8NotificationAudienceKind": {
      "enum": [
        "CASE_SUBJECT",
        "LEADER_MAJOR_EVENT",
        "OPERATIONS_DEVICE_RESPONSE",
        "SAFETY_RESPONDER"
      ],
      "title": "M8NotificationAudienceKind",
      "type": "string"
    },
    "M8NotificationChannelCapabilityAuthorityV1": {
      "additionalProperties": false,
      "description": "Pinned adapter behavior for one notification channel.",
      "properties": {
        "adapter_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Adapter Manifest Id",
          "type": "string"
        },
        "adapter_revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Adapter Revision",
          "type": "string"
        },
        "capability_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Capability Authority Id",
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/M8NotificationChannelKind"
        },
        "inbound_response_supported": {
          "title": "Inbound Response Supported",
          "type": "boolean"
        },
        "network_required": {
          "title": "Network Required",
          "type": "boolean"
        },
        "offline_capable": {
          "title": "Offline Capable",
          "type": "boolean"
        },
        "provider_idempotency_key": {
          "const": "notification_id",
          "default": "notification_id",
          "title": "Provider Idempotency Key",
          "type": "string"
        },
        "request_timeout_ms": {
          "exclusiveMinimum": 0,
          "maximum": 30000,
          "title": "Request Timeout Ms",
          "type": "integer"
        },
        "schema_version": {
          "const": "m8-notification-channel-capability-authority-v1",
          "default": "m8-notification-channel-capability-authority-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "simulated": {
          "title": "Simulated",
          "type": "boolean"
        }
      },
      "required": [
        "adapter_id",
        "adapter_revision",
        "channel",
        "request_timeout_ms",
        "network_required",
        "offline_capable",
        "simulated",
        "inbound_response_supported",
        "adapter_manifest_id",
        "capability_authority_id"
      ],
      "title": "M8NotificationChannelCapabilityAuthorityV1",
      "type": "object"
    },
    "M8NotificationChannelKind": {
      "enum": [
        "DINGTALK",
        "FEISHU",
        "LOCAL_OFFLINE_FAKE",
        "WECHAT_WORK"
      ],
      "title": "M8NotificationChannelKind",
      "type": "string"
    },
    "M8NotificationDispatchRequestV1": {
      "additionalProperties": false,
      "description": "One bounded send attempt over an exact rendered card artifact.",
      "properties": {
        "attempt_number": {
          "exclusiveMinimum": 0,
          "title": "Attempt Number",
          "type": "integer"
        },
        "channel_capability": {
          "$ref": "#/$defs/M8NotificationChannelCapabilityAuthorityV1"
        },
        "dispatch_request_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Dispatch Request Id",
          "type": "string"
        },
        "dispatched_at": {
          "format": "date-time",
          "title": "Dispatched At",
          "type": "string"
        },
        "external_delivery_claim_permitted": {
          "readOnly": true,
          "title": "External Delivery Claim Permitted",
          "type": "boolean"
        },
        "idempotency_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/M8NotificationPlanAuthorityV1"
        },
        "rendered_card_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Rendered Card Ref",
          "type": "string"
        },
        "rendered_card_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rendered Card Sha256",
          "type": "string"
        },
        "request_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Manifest Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-notification-dispatch-request-v1",
          "default": "m8-notification-dispatch-request-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_notification_authority_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Notification Authority Sha256",
          "type": "string"
        },
        "source_notification_version": {
          "exclusiveMinimum": 0,
          "title": "Source Notification Version",
          "type": "integer"
        },
        "source_status": {
          "const": "QUEUED",
          "default": "QUEUED",
          "title": "Source Status",
          "type": "string"
        },
        "timeout_ms": {
          "exclusiveMinimum": 0,
          "maximum": 30000,
          "title": "Timeout Ms",
          "type": "integer"
        }
      },
      "required": [
        "plan",
        "source_notification_version",
        "source_notification_authority_sha256",
        "attempt_number",
        "channel_capability",
        "rendered_card_ref",
        "rendered_card_sha256",
        "dispatched_at",
        "timeout_ms",
        "idempotency_key",
        "request_manifest_id",
        "external_delivery_claim_permitted",
        "dispatch_request_id"
      ],
      "title": "M8NotificationDispatchRequestV1",
      "type": "object"
    },
    "M8NotificationEscalationPolicyAuthorityV1": {
      "additionalProperties": false,
      "description": "Bounded response deadline and escalation routing policy.",
      "properties": {
        "case_transition_permitted": {
          "readOnly": true,
          "title": "Case Transition Permitted",
          "type": "boolean"
        },
        "escalation_roles": {
          "items": {
            "$ref": "#/$defs/M8ActorRole"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Escalation Roles",
          "type": "array"
        },
        "max_delivery_attempts": {
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Max Delivery Attempts",
          "type": "integer"
        },
        "policy_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Policy Authority Id",
          "type": "string"
        },
        "policy_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Manifest Id",
          "type": "string"
        },
        "policy_rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Policy Rule Id",
          "type": "string"
        },
        "requires_human_send_confirmation": {
          "title": "Requires Human Send Confirmation",
          "type": "boolean"
        },
        "response_timeout_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 604800,
          "title": "Response Timeout Seconds",
          "type": "integer"
        },
        "risk_level": {
          "$ref": "#/$defs/M8OperationalRiskLevel"
        },
        "schema_version": {
          "const": "m8-notification-escalation-policy-authority-v1",
          "default": "m8-notification-escalation-policy-authority-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "policy_rule_id",
        "risk_level",
        "response_timeout_seconds",
        "max_delivery_attempts",
        "escalation_roles",
        "requires_human_send_confirmation",
        "policy_manifest_id",
        "case_transition_permitted",
        "policy_authority_id"
      ],
      "title": "M8NotificationEscalationPolicyAuthorityV1",
      "type": "object"
    },
    "M8NotificationPlanAuthorityV1": {
      "additionalProperties": false,
      "description": "Immutable PLANNED outbox intent for one exact operational Case version.",
      "properties": {
        "audience": {
          "$ref": "#/$defs/M8NotificationAudienceKind"
        },
        "case_authority_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Case Authority Sha256",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "case_status": {
          "$ref": "#/$defs/M8OperationalCaseStatus"
        },
        "case_subject_actor_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Subject Actor Id"
        },
        "case_transition_permitted": {
          "readOnly": true,
          "title": "Case Transition Permitted",
          "type": "boolean"
        },
        "case_version": {
          "exclusiveMinimum": 0,
          "title": "Case Version",
          "type": "integer"
        },
        "direct_disciplinary_action_permitted": {
          "readOnly": true,
          "title": "Direct Disciplinary Action Permitted",
          "type": "boolean"
        },
        "display_badge": {
          "readOnly": true,
          "title": "Display Badge",
          "type": "string"
        },
        "escalation_policy": {
          "$ref": "#/$defs/M8NotificationEscalationPolicyAuthorityV1"
        },
        "external_delivery_claim_permitted": {
          "readOnly": true,
          "title": "External Delivery Claim Permitted",
          "type": "boolean"
        },
        "idempotency_key": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Idempotency Key",
          "type": "string"
        },
        "location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Location Id",
          "type": "string"
        },
        "notification_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Notification Id",
          "type": "string"
        },
        "notification_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Notification Manifest Id",
          "type": "string"
        },
        "planned_at": {
          "format": "date-time",
          "title": "Planned At",
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/M8NotificationPurpose"
        },
        "response_due_at": {
          "format": "date-time",
          "readOnly": true,
          "title": "Response Due At",
          "type": "string"
        },
        "risk_level": {
          "$ref": "#/$defs/M8OperationalRiskLevel"
        },
        "schema_version": {
          "const": "m8-notification-plan-authority-v1",
          "default": "m8-notification-plan-authority-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "simulated": {
          "readOnly": true,
          "title": "Simulated",
          "type": "boolean"
        },
        "status": {
          "const": "PLANNED",
          "default": "PLANNED",
          "title": "Status",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/M8NotificationTargetAuthorityV1"
        },
        "template": {
          "$ref": "#/$defs/M8NotificationTemplateAuthorityV1"
        }
      },
      "required": [
        "case_id",
        "case_version",
        "case_authority_sha256",
        "case_status",
        "risk_level",
        "location_id",
        "purpose",
        "audience",
        "target",
        "template",
        "escalation_policy",
        "planned_at",
        "notification_manifest_id",
        "simulated",
        "display_badge",
        "response_due_at",
        "direct_disciplinary_action_permitted",
        "case_transition_permitted",
        "external_delivery_claim_permitted",
        "notification_id",
        "idempotency_key"
      ],
      "title": "M8NotificationPlanAuthorityV1",
      "type": "object"
    },
    "M8NotificationPurpose": {
      "enum": [
        "APPEAL_UPDATED",
        "CASE_ACTION_REQUIRED",
        "CASE_CREATED",
        "CASE_UPDATED",
        "DEVICE_ATTENTION_REQUIRED",
        "ESCALATION",
        "EVIDENCE_REQUESTED"
      ],
      "title": "M8NotificationPurpose",
      "type": "string"
    },
    "M8NotificationTargetAuthorityV1": {
      "additionalProperties": false,
      "description": "Versioned privacy-safe mapping from one actor to one delivery channel.",
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "actor_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Actor Id",
          "type": "string"
        },
        "authority_revision": {
          "exclusiveMinimum": 0,
          "title": "Authority Revision",
          "type": "integer"
        },
        "channel": {
          "$ref": "#/$defs/M8NotificationChannelKind"
        },
        "display_badge": {
          "readOnly": true,
          "title": "Display Badge",
          "type": "string"
        },
        "external_subject_binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "External Subject Binding Sha256",
          "type": "string"
        },
        "identity_provider_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Identity Provider Id",
