{
  "$defs": {
    "HearingModelResponseRecoveryDisposition": {
      "enum": [
        "VERIFIED",
        "ACKNOWLEDGED",
        "DEFERRED",
        "ANOMALY"
      ],
      "title": "HearingModelResponseRecoveryDisposition",
      "type": "string"
    },
    "HearingModelResponseRecoveryItem": {
      "additionalProperties": false,
      "description": "One request-level outcome without owner token, path, or response bytes.",
      "properties": {
        "disposition": {
          "$ref": "#/$defs/HearingModelResponseRecoveryDisposition"
        },
        "reason_code": {
          "$ref": "#/$defs/HearingModelResponseRecoveryReason"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "response_content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Content Sha256"
        },
        "response_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Id"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m4-hearing-model-response-recovery-item-v1",
          "default": "m4-hearing-model-response-recovery-item-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_token": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Token"
        }
      },
      "required": [
        "run_id",
        "disposition",
        "reason_code"
      ],
      "title": "HearingModelResponseRecoveryItem",
      "type": "object"
    },
    "HearingModelResponseRecoveryReason": {
      "enum": [
        "ACTIVE_LEASE_UNEXPIRED",
        "ACTIVE_EXPIRED_NO_JOURNAL",
        "CLAIM_RACE_LOST",
        "CLAIM_SCAN_INCOMPLETE",
        "CLAIM_RECOVERY_SUPPRESSED",
        "JOURNAL_ACKNOWLEDGED",
        "JOURNAL_ALREADY_ABSENT",
        "CLAIM_AUTHORITY_INVALID",
        "JOURNAL_INTEGRITY_FAILURE",
        "RESPONSE_INTEGRITY_FAILURE",
        "RESPONSE_CONFLICT",
        "DATABASE_OBSERVATION_CONFLICT"
      ],
      "title": "HearingModelResponseRecoveryReason",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/hearing-model-response-recovery-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded provider-free convergence report for M4 request claims.",
  "properties": {
    "claim_limit": {
      "exclusiveMinimum": 0,
      "maximum": 10000,
      "title": "Claim Limit",
      "type": "integer"
    },
    "claims_scanned": {
      "minimum": 0,
      "title": "Claims Scanned",
      "type": "integer"
    },
    "items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/HearingModelResponseRecoveryItem"
      },
      "title": "Items",
      "type": "array"
    },
    "passed": {
      "readOnly": true,
      "title": "Passed",
      "type": "boolean"
    },
    "report_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Report Id",
      "type": "string"
    },
    "requires_attention": {
      "readOnly": true,
      "title": "Requires Attention",
      "type": "boolean"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "scan_complete": {
      "title": "Scan Complete",
      "type": "boolean"
    },
    "schema_version": {
      "const": "m4-hearing-model-response-recovery-report-v1",
      "default": "m4-hearing-model-response-recovery-report-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "started_at",
    "claim_limit",
    "claims_scanned",
    "scan_complete",
    "report_id",
    "requires_attention",
    "passed"
  ],
  "title": "HearingModelResponseRecoveryReport",
  "type": "object"
}
