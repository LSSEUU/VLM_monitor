{
  "$id": "https://schemas.labcourt.local/v2/m8-calibration-fit-request-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dataset_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Manifest Id",
      "type": "string"
    },
    "explicit_human_confirmation": {
      "const": true,
      "title": "Explicit Human Confirmation",
      "type": "boolean"
    },
    "schema_version": {
      "const": "m8-calibration-fit-request-v1",
      "default": "m8-calibration-fit-request-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "dataset_manifest_id",
    "explicit_human_confirmation"
  ],
  "title": "M8CalibrationFitRequestV1",
  "type": "object"
}
