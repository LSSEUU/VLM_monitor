{
  "$defs": {
    "M8ActorRole": {
      "enum": [
        "LEADER",
        "SAFETY_OFFICER",
        "STUDENT",
        "OPERATIONS"
      ],
      "title": "M8ActorRole",
      "type": "string"
    },
    "M8ActorScopeKind": {
      "enum": [
        "CAMPUS_WIDE",
        "LOCATIONS",
        "SELF_ONLY"
      ],
      "title": "M8ActorScopeKind",
      "type": "string"
    },
    "M8Capability": {
      "enum": [
        "VIEW_GLOBAL_OVERVIEW",
        "VIEW_MAJOR_EVENTS",
        "VIEW_AUDIT",
        "CONFIRM_CASE",
        "REJECT_CASE",
        "REQUEST_CASE_EVIDENCE",
        "RETURN_CASE_TO_VERIFICATION",
        "RESOLVE_CASE",
        "RESOLVE_APPEAL",
        "MANAGE_RULES",
        "VIEW_OWN_CASE",
        "SUBMIT_EXPLANATION",
        "SUBMIT_APPEAL",
        "MANAGE_DEVICES",
        "VIEW_DEVICE_HEALTH"
      ],
      "title": "M8Capability",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-actor-authority-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "LEADER"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "const": [
              "VIEW_GLOBAL_OVERVIEW",
              "VIEW_MAJOR_EVENTS",
              "VIEW_AUDIT"
            ]
          },
          "scope_kind": {
            "const": "CAMPUS_WIDE"
          },
          "scope_location_ids": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "SAFETY_OFFICER"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "allOf": [
          {
            "else": {
              "properties": {
                "scope_location_ids": {
                  "maxItems": 0
                }
              }
            },
            "if": {
              "properties": {
                "scope_kind": {
                  "const": "LOCATIONS"
                }
              },
              "required": [
                "scope_kind"
              ]
            },
            "then": {
              "properties": {
                "scope_location_ids": {
                  "minItems": 1
                }
              }
            }
          }
        ],
        "properties": {
          "capabilities": {
            "const": [
              "VIEW_GLOBAL_OVERVIEW",
              "VIEW_MAJOR_EVENTS",
              "VIEW_AUDIT",
              "CONFIRM_CASE",
              "REJECT_CASE",
              "REQUEST_CASE_EVIDENCE",
              "RETURN_CASE_TO_VERIFICATION",
              "RESOLVE_CASE",
              "RESOLVE_APPEAL",
              "MANAGE_RULES"
            ]
          },
          "scope_kind": {
            "enum": [
              "CAMPUS_WIDE",
              "LOCATIONS"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "STUDENT"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "const": [
              "VIEW_OWN_CASE",
              "SUBMIT_EXPLANATION",
              "SUBMIT_APPEAL"
            ]
          },
          "scope_kind": {
            "const": "SELF_ONLY"
          },
          "scope_location_ids": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "OPERATIONS"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "allOf": [
          {
            "else": {
              "properties": {
                "scope_location_ids": {
                  "maxItems": 0
                }
              }
            },
            "if": {
              "properties": {
                "scope_kind": {
                  "const": "LOCATIONS"
                }
              },
              "required": [
                "scope_kind"
              ]
            },
            "then": {
              "properties": {
                "scope_location_ids": {
                  "minItems": 1
                }
              }
            }
          }
        ],
        "properties": {
          "capabilities": {
            "const": [
              "MANAGE_DEVICES",
              "VIEW_DEVICE_HEALTH"
            ]
          },
          "scope_kind": {
            "enum": [
              "CAMPUS_WIDE",
              "LOCATIONS"
            ]
          }
        }
      }
    }
  ],
  "description": "Versioned actor role, scope, and derived capability authority.",
  "properties": {
    "active": {
      "title": "Active",
      "type": "boolean"
    },
    "actor_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Actor Authority Id",
      "type": "string"
    },
    "actor_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Actor Id",
      "type": "string"
    },
    "authority_revision": {
      "exclusiveMinimum": 0,
      "title": "Authority Revision",
      "type": "integer"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/M8Capability"
      },
      "readOnly": true,
      "title": "Capabilities",
      "type": "array"
    },
    "identity_provider_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Identity Provider Id",
      "type": "string"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/M8ActorRole"
    },
    "schema_version": {
      "const": "m8-actor-authority-v1",
      "default": "m8-actor-authority-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_kind": {
      "$ref": "#/$defs/M8ActorScopeKind"
    },
    "scope_location_ids": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
        "type": "string"
      },
      "maxItems": 10000,
      "title": "Scope Location Ids",
      "type": "array"
    },
    "subject_binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Subject Binding Sha256",
      "type": "string"
    }
  },
  "required": [
    "actor_id",
    "role",
    "scope_kind",
    "identity_provider_id",
    "subject_binding_sha256",
    "authority_revision",
    "active",
    "manifest_id",
    "capabilities",
    "actor_authority_id"
  ],
  "title": "M8ActorAuthorityV1",
  "type": "object"
}
