{
  "$defs": {
    "M8KnowledgeCatalogAuthorityV1": {
      "additionalProperties": false,
      "description": "Stable inventory of immutable document versions with non-overlapping validity.",
      "properties": {
        "catalog_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Catalog Authority Id",
          "type": "string"
        },
        "catalog_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Catalog Id",
          "type": "string"
        },
        "catalog_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Catalog Manifest Id",
          "type": "string"
        },
        "catalog_revision": {
          "exclusiveMinimum": 0,
          "title": "Catalog Revision",
          "type": "integer"
        },
        "documents": {
          "items": {
            "$ref": "#/$defs/M8KnowledgeDocumentAuthorityV1"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Documents",
          "type": "array"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "ordinary_documents_can_define_case_rules": {
          "readOnly": true,
          "title": "Ordinary Documents Can Define Case Rules",
          "type": "boolean"
        },
        "schema_version": {
          "const": "m8-knowledge-catalog-authority-v1",
          "default": "m8-knowledge-catalog-authority-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "catalog_id",
        "catalog_revision",
        "documents",
        "generated_at",
        "catalog_manifest_id",
        "ordinary_documents_can_define_case_rules",
        "catalog_authority_id"
      ],
      "title": "M8KnowledgeCatalogAuthorityV1",
      "type": "object"
    },
    "M8KnowledgeContentType": {
      "enum": [
        "MARKDOWN",
        "PLAIN_TEXT"
      ],
      "title": "M8KnowledgeContentType",
      "type": "string"
    },
    "M8KnowledgeDocumentAuthorityV1": {
      "additionalProperties": false,
      "description": "Metadata for one immutable ordinary knowledge document version.",
      "properties": {
        "content_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Content Ref",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "content_size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 1048576,
          "title": "Content Size Bytes",
          "type": "integer"
        },
        "content_type": {
          "$ref": "#/$defs/M8KnowledgeContentType"
        },
        "direct_case_decision_permitted": {
          "readOnly": true,
          "title": "Direct Case Decision Permitted",
          "type": "boolean"
        },
        "document_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Document Authority Id",
          "type": "string"
        },
        "document_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Manifest Id",
          "type": "string"
        },
        "document_type": {
          "$ref": "#/$defs/M8KnowledgeDocumentType"
        },
        "document_version": {
          "exclusiveMinimum": 0,
          "title": "Document Version",
          "type": "integer"
        },
        "effective_at": {
          "format": "date-time",
          "title": "Effective At",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "issuer_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Issuer Id",
          "type": "string"
        },
        "locale": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Locale",
          "type": "string"
        },
        "logical_document_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Logical Document Id",
          "type": "string"
        },
        "ordinary_document_can_define_case_rule": {
          "readOnly": true,
          "title": "Ordinary Document Can Define Case Rule",
          "type": "boolean"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-knowledge-document-authority-v1",
          "default": "m8-knowledge-document-authority-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Source Ref",
          "type": "string"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "logical_document_id",
        "document_version",
        "document_type",
        "title",
        "locale",
        "issuer_id",
        "source_ref",
        "content_ref",
        "content_sha256",
        "content_size_bytes",
        "content_type",
        "published_at",
        "effective_at",
        "document_manifest_id",
        "ordinary_document_can_define_case_rule",
        "direct_case_decision_permitted",
        "document_authority_id"
      ],
      "title": "M8KnowledgeDocumentAuthorityV1",
      "type": "object"
    },
    "M8KnowledgeDocumentCommitReceiptV1": {
      "additionalProperties": false,
      "description": "Receipt for exact persisted raw bytes of one document authority.",
      "properties": {
        "commit_receipt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Commit Receipt Id",
          "type": "string"
        },
        "document": {
          "$ref": "#/$defs/M8KnowledgeDocumentAuthorityV1"
        },
        "document_metadata_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Document Metadata Sha256",
          "type": "string"
        },
        "raw_storage_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Storage Manifest Id",
          "type": "string"
        },
        "repository_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Repository Manifest Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-knowledge-document-commit-receipt-v1",
          "default": "m8-knowledge-document-commit-receipt-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "document",
        "raw_storage_manifest_id",
        "repository_manifest_id",
        "document_metadata_sha256",
        "commit_receipt_id"
      ],
      "title": "M8KnowledgeDocumentCommitReceiptV1",
      "type": "object"
    },
    "M8KnowledgeDocumentType": {
      "enum": [
        "DEVICE_MANUAL",
        "EMERGENCY_PLAN",
        "FAQ",
        "HISTORICAL_PRECEDENT",
        "POLICY",
        "SOP"
      ],
      "title": "M8KnowledgeDocumentType",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-knowledge-catalog-commit-receipt-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Atomic append receipt for one catalog revision and all exact document bytes.",
  "properties": {
    "catalog": {
      "$ref": "#/$defs/M8KnowledgeCatalogAuthorityV1"
    },
    "catalog_document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Catalog Document Sha256",
      "type": "string"
    },
    "commit_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Commit Receipt Id",
      "type": "string"
    },
    "content_inventory_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Content Inventory Sha256",
      "type": "string"
    },
    "document_receipts": {
      "items": {
        "$ref": "#/$defs/M8KnowledgeDocumentCommitReceiptV1"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Document Receipts",
      "type": "array"
    },
    "prior_catalog_authority_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prior Catalog Authority Id"
    },
    "prior_catalog_document_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prior Catalog Document Sha256"
    },
    "raw_storage_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Storage Manifest Id",
      "type": "string"
    },
    "repository_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Repository Manifest Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m8-knowledge-catalog-commit-receipt-v1",
      "default": "m8-knowledge-catalog-commit-receipt-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "total_content_size_bytes": {
      "readOnly": true,
      "title": "Total Content Size Bytes",
      "type": "integer"
    }
  },
  "required": [
    "catalog",
    "document_receipts",
    "raw_storage_manifest_id",
    "repository_manifest_id",
    "catalog_document_sha256",
    "content_inventory_sha256",
    "total_content_size_bytes",
    "commit_receipt_id"
  ],
  "title": "M8KnowledgeCatalogCommitReceiptV1",
  "type": "object"
}
