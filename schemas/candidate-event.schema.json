{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "RUN",
        "FRAME",
        "SAFETY_SIGNAL",
        "EVENT",
        "CASE",
        "DETECTION",
        "OBJECTIVE_FACT",
        "CROP",
        "MEDIA",
        "EVIDENCE_PACK",
        "TOOL_RESULT",
        "MANIFEST",
        "MODEL_RESPONSE",
        "MODEL_REQUEST",
        "PROMPT_MANIFEST",
        "MODEL_PARSE_RECEIPT",
        "PARSED_MODEL_OUTPUT",
        "PROCEDURAL_REVIEW",
        "MODEL_CACHE_ENTRY",
        "SCREENING_RESULT",
        "VERDICT",
        "ALERT",
        "PRECEDENT",
        "APPEAL",
        "TRAINING_LABEL",
        "BACKLOG_ITEM",
        "DATASET"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A kind-discriminated reference with syntax fixed by the artifact kind.",
      "properties": {
        "artifact_id": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ConfirmationPolicy": {
      "enum": [
        "STRICT_CAUSAL",
        "SOURCE_COMPAT",
        "NONE"
      ],
      "title": "ConfirmationPolicy",
      "type": "string"
    },
    "ConfirmationRecord": {
      "additionalProperties": false,
      "properties": {
        "causal_risk": {
          "default": false,
          "title": "Causal Risk",
          "type": "boolean"
        },
        "counterevidence_frame_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:(?:0|[1-9][0-9]{0,19})$",
            "type": "string"
          },
          "title": "Counterevidence Frame Ids",
          "type": "array"
        },
        "examined_frame_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:(?:0|[1-9][0-9]{0,19})$",
            "type": "string"
          },
          "title": "Examined Frame Ids",
          "type": "array"
        },
        "policy": {
          "$ref": "#/$defs/ConfirmationPolicy"
        },
        "post_threshold_recovery_frame_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:(?:0|[1-9][0-9]{0,19})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Post Threshold Recovery Frame Id"
        },
        "resolved_frame": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Frame"
        },
        "suppressed": {
          "default": false,
          "title": "Suppressed",
          "type": "boolean"
        },
        "suppression_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suppression Reason"
        }
      },
      "required": [
        "policy"
      ],
      "title": "ConfirmationRecord",
      "type": "object"
    },
    "EvidenceClass": {
      "enum": [
        "PRESENCE",
        "ABSENCE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "ObjectiveFact": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "DURATION_FRAMES",
                  "PERSON_COUNT"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "minimum": 0,
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "FRAME_INTERVAL",
                  "TRACK_PRESENCE_INTERVAL"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "minimum": 1,
                    "type": "integer"
                  }
                ],
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ZONE_ID"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "RISK_LEVEL"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH"
                ],
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "DETECTION_SCORE",
                  "OBSERVABILITY"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              }
            }
          }
        }
      ],
      "properties": {
        "fact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Fact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ObjectiveFactKind"
        },
        "source_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Manifest Id",
          "type": "string"
        },
        "source_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "fact_id",
        "kind",
        "value",
        "source_ref",
        "source_manifest_id"
      ],
      "title": "ObjectiveFact",
      "type": "object"
    },
    "ObjectiveFactKind": {
      "enum": [
        "DURATION_FRAMES",
        "PERSON_COUNT",
        "ZONE_ID",
        "RISK_LEVEL",
        "FRAME_INTERVAL",
        "TRACK_PRESENCE_INTERVAL",
        "DETECTION_SCORE",
        "OBSERVABILITY"
      ],
      "title": "ObjectiveFactKind",
      "type": "string"
    },
    "ViolationType": {
      "enum": [
        "PPE_GOGGLES_MISSING",
        "PPE_GLOVES_MISSING",
        "PPE_LAB_COAT_MISSING",
        "REAGENT_CONTAINER_OPEN",
        "FOOD_OR_DRINK_IN_LAB",
        "SINGLE_PERSON_HAZARDOUS_OPERATION",
        "FUME_HOOD_SASH_TOO_HIGH",
        "UNATTENDED_HEATING",
        "SMOKE_ABNORMAL",
        "OPEN_FLAME"
      ],
      "title": "ViolationType",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/candidate-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "camera_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Camera Id",
      "type": "string"
    },
    "confirmation": {
      "$ref": "#/$defs/ConfirmationRecord"
    },
    "end_frame_exclusive": {
      "exclusiveMinimum": 0,
      "title": "End Frame Exclusive",
      "type": "integer"
    },
    "event_id": {
      "readOnly": true,
      "title": "Event Id",
      "type": "string"
    },
    "evidence_class": {
      "$ref": "#/$defs/EvidenceClass"
    },
    "hard_rule": {
      "default": false,
      "title": "Hard Rule",
      "type": "boolean"
    },
    "l1_score": {
      "maximum": 1,
      "minimum": 0,
      "title": "L1 Score",
      "type": "number"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "objective_facts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectiveFact"
      },
      "title": "Objective Facts",
      "type": "array"
    },
    "primary_track_ref": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Primary Track Ref"
    },
    "related_track_refs": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
        "type": "string"
      },
      "title": "Related Track Refs",
      "type": "array"
    },
    "rule_version": {
      "minLength": 1,
      "title": "Rule Version",
      "type": "string"
    },
    "start_frame": {
      "minimum": 0,
      "title": "Start Frame",
      "type": "integer"
    },
    "stream_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Stream Id",
      "type": "string"
    },
    "trigger_frame": {
      "minimum": 0,
      "title": "Trigger Frame",
      "type": "integer"
    },
    "violation_type": {
      "$ref": "#/$defs/ViolationType"
    },
    "zone_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Zone Id",
      "type": "string"
    }
  },
  "required": [
    "camera_id",
    "stream_id",
    "rule_version",
    "violation_type",
    "evidence_class",
    "zone_id",
    "start_frame",
    "end_frame_exclusive",
    "trigger_frame",
    "l1_score",
    "confirmation",
    "manifest_id",
    "event_id"
  ],
  "title": "CandidateEvent",
  "type": "object"
}
