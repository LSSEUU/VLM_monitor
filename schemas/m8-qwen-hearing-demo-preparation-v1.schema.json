{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "RUN",
        "FRAME",
        "SAFETY_SIGNAL",
        "EVENT",
        "CASE",
        "DETECTION",
        "OBJECTIVE_FACT",
        "CROP",
        "MEDIA",
        "EVIDENCE_PACK",
        "TOOL_RESULT",
        "MANIFEST",
        "MODEL_RESPONSE",
        "MODEL_REQUEST",
        "PROMPT_MANIFEST",
        "MODEL_PARSE_RECEIPT",
        "PARSED_MODEL_OUTPUT",
        "PROCEDURAL_REVIEW",
        "MODEL_CACHE_ENTRY",
        "SCREENING_RESULT",
        "VERDICT",
        "ALERT",
        "PRECEDENT",
        "APPEAL",
        "TRAINING_LABEL",
        "BACKLOG_ITEM",
        "DATASET"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A kind-discriminated reference with syntax fixed by the artifact kind.",
      "properties": {
        "artifact_id": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CaseStatus": {
      "enum": [
        "CANDIDATE",
        "EVIDENCE_READY",
        "SCREENED",
        "ESCALATED",
        "DELIBERATING",
        "PROCEDURAL_REVIEW",
        "READY_FOR_ALERT_POLICY",
        "REWORK_REQUIRED",
        "HUMAN_REVIEW",
        "BACKLOGGED",
        "CLOSED",
        "APPEALED",
        "APPEAL_RESOLVED"
      ],
      "title": "CaseStatus",
      "type": "string"
    },
    "ExecutionLocation": {
      "enum": [
        "LOCAL",
        "EXTERNAL"
      ],
      "title": "ExecutionLocation",
      "type": "string"
    },
    "M8HearingModelMode": {
      "enum": [
        "OFFLINE_FIXTURE",
        "OPENAI_COMPATIBLE_QWEN"
      ],
      "title": "M8HearingModelMode",
      "type": "string"
    },
    "M8HearingProviderSelectionV1": {
      "additionalProperties": false,
      "description": "Exact role profile selected by server configuration and the run manifest.",
      "properties": {
        "execution_location": {
          "$ref": "#/$defs/ExecutionLocation"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Manifest Id",
          "type": "string"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "provider_profile": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Provider Profile",
          "type": "string"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/VlmRole"
        },
        "schema_version": {
          "const": "m8-hearing-provider-selection-v1",
          "default": "m8-hearing-provider-selection-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Selection Id",
          "type": "string"
        },
        "transport": {
          "$ref": "#/$defs/ProviderTransport"
        }
      },
      "required": [
        "role",
        "provider_profile",
        "provider",
        "model",
        "revision",
        "model_manifest_id",
        "execution_location",
        "transport",
        "selection_id"
      ],
      "title": "M8HearingProviderSelectionV1",
      "type": "object"
    },
    "M8HearingStartRequestV1": {
      "additionalProperties": false,
      "description": "Explicit source fence and model selection for one M4 hearing start.",
      "properties": {
        "automatic_start_permitted": {
          "readOnly": true,
          "title": "Automatic Start Permitted",
          "type": "boolean"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "clear_case_forcing_permitted": {
          "readOnly": true,
          "title": "Clear Case Forcing Permitted",
          "type": "boolean"
        },
        "client_actor_authority_permitted": {
          "readOnly": true,
          "title": "Client Actor Authority Permitted",
          "type": "boolean"
        },
        "explicit_start": {
          "const": true,
          "default": true,
          "title": "Explicit Start",
          "type": "boolean"
        },
        "model_mode": {
          "$ref": "#/$defs/M8HearingModelMode",
          "default": "OFFLINE_FIXTURE"
        },
        "request_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Manifest Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-hearing-start-request-v1",
          "default": "m8-hearing-start-request-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_evidence_pack_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Evidence Pack Id",
          "type": "string"
        },
        "source_evidence_pack_version": {
          "exclusiveMinimum": 0,
          "title": "Source Evidence Pack Version",
          "type": "integer"
        },
        "source_screening_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Screening Id",
          "type": "string"
        },
        "source_status": {
          "$ref": "#/$defs/CaseStatus"
        },
        "start_request_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Start Request Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "source_status",
        "source_screening_id",
        "source_evidence_pack_id",
        "source_evidence_pack_version",
        "request_manifest_id",
        "client_actor_authority_permitted",
        "automatic_start_permitted",
        "clear_case_forcing_permitted",
        "start_request_id"
      ],
      "title": "M8HearingStartRequestV1",
      "type": "object"
    },
    "M8QwenHearingDemoEvidenceRole": {
      "enum": [
        "PRIMARY",
        "SUPPLEMENTARY"
      ],
      "title": "M8QwenHearingDemoEvidenceRole",
      "type": "string"
    },
    "M8QwenHearingDemoEvidenceV1": {
      "additionalProperties": false,
      "description": "Secret-free provenance for one generated demo image.",
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "authorized_for_external_model": {
          "const": true,
          "default": true,
          "title": "Authorized For External Model",
          "type": "boolean"
        },
        "canonical_media_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Media Sha256",
          "type": "string"
        },
        "ground_truth": {
          "const": false,
          "default": false,
          "title": "Ground Truth",
          "type": "boolean"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "machine_weak_label": {
          "const": true,
          "default": true,
          "title": "Machine Weak Label",
          "type": "boolean"
        },
        "model_generated": {
          "const": true,
          "default": true,
          "title": "Model Generated",
          "type": "boolean"
        },
        "preauthorized_acquisition_catalog": {
          "title": "Preauthorized Acquisition Catalog",
          "type": "boolean"
        },
        "prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "real_person_depicted": {
          "const": false,
          "default": false,
          "title": "Real Person Depicted",
          "type": "boolean"
        },
        "role": {
          "$ref": "#/$defs/M8QwenHearingDemoEvidenceRole"
        },
        "schema_version": {
          "const": "m8-qwen-hearing-demo-evidence-v1",
          "default": "m8-qwen-hearing-demo-evidence-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source File Sha256",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "role",
        "artifact_ref",
        "source_file_sha256",
        "canonical_media_sha256",
        "prompt_sha256",
        "width",
        "height",
        "size_bytes",
        "preauthorized_acquisition_catalog"
      ],
      "title": "M8QwenHearingDemoEvidenceV1",
      "type": "object"
    },
    "ProviderTransport": {
      "enum": [
        "IN_PROCESS",
        "HTTP"
      ],
      "title": "ProviderTransport",
      "type": "string"
    },
    "VlmRole": {
      "enum": [
        "SCREENING",
        "STRUCTURE_REPAIR",
        "PROSECUTOR",
        "DEFENDER",
        "JUDGE"
      ],
      "title": "VlmRole",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-qwen-hearing-demo-preparation-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Reproducible preparation authority before any external hearing call.",
  "properties": {
    "api_key_persisted": {
      "const": false,
      "default": false,
      "title": "Api Key Persisted",
      "type": "boolean"
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "case_status": {
      "const": "ESCALATED",
      "default": "ESCALATED",
      "title": "Case Status",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/M8QwenHearingDemoEvidenceV1"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Evidence",
      "type": "array"
    },
    "external_call_permitted": {
      "const": false,
      "default": false,
      "title": "External Call Permitted",
      "type": "boolean"
    },
    "machine_weak_labels_are_ground_truth": {
      "const": false,
      "default": false,
      "title": "Machine Weak Labels Are Ground Truth",
      "type": "boolean"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "model_mode": {
      "const": "OPENAI_COMPATIBLE_QWEN",
      "default": "OPENAI_COMPATIBLE_QWEN",
      "title": "Model Mode",
      "type": "string"
    },
    "preparation_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Preparation Id",
      "type": "string"
    },
    "provider_selections": {
      "items": {
        "$ref": "#/$defs/M8HearingProviderSelectionV1"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Provider Selections",
      "type": "array"
    },
    "raw_model_response_content_exposed": {
      "const": false,
      "default": false,
      "title": "Raw Model Response Content Exposed",
      "type": "boolean"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m8-qwen-hearing-demo-preparation-v1",
      "default": "m8-qwen-hearing-demo-preparation-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "screening_decision": {
      "const": "ESCALATE",
      "default": "ESCALATE",
      "title": "Screening Decision",
      "type": "string"
    },
    "screening_probability": {
      "default": 0.5,
      "maximum": 0.5,
      "minimum": 0.5,
      "title": "Screening Probability",
      "type": "number"
    },
    "start_request": {
      "$ref": "#/$defs/M8HearingStartRequestV1"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "config_sha256",
    "manifest_id",
    "provider_selections",
    "evidence",
    "start_request",
    "preparation_id"
  ],
  "title": "M8QwenHearingDemoPreparationV1",
  "type": "object"
}
