{
  "$defs": {
    "M8OperationalSource": {
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "raw_reference_required": {
              "const": true
            }
          },
          "required": [
            "raw_reference_required"
          ]
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "LIVE_CAMERA"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "certification_id": {
                "type": "null"
              },
              "display_badge": {
                "const": "LIVE · CAMERA"
              },
              "emergency_authority_enabled": {
                "const": false
              },
              "life_safety_eligible": {
                "const": false
              },
              "sensor_type": {
                "type": "null"
              },
              "simulated": {
                "const": false
              },
              "source_kind": {
                "const": "CAMERA"
              },
              "timebase": {
                "const": "FRAME_INDEX"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "RECORDED_VIDEO_SIMULATION"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "certification_id": {
                "type": "null"
              },
              "display_badge": {
                "const": "SIMULATED · RECORDED VIDEO"
              },
              "emergency_authority_enabled": {
                "const": false
              },
              "life_safety_eligible": {
                "const": false
              },
              "sensor_type": {
                "type": "null"
              },
              "simulated": {
                "const": true
              },
              "source_kind": {
                "const": "CAMERA"
              },
              "timebase": {
                "const": "FRAME_INDEX"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "LIVE_SENSOR"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "allOf": [
              {
                "else": {
                  "properties": {
                    "life_safety_eligible": {
                      "const": false
                    }
                  }
                },
                "if": {
                  "properties": {
                    "emergency_authority_enabled": {
                      "const": true
                    }
                  },
                  "required": [
                    "emergency_authority_enabled"
                  ]
                },
                "then": {
                  "properties": {
                    "certification_id": {
                      "pattern": "^\\S{1,128}$",
                      "type": "string"
                    },
                    "life_safety_eligible": {
                      "const": true
                    }
                  },
                  "required": [
                    "certification_id"
                  ]
                }
              }
            ],
            "properties": {
              "certification_id": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "pattern": "^\\S{1,128}$",
                    "type": "string"
                  }
                ]
              },
              "display_badge": {
                "const": "LIVE · SENSOR"
              },
              "sensor_type": {
                "enum": [
                  "SMOKE",
                  "TEMPERATURE",
                  "COMBUSTIBLE_GAS",
                  "TOXIC_GAS",
                  "DOOR_CONTACT",
                  "WATER_LEAK",
                  "EMERGENCY_BUTTON"
                ],
                "type": "string"
              },
              "simulated": {
                "const": false
              },
              "source_kind": {
                "const": "SENSOR"
              },
              "timebase": {
                "const": "DEVICE_TIMESTAMP_UTC"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "SIMULATED_SENSOR"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "certification_id": {
                "type": "null"
              },
              "display_badge": {
                "const": "SIMULATED · SENSOR"
              },
              "emergency_authority_enabled": {
                "const": false
              },
              "life_safety_eligible": {
                "const": false
              },
              "sensor_type": {
                "enum": [
                  "SMOKE",
                  "TEMPERATURE",
                  "COMBUSTIBLE_GAS",
                  "TOXIC_GAS",
                  "DOOR_CONTACT",
                  "WATER_LEAK",
                  "EMERGENCY_BUTTON"
                ],
                "type": "string"
              },
              "simulated": {
                "const": true
              },
              "source_kind": {
                "const": "SENSOR"
              },
              "timebase": {
                "const": "SIMULATION_TICK"
              }
            }
          }
        }
      ],
      "description": "One camera or sensor source with machine-enforced truth labeling.",
      "properties": {
        "adapter_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "certification_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certification Id"
        },
        "device_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Device Id",
          "type": "string"
        },
        "display_badge": {
          "readOnly": true,
          "title": "Display Badge",
          "type": "string"
        },
        "emergency_authority_enabled": {
          "default": false,
          "title": "Emergency Authority Enabled",
          "type": "boolean"
        },
        "life_safety_eligible": {
          "readOnly": true,
          "title": "Life Safety Eligible",
          "type": "boolean"
        },
        "location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Location Id",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/M8OperationalSourceMode"
        },
        "raw_reference_required": {
          "default": true,
          "title": "Raw Reference Required",
          "type": "boolean"
        },
        "schema_version": {
          "const": "m8-operational-source-v1",
          "default": "m8-operational-source-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sensor_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/M8SensorType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "simulated": {
          "readOnly": true,
          "title": "Simulated",
          "type": "boolean"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/M8OperationalSourceKind",
          "readOnly": true
        },
        "timebase": {
          "$ref": "#/$defs/M8SourceTimebase",
          "readOnly": true
        }
      },
      "required": [
        "source_id",
        "device_id",
        "location_id",
        "mode",
        "adapter_id",
        "manifest_id",
        "source_kind",
        "timebase",
        "simulated",
        "display_badge",
        "life_safety_eligible"
      ],
      "title": "M8OperationalSource",
      "type": "object"
    },
    "M8OperationalSourceKind": {
      "enum": [
        "CAMERA",
        "SENSOR"
      ],
      "title": "M8OperationalSourceKind",
      "type": "string"
    },
    "M8OperationalSourceMode": {
      "enum": [
        "LIVE_CAMERA",
        "RECORDED_VIDEO_SIMULATION",
        "LIVE_SENSOR",
        "SIMULATED_SENSOR"
      ],
      "title": "M8OperationalSourceMode",
      "type": "string"
    },
    "M8SensorQuality": {
      "enum": [
        "GOOD",
        "DEGRADED",
        "INVALID"
      ],
      "title": "M8SensorQuality",
      "type": "string"
    },
    "M8SensorType": {
      "enum": [
        "SMOKE",
        "TEMPERATURE",
        "COMBUSTIBLE_GAS",
        "TOXIC_GAS",
        "DOOR_CONTACT",
        "WATER_LEAK",
        "EMERGENCY_BUTTON"
      ],
      "title": "M8SensorType",
      "type": "string"
    },
    "M8SimulatedSensorReading": {
      "additionalProperties": false,
      "description": "One deterministic reading in an offline simulation fixture.",
      "properties": {
        "quality": {
          "$ref": "#/$defs/M8SensorQuality",
          "default": "GOOD"
        },
        "schema_version": {
          "const": "m8-simulated-sensor-reading-v1",
          "default": "m8-simulated-sensor-reading-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "simulation_tick": {
          "minimum": 0,
          "title": "Simulation Tick",
          "type": "integer"
        },
        "source_sequence": {
          "minimum": 0,
          "title": "Source Sequence",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "source_sequence",
        "simulation_tick",
        "value"
      ],
      "title": "M8SimulatedSensorReading",
      "type": "object"
    },
    "M8SourceTimebase": {
      "enum": [
        "FRAME_INDEX",
        "DEVICE_TIMESTAMP_UTC",
        "SIMULATION_TICK"
      ],
      "title": "M8SourceTimebase",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-simulated-sensor-scenario-authority-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Complete ordered fixture consumed by the default offline adapter.",
  "properties": {
    "fixture_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fixture Manifest Id",
      "type": "string"
    },
    "reading_inventory_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Reading Inventory Sha256",
      "type": "string"
    },
    "readings": {
      "items": {
        "$ref": "#/$defs/M8SimulatedSensorReading"
      },
      "maxItems": 100000,
      "minItems": 1,
      "title": "Readings",
      "type": "array"
    },
    "scenario_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Scenario Authority Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m8-simulated-sensor-scenario-authority-v1",
      "default": "m8-simulated-sensor-scenario-authority-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/M8OperationalSource"
    },
    "source_catalog_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Catalog Id",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "source_catalog_id",
    "source",
    "readings",
    "fixture_manifest_id",
    "reading_inventory_sha256",
    "scenario_authority_id"
  ],
  "title": "M8SimulatedSensorScenarioAuthorityV1",
  "type": "object"
}
