{
  "$defs": {
    "M8KnowledgeDocumentType": {
      "enum": [
        "DEVICE_MANUAL",
        "EMERGENCY_PLAN",
        "FAQ",
        "HISTORICAL_PRECEDENT",
        "POLICY",
        "SOP"
      ],
      "title": "M8KnowledgeDocumentType",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-knowledge-query-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded lexical query over one exact catalog and requester authority.",
  "properties": {
    "allowed_document_types": {
      "items": {
        "$ref": "#/$defs/M8KnowledgeDocumentType"
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Allowed Document Types",
      "type": "array"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "catalog_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Catalog Authority Id",
      "type": "string"
    },
    "locale": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Locale",
      "type": "string"
    },
    "max_citations": {
      "exclusiveMinimum": 0,
      "maximum": 10,
      "title": "Max Citations",
      "type": "integer"
    },
    "query_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Query Id",
      "type": "string"
    },
    "query_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Query Manifest Id",
      "type": "string"
    },
    "query_text": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Query Text",
      "type": "string"
    },
    "requester_actor_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Requester Actor Authority Id",
      "type": "string"
    },
    "requester_actor_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Requester Actor Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m8-knowledge-query-v1",
      "default": "m8-knowledge-query-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "catalog_authority_id",
    "requester_actor_id",
    "requester_actor_authority_id",
    "query_text",
    "locale",
    "as_of",
    "allowed_document_types",
    "max_citations",
    "query_manifest_id",
    "query_id"
  ],
  "title": "M8KnowledgeQueryV1",
  "type": "object"
}
