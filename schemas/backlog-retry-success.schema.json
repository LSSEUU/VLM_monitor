{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "RUN",
        "FRAME",
        "SAFETY_SIGNAL",
        "EVENT",
        "CASE",
        "DETECTION",
        "OBJECTIVE_FACT",
        "CROP",
        "MEDIA",
        "EVIDENCE_PACK",
        "TOOL_RESULT",
        "MANIFEST",
        "MODEL_RESPONSE",
        "MODEL_REQUEST",
        "PROMPT_MANIFEST",
        "MODEL_PARSE_RECEIPT",
        "PARSED_MODEL_OUTPUT",
        "PROCEDURAL_REVIEW",
        "MODEL_CACHE_ENTRY",
        "SCREENING_RESULT",
        "VERDICT",
        "ALERT",
        "PRECEDENT",
        "APPEAL",
        "TRAINING_LABEL",
        "BACKLOG_ITEM",
        "DATASET"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A kind-discriminated reference with syntax fixed by the artifact kind.",
      "properties": {
        "artifact_id": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BacklogLeaseIdentity": {
      "additionalProperties": false,
      "description": "Non-secret CAS identity for one exact leased backlog generation.",
      "properties": {
        "attempt_count": {
          "exclusiveMinimum": 0,
          "title": "Attempt Count",
          "type": "integer"
        },
        "item_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Item Id",
          "type": "string"
        },
        "lease_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lease Id",
          "type": "string"
        },
        "lease_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Lease Identity Sha256",
          "type": "string"
        },
        "retry_generation": {
          "minimum": 0,
          "title": "Retry Generation",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "item_id",
        "lease_id",
        "attempt_count",
        "retry_generation",
        "lease_identity_sha256"
      ],
      "title": "BacklogLeaseIdentity",
      "type": "object"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/backlog-retry-success.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Intent for one M3 business success under an exact lease identity.",
  "properties": {
    "completion_case_status": {
      "enum": [
        "ESCALATED",
        "READY_FOR_ALERT_POLICY",
        "REWORK_REQUIRED"
      ],
      "title": "Completion Case Status",
      "type": "string"
    },
    "completion_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "lease": {
      "$ref": "#/$defs/BacklogLeaseIdentity"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "outcome_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Outcome Id",
      "type": "string"
    },
    "outcome_kind": {
      "const": "SUCCESS",
      "default": "SUCCESS",
      "title": "Outcome Kind",
      "type": "string"
    },
    "response_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Response Refs",
      "type": "array"
    }
  },
  "required": [
    "lease",
    "completion_case_status",
    "completion_ref",
    "response_refs",
    "manifest_id",
    "outcome_id"
  ],
  "title": "BacklogRetrySuccess",
  "type": "object"
}
