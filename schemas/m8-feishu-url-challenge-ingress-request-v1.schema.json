{
  "$id": "https://schemas.labcourt.local/v2/m8-feishu-url-challenge-ingress-request-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact encrypted URL challenge evidence before decryption or token claims.",
  "properties": {
    "business_event_accepted": {
      "readOnly": true,
      "title": "Business Event Accepted",
      "type": "boolean"
    },
    "credential_material_embedded": {
      "readOnly": true,
      "title": "Credential Material Embedded",
      "type": "boolean"
    },
    "encrypted_body_ref": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Encrypted Body Ref",
      "type": "string"
    },
    "encrypted_body_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Encrypted Body Sha256",
      "type": "string"
    },
    "encrypted_body_size_bytes": {
      "exclusiveMinimum": 0,
      "maximum": 262144,
      "title": "Encrypted Body Size Bytes",
      "type": "integer"
    },
    "inbound_profile_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Inbound Profile Id",
      "type": "string"
    },
    "ingress_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ingress Manifest Id",
      "type": "string"
    },
    "ingress_request_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Ingress Request Id",
      "type": "string"
    },
    "payload_decrypted": {
      "readOnly": true,
      "title": "Payload Decrypted",
      "type": "boolean"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "request_signature_applicable": {
      "readOnly": true,
      "title": "Request Signature Applicable",
      "type": "boolean"
    },
    "schema_version": {
      "const": "m8-feishu-url-challenge-ingress-request-v1",
      "default": "m8-feishu-url-challenge-ingress-request-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "signature_verified": {
      "readOnly": true,
      "title": "Signature Verified",
      "type": "boolean"
    }
  },
  "required": [
    "inbound_profile_id",
    "encrypted_body_ref",
    "encrypted_body_sha256",
    "encrypted_body_size_bytes",
    "received_at",
    "ingress_manifest_id",
    "request_signature_applicable",
    "signature_verified",
    "payload_decrypted",
    "business_event_accepted",
    "credential_material_embedded",
    "ingress_request_id"
  ],
  "title": "M8FeishuUrlChallengeIngressRequestV1",
  "type": "object"
}
