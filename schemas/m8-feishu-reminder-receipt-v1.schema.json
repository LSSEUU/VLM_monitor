{
  "$defs": {
    "M8FeishuReminderOutcome": {
      "enum": [
        "QUEUED",
        "CANCELLED_ACKNOWLEDGED",
        "CANCELLED_CASE_RESOLVED",
        "SUPPRESSED_UNKNOWN_DELIVERY"
      ],
      "title": "M8FeishuReminderOutcome",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-feishu-reminder-receipt-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assessed_at": {
      "format": "date-time",
      "title": "Assessed At",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/M8FeishuReminderOutcome"
    },
    "reminder_notification_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reminder Notification Id"
    },
    "reminder_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Reminder Receipt Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m8-feishu-reminder-receipt-v1",
      "default": "m8-feishu-reminder-receipt-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_dispatch_request_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Dispatch Request Id",
      "type": "string"
    },
    "source_notification_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Notification Id",
      "type": "string"
    }
  },
  "required": [
    "source_dispatch_request_id",
    "source_notification_id",
    "outcome",
    "assessed_at",
    "reminder_receipt_id"
  ],
  "title": "M8FeishuReminderReceiptV1",
  "type": "object"
}
