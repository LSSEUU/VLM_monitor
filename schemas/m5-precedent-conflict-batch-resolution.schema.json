{
  "$defs": {
    "EvidenceClass": {
      "enum": [
        "PRESENCE",
        "ABSENCE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "M5EmbeddingChannel": {
      "enum": [
        "TEXT",
        "VISUAL"
      ],
      "title": "M5EmbeddingChannel",
      "type": "string"
    },
    "M5EmbeddingRequest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "FAKE_SHA256_SIGNED_PROJECTION_V1",
          "default": "FAKE_SHA256_SIGNED_PROJECTION_V1",
          "title": "Algorithm",
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/M5EmbeddingChannel"
        },
        "dimensions": {
          "exclusiveMinimum": 0,
          "maximum": 4096,
          "title": "Dimensions",
          "type": "integer"
        },
        "input_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Input Ref",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "model_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Manifest Id",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m5-embedding-request-v1",
          "default": "m5-embedding-request-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "input_ref",
        "input_sha256",
        "model_manifest_id",
        "dimensions",
        "request_id"
      ],
      "title": "M5EmbeddingRequest",
      "type": "object"
    },
    "M5EmbeddingVector": {
      "additionalProperties": false,
      "properties": {
        "embedding_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Embedding Id",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/M5EmbeddingRequest"
        },
        "schema_version": {
          "const": "m5-embedding-vector-v1",
          "default": "m5-embedding-vector-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "request",
        "values",
        "embedding_id"
      ],
      "title": "M5EmbeddingVector",
      "type": "object"
    },
    "M5PrecedentAuthority": {
      "additionalProperties": false,
      "properties": {
        "activated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activated At"
        },
        "activation_not_before": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activation Not Before"
        },
        "authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Authority Id",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "precedent": {
          "$ref": "#/$defs/Precedent"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m5-precedent-authority-v1",
          "default": "m5-precedent-authority-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "text_embedding": {
          "anyOf": [
            {
              "$ref": "#/$defs/M5EmbeddingVector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "visual_embeddings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/M5EmbeddingVector"
          },
          "maxItems": 32,
          "title": "Visual Embeddings",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "config_sha256",
        "revision",
        "precedent",
        "created_at",
        "authority_id"
      ],
      "title": "M5PrecedentAuthority",
      "type": "object"
    },
    "M5PrecedentConflictBatchAuthority": {
      "additionalProperties": false,
      "description": "Content-addressed evidence for one complete, budgeted ACTIVE snapshot.",
      "properties": {
        "batch_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Batch Authority Id",
          "type": "string"
        },
        "candidates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/M5PrecedentConflictCandidateAuthority"
          },
          "maxItems": 9999,
          "title": "Candidates",
          "type": "array"
        },
        "causal_cut": {
          "$ref": "#/$defs/M5PrecedentConflictCausalCut"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "edges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/M5PrecedentConflictEdge"
          },
          "maxItems": 49985001,
          "title": "Edges",
          "type": "array"
        },
        "evaluated_pair_count": {
          "maximum": 49985001,
          "minimum": 0,
          "title": "Evaluated Pair Count",
          "type": "integer"
        },
        "policy_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "scan_limit": {
          "exclusiveMinimum": 0,
          "maximum": 9999,
          "title": "Scan Limit",
          "type": "integer"
        },
        "schema_version": {
          "const": "m5-precedent-conflict-batch-authority-v1",
          "default": "m5-precedent-conflict-batch-authority-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "config_sha256",
        "policy_id",
        "causal_cut",
        "scan_limit",
        "evaluated_pair_count",
        "batch_authority_id"
      ],
      "title": "M5PrecedentConflictBatchAuthority",
      "type": "object"
    },
    "M5PrecedentConflictBatchReceipt": {
      "additionalProperties": false,
      "description": "Atomic commit receipt covering every node in a conflict batch.",
      "properties": {
        "batch_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Batch Authority Id",
          "type": "string"
        },
        "causal_cut_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Causal Cut Id",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Id",
          "type": "string"
        },
        "receipt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Receipt Id",
          "type": "string"
        },
        "results": {
          "default": [],
          "items": {
            "$ref": "#/$defs/M5PrecedentConflictNodeResult"
          },
          "maxItems": 9999,
          "title": "Results",
          "type": "array"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m5-precedent-conflict-batch-receipt-v1",
          "default": "m5-precedent-conflict-batch-receipt-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "config_sha256",
        "policy_id",
        "batch_authority_id",
        "causal_cut_id",
        "receipt_id"
      ],
      "title": "M5PrecedentConflictBatchReceipt",
      "type": "object"
    },
    "M5PrecedentConflictCandidateAuthority": {
      "additionalProperties": false,
      "description": "One exact ACTIVE head in a complete conflict-scan snapshot.",
      "properties": {
        "authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Authority Id",
          "type": "string"
        },
        "decision_direction": {
          "$ref": "#/$defs/VerdictDecision"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "precedent_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Precedent Id",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "rule_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Rule Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/PrecedentSource"
        },
        "source_priority": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Source Priority",
          "type": "integer"
        },
        "violation_type": {
          "$ref": "#/$defs/ViolationType"
        }
      },
      "required": [
        "precedent_id",
        "authority_id",
        "revision",
        "source",
        "source_priority",
        "evidence_class",
        "violation_type",
        "rule_version",
        "decision_direction"
      ],
      "title": "M5PrecedentConflictCandidateAuthority",
      "type": "object"
    },
    "M5PrecedentConflictCausalCut": {
      "additionalProperties": false,
      "description": "Authority-only ledger watermark and complete ACTIVE-head root.",
      "properties": {
        "active_head_count": {
          "maximum": 9999,
          "minimum": 0,
          "title": "Active Head Count",
          "type": "integer"
        },
        "active_head_root_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Active Head Root Sha256",
          "type": "string"
        },
        "authority_event_sequence": {
          "minimum": 0,
          "title": "Authority Event Sequence",
          "type": "integer"
        },
        "authority_event_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Authority Event Sha256",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "cut_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Cut Id",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m5-precedent-conflict-causal-cut-v1",
          "default": "m5-precedent-conflict-causal-cut-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "manifest_id",
        "config_sha256",
        "policy_id",
        "authority_event_sequence",
        "authority_event_sha256",
        "active_head_count",
        "active_head_root_sha256",
        "cut_id"
      ],
      "title": "M5PrecedentConflictCausalCut",
      "type": "object"
    },
    "M5PrecedentConflictEdge": {
      "additionalProperties": false,
      "description": "One threshold-qualified opposite-direction edge in the complete graph.",
      "properties": {
        "edge_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Edge Id",
          "type": "string"
        },
        "left_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Left Authority Id",
          "type": "string"
        },
        "left_precedent_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Left Precedent Id",
          "type": "string"
        },
        "left_priority": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Left Priority",
          "type": "integer"
        },
        "normalized_text_weight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Normalized Text Weight",
          "type": "number"
        },
        "normalized_visual_weight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Normalized Visual Weight",
          "type": "number"
        },
        "right_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Right Authority Id",
          "type": "string"
        },
        "right_precedent_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Right Precedent Id",
          "type": "string"
        },
        "right_priority": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Right Priority",
          "type": "integer"
        },
        "similarity": {
          "maximum": 1,
          "minimum": -1,
          "title": "Similarity",
          "type": "number"
        },
        "text_similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Similarity"
        },
        "threshold": {
          "maximum": 1,
          "minimum": -1,
          "title": "Threshold",
          "type": "number"
        },
        "visual_similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visual Similarity"
        }
      },
      "required": [
        "left_precedent_id",
        "right_precedent_id",
        "left_authority_id",
        "right_authority_id",
        "left_priority",
        "right_priority",
        "normalized_text_weight",
        "normalized_visual_weight",
        "similarity",
        "threshold",
        "edge_id"
      ],
      "title": "M5PrecedentConflictEdge",
      "type": "object"
    },
    "M5PrecedentConflictNodeResult": {
      "additionalProperties": false,
      "description": "The unique graph-wide result selected for one candidate head.",
      "properties": {
        "invalidated_by_precedent_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalidated By Precedent Id"
        },
        "precedent_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Precedent Id",
          "type": "string"
        },
        "prior_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prior Authority Id",
          "type": "string"
        },
        "prior_revision": {
          "exclusiveMinimum": 0,
          "title": "Prior Revision",
          "type": "integer"
        },
        "resulting_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Resulting Authority Id",
          "type": "string"
        },
        "resulting_revision": {
          "exclusiveMinimum": 0,
          "title": "Resulting Revision",
          "type": "integer"
        },
        "status_after": {
          "$ref": "#/$defs/PrecedentStatus"
        }
      },
      "required": [
        "precedent_id",
        "prior_authority_id",
        "prior_revision",
        "resulting_authority_id",
        "resulting_revision",
        "status_after"
      ],
      "title": "M5PrecedentConflictNodeResult",
      "type": "object"
    },
    "M5PrecedentPolicy": {
      "additionalProperties": false,
      "properties": {
        "automatic_activation_delay_seconds": {
          "maximum": 316224000,
          "minimum": 0,
          "title": "Automatic Activation Delay Seconds",
          "type": "integer"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "conflict_similarity": {
          "maximum": 1,
          "minimum": -1,
          "title": "Conflict Similarity",
          "type": "number"
        },
        "policy_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Policy Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m5-precedent-policy-v1",
          "default": "m5-precedent-policy-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_priorities": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/PrecedentSource"
          },
          "title": "Source Priorities",
          "type": "object"
        },
        "source_weights": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/PrecedentSource"
          },
          "title": "Source Weights",
          "type": "object"
        },
        "text_weight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Text Weight",
          "type": "number"
        },
        "visual_weight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Visual Weight",
          "type": "number"
        }
      },
      "required": [
        "config_sha256",
        "text_weight",
        "visual_weight",
        "source_weights",
        "source_priorities",
        "conflict_similarity",
        "automatic_activation_delay_seconds",
        "policy_id"
      ],
      "title": "M5PrecedentPolicy",
      "type": "object"
    },
    "Precedent": {
      "additionalProperties": false,
      "properties": {
        "activation_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activation At"
        },
        "citation_count": {
          "default": 0,
          "minimum": 0,
          "title": "Citation Count",
          "type": "integer"
        },
        "decision_direction": {
          "$ref": "#/$defs/VerdictDecision"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "invalidated_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalidated By"
        },
        "precedent_id": {
          "minLength": 1,
          "title": "Precedent Id",
          "type": "string"
        },
        "rule_version": {
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "situation_text": {
          "minLength": 1,
          "title": "Situation Text",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/PrecedentSource"
        },
        "source_case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Case Id"
        },
        "status": {
          "$ref": "#/$defs/PrecedentStatus"
        },
        "text_embedding_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Embedding Ref"
        },
        "violation_type": {
          "$ref": "#/$defs/ViolationType"
        },
        "visual_embedding_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Visual Embedding Refs",
          "type": "array"
        }
      },
      "required": [
        "precedent_id",
        "situation_text",
        "decision_direction",
        "source",
        "status",
        "evidence_class",
        "violation_type",
        "rule_version"
      ],
      "title": "Precedent",
      "type": "object"
    },
    "PrecedentSource": {
      "enum": [
        "PRESET",
        "AUTOMATIC",
        "HUMAN_REVIEW",
        "APPEAL_OVERTURN"
      ],
      "title": "PrecedentSource",
      "type": "string"
    },
    "PrecedentStatus": {
      "enum": [
        "PROVISIONAL",
        "ACTIVE",
        "CONFLICT",
        "INVALIDATED",
        "REVOKED"
      ],
      "title": "PrecedentStatus",
      "type": "string"
    },
    "VerdictDecision": {
      "enum": [
        "ESTABLISHED",
        "NOT_ESTABLISHED",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "VerdictDecision",
      "type": "string"
    },
    "ViolationType": {
      "enum": [
        "PPE_GOGGLES_MISSING",
        "PPE_GLOVES_MISSING",
        "PPE_LAB_COAT_MISSING",
        "REAGENT_CONTAINER_OPEN",
        "FOOD_OR_DRINK_IN_LAB",
        "SINGLE_PERSON_HAZARDOUS_OPERATION",
        "FUME_HOOD_SASH_TOO_HIGH",
        "UNATTENDED_HEATING",
        "SMOKE_ABNORMAL",
        "OPEN_FLAME"
      ],
      "title": "ViolationType",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m5-precedent-conflict-batch-resolution.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Pure graph result supplied to the atomic repository commit boundary.",
  "properties": {
