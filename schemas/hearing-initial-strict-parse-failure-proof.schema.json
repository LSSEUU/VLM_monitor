  "$id": "https://schemas.labcourt.local/v2/hearing-initial-strict-parse-failure-proof.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Two initial strict failures authorizing generation one backlog work.\n\nThis proof deliberately has no lease: it closes the original role call in\nthe same transaction that creates its immutable HEARING backlog item.  A\nlater strict failure while processing a lease uses\n:class:`HearingStrictParseFailureProof` instead.",
  "properties": {
    "attempts": {
      "items": {
        "$ref": "#/$defs/HearingStrictParseFailureAttempt"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Attempts",
      "type": "array"
    },
    "backlog_item_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Backlog Item Id",
      "type": "string"
    },
    "proof_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Proof Id",
      "type": "string"
    },
    "role": {
      "enum": [
        "PROSECUTOR",
        "DEFENDER",
        "JUDGE"
      ],
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "const": "m4-hearing-initial-strict-parse-failure-proof-v1",
      "default": "m4-hearing-initial-strict-parse-failure-proof-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_checkpoint_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Checkpoint Id",
      "type": "string"
    },
    "source_checkpoint_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Checkpoint Sha256",
      "type": "string"
    },
    "source_checkpoint_version": {
      "exclusiveMinimum": 0,
      "title": "Source Checkpoint Version",
      "type": "integer"
    }
  },
  "required": [
    "backlog_item_id",
    "source_checkpoint_id",
    "source_checkpoint_sha256",
    "source_checkpoint_version",
    "role",
    "attempts",
    "proof_id"
  ],
  "title": "HearingInitialStrictParseFailureProof",
  "type": "object"
}
