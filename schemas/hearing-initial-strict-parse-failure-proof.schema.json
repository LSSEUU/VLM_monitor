    "ProceduralDefect": {
      "additionalProperties": false,
      "description": "One code-specific, non-sensitive parser or gate defect.",
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "code": {
          "$ref": "#/$defs/ProceduralDefectCode"
        },
        "defect_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Defect Id",
          "type": "string"
        },
        "field": {
          "$ref": "#/$defs/ProceduralField"
        },
        "origin": {
          "$ref": "#/$defs/ProceduralDefectOrigin"
        },
        "reason_code": {
          "$ref": "#/$defs/ProceduralReasonCode"
        },
        "related_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Related Refs",
          "type": "array"
        },
        "value_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Sha256"
        }
      },
      "required": [
        "code",
        "origin",
        "reason_code",
        "artifact_ref",
        "field",
        "defect_id"
      ],
      "title": "ProceduralDefect",
      "type": "object"
    },
    "ProceduralDefectCode": {
