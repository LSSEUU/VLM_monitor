{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "RUN",
        "FRAME",
        "SAFETY_SIGNAL",
        "EVENT",
        "CASE",
        "DETECTION",
        "OBJECTIVE_FACT",
        "CROP",
        "MEDIA",
        "EVIDENCE_PACK",
        "TOOL_RESULT",
        "MANIFEST",
        "MODEL_RESPONSE",
        "MODEL_REQUEST",
        "PROMPT_MANIFEST",
        "MODEL_PARSE_RECEIPT",
        "PARSED_MODEL_OUTPUT",
        "PROCEDURAL_REVIEW",
        "MODEL_CACHE_ENTRY",
        "SCREENING_RESULT",
        "VERDICT",
        "ALERT",
        "PRECEDENT",
        "APPEAL",
        "TRAINING_LABEL",
        "BACKLOG_ITEM",
        "DATASET"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A kind-discriminated reference with syntax fixed by the artifact kind.",
      "properties": {
        "artifact_id": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BacklogRetryContext": {
      "additionalProperties": false,
      "description": "Request identity input that changes only after a proven parse failure.\n\nThe lease is deliberately absent.  A provider outage, timeout, or unknown\nworker crash may result in another lease, but must keep the same model\nrequest identity so durable claim/journal recovery can prevent a duplicate\nexternal call.",
      "properties": {
        "backlog_item_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Backlog Item Id",
          "type": "string"
        },
        "context_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Context Id",
          "type": "string"
        },
        "retry_generation": {
          "minimum": 0,
          "title": "Retry Generation",
          "type": "integer"
        }
      },
      "required": [
        "backlog_item_id",
        "retry_generation",
        "context_id"
      ],
      "title": "BacklogRetryContext",
      "type": "object"
    },
    "CropSource": {
      "enum": [
        "PANORAMA",
        "SUBJECT",
        "DETECTION_FOCUS",
        "ANCHOR_FOCUS",
        "RECROP"
      ],
      "title": "CropSource",
      "type": "string"
    },
    "EvidenceClass": {
      "enum": [
        "PRESENCE",
        "ABSENCE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "ExecutionLocation": {
      "enum": [
        "LOCAL",
        "EXTERNAL"
      ],
      "title": "ExecutionLocation",
      "type": "string"
    },
    "HearingModelParseReceipt": {
      "additionalProperties": false,
      "description": "Strict parser outcome for one role payload, preserving unknown references.",
      "properties": {
        "attempt_index": {
          "enum": [
            0,
            1
          ],
          "title": "Attempt Index",
          "type": "integer"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "defects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProceduralDefect"
          },
          "maxItems": 3,
          "title": "Defects",
          "type": "array"
        },
        "hearing_session_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hearing Session Id",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "output_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Schema Sha256",
          "type": "string"
        },
        "parse_receipt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Parse Receipt Id",
          "type": "string"
        },
        "parsed_payload_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parsed Payload Sha256"
        },
        "parser_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Parser Version",
          "type": "string"
        },
        "repair_request_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repair Request Id"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Id",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "response_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Content Sha256",
          "type": "string"
        },
        "response_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "PROSECUTOR",
            "DEFENDER",
            "JUDGE"
          ],
          "title": "Role",
          "type": "string"
        },
        "round_index": {
          "exclusiveMinimum": 0,
          "maximum": 5,
          "title": "Round Index",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m4-hearing-parse-receipt-v1",
          "default": "m4-hearing-parse-receipt-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ModelParseStatus"
        },
        "unknown_reference_attempts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HearingUnknownReferenceAttempt"
          },
          "maxItems": 256,
          "title": "Unknown Reference Attempts",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "hearing_session_id",
        "round_index",
        "role",
        "attempt_index",
        "request_id",
        "request_sha256",
        "response_id",
        "response_content_sha256",
        "parser_version",
        "output_schema_sha256",
        "status",
        "manifest_id",
        "parse_receipt_id"
      ],
      "title": "HearingModelParseReceipt",
      "type": "object"
    },
    "HearingModelRequest": {
      "additionalProperties": false,
      "description": "One role-specific M4 call, including its repair generation when present.",
      "properties": {
        "allowed_evidence_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "maxItems": 512,
          "minItems": 1,
          "title": "Allowed Evidence Refs",
          "type": "array"
        },
        "allowed_precedent_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "maxItems": 64,
          "title": "Allowed Precedent Refs",
          "type": "array"
        },
        "attempt_index": {
          "default": 0,
          "enum": [
            0,
            1
          ],
          "title": "Attempt Index",
          "type": "integer"
        },
        "backlog_retry_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/BacklogRetryContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "budget": {
          "$ref": "#/$defs/VlmCallBudget"
        },
        "cache_key": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Cache Key",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "current_evidence_pack_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Current Evidence Pack Id",
          "type": "string"
        },
        "current_evidence_pack_version": {
          "exclusiveMinimum": 0,
          "title": "Current Evidence Pack Version",
          "type": "integer"
        },
        "cycle_scope_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Cycle Scope Id",
          "type": "string"
        },
        "cycle_scope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Cycle Scope Sha256",
          "type": "string"
        },
        "defender_output_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "execution_location": {
          "$ref": "#/$defs/ExecutionLocation"
        },
        "hearing_context_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hearing Context Sha256",
          "type": "string"
        },
        "hearing_prompt_bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hearing Prompt Bundle Sha256",
          "type": "string"
        },
        "hearing_session_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hearing Session Id",
          "type": "string"
        },
        "initial_defect_codes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProceduralDefectCode"
          },
          "maxItems": 14,
          "title": "Initial Defect Codes",
          "type": "array"
        },
        "initial_trigger_review_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "media": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VLMMediaRef"
          },
          "maxItems": 64,
          "title": "Media",
          "type": "array"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Manifest Id",
          "type": "string"
        },
        "original_request_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Request Id"
        },
        "original_response_content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Response Content Sha256"
        },
        "original_response_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Response Id"
        },
        "precedent_retrieval_degraded": {
          "title": "Precedent Retrieval Degraded",
          "type": "boolean"
        },
        "precedent_retrieval_receipt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Precedent Retrieval Receipt Id",
          "type": "string"
        },
        "precedent_retrieval_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Precedent Retrieval Receipt Sha256",
          "type": "string"
        },
        "prior_acquisition_rounds": {
          "maximum": 2,
          "minimum": 0,
          "title": "Prior Acquisition Rounds",
          "type": "integer"
        },
        "prior_rework_rounds": {
          "maximum": 2,
          "minimum": 0,
          "title": "Prior Rework Rounds",
          "type": "integer"
        },
        "prompt_manifest": {
          "$ref": "#/$defs/PromptManifest"
        },
        "prosecutor_output_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "provider_profile": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Provider Profile",
          "type": "string"
        },
        "purpose": {
          "const": "HEARING_ROLE",
          "default": "HEARING_ROLE",
          "title": "Purpose",
          "type": "string"
        },
        "rendered_prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rendered Prompt Sha256",
          "type": "string"
        },
        "repair_context_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repair Context Sha256"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Request Id",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Request Sha256",
          "type": "string"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "rework_defect_codes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProceduralDefectCode"
          },
          "maxItems": 14,
          "title": "Rework Defect Codes",
          "type": "array"
        },
        "rework_review_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "enum": [
            "PROSECUTOR",
            "DEFENDER",
            "JUDGE"
          ],
          "title": "Role",
          "type": "string"
        },
        "round_index": {
          "exclusiveMinimum": 0,
          "maximum": 5,
          "title": "Round Index",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m4-hearing-model-request-v1",
          "default": "m4-hearing-model-request-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "screening_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "temperature": {
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "violation_type": {
          "$ref": "#/$defs/ViolationType"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "hearing_session_id",
        "round_index",
        "prior_acquisition_rounds",
        "prior_rework_rounds",
        "current_evidence_pack_id",
        "current_evidence_pack_version",
        "screening_ref",
        "violation_type",
        "evidence_class",
        "role",
        "provider_profile",
        "provider",
        "model",
        "revision",
        "model_manifest_id",
        "execution_location",
        "prompt_manifest",
        "hearing_prompt_bundle_sha256",
        "rendered_prompt_sha256",
        "hearing_context_sha256",
        "allowed_evidence_refs",
        "precedent_retrieval_degraded",
        "precedent_retrieval_receipt_id",
        "precedent_retrieval_receipt_sha256",
        "temperature",
        "budget",
        "manifest_id",
        "cycle_scope_id",
        "cycle_scope_sha256",
        "request_sha256",
        "request_id",
        "cache_key"
      ],
      "title": "HearingModelRequest",
      "type": "object"
    },
    "HearingModelResponse": {
      "additionalProperties": false,
      "description": "Raw M4 provider response receipt; arbitrary bytes remain in private storage.",
      "properties": {
        "attempt_index": {
          "enum": [
            0,
            1
          ],
          "title": "Attempt Index",
          "type": "integer"
        },
        "cache_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cache Key",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "current_evidence_pack_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Current Evidence Pack Id",
          "type": "string"
        },
        "current_evidence_pack_version": {
          "exclusiveMinimum": 0,
          "title": "Current Evidence Pack Version",
          "type": "integer"
        },
        "hearing_session_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hearing Session Id",
          "type": "string"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "model_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Manifest Id",
          "type": "string"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "prior_acquisition_rounds": {
          "maximum": 2,
          "minimum": 0,
          "title": "Prior Acquisition Rounds",
          "type": "integer"
        },
        "prior_rework_rounds": {
          "maximum": 2,
          "minimum": 0,
          "title": "Prior Rework Rounds",
          "type": "integer"
        },
        "raw_response_ref": {
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\<>:\\\"|?*])(?:[^/\\x00-\\x1f]+/)*[^/\\x00-\\x1f]+$",
          "title": "Raw Response Ref",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Id",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "response_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Response Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "PROSECUTOR",
            "DEFENDER",
            "JUDGE"
          ],
          "title": "Role",
          "type": "string"
        },
        "round_index": {
          "exclusiveMinimum": 0,
          "maximum": 5,
          "title": "Round Index",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m4-hearing-model-response-v1",
          "default": "m4-hearing-model-response-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 16777216,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "hearing_session_id",
        "round_index",
        "prior_acquisition_rounds",
        "prior_rework_rounds",
        "current_evidence_pack_id",
        "current_evidence_pack_version",
        "role",
        "attempt_index",
        "request_id",
        "request_sha256",
        "cache_key",
        "raw_response_ref",
        "content_sha256",
        "size_bytes",
        "model_manifest_id",
        "manifest_id",
        "response_id"
      ],
      "title": "HearingModelResponse",
      "type": "object"
    },
    "HearingStrictParseFailureAttempt": {
      "additionalProperties": false,
      "description": "One fully persisted strict parse failure for a hearing retry.",
      "properties": {
        "attempt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Attempt Id",
          "type": "string"
        },
        "parse_receipt": {
          "$ref": "#/$defs/HearingModelParseReceipt"
        },
        "request": {
          "$ref": "#/$defs/HearingModelRequest"
        },
        "response": {
          "$ref": "#/$defs/HearingModelResponse"
        },
        "schema_version": {
          "const": "m4-hearing-strict-parse-attempt-v1",
          "default": "m4-hearing-strict-parse-attempt-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "request",
        "response",
        "parse_receipt",
        "attempt_id"
      ],
      "title": "HearingStrictParseFailureAttempt",
      "type": "object"
    },
    "HearingUnknownReferenceAttempt": {
      "additionalProperties": false,
      "description": "Non-sensitive proof that one M4 role emitted a non-whitelisted reference.",
      "properties": {
        "namespace": {
          "$ref": "#/$defs/UnknownReferenceNamespace"
        },
        "source": {
          "$ref": "#/$defs/HearingUnknownReferenceSource"
        },
        "value_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value Sha256",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "source",
        "value_sha256"
      ],
      "title": "HearingUnknownReferenceAttempt",
      "type": "object"
    },
