{
  "$defs": {
    "M8CalibrationAssessmentMode": {
      "enum": [
        "SHADOW",
        "NOT_APPLICABLE"
      ],
      "title": "M8CalibrationAssessmentMode",
      "type": "string"
    },
    "M8CalibrationReasonCode": {
      "enum": [
        "INSUFFICIENT_DATA",
        "ARTIFACT_UNAVAILABLE",
        "CONFIG_MISMATCH",
        "MODEL_PROFILE_MISMATCH",
        "DETECTOR_MODEL_MISMATCH",
        "FEATURE_SCHEMA_MISMATCH",
        "EVIDENCE_INSUFFICIENT"
      ],
      "title": "M8CalibrationReasonCode",
      "type": "string"
    },
    "M8EventRiskAssessmentV1": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "assessment_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assessment Id",
          "type": "string"
        },
        "asset_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Asset Id",
          "type": "string"
        },
        "calibrated_probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibrated Probability"
        },
        "evidence_quality_assessment_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Quality Assessment Id",
          "type": "string"
        },
        "llm_output_used": {
          "const": false,
          "default": false,
          "title": "Llm Output Used",
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/M8CalibrationAssessmentMode"
        },
        "raw_event_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Event Score"
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/M8CalibrationReasonCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "routing_authority": {
          "const": false,
          "default": false,
          "title": "Routing Authority",
          "type": "boolean"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-event-risk-assessment-v1",
          "default": "m8-event-risk-assessment-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "assessment_id",
        "run_id",
        "asset_id",
        "evidence_quality_assessment_id",
        "mode"
      ],
      "title": "M8EventRiskAssessmentV1",
      "type": "object"
    },
    "M8EvidenceQualityAssessmentV1": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "assessment_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assessment Id",
          "type": "string"
        },
        "asset_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Asset Id",
          "type": "string"
        },
        "llm_output_used": {
          "const": false,
          "default": false,
          "title": "Llm Output Used",
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/M8CalibrationAssessmentMode"
        },
        "quality_probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Probability"
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/M8CalibrationReasonCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "routing_authority": {
          "const": false,
          "default": false,
          "title": "Routing Authority",
          "type": "boolean"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-evidence-quality-assessment-v1",
          "default": "m8-evidence-quality-assessment-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sufficiency_threshold": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sufficiency Threshold"
        },
        "sufficient": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sufficient"
        }
      },
      "required": [
        "assessment_id",
        "run_id",
        "asset_id",
        "mode"
      ],
      "title": "M8EvidenceQualityAssessmentV1",
      "type": "object"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-run-risk-assessment-view-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Asset Id",
      "type": "string"
    },
    "event_risk": {
      "$ref": "#/$defs/M8EventRiskAssessmentV1"
    },
    "evidence_quality": {
      "$ref": "#/$defs/M8EvidenceQualityAssessmentV1"
    },
    "qwen_probability_is_authority": {
      "const": false,
      "default": false,
      "title": "Qwen Probability Is Authority",
      "type": "boolean"
    },
    "routing_changed": {
      "const": false,
      "default": false,
      "title": "Routing Changed",
      "type": "boolean"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m8-run-risk-assessment-view-v1",
      "default": "m8-run-risk-assessment-view-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "asset_id",
    "evidence_quality",
    "event_risk"
  ],
  "title": "M8RunRiskAssessmentViewV1",
  "type": "object"
}
