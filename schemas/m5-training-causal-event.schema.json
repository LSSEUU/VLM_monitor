{
  "$defs": {
    "M5TrainingCausalEventKind": {
      "enum": [
        "TRAINING_LABEL_APPENDED",
        "DATASET_REGISTRATION_COMMITTED"
      ],
      "title": "M5TrainingCausalEventKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m5-training-causal-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One source authority at one exact position in the per-run training chain.",
  "properties": {
    "event_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Event Id",
      "type": "string"
    },
    "event_kind": {
      "$ref": "#/$defs/M5TrainingCausalEventKind"
    },
    "event_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Event Sha256",
      "type": "string"
    },
    "label_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label Id"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "previous_event_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Previous Event Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m5-training-causal-event-v1",
      "default": "m5-training-causal-event-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "exclusiveMinimum": 0,
      "maximum": 100000,
      "title": "Sequence",
      "type": "integer"
    },
    "source_document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Document Sha256",
      "type": "string"
    },
    "source_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Id",
      "type": "string"
    },
    "source_identity": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Source Identity",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "sequence",
    "event_kind",
    "source_id",
    "source_document_sha256",
    "manifest_id",
    "previous_event_sha256",
    "source_identity",
    "event_id",
    "event_sha256"
  ],
  "title": "M5TrainingCausalEvent",
  "type": "object"
}
