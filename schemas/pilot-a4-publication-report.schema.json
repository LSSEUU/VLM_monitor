{
  "$defs": {
    "AlertChannelCapabilityAuthority": {
      "additionalProperties": false,
      "description": "Durable channel claim governing retries after an unknown delivery.",
      "properties": {
        "capability_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Capability Id",
          "type": "string"
        },
        "capability_revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Capability Revision",
          "type": "string"
        },
        "channel": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Channel",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "idempotency_guarantee": {
          "$ref": "#/$defs/AlertChannelIdempotencyGuarantee"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "provider_idempotency_key": {
          "anyOf": [
            {
              "const": "alert_id",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Idempotency Key"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "manifest_id",
        "config_sha256",
        "channel",
        "capability_revision",
        "idempotency_guarantee",
        "capability_id"
      ],
      "title": "AlertChannelCapabilityAuthority",
      "type": "object"
    },
    "AlertChannelIdempotencyGuarantee": {
      "enum": [
        "NONE",
        "EXACT_ALERT_ID"
      ],
      "title": "AlertChannelIdempotencyGuarantee",
      "type": "string"
    },
    "AlertDispatchContinuation": {
      "enum": [
        "CLOSED",
        "RETRY_ALLOWED",
        "ATTENTION_REQUIRED"
      ],
      "title": "AlertDispatchContinuation",
      "type": "string"
    },
    "AlertDispatchDisposition": {
      "enum": [
        "SUCCEEDED",
        "RETRYABLE_FAILURE",
        "UNKNOWN_DELIVERY"
      ],
      "title": "AlertDispatchDisposition",
      "type": "string"
    },
    "AlertDispatchFailureCode": {
      "enum": [
        "CHANNEL_EXCEPTION",
        "CHANNEL_DEFINITELY_NOT_SENT",
        "CHANNEL_REJECTED",
        "RECEIPT_MISMATCH",
        "LEASE_EXPIRED"
      ],
      "title": "AlertDispatchFailureCode",
      "type": "string"
    },
    "AlertDispatchReceipt": {
      "additionalProperties": false,
      "properties": {
        "alert_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Alert Id",
          "type": "string"
        },
        "attempt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "attempt_number": {
          "exclusiveMinimum": 0,
          "title": "Attempt Number",
          "type": "integer"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "channel_capability": {
          "$ref": "#/$defs/AlertChannelCapabilityAuthority"
        },
        "continuation": {
          "$ref": "#/$defs/AlertDispatchContinuation"
        },
        "delivery_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryReceipt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "disposition": {
          "$ref": "#/$defs/AlertDispatchDisposition"
        },
        "failure_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlertDispatchFailureCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fence": {
          "exclusiveMinimum": 0,
          "title": "Fence",
          "type": "integer"
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "lease_expires_at": {
          "format": "date-time",
          "title": "Lease Expires At",
          "type": "string"
        },
        "lease_owner_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lease Owner Sha256",
          "type": "string"
        },
        "outbox_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Outbox Id",
          "type": "string"
        },
        "receipt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Receipt Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "outbox_id",
        "alert_id",
        "case_id",
        "attempt_number",
        "fence",
        "lease_owner_sha256",
        "started_at",
        "lease_expires_at",
        "channel_capability",
        "idempotency_key",
        "disposition",
        "continuation",
        "receipt_id"
      ],
      "title": "AlertDispatchReceipt",
      "type": "object"
    },
    "AlertLevel": {
      "enum": [
        "ADVISORY",
        "CONFIRMED",
        "EMERGENCY"
      ],
      "title": "AlertLevel",
      "type": "string"
    },
    "AlertPolicyDisposition": {
      "enum": [
        "ENQUEUE",
        "SUPPRESSED_MERGED",
        "CLOSE_NO_ALERT"
      ],
      "title": "AlertPolicyDisposition",
      "type": "string"
    },
    "AppealStatus": {
      "enum": [
        "SUBMITTED",
        "UNDER_REVIEW",
        "UPHELD",
        "OVERTURNED"
      ],
      "title": "AppealStatus",
      "type": "string"
    },
    "CaseStatus": {
      "enum": [
        "CANDIDATE",
        "EVIDENCE_READY",
        "SCREENED",
        "ESCALATED",
        "DELIBERATING",
        "PROCEDURAL_REVIEW",
        "READY_FOR_ALERT_POLICY",
        "REWORK_REQUIRED",
        "HUMAN_REVIEW",
        "BACKLOGGED",
        "CLOSED",
        "APPEALED",
        "APPEAL_RESOLVED"
      ],
      "title": "CaseStatus",
      "type": "string"
    },
    "DeliveryReceipt": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "alert_id": {
          "minLength": 1,
          "title": "Alert Id",
          "type": "string"
        },
        "channel": {
          "minLength": 1,
          "title": "Channel",
          "type": "string"
        },
        "idempotency_key": {
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "provider_receipt_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Receipt Ref"
        }
      },
      "required": [
        "alert_id",
        "channel",
        "idempotency_key",
        "accepted"
      ],
      "title": "DeliveryReceipt",
      "type": "object"
    },
    "M5CloseCaseOutcome": {
      "additionalProperties": false,
      "properties": {
        "alert_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alert Id"
        },
        "alert_policy_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Alert Policy Authority Id",
          "type": "string"
        },
        "application_batch_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Application Batch Id"
        },
        "applied_citation_count": {
          "default": 0,
          "maximum": 64,
          "minimum": 0,
          "title": "Applied Citation Count",
          "type": "integer"
        },
        "automatic_precedent_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Automatic Precedent Authority Id",
          "type": "string"
        },
        "automatic_precedent_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Automatic Precedent Id",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "closed_revision": {
          "exclusiveMinimum": 0,
          "title": "Closed Revision",
          "type": "integer"
        },
        "disposition": {
          "$ref": "#/$defs/AlertPolicyDisposition"
        },
        "source_revision": {
          "exclusiveMinimum": 0,
          "title": "Source Revision",
          "type": "integer"
        }
      },
      "required": [
        "case_id",
        "source_revision",
        "closed_revision",
        "disposition",
        "alert_policy_authority_id",
        "automatic_precedent_id",
        "automatic_precedent_authority_id"
      ],
      "title": "M5CloseCaseOutcome",
      "type": "object"
    },
    "M5DispatchCommandReport": {
      "additionalProperties": false,
      "properties": {
        "attention_required_count": {
          "maximum": 256,
          "minimum": 0,
          "title": "Attention Required Count",
          "type": "integer"
        },
        "receipts": {
          "items": {
            "$ref": "#/$defs/AlertDispatchReceipt"
          },
          "maxItems": 256,
          "title": "Receipts",
          "type": "array"
        },
        "retryable_failure_count": {
          "maximum": 256,
          "minimum": 0,
          "title": "Retryable Failure Count",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "selected_count": {
          "maximum": 256,
          "minimum": 0,
          "title": "Selected Count",
          "type": "integer"
        },
        "succeeded_count": {
          "maximum": 256,
          "minimum": 0,
          "title": "Succeeded Count",
          "type": "integer"
        },
        "unknown_delivery_count": {
          "maximum": 256,
          "minimum": 0,
          "title": "Unknown Delivery Count",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "selected_count",
        "succeeded_count",
        "retryable_failure_count",
        "unknown_delivery_count",
        "attention_required_count",
        "receipts"
      ],
      "title": "M5DispatchCommandReport",
      "type": "object"
    },
    "PilotA4CaseView": {
      "additionalProperties": false,
      "properties": {
        "alert_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlertLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "alert_rescinded": {
          "default": false,
          "title": "Alert Rescinded",
          "type": "boolean"
        },
        "anonymous_track_ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anonymous Track Ref"
        },
        "appeal_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppealStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "association_end_frame_exclusive": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Association End Frame Exclusive"
        },
        "association_start_frame": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Association Start Frame"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "case_view_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Case View Id",
          "type": "string"
        },
        "detector": {
          "$ref": "#/$defs/PilotA4ModelVersion"
        },
        "disclaimer": {
          "const": "用于安全辅助与记录，不直接作为处罚依据",
          "default": "用于安全辅助与记录，不直接作为处罚依据",
          "title": "Disclaimer",
          "type": "string"
        },
        "end_frame_exclusive": {
          "exclusiveMinimum": 0,
          "title": "End Frame Exclusive",
          "type": "integer"
        },
        "final_decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerdictDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "human_review_required": {
          "title": "Human Review Required",
          "type": "boolean"
        },
        "key_crops": {
          "items": {
            "$ref": "#/$defs/PilotA4MediaView"
          },
          "maxItems": 12,
          "title": "Key Crops",
          "type": "array"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "observed_frame_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Frame Count"
        },
        "procedural_gate_version": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Procedural Gate Version"
        },
        "procedural_review_passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Procedural Review Passed"
        },
        "prompt_bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Bundle Sha256",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "rule_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Rule Version",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "screening_decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScreeningDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "screening_model": {
          "$ref": "#/$defs/PilotA4ModelVersion"
        },
        "screening_probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Screening Probability"
        },
        "screening_router_version": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Screening Router Version"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/CaseStatus"
        },
        "verdict_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verdict Confidence"
        },
        "verdict_decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerdictDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "violation_type": {
          "$ref": "#/$defs/ViolationType"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "revision",
        "status",
        "violation_type",
        "start_frame",
        "end_frame_exclusive",
        "key_crops",
        "human_review_required",
        "detector",
        "screening_model",
        "prompt_bundle_sha256",
        "rule_version",
        "manifest_id",
        "case_view_id"
      ],
      "title": "PilotA4CaseView",
      "type": "object"
    },
    "PilotA4CloseReport": {
      "additionalProperties": false,
      "description": "Run-scoped A4 closure result that cannot claim external alert delivery.",
      "properties": {
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "delivery_mode": {
          "const": "LOCAL_OUTBOX_ONLY",
          "default": "LOCAL_OUTBOX_ONLY",
          "title": "Delivery Mode",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "outcomes": {
          "items": {
            "$ref": "#/$defs/M5CloseCaseOutcome"
          },
          "maxItems": 10000,
          "title": "Outcomes",
          "type": "array"
        },
        "production_delivery_count": {
          "const": 0,
          "default": 0,
          "title": "Production Delivery Count",
          "type": "integer"
        },
        "report_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Report Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "pilot-a4-close-report-v1",
          "default": "pilot-a4-close-report-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Selected Count",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "manifest_id",
        "config_sha256",
        "selected_count",
        "outcomes",
        "report_id"
      ],
      "title": "PilotA4CloseReport",
      "type": "object"
    },
    "PilotA4MediaView": {
