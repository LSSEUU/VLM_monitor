        "established_count": {
          "minimum": 0,
          "title": "Established Count",
          "type": "integer"
        },
        "human_review_count": {
          "minimum": 0,
          "title": "Human Review Count",
          "type": "integer"
        },
        "insufficient_evidence_count": {
          "minimum": 0,
          "title": "Insufficient Evidence Count",
          "type": "integer"
        },
        "manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "metrics_id": {
          "pattern": "^[0-9a-f]{64}$",
