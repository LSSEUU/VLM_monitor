          "title": "Run Relative Path"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "crop_id",
        "role",
        "frame_id",
        "integrity",
        "media_sha256",
        "width",
        "height"
      ],
      "title": "PilotA4MediaView",
      "type": "object"
    },
    "PilotA4Metrics": {
      "additionalProperties": false,
