        "case_count": {
          "minimum": 0,
          "title": "Case Count",
          "type": "integer"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/PilotA4CaseView"
          },
          "title": "Cases",
          "type": "array"
        },
        "closed_count": {
          "minimum": 0,
          "title": "Closed Count",
          "type": "integer"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
