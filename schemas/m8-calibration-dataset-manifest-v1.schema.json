{
  "$defs": {
    "M8CalibrationDatasetEntryV1": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Asset Id",
          "type": "string"
        },
        "end_frame_exclusive": {
          "exclusiveMinimum": 0,
          "title": "End Frame Exclusive",
          "type": "integer"
        },
        "ground_truth_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ground Truth Id",
          "type": "string"
        },
        "ground_truth_revision": {
          "exclusiveMinimum": 0,
          "title": "Ground Truth Revision",
          "type": "integer"
        },
        "group_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Group Id",
          "type": "string"
        },
        "human_confirmed": {
          "const": true,
          "default": true,
          "title": "Human Confirmed",
          "type": "boolean"
        },
        "interval_index": {
          "minimum": 0,
          "title": "Interval Index",
          "type": "integer"
        },
        "machine_output_is_ground_truth": {
          "const": false,
          "default": false,
          "title": "Machine Output Is Ground Truth",
          "type": "boolean"
        },
        "partition": {
          "$ref": "#/$defs/M8CalibrationPartition"
        },
        "ppe_state": {
          "$ref": "#/$defs/M8EvaluationPpeState"
        },
        "sample_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sample Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m8-calibration-dataset-entry-v1",
          "default": "m8-calibration-dataset-entry-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        }
      },
      "required": [
        "sample_id",
        "asset_id",
        "ground_truth_id",
        "ground_truth_revision",
        "interval_index",
        "start_frame",
        "end_frame_exclusive",
        "ppe_state",
        "group_id",
        "partition"
      ],
      "title": "M8CalibrationDatasetEntryV1",
      "type": "object"
    },
    "M8CalibrationPartition": {
      "enum": [
        "DEVELOPMENT",
        "CALIBRATION",
        "SEALED_TEST"
      ],
      "title": "M8CalibrationPartition",
      "type": "string"
    },
    "M8EvaluationPpeState": {
      "enum": [
        "WORN",
        "NOT_WORN",
        "UNCLEAR"
      ],
      "title": "M8EvaluationPpeState",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-calibration-dataset-manifest-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Manifest Id",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/M8CalibrationDatasetEntryV1"
      },
      "title": "Entries",
      "type": "array"
    },
    "machine_output_is_ground_truth": {
      "const": false,
      "default": false,
      "title": "Machine Output Is Ground Truth",
      "type": "boolean"
    },
    "schema_version": {
      "const": "m8-calibration-dataset-manifest-v1",
      "default": "m8-calibration-dataset-manifest-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "split_policy": {
      "const": "SHA256_GROUP_60_20_20_V1",
      "default": "SHA256_GROUP_60_20_20_V1",
      "title": "Split Policy",
      "type": "string"
    }
  },
  "required": [
    "dataset_manifest_id",
    "entries",
    "created_at"
  ],
  "title": "M8CalibrationDatasetManifestV1",
  "type": "object"
}
