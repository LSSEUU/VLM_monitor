{
  "$defs": {
    "M8KnowledgeContentType": {
      "enum": [
        "MARKDOWN",
        "PLAIN_TEXT"
      ],
      "title": "M8KnowledgeContentType",
      "type": "string"
    },
    "M8KnowledgeDocumentType": {
      "enum": [
        "DEVICE_MANUAL",
        "EMERGENCY_PLAN",
        "FAQ",
        "HISTORICAL_PRECEDENT",
        "POLICY",
        "SOP"
      ],
      "title": "M8KnowledgeDocumentType",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/m8-knowledge-document-authority-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Metadata for one immutable ordinary knowledge document version.",
  "properties": {
    "content_ref": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Content Ref",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "content_size_bytes": {
      "exclusiveMinimum": 0,
      "maximum": 1048576,
      "title": "Content Size Bytes",
      "type": "integer"
    },
    "content_type": {
      "$ref": "#/$defs/M8KnowledgeContentType"
    },
    "direct_case_decision_permitted": {
      "readOnly": true,
      "title": "Direct Case Decision Permitted",
      "type": "boolean"
    },
    "document_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Document Authority Id",
      "type": "string"
    },
    "document_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Document Manifest Id",
      "type": "string"
    },
    "document_type": {
      "$ref": "#/$defs/M8KnowledgeDocumentType"
    },
    "document_version": {
      "exclusiveMinimum": 0,
      "title": "Document Version",
      "type": "integer"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "issuer_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Issuer Id",
      "type": "string"
    },
    "locale": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Locale",
      "type": "string"
    },
    "logical_document_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Logical Document Id",
      "type": "string"
    },
    "ordinary_document_can_define_case_rule": {
      "readOnly": true,
      "title": "Ordinary Document Can Define Case Rule",
      "type": "boolean"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "schema_version": {
      "const": "m8-knowledge-document-authority-v1",
      "default": "m8-knowledge-document-authority-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_ref": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Source Ref",
      "type": "string"
    },
    "title": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "logical_document_id",
    "document_version",
    "document_type",
    "title",
    "locale",
    "issuer_id",
    "source_ref",
    "content_ref",
    "content_sha256",
    "content_size_bytes",
    "content_type",
    "published_at",
    "effective_at",
    "document_manifest_id",
    "ordinary_document_can_define_case_rule",
    "direct_case_decision_permitted",
    "document_authority_id"
  ],
  "title": "M8KnowledgeDocumentAuthorityV1",
  "type": "object"
}
