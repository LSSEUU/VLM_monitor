          "pattern": "^[0-9a-f]{64}$",
          "title": "Second Source Snapshot Id",
          "type": "string"
        },
        "source_determinism_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Source Determinism Authority Id",
          "type": "string"
        },
        "source_determinism_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "readOnly": true,
          "title": "Source Determinism Document Sha256",
          "type": "string"
        },
        "source_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Identity Sha256",
          "type": "string"
        },
        "source_manifest_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Manifest Id",
          "type": "string"
        },
