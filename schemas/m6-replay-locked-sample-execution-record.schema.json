          "type": "string"
        },
        "first_source_snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "First Source Snapshot Id",
          "type": "string"
        },
        "projection_read_count": {
          "const": 2,
          "default": 2,
          "title": "Projection Read Count",
          "type": "integer"
        },
        "replay_input_closure_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Replay Input Closure Authority Id",
          "type": "string"
        },
        "replay_input_closure_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Replay Input Closure Document Sha256",
          "type": "string"
        },
        "sample_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Sample Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m6-replay-locked-source-determinism-authority-v1",
          "default": "m6-replay-locked-source-determinism-authority-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "second_semantic_case_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Second Semantic Case Hash",
          "type": "string"
        },
