{
  "$defs": {
    "BBoxXYXY": {
      "additionalProperties": false,
      "description": "Integer `[x1, y1, x2, y2)` bounding box.",
      "properties": {
        "x1": {
          "minimum": 0,
          "title": "X1",
          "type": "integer"
        },
        "x2": {
          "exclusiveMinimum": 0,
          "title": "X2",
          "type": "integer"
        },
        "y1": {
          "minimum": 0,
          "title": "Y1",
          "type": "integer"
        },
        "y2": {
          "exclusiveMinimum": 0,
          "title": "Y2",
          "type": "integer"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "BBoxXYXY",
      "type": "object"
    },
    "TrainingLabelQuality": {
      "enum": [
        "WEAK_AUTO",
        "CONSENSUS_REVIEWED",
        "HUMAN_CONFIRMED",
        "APPEAL_CONFIRMED"
      ],
      "title": "TrainingLabelQuality",
      "type": "string"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/training-label.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bbox": {
      "$ref": "#/$defs/BBoxXYXY"
    },
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "crop_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Crop Id",
      "type": "string"
    },
    "detector_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Detector Manifest Id",
      "type": "string"
    },
    "excluded_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excluded Reason"
    },
    "label_id": {
      "minLength": 1,
      "title": "Label Id",
      "type": "string"
    },
    "label_name": {
      "minLength": 1,
      "title": "Label Name",
      "type": "string"
    },
    "label_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Label Value"
    },
    "quality": {
      "$ref": "#/$defs/TrainingLabelQuality"
    },
    "reviewer_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer Id"
    },
    "rule_version": {
      "minLength": 1,
      "title": "Rule Version",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "label_id",
    "case_id",
    "crop_id",
    "bbox",
    "label_name",
    "label_value",
    "quality",
    "source",
    "rule_version",
    "detector_manifest_id"
  ],
  "title": "TrainingLabel",
  "type": "object"
}
