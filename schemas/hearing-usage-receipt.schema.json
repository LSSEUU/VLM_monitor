{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "RUN",
        "FRAME",
        "SAFETY_SIGNAL",
        "EVENT",
        "CASE",
        "DETECTION",
        "OBJECTIVE_FACT",
        "CROP",
        "MEDIA",
        "EVIDENCE_PACK",
        "TOOL_RESULT",
        "MANIFEST",
        "MODEL_RESPONSE",
        "MODEL_REQUEST",
        "PROMPT_MANIFEST",
        "MODEL_PARSE_RECEIPT",
        "PARSED_MODEL_OUTPUT",
        "PROCEDURAL_REVIEW",
        "MODEL_CACHE_ENTRY",
        "SCREENING_RESULT",
        "VERDICT",
        "ALERT",
        "PRECEDENT",
        "APPEAL",
        "TRAINING_LABEL",
        "BACKLOG_ITEM",
        "DATASET"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A kind-discriminated reference with syntax fixed by the artifact kind.",
      "properties": {
        "artifact_id": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.labcourt.local/v2/hearing-usage-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exactly-once provider usage evidence; cache/recovery reads create no receipt.",
  "properties": {
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "estimated_cost": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Estimated Cost",
      "type": "number"
    },
    "hearing_session_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hearing Session Id",
      "type": "string"
    },
    "input_images": {
      "maximum": 64,
      "minimum": 0,
      "title": "Input Images",
      "type": "integer"
    },
    "input_pixels": {
      "maximum": 1000000000,
      "minimum": 0,
      "title": "Input Pixels",
      "type": "integer"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "request_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "response_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "retry_count": {
      "maximum": 16,
      "minimum": 0,
      "title": "Retry Count",
      "type": "integer"
    },
    "role": {
      "enum": [
        "PROSECUTOR",
        "DEFENDER",
        "JUDGE"
      ],
      "title": "Role",
      "type": "string"
    },
    "round_index": {
      "exclusiveMinimum": 0,
      "maximum": 5,
      "title": "Round Index",
      "type": "integer"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m4-hearing-usage-receipt-v1",
      "default": "m4-hearing-usage-receipt-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "usage_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "readOnly": true,
      "title": "Usage Receipt Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "hearing_session_id",
    "round_index",
    "role",
    "request_ref",
    "response_ref",
    "input_images",
    "input_pixels",
    "input_tokens",
    "output_tokens",
    "latency_ms",
    "retry_count",
    "estimated_cost",
    "manifest_id",
    "usage_receipt_id"
  ],
  "title": "HearingUsageReceipt",
  "type": "object"
}
